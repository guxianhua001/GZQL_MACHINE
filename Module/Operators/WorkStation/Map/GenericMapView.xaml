<UserControl x:Class="Framework.Views.GenericMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Framework.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:conv="clr-namespace:Framework.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="Ellipse">
                <Setter Property="Width"
                        Value="18" />
                <Setter Property="Height"
                        Value="18" />
                <Setter Property="StrokeThickness"
                        Value="2" />
                <Setter Property="ToolTipService.ToolTip">
                    <Setter.Value>
                        <StackPanel>
                            <TextBlock Text="{Binding ArrayIndex, StringFormat='阵列: {0}'}" />
                            <TextBlock Text="{Binding Row, StringFormat='行: {0}'}" />
                            <TextBlock Text="{Binding Column, StringFormat='列: {0}'}" />
                            <TextBlock Text="{Binding Index, StringFormat='全局序号: {0}'}" />
                        </StackPanel>
                    </Setter.Value>
                </Setter>
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <TabControl>
        <!-- MAP设置标签页 -->
        <TabItem 
                 Header="{Binding PinDisplayName}"
                 Background="{StaticResource MaterialDesignPaper}">
            <Grid Background="{StaticResource MaterialDesignPaper}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 基础阵列配置 GroupBox -->
                <GroupBox Grid.Row="0"
                          Header="基础阵列配置"
                          IsEnabled="{Binding CanEditConfig, 
                          Mode=OneWay,
                          UpdateSourceTrigger=PropertyChanged}">
                    <StackPanel Orientation="Vertical"
                                Margin="5">
                        <!-- 第一行：行/列配置 -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="行数:"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding Rows}"
                                         Margin="5,0"
                                         Width="60" />

                                <TextBlock Grid.Column="2"
                                           Text="列数:"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding Columns}"
                                         Margin="5,0"
                                         Width="60" />
                            </Grid>
                        </StackPanel>

                        <!-- 新增：生成规则选择 -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,5">
                            <TextBlock Text="生成规则:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <ComboBox ItemsSource="{Binding Source={x:Static local:GenerationRule.Values}}"
                                      SelectedValue="{Binding SelectedGenerationRule}"
                                      SelectedValuePath="Rule"
                                      Width="150"
                                      Margin="0,0,10,0" >
                            <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Button Content="初始化网格"
                                    Command="{Binding InitializeBaseOffsetsCommand}"
                                    Padding="10,3" />
                            <!-- 导出导入按钮 -->
                            <Button Content="导出网格"
                                    Command="{Binding ExportGridCommand}"
                                    Margin="10,0"
                                    Padding="10,3"
                                    ToolTip="导出当前网格配置" />
                            <Button Content="导入网格"
                                    Command="{Binding ImportGridCommand}"
                                    Margin="10,0"
                                    Padding="10,3"
                                    ToolTip="导入网格配置文件" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 在参数设置区域下方添加偏移网格 -->
                <GroupBox Grid.Row="1"
                          Header="偏移配置网格"
                          IsEnabled="{Binding CanEditConfig, 
                          Mode=OneWay,
                          UpdateSourceTrigger=PropertyChanged}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding BasePoints}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2"
                                                      Width="120">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Grid.Column="0"
                                                             Text="{Binding X}"
                                                             Margin="2"
                                                             ToolTip="X偏移"/>
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Y}"
                                                             Margin="2"
                                                             ToolTip="Y偏移"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>

                <!-- 参数设置 -->
                <GroupBox Grid.Row="2"
                          Header="阵列配置"
                          IsEnabled="{Binding CanEditConfig, 
                          Mode=OneWay,
                          UpdateSourceTrigger=PropertyChanged}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Margin="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="偏移X"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding GlobalOffsetX}"
                                         Margin="5" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="偏移Y"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding GlobalOffsetY}"
                                         Margin="5" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Margin="5"
                                    Orientation="Vertical">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="偏移次数"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding GlobalOffsetCount}"
                                         Margin="5" />
                            </Grid>
                            <Button Content="添加偏移阵列"
                                    Command="{Binding AddOffsetArrayCommand}"
                                    Margin="0,10"
                                    Padding="10,5" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- 地图显示 -->
                <Border Grid.Row="3"
                        Margin="10"
                        BorderBrush="Gray"
                        BorderThickness="1">
                    <ScrollViewer  x:Name="MainScrollViewer"
                                   HorizontalScrollBarVisibility="Auto"
                                   VerticalScrollBarVisibility="Auto"
                                   Background="{DynamicResource MaterialDesignPaper}">
                        <Viewbox Stretch="Uniform"
                                 Width="{Binding CanvasWidth}"
                                 Height="{Binding CanvasHeight}">
                            <ItemsControl ItemsSource="{Binding MapPoints}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="{Binding CanvasWidth}"
                                                Height="{Binding CanvasHeight}"
                                                Background="WhiteSmoke" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left"
                                                Value="{Binding X}" />
                                        <Setter Property="Canvas.Top"
                                                Value="{Binding Y}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="22"
                                                 Height="22"
                                                 Stroke="{Binding ArrayIndex, Converter={StaticResource ArrayColorConverter}}"
                                                 Fill="{Binding IsChecked, Converter={StaticResource StatusConverter}}">
                                            <!-- 添加视觉效果 -->
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="8"
                                                                  ShadowDepth="2"
                                                                  Color="Black"
                                                                  Opacity="0.5" />
                                            </Ellipse.Effect>
                                            <!-- 添加悬停动画 -->
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <ScaleTransform ScaleX="1.2"
                                                                                    ScaleY="1.2" />
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                            <i:Interaction.Triggers>
                                                <!-- 新增点击选择命令 -->
                                                <i:EventTrigger EventName="MouseEnter">
                                                    <i:InvokeCommandAction Command="{Binding DataContext.SelectPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           CommandParameter="{Binding}" />
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                        </Ellipse>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                    </ScrollViewer>
                </Border>

                <!-- 在Grid底部添加信息显示区域 -->
                <Border Grid.Row="4"
                        Height="40"
                        Background="{DynamicResource MaterialDesignToolBarBackground}"
                        Padding="10"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Visibility="{Binding SelectedPoint, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="当前选中点："
                                   Margin="0,0,10,0" />
                        <TextBlock Text="{Binding SelectedPoint.Index, StringFormat=序号: {0}}" />
                        <TextBlock Text=" | "
                                   Margin="5,0" />
                        <TextBlock Text="{Binding SelectedPoint.OriginalX, StringFormat=X: {0:F3}}" />
                        <TextBlock Text=" | "
                                   Margin="5,0" />
                        <TextBlock Text="{Binding SelectedPoint.OriginalY, StringFormat=Y: {0:F3}}" />
                    </StackPanel>
                </Border>

                <!-- 控制区域 -->
                <StackPanel Grid.Row="5"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="生成基础阵列"
                            Command="{Binding GenerateBaseCommand}"
                            Margin="5"
                            Padding="10,3" />
                    <Button Content="清空所有阵列"
                            Command="{Binding ClearAllCommand}"
                            Margin="5"
                            Padding="10,3" />
                    <Slider Minimum="0"
                            Maximum="{Binding MaxIndex}"
                            Value="{Binding CurrentIndex}"
                            Width="300"
                            Margin="10"
                            VerticalAlignment="Center" />
                    <!-- 新增按钮 -->
                    <Button Content="保存配方"
                            Command="{Binding SaveRecipeCommand}"
                            Margin="5"
                            Padding="10,3"
                            ToolTip="保存当前配置到文件"
                            Style="{StaticResource MaterialDesignRaisedButton}" />

                    <Button Content="加载配方"
                            Command="{Binding LoadRecipeCommand}">
                        <Button.Resources>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}"
                                                 Value="True">
                                        <Setter Property="Content"
                                                Value="加载中..." />
                                        <Setter Property="IsEnabled"
                                                Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <!-- 实时缩放 -->
                    <Button Content="放大"
                            Command="{Binding ZoomOutCommand}"
                            Margin="5" />
                    <Button Content="缩小"
                            Command="{Binding ZoomInCommand}"
                            Margin="5" />
                </StackPanel>

            </Grid>

        </TabItem>

        <!-- 参数设置标签页 -->
        <TabItem Header="参数设置"
                 Background="{StaticResource MaterialDesignPaper}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="10"
                      Background="{StaticResource MaterialDesignPaper}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 基础参数 -->
                    <GroupBox Grid.Row="0"
                              Header="坐标点管理">
                        <Grid Margin="5">
                            <DataGrid ItemsSource="{Binding AllPoints}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      EnableRowVirtualization="True"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True"
                                      IsEnabled="{Binding CanEditConfig}">
                                <DataGrid.Columns>
                                    <!-- 序号 -->
                                    <DataGridTextColumn Header="序号"
                                                        Binding="{Binding Index}"
                                                        Width="Auto"
                                                        IsReadOnly="True" />
                                    <!-- X坐标 -->
                                    <DataGridTemplateColumn Header="X坐标">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="2"
                                                         IsReadOnly="{Binding DataContext.CanEditConfig}"
                                                         ToolTip="双击编辑X坐标" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Y坐标 -->
                                    <DataGridTemplateColumn Header="Y坐标">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="2"
                                                         ToolTip="双击编辑Y坐标" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- 启用状态 -->
                                    <DataGridCheckBoxColumn Header="启用"
                                                            Binding="{Binding IsActive}"
                                                            Width="Auto" />
                                    <!-- 旋转状态 -->
                                    <DataGridCheckBoxColumn Header="启用旋转90度"
                                                            Binding="{Binding IsRotate}"
                                                            Width="Auto" />
                                    <!-- 顺序号 -->
                                    <DataGridTemplateColumn Header="顺序">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Order, UpdateSourceTrigger=LostFocus}"
                                                         Margin="2"
                                                         Width="60"
                                                         ToolTip="设置加工顺序" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- X坐标补偿 -->
                                    <DataGridTemplateColumn Header="X补偿">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding XOffset, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="2"
                                                         ToolTip="双击编辑X坐标" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Y坐标补偿 -->
                                    <DataGridTemplateColumn Header="Y补偿">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding YOffset, UpdateSourceTrigger=PropertyChanged}"
                                                         Margin="2"
                                                         ToolTip="双击编辑Y坐标" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- 移动按钮 -->
                                    <DataGridTemplateColumn Header="操作">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="移动"
                                                        Command="{Binding DataContext.MoveToPointCommand, 
                                     RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,2"
                                                        IsEnabled="True"
                                                        Style="{StaticResource MaterialDesignFlatButton}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>

                    <!-- 高级参数 -->
                    <GroupBox Grid.Row="1"
                              Header="高级参数">
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>


                        </Grid>
                    </GroupBox>

                    <!-- 参数预设管理 -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="10">
                        <Button Content="保存预设"
                                Command="{Binding SaveRecipeCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="5"
                                Padding="10,3" />

                        <Button Content="加载预设"
                                Command="{Binding LoadRecipeCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="5"
                                Padding="10,3" />

                        <!-- 添加导出功能 -->
                        <Button Content="导出CSV"
                                Command="{Binding ExportPointsCommand}"
                                ToolTip="导出当前点列表"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Margin="5" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </TabItem>
    </TabControl>

</UserControl>
