<UserControl x:Class="Module.Views.AssemblyStepControlView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
              xmlns:prism="http://prismlibrary.com/"
              xmlns:converters="clr-namespace:Framework.Converters"
              prism:ViewModelLocator.AutoWireViewModel="True"
              mc:Ignorable="d"
              d:DesignHeight="900"
              d:DesignWidth="500">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:BooleanToColorConverter x:Key="BooleanToColorConverter" />
            <converters:BooleanToSingleStepTextConverter x:Key="BooleanToSingleStepTextConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <!-- 单步控制区域 -->
                <GroupBox Header="单步控制"
                          Margin="0,0,0,15">
                    <StackPanel>
                        <!-- 当前步骤显示 -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,5">
                            <TextBlock Text="当前步骤:"
                                       FontWeight="Bold"
                                       Width="80" />
                            <TextBlock Text="{Binding CurrentStepDescription}"
                                       Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 控制按钮 -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,10"
                                    HorizontalAlignment="Center">
                            <!-- 启动单步 -->
                            <Button Content="启动单步"
                                    Command="{Binding StartSingleStepCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="100"
                                    Margin="5,0"
                                    ToolTip="启动单步执行模式" />

                            <!-- 下一步 -->
                            <Button Content="下一步"
                                    Command="{Binding NextStepCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Width="100"
                                    Margin="5,0"
                                    ToolTip="执行下一步操作"
                                    IsEnabled="{Binding IsStepWaiting}" />

                            <!-- 停止单步 -->
                            <Button Content="停止单步"
                                    Command="{Binding StopSingleStepCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="100"
                                    Margin="5,0"
                                    ToolTip="停止单步模式" />
                        </StackPanel>

                        <!-- 状态指示 -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,5"
                                    HorizontalAlignment="Center">
                            <Ellipse Width="12"
                                     Height="12"
                                     Fill="{Binding IsSingleStepMode, Converter={StaticResource BooleanToColorConverter}}"
                                     Stroke="DarkGray"
                                     StrokeThickness="1"
                                     ToolTip="单步模式状态" />
                            <TextBlock Text="{Binding IsSingleStepMode, Converter={StaticResource BooleanToSingleStepTextConverter}}"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 组装工位选择 -->
                <GroupBox Header="组装工位选择"
                          Margin="0,0,0,15">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding StationIndices}"
                                  SelectedItem="{Binding SelectedStationIndex}"
                                  materialDesign:HintAssist.Hint="选择工位序号"
                                  Width="120"
                                  Margin="0,0,0,10" />

                        <StackPanel Orientation="Horizontal">
                            <Button Content="加载参数"
                                    Command="{Binding LoadCompensationCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="120"
                                    Margin="5" />
                            <Button Content="保存参数"
                                    Command="{Binding SaveCompensationCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="120"
                                    Margin="5" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- 补偿值设置 -->
                <GroupBox Header="补偿值设置 (工位 {Binding SelectedStationIndex})"
                          Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Grid列定义修改：增加一列用于"获取"按钮 -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- X方向组装补偿 -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="X组装补偿:"
                                   Margin="5,8,10,8"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding CompensationX, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"
                                 Margin="5,8"
                                 VerticalContentAlignment="Center" />
                        <!-- 获取X补偿值按钮 -->
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Command="{Binding GetCompensationXCommand}"
                                Content="获取"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="60"
                                Margin="5,8,5,8"
                                ToolTip="从补偿服务获取X轴补偿值"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="3"
                                   Text="mm"
                                   Margin="5,8"
                                   VerticalAlignment="Center" />
                        <Button Grid.Row="0"
                                Grid.Column="4"
                                Command="{Binding MoveXRelativeCommand}"
                                Content="相对移动"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="120"
                                Margin="5,8,5,8"
                                ToolTip="将X轴相对移动指定距离"
                                VerticalAlignment="Center" />

                        <!-- Z方向组装补偿 -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="Z组装补偿:"
                                   Margin="5,8,10,8"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding CompensationZ, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"
                                 Margin="5,8"
                                 VerticalContentAlignment="Center" />
                        <!-- 获取Z补偿值按钮 -->
                        <Button Grid.Row="1"
                                Grid.Column="2"
                                Command="{Binding GetCompensationZCommand}"
                                Content="获取"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="60"
                                Margin="5,8,5,8"
                                ToolTip="从补偿服务获取Z轴补偿值"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   Text="mm"
                                   Margin="5,8"
                                   VerticalAlignment="Center" />
                        <Button Grid.Row="1"
                                Grid.Column="4"
                                Command="{Binding MoveZRelativeCommand}"
                                Content="相对移动"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="120"
                                Margin="5,8,5,8"
                                ToolTip="将Z轴相对移动指定距离"
                                VerticalAlignment="Center" />

                        <!-- Y向组装补偿 -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="Y向组装补偿:"
                                   Margin="5,8,10,8"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding CompensationY, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"
                                 Margin="5,8"
                                 VerticalContentAlignment="Center" />
                        <!-- 获取Y补偿值按钮 -->
                        <Button Grid.Row="2"
                                Grid.Column="2"
                                Command="{Binding GetCompensationYCommand}"
                                Content="获取"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="60"
                                Margin="5,8,5,8"
                                ToolTip="从补偿服务获取Y轴补偿值"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="3"
                                   Text="mm"
                                   Margin="5,8"
                                   VerticalAlignment="Center" />
                        <Button Grid.Row="2"
                                Grid.Column="4"
                                Command="{Binding MoveYRelativeCommand}"
                                Content="相对1移动"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="120"
                                Margin="5,8,5,8"
                                ToolTip="将Y轴相对移动指定距离"
                                VerticalAlignment="Center" />

                        <!-- X方向平移补偿 -->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="X平移补偿:"
                                   Margin="5,8,10,8"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding CompensationXTranslate, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"
                                 Margin="5,8"
                                 VerticalContentAlignment="Center" />
                        <!-- 获取X平移补偿值按钮 -->
                        <Button Grid.Row="3"
                                Grid.Column="2"
                                Command="{Binding GetCompensationXTranslateCommand}"
                                Content="获取"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="60"
                                Margin="5,8,5,8"
                                ToolTip="从补偿服务获取X平移轴补偿值"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="3"
                                   Text="mm"
                                   Margin="5,8"
                                   VerticalAlignment="Center" />
                        <Button Grid.Row="3"
                                Grid.Column="4"
                                Command="{Binding MoveXTranslateRelativeCommand}"
                                Content="相对移动"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="120"
                                Margin="5,8,5,8"
                                ToolTip="将平移轴相对移动指定距离"
                                VerticalAlignment="Center" />

                        <!-- Z方向下压补偿 -->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="Z下压补偿:"
                                   Margin="5,8,10,8"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding CompensationZPress, UpdateSourceTrigger=PropertyChanged}"
                                 Width="120"
                                 Margin="5,8"
                                 VerticalContentAlignment="Center" />
                        <!-- 获取Z下压补偿值按钮 -->
                        <Button Grid.Row="4"
                                Grid.Column="2"
                                Command="{Binding GetCompensationZPressCommand}"
                                Content="获取"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="60"
                                Margin="5,8,5,8"
                                ToolTip="从补偿服务获取Z下压轴补偿值"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4"
                                   Grid.Column="3"
                                   Text="mm"
                                   Margin="5,8"
                                   VerticalAlignment="Center" />
                        <Button Grid.Row="4"
                                Grid.Column="4"
                                Command="{Binding MoveZPressRelativeCommand}"
                                Content="相对移动"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Width="120"
                                Margin="5,8,5,8"
                                ToolTip="将下压轴相对移动指定距离"
                                VerticalAlignment="Center" />

                        <!-- 调整按钮区域的行位置 -->
                        <StackPanel Grid.Row="5"
                                    Grid.ColumnSpan="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,15">
                            <Button Content="应用所有工位"
                                    Command="{Binding ApplyToAllStationsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="120"
                                    Margin="5" />
                            <Button Content="重置"
                                    Command="{Binding ResetCompensationCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="80"
                                    Margin="5" />
                        </StackPanel>

                        <!-- 状态显示 -->
                        <TextBlock Grid.Row="6"
                                   Grid.ColumnSpan="5"
                                   Text="{Binding CompensationStatus}"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                   Margin="5,10"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Grid>
                </GroupBox>

                <!-- 开始组装按钮 -->
                <GroupBox Header="组装执行"
                          Margin="0,0,0,10">
                    <StackPanel>
                        <!-- 修正：移除外部的Style属性，直接在Button.Style中定义 -->
                        <Button Content="开始组装"
                                Command="{Binding StartAssemblyCommand}"
                                Width="150"
                                Height="40"
                                FontSize="14"
                                FontWeight="Bold"
                                Margin="0,10"
                                HorizontalAlignment="Center">
                            <Button.Style>
                                <Style BasedOn="{StaticResource MaterialDesignRaisedButton}"
                                       TargetType="Button">
                                    <!-- 默认状态 -->
                                    <Setter Property="Background"
                                            Value="{DynamicResource PrimaryHueMidBrush}" />
                                    <Setter Property="Foreground"
                                            Value="White" />
                                    <Setter Property="Cursor"
                                            Value="Hand" />

                                    <!-- 触发器 -->
                                    <Style.Triggers>
                                        <!-- 组装运行中状态 -->
                                        <DataTrigger Binding="{Binding IsAssemblyRunning}"
                                                     Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource MaterialDesignRed500}" />
                                            <Setter Property="Foreground"
                                                    Value="White" />
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="CogPlay"
                                                                                 Width="16"
                                                                                 Height="16"
                                                                                 Margin="0,0,5,0"
                                                                                 Foreground="White" />
                                                        <TextBlock Text="组装中..."
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="IsEnabled"
                                                    Value="False" />
                                        </DataTrigger>

                                        <!-- 非运行状态 -->
                                        <DataTrigger Binding="{Binding IsAssemblyRunning}"
                                                     Value="False">
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal"
                                                                VerticalAlignment="Center">
                                                        <materialDesign:PackIcon Kind="PlayCircle"
                                                                                 Width="16"
                                                                                 Height="16"
                                                                                 Margin="0,0,5,0"
                                                                                 Foreground="White" />
                                                        <TextBlock Text="开始组装"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="IsEnabled"
                                                    Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 组装状态显示 -->
                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,5"
                                Margin="0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="Information"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,5,0"
                                                         VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="组装状态:"
                                               FontWeight="Bold"
                                               Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding AssemblyStatus}"
                                               Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>