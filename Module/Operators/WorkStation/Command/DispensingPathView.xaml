<UserControl x:Class="Framework.Views.DispensingPathView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Framework.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:Framework.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200">
     
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 布尔值到颜色转换器 -->
            <converters:BooleanToColorConverter x:Key="BooleanToColorConverter"
                                      TrueColor="Green"
                                      FalseColor="LightGray" />
            <converters:ArcDirectionConverter x:Key="ArcDirectionConverter" />
            <!-- 操作按钮样式 -->
            <Style x:Key="OperationButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="30" />
                <Setter Property="Width" Value="120" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <!-- 数据网格样式 -->
            <Style x:Key="DataGridStyle" TargetType="DataGrid">
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource MaterialDesignPaper}" />
                <Setter Property="RowBackground" Value="White" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 轨迹参数设置 -->
            <GroupBox Header="轨迹参数设置" Grid.Row="0" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 序号选择和拍照按钮 -->
                    <TextBlock Text="选择序号:" 
                               Grid.Row="0" Grid.Column="0"
                               Margin="5" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding AvailableIndexes}"
                              SelectedItem="{Binding SelectedIndex}"
                              Grid.Row="0" Grid.Column="1"
                              Width="60" Margin="5"/>
                    <TextBlock Text="号" 
                               Grid.Row="0" Grid.Column="2"
                               VerticalAlignment="Center" Margin="2,0,10,0"/>
                    <!-- 移动和拍照按钮 -->
                    <Button Content="移到点胶轨迹位置" 
                            Command="{Binding MoveToPhotoPositionCommand}"
                            Grid.Row="0" Grid.Column="3"
                            Width="130" Height="30" Margin="5"
                            Background="LightGreen"
                            ToolTip="将相机移动到指定序号的拍照位置"/>

                    <Button Content="轨迹拍照1" 
                            Command="{Binding TakeCurvedPathPhoto1Command}"
                            Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="1"
                            Width="130" Height="30" Margin="5"
                            Background="LightBlue"
                            ToolTip="在当前拍照位置进行拍照并获取轨迹点"/>
                    
                    <Button Content="轨迹拍照2" 
                            Command="{Binding TakeCurvedPathPhoto2Command}"
                            Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="1"
                            Width="130" Height="30" Margin="5"
                            Background="LightBlue"
                            ToolTip="在当前拍照位置进行拍照并获取轨迹点"/>
                    
                    <!-- 相机中心坐标（从视觉结果获取） -->
                    <TextBlock Text="相机中心(X,Y):" 
                               Grid.Row="1" Grid.Column="0"
                               Margin="5" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding CameraCenterX, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="1" Grid.Column="1"
                             Width="80" Margin="5" IsReadOnly="True" Background="LightGray"/>
                    <TextBox Text="{Binding CameraCenterY, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="1" Grid.Column="3"
                             Width="80" Margin="5" IsReadOnly="True" Background="LightGray"/>
                    <TextBlock Text="mm" 
                               Grid.Row="1" Grid.Column="4"
                               VerticalAlignment="Center" Margin="2,0,10,0"/>

                    <!-- 起始点 -->
                    <TextBlock Text="起始点(X,Y):" 
                               Grid.Row="2" Grid.Column="0"
                               Margin="5" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PathStartX, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="2" Grid.Column="1"
                             Width="80" Margin="5"/>
                    <TextBox Text="{Binding PathStartY, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="2" Grid.Column="3"
                             Width="80" Margin="5"/>
                    <TextBlock Text="mm" 
                               Grid.Row="2" Grid.Column="4"
                               VerticalAlignment="Center" Margin="2,0,10,0"/>

                    <!-- 中间点 -->
                    <TextBlock Text="中间点(X,Y):" 
                               Grid.Row="3" Grid.Column="0"
                               Margin="5" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PathMidX, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="3" Grid.Column="1"
                             Width="80" Margin="5"/>
                    <TextBox Text="{Binding PathMidY, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="3" Grid.Column="3"
                             Width="80" Margin="5"/>
                    <TextBlock Text="mm" 
                               Grid.Row="3" Grid.Column="4"
                               VerticalAlignment="Center" Margin="2,0,10,0"/>

                    <!-- 结束点 -->
                    <TextBlock Text="结束点(X,Y):" 
                               Grid.Row="4" Grid.Column="0"
                               Margin="5" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PathEndX, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="4" Grid.Column="1"
                             Width="80" Margin="5"/>
                    <TextBox Text="{Binding PathEndY, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="4" Grid.Column="3"
                             Width="80" Margin="5"/>
                    <TextBlock Text="mm" 
                               Grid.Row="4" Grid.Column="4"
                               VerticalAlignment="Center" Margin="2,0,10,0"/>

                    <!-- 段数 -->
                    <TextBlock Text="段数:" 
                               Grid.Row="5" Grid.Column="0"
                               Margin="5" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding PathSegmentCount, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="5" Grid.Column="1"
                             Width="80" Margin="5"/>
                    <TextBlock Text="段" 
                               Grid.Row="5" Grid.Column="2"
                               VerticalAlignment="Center" Margin="5,0,10,0"/>

                    <!-- 轨迹类型选择 -->
                    <TextBlock Text="轨迹类型:" 
                                Grid.Row="5" Grid.Column="3"
                                Margin="5" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding PathTypes}"
                              SelectedItem="{Binding SelectedPathType}"
                              Width="120"
                              Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="2"
                              Margin="5">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 生成轨迹按钮 -->
                    <Button Content="生成轨迹" 
                            Command="{Binding GeneratePathCommand}"
                            Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="8"
                            Width="120" Height="30"
                            Margin="5,10,5,5"
                            HorizontalAlignment="Center"/>

                    <!-- 拍照状态显示 -->
                    <TextBlock Text="提示: 点击'弧形轨迹拍照'按钮，自动获取相机中心、起点、中点、终点坐标；点击'生成轴轨迹'自动计算轴偏移量"
                               Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="8"
                               Margin="5" FontStyle="Italic" Foreground="Gray"/>
                </Grid>
            </GroupBox>

            <!-- 生成的轨迹点列表 -->
            <GroupBox Header="生成的轨迹点" Grid.Row="1" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid ItemsSource="{Binding GeneratedPathPoints}"
                              Style="{StaticResource DataGridStyle}"
                              Height="200"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" 
                                Binding="{Binding Index}" 
                                Width="60"/>
                            <DataGridTextColumn Header="X坐标" 
                                Binding="{Binding X, StringFormat=F3}" 
                                Width="100"/>
                            <DataGridTextColumn Header="Y坐标" 
                                Binding="{Binding Y, StringFormat=F3}" 
                                Width="100"/>
                            <DataGridTextColumn Header="段长" 
                                Binding="{Binding SegmentLength, StringFormat=F3}" 
                                Width="80"/>
                            <DataGridTextColumn Header="累计长度" 
                                Binding="{Binding AccumulatedLength, StringFormat=F3}" 
                                Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="导出CSV" 
                                Command="{Binding ExportPathPointsCommand}"
                                Width="100" Height="25" Margin="5"/>
                        <Button Content="清空列表" 
                                Command="{Binding ClearPathPointsCommand}"
                                Width="100" Height="25" Margin="5"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 轴坐标转换 -->
            <GroupBox Header="轴坐标转换" Grid.Row="2" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 起始轴坐标 -->
                    <TextBlock Text="起始轴坐标(X,Y):" 
                               Grid.Row="0" Grid.Column="0"
                               Margin="5" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding AxisStartX, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="0" Grid.Column="1"
                             Width="80" Margin="5"
                             ToolTip="针尖标定的相机中心X"/>
                    <TextBox Text="{Binding AxisStartY, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="0" Grid.Column="3"
                             Width="80" Margin="5"
                             ToolTip="针尖标定的相机中心Y"/>
                    <TextBlock Text="mm" 
                               Grid.Row="0" Grid.Column="2"
                               VerticalAlignment="Center" Margin="5,0,10,0"/>
                    
                    <TextBlock Text="拍照轴坐标(X,Y):" 
                                Grid.Row="1" Grid.Column="0"
                                Margin="5" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding AxisX, UpdateSourceTrigger=PropertyChanged}"
                              Grid.Row="1" Grid.Column="1"
                              Width="80" Margin="5"
                              ToolTip="当前拍照位X"/>
                    <TextBox Text="{Binding AxisY, UpdateSourceTrigger=PropertyChanged}"
                              Grid.Row="1" Grid.Column="3"
                              Width="80" Margin="5"
                              ToolTip="当前拍照位Y"/>
                    <TextBlock Text="mm" 
                               Grid.Row="1" Grid.Column="2"
                               VerticalAlignment="Center" Margin="5,0,10,0"/>
                    
                    <!-- 轴偏移量 -->
                    <TextBlock Text="轴偏移量(ΔX,ΔY):" 
                               Grid.Row="2" Grid.Column="0"
                               Margin="5" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding AxisOffsetX, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="2" Grid.Column="1"
                             Width="80" Margin="5"/>
                    <TextBox Text="{Binding AxisOffsetY, UpdateSourceTrigger=PropertyChanged}"
                             Grid.Row="2" Grid.Column="3"
                             Width="80" Margin="5"/>
                    <TextBlock Text="mm" 
                               Grid.Row="2" Grid.Column="2"
                               VerticalAlignment="Center" Margin="5,0,10,0"/>

                    <!-- 点胶高度 -->
                    <TextBlock Text="点胶高度:" 
                               Grid.Row="3" Grid.Column="0"
                               Margin="5" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SafeHeight, UpdateSourceTrigger=PropertyChanged}"
                               Grid.Row="3" Grid.Column="1"
                               Width="80" Margin="5"/>
                    <TextBlock Text="mm" 
                               Grid.Row="3" Grid.Column="2"
                               VerticalAlignment="Center" Margin="5,0,10,0"/>
                    
                    <!-- 生成轴轨迹按钮 -->
                    <Button Content="生成轴轨迹" 
                            Command="{Binding GenerateAxisPathCommand}"
                            Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                            Width="120" Height="30"
                            Margin="5,10,5,5"
                            HorizontalAlignment="Center"/>
                </Grid>
            </GroupBox>

            <!-- 针头真实轨迹计算 -->
            <GroupBox Header="针头真实轨迹计算" Grid.Row="3" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 计算公式说明 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="针头坐标计算公式:" 
                                   FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="针头坐标 = 轴坐标 + 相机与针头固定间距 + 校针补偿量 + 相机补偿量" 
                                   Margin="0,2" TextWrapping="Wrap"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="相机-针头间距:" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding CameraNeedleOffsetX, StringFormat=F3}"
                                     Grid.Column="1" Width="80" Margin="5" IsReadOnly="False" Background="LightGray"/>
                            <TextBox Text="{Binding CameraNeedleOffsetY, StringFormat=F3}"
                                     Grid.Column="3" Width="80" Margin="5" IsReadOnly="False" Background="LightGray"/>
                            <TextBlock Text="mm" Grid.Column="2" VerticalAlignment="Center" Margin="5,0,10,0"/>
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="校针补偿量:" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding NeedleCompensationX, StringFormat=F3}"
                                     Grid.Column="1" Width="80" Margin="5" IsReadOnly="False" Background="LightGray"/>
                            <TextBox Text="{Binding NeedleCompensationY, StringFormat=F3}"
                                     Grid.Column="3" Width="80" Margin="5" IsReadOnly="False" Background="LightGray"/>
                            <TextBlock Text="mm" Grid.Column="2" VerticalAlignment="Center" Margin="5,0,10,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- 针头轨迹点列表 -->
                    <DataGrid ItemsSource="{Binding NeedlePathPoints}"
                              Style="{StaticResource DataGridStyle}"
                              Height="250"
                              Grid.Row="1"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" 
                                Binding="{Binding Index}" 
                                Width="60"/>
                            <DataGridTextColumn Header="轴坐标X" 
                                Binding="{Binding AxisOffsetX, StringFormat=F3}" 
                                Width="100"/>
                            <DataGridTextColumn Header="轴坐标Y" 
                                Binding="{Binding AxisOffsetY, StringFormat=F3}" 
                                Width="100"/>
                            <DataGridTextColumn Header="针头坐标X" 
                                Binding="{Binding NeedleX, StringFormat=F3}" 
                                Width="100"/>
                            <DataGridTextColumn Header="针头坐标Y" 
                                Binding="{Binding NeedleY, StringFormat=F3}" 
                                Width="100"/>
                            <DataGridTextColumn Header="移动速度" 
                                Binding="{Binding Speed, StringFormat=F0}" 
                                Width="80"/>
                            <DataGridTextColumn Header="点胶时间" 
                                Binding="{Binding DispensingTime, StringFormat=F0}" 
                                Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 点胶参数设置 -->
                    <StackPanel Grid.Row="2">
                        <!-- 第一排：速度与时间 -->
                        <UniformGrid Columns="4" Margin="0,5">
                            <TextBlock Text="移动速度:" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Text="{Binding PathMoveSpeed,UpdateSourceTrigger=PropertyChanged}"
                                     Width="80" Margin="0,0,5,0"/>
                            <TextBlock Text="mm/s" VerticalAlignment="Center" Margin="0,0,15,0"/>

                            <TextBlock Text="点胶时间:" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Text="{Binding PathDispensingTime,UpdateSourceTrigger=PropertyChanged}"
                                     Width="80" Margin="0,0,5,0"/>
                            <TextBlock Text="ms"   VerticalAlignment="Center"/>
                        </UniformGrid>

                        <!-- 第二排：按钮 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5">
                            <Button Content="移动到起点"
                                    Command="{Binding MoveToStartPointCommand}"
                                    Width="110" Height="30" Margin="0,0,10,0"/>
                            <Button Content="计算针头轨迹"
                                    Command="{Binding CalculateNeedlePathCommand}"
                                    Width="120" Height="30"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 连续插补控制 -->
            <GroupBox Header="连续插补控制" Grid.Row="4">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 控制按钮 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="启动连续插补" 
                                Command="{Binding StartContinuousInterpolationCommand}"
                                Width="150" Height="40"
                                Margin="10"
                                Background="LightGreen"
                                FontWeight="Bold"/>

                        <Button Content="暂停" 
                                Command="{Binding PauseContinuousInterpolationCommand}"
                                Width="100" Height="40"
                                Margin="10"/>

                        <Button Content="停止" 
                                Command="{Binding StopContinuousInterpolationCommand}"
                                Width="100" Height="40"
                                Margin="10"
                                Background="LightCoral"/>

                        <Button Content="单步测试" 
                                Command="{Binding TestSingleStepCommand}"
                                Width="100" Height="40"
                                Margin="10"/>
                    </StackPanel>

                    <!-- 状态显示 -->
                    <Border Grid.Row="1" 
                            Background="{Binding InterpolationStatusColor}"
                            CornerRadius="3"
                            Padding="10,5"
                            Margin="0,10,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="12" Height="12"
                                     Fill="{Binding IsInterpolationRunning, Converter={StaticResource BooleanToColorConverter}}"
                                     Stroke="DarkGray" StrokeThickness="1"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding InterpolationStatus}" 
                                       FontWeight="Bold" FontSize="14"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <!-- 进度信息 -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="当前点:" Grid.Column="0" Margin="5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentPointIndex}"
                                   Grid.Column="1" Margin="5" VerticalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="进度:" Grid.Column="2" Margin="10,5,5,5" VerticalAlignment="Center"/>
                        <ProgressBar Value="{Binding InterpolationProgress}" 
                                     Minimum="0" Maximum="100"
                                     Height="20"
                                     Grid.Column="3" Margin="5"/>
                    </Grid>
                </Grid>
            </GroupBox>
            
            <!-- 弧线方向控制 -->
            <GroupBox Header="弧线方向控制" Grid.Row="5" Margin="0,0,0,10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 弧线方向选择 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                        <RadioButton Content="弧线向外" 
                                     IsChecked="{Binding ArcDirection, Converter={StaticResource ArcDirectionConverter}, ConverterParameter=1}"
                                     Margin="5"/>
                        <RadioButton Content="弧线向内" 
                                     IsChecked="{Binding ArcDirection, Converter={StaticResource ArcDirectionConverter}, ConverterParameter=-1}"
                                     Margin="5"/>
                    </StackPanel>

                    <!-- 自动调整选项 -->
                    <CheckBox Grid.Row="1" 
                              Content="自动调整弧线方向"
                              IsChecked="{Binding AutoAdjustArcDirection}"
                              Margin="5"/>
                </Grid>
            </GroupBox>

        </Grid>
    </ScrollViewer>
</UserControl>