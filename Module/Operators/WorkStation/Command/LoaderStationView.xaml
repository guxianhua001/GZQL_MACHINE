<UserControl x:Class="Framework.Views.LoaderStationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Framework.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/" xmlns:converters="clr-namespace:Framework.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
            <converters:BooleanToFontWeightConverter x:Key="BooleanToFontWeightConverter" />
            
            <!-- 状态指示灯样式 -->
            <Style x:Key="StatusIndicator"
                   TargetType="Border">
                <Setter Property="Width"
                        Value="12" />
                <Setter Property="Height"
                        Value="12" />
                <Setter Property="CornerRadius"
                        Value="6" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="BorderBrush"
                        Value="Gray" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧控制面板 -->
        <TabControl Grid.Column="0"
                    SelectedIndex="{Binding SelectedTabIndex}">
            <!-- 上料工位控制 -->
            <TabItem Header="上料控制">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- 基本操作 -->
                        <GroupBox Header="基本操作"
                                  Margin="0,0,0,10">
                            <UniformGrid Columns="2"
                                         Margin="5">
                                <Button Command="{Binding LoadCommand}"
                                        Content="上料扫描"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="2" />
                                <Button Command="{Binding UnloadCommand}"
                                        Content="出料位"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="2" />
                                <Button Command="{Binding MoveToPickPositionCommand}"
                                        Content="取料位"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="2" />
                                <Button Command="{Binding PlatformHomeCommand}"
                                        Content="平台归零"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="2" />
                            </UniformGrid>
                        </GroupBox>

                        <!-- 载台真空控制 -->
                        <GroupBox Header="载台真空"
                                  Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal"
                                        Margin="5">
                                <Button Command="{Binding ChuckVacuumOnCommand}"
                                        Content="吸真空"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="2" />
                                <Button Command="{Binding ChuckVacuumBreakCommand}"
                                        Content="破真空"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="2" />
                                <Button Command="{Binding ChuckVacuumOffCommand}"
                                        Content="关真空"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="2" />
                                <Border Style="{StaticResource StatusIndicator}" 
                                        Background="{Binding VacuumStatus, Converter={StaticResource BooleanToBrushConverter}}"
                                        ToolTip="真空状态" />
                            </StackPanel>
                        </GroupBox>

                        <!-- 装配位置 -->
                        <GroupBox Header="装配位置"
                                  Margin="0,0,0,10">
                            <UniformGrid Columns="3"
                                         Margin="5">
                                <Button Command="{Binding AssemblyPos1Command}"
                                        Content="位置1"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="1" />
                                <Button Command="{Binding AssemblyPos2Command}"
                                        Content="位置2"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="1" />
                                <Button Command="{Binding AssemblyPos3Command}"
                                        Content="位置3"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="1" />
                                <Button Command="{Binding AssemblyPos4Command}"
                                        Content="位置4"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="1" />
                                <Button Command="{Binding AssemblyPos5Command}"
                                        Content="位置5"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="1" />
                                <Button Command="{Binding AssemblyPos6Command}"
                                        Content="位置6"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="1" />
                            </UniformGrid>
                        </GroupBox>

                        <!-- 流程控制 -->
                        <GroupBox Header="流程控制"
                                  Margin="0,0,0,10">
                            <UniformGrid Columns="2"
                                         Margin="5">
                                <Button Command="{Binding StartLoadingProcessCommand}"
                                        Content="开始上料流程"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="Green"
                                        Margin="2" />
                                <Button Command="{Binding StopLoadingProcessCommand}"
                                        Content="停止上料流程"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="Red"
                                        Margin="2" />
                                <Button Content="启动单步"
                                        Command="{Binding StartSingleStepCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="2" />
                                <Button Command="{Binding PauseProcessCommand}"
                                        Content="暂停"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="2" />
                                <Button Command="{Binding SingleStepCommand}"
                                        Content="单步执行"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="2" />
                            </UniformGrid>
                        </GroupBox>

                        <!-- 参数操作 -->
                        <GroupBox Header="参数操作"
                                  Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal"
                                        Margin="5">
                                <Button Command="{Binding EditParametersCommand}"
                                        Content="编辑参数"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Margin="2" />
                                <Button Command="{Binding SaveParametersCommand}"
                                        Content="保存参数"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Margin="2" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- 标定页面 -->
            <TabItem Header="标定">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <GroupBox Header="轴标定"
                                  Margin="0,0,0,10">
                            <UniformGrid Columns="2"
                                         Margin="5">
                                <Button Command="{Binding CalibrateYAxisCommand}"
                                        Content="Y轴标定"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="2" />
                                <Button Command="{Binding CalibrateUAxisCommand}"
                                        Content="U轴标定"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="2" />
                                <Button Command="{Binding CalibrateRAxisCommand}"
                                        Content="R轴标定"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="2" />
                                <Button Command="{Binding CalibrateAllAxesCommand}"
                                        Content="全部标定"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Margin="2" />
                            </UniformGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 右侧状态显示 -->
        <Grid Grid.Column="1"
              Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 状态概览 -->
            <GroupBox Grid.Row="0"
                      Header="状态概览"
                      Margin="0,0,0,10">
                <UniformGrid Columns="4"
                             Margin="5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Y轴:"
                                   Margin="5,0" />
                        <Border Style="{StaticResource StatusIndicator}" />
                        <!--Background="{Binding YAxisReady, Converter={StaticResource BooleanToBrushConverter}}" />-->
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="U轴:"
                                   Margin="5,0" />
                        <Border Style="{StaticResource StatusIndicator}" />
                        <!--Background="{Binding UAxisReady, Converter={StaticResource BooleanToBrushConverter}}" />-->
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="R轴:"
                                   Margin="5,0" />
                        <Border Style="{StaticResource StatusIndicator}" />
                        <!--Background="{Binding RAxisReady, Converter={StaticResource BooleanToBrushConverter}}" />-->
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="流程状态:"
                                   Margin="5,0" />
                        <TextBlock Text="{Binding ProcessStatus}"
                                   Margin="5,0"
                                   FontWeight="Bold" />
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <!-- 流程状态显示 -->
            <GroupBox Grid.Row="1"
                      Header="流程状态"
                      Margin="0,0,0,10">
                <ListBox ItemsSource="{Binding StepStatusList}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Margin="2">
                                <Border Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="{Binding IsCompleted, Converter={StaticResource BooleanToBrushConverter}}"
                                        Margin="0,0,5,0" />
                                <TextBlock Text="{Binding Description}"
                                           FontWeight="{Binding IsCurrent, Converter={StaticResource BooleanToFontWeightConverter}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>

            <!-- 日志显示 -->
            <GroupBox Grid.Row="2"
                      Header="操作日志">
                <TextBox Text="{Binding LogMessages}"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         Height="120"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>