<UserControl x:Class="Framework.Views.DispenserStationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Framework.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:Framework.Converters"
             xmlns:converters1="clr-namespace:Module.Converters"
             xmlns:view="clr-namespace:Module.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="860"
             d:DesignWidth="1200">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
            </ResourceDictionary.MergedDictionaries>
            <LinearGradientBrush x:Key="WindowBackgroundBrush"
                                 StartPoint="0,0"
                                 EndPoint="1,1">
                <GradientStop Color="White"
                              Offset="0.0" />
                <GradientStop Color="White"
                              Offset="1.0" />
            </LinearGradientBrush>
            <Thickness x:Key="Marg"
                       Left="3"
                       Right="3"
                       Top="2"
                       Bottom="2" />

            <!-- 布尔值到颜色转换器 -->
            <converters:BooleanToColorConverter x:Key="BooleanToColorConverter"
                                      TrueColor="Green"
                                      FalseColor="LightGray" />
            <converters:BooleanToTextConverter x:Key="BooleanToSingleStepTextConverter"
                                     TrueText="单步模式运行中"
                                     FalseText="单步模式已停止" />
            <converters1:IndexToTabHeaderConverter x:Key="IndexToTabHeaderConverter" />
            <converters1:IndexToPositionHeaderConverter x:Key="IndexToPositionHeaderConverter" />

            <!-- 3D扫描和标定样式 -->
            <Style x:Key="OperationButtonStyle"
                   TargetType="Button">
                <Setter Property="Height"
                        Value="30" />
                <Setter Property="Width"
                        Value="120" />
                <Setter Property="Margin"
                        Value="5" />
                <Setter Property="FontSize"
                        Value="12" />
            </Style>

            <Style x:Key="StatusIndicatorStyle"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="LightGray" />
                <Setter Property="CornerRadius"
                        Value="3" />
                <Setter Property="Padding"
                        Value="8,4" />
                <Setter Property="Margin"
                        Value="5" />
            </Style>

            <!-- 单步控制按钮样式 -->
            <Style x:Key="SingleStepButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Width"
                        Value="100" />
                <Setter Property="Height"
                        Value="30" />
                <Setter Property="Margin"
                        Value="3" />
                <Setter Property="FontSize"
                        Value="12" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    
    <Grid VirtualizingStackPanel.IsVirtualizing="True"
          Width="1200">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="900" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- 左侧主内容区域，添加滚动条 -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="5">
            <TabControl SelectedIndex="{Binding Index}"
                        BorderThickness="0"
                        Background="Transparent">
                <TabItem>
                    <TabItem.Header>
                        <TextBlock Text="点胶工站"
                                   FontWeight="Bold"
                                   FontSize="14" />
                    </TabItem.Header>
                    <Grid Background="{StaticResource MaterialDesignPaper}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 拍照位置选择与控制 -->
                        <GroupBox Header="拍照位置选择与控制"
                                  Grid.Row="0"
                                  Margin="5">
                            <StackPanel>
                                <!-- 序号选择 -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <TextBlock Text="选择序号:"
                                               VerticalAlignment="Center"
                                               Margin="5,0" />
                                    <ComboBox ItemsSource="{Binding PhotoPositionIndices}"
                                              SelectedItem="{Binding SelectedPhotoPositionIndex}"
                                              Width="60"
                                              Margin="5,0" />
                                </StackPanel>

                                <!-- 拍照功能按钮 -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Margin="5"
                                            Command="{Binding MoveToTabPhotoPositionCommand}"
                                            Content="去Tab拍照"
                                            Width="120" />
                                    <Button Margin="5"
                                            Command="{Binding MoveToPillar1PhotoPositionCommand}"
                                            Content="去Pillar1拍照"
                                            Width="120" />
                                    <Button Margin="5"
                                            Command="{Binding MoveToPillar2PhotoPositionCommand}"
                                            Content="去Pillar2拍照"
                                            Width="120" />
                                </StackPanel>

                                <!-- 角度纠正和补偿计算按钮 -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Margin="5"
                                            Command="{Binding CalculateTabCompensationCommand}"
                                            Content="计算tab补偿"
                                            Width="120" 
                                            ToolTip="计算Tab位置补偿值" />
                                    <Button Margin="5"
                                            Command="{Binding CorrectPillarAngleCommand}"
                                            Content="计算Pillar角度"
                                            Width="120" 
                                            ToolTip="根据视觉数据纠正Pillar角度" />
                                    <Button Margin="5"
                                            Command="{Binding CorrectActuatorXCommand}"
                                            Content="计算act补偿"
                                            Width="120"
                                            ToolTip="计算actuator补偿值" />
                                    <Button Margin="5"
                                            Command="{Binding AssemblyIPQCCommand}"
                                            Content="IPQC复查"
                                            Width="120"
                                            ToolTip="装配后拍照" />
                                </StackPanel>

                                <!-- UV固化按钮 -->
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Margin="5"
                                            Command="{Binding StartUVCuring1Command}"
                                            Content="UV固化1"
                                            Width="120"
                                            Background="LightBlue"
                                            ToolTip="启动UV固化1" />
                                    <Button Margin="5"
                                            Command="{Binding StartUVCuring2Command}"
                                            Content="UV固化2"
                                            Width="120"
                                            Background="LightBlue"
                                            ToolTip="启动UV固化2" />
                                    <Button Margin="5"
                                            Command="{Binding StartUVCuring3Command}"
                                            Content="关闭UV"
                                            Width="120"
                                            ToolTip="关闭UV" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 3D扫描功能 -->
                        <GroupBox Header="3D扫描功能"
                                  Grid.Row="1"
                                  Margin="5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Margin="5"
                                            Width="120"
                                            Command="{Binding Perform3DScanCommand}"
                                            Content="执行3D扫描" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">

                                </StackPanel>

                                <!-- 扫描状态显示 -->
                                <Border Style="{StaticResource StatusIndicatorStyle}"
                                        Background="{Binding ScanStatusColor}"
                                        Margin="5">
                                    <TextBlock Text="{Binding ScanStatus}"
                                               HorizontalAlignment="Center"
                                               FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- 3D相机标定 -->
                        <GroupBox Header="3D相机标定"
                                  Grid.Row="2"
                                  Margin="5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource OperationButtonStyle}"
                                            Command="{Binding Start3DCalibrationCommand}"
                                            Content="开始标定"
                                            Background="LightGreen" />
                                    <Button Style="{StaticResource OperationButtonStyle}"
                                            Command="{Binding Stop3DCalibrationCommand}"
                                            Content="停止标定"
                                            Background="LightCoral" />
                                </StackPanel>

                                <!-- 标定进度 -->
                                <StackPanel Orientation="Vertical"
                                            Margin="5">
                                    <TextBlock Text="标定进度:"
                                               FontWeight="Bold"
                                               Margin="0,0,0,2" />
                                    <ProgressBar Value="{Binding CalibrationProgress}"
                                                 Height="20"
                                                 Minimum="0"
                                                 Maximum="100" />
                                    <TextBlock Text="{Binding CalibrationProgressText}"
                                               HorizontalAlignment="Center"
                                               FontSize="10" />
                                </StackPanel>

                                <!-- 标定状态 -->
                                <Border Style="{StaticResource StatusIndicatorStyle}"
                                        Background="{Binding CalibrationStatusColor}">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding CalibrationStatus}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,5,0" />
                                        <materialDesign:PackIcon Kind="{Binding CalibrationStatusIcon}"
                                                                 Width="16"
                                                                 Height="16" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- 点胶控制 -->
                        <GroupBox Header="点胶控制"
                                  Grid.Row="3"
                                  Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource OperationButtonStyle}"
                                        Command="{Binding TriggerDispensingCommand}"
                                        Content="触发点胶" />
                                <Button Style="{StaticResource OperationButtonStyle}"
                                        Command="{Binding TestDispensingCommand}"
                                        Content="测试点胶" />
                                <Button Style="{StaticResource OperationButtonStyle}"
                                        Command="{Binding UVFixCommand}"
                                        Content="UV固化" />
                                <Button Style="{StaticResource OperationButtonStyle}"
                                        Command="{Binding UVOffCommand}"
                                        Content="关闭UV" />
                                <Button Style="{StaticResource OperationButtonStyle}"
                                        Command="{Binding PerformWipingCommand}"
                                        Content="擦胶" />
                            </StackPanel>
                        </GroupBox>

                        <!-- 系统状态和单步控制 -->
                        <GroupBox Header="系统状态与控制"
                                  Grid.Row="4"
                                  Margin="5">
                            <StackPanel>
                                <!-- 系统状态信息 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="工站状态:"
                                               Grid.Row="0"
                                               Grid.Column="0"
                                               FontWeight="Bold"
                                               Margin="5" />
                                    <TextBlock Text="{Binding StationStatus}"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               Margin="5" />

                                    <TextBlock Text="安全状态:"
                                               Grid.Row="0"
                                               Grid.Column="2"
                                               FontWeight="Bold"
                                               Margin="5" />
                                    <Border Background="{Binding SafetyStatusColor}"
                                            Grid.Row="0"
                                            Grid.Column="3"
                                            CornerRadius="3"
                                            Padding="5,2"
                                            Margin="5">
                                        <TextBlock Text="{Binding SafetyStatus}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                    </Border>

                                    <TextBlock Text="当前步骤:"
                                               Grid.Row="1"
                                               Grid.Column="0"
                                               FontWeight="Bold"
                                               Margin="5" />
                                    <TextBlock Text="{Binding CurrentStepDescription}"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="3"
                                               Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                               FontWeight="SemiBold"
                                               Margin="5"
                                               TextWrapping="Wrap" />
                                </Grid>

                                <!-- 单步控制区域 -->
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="单步执行控制"
                                                   FontWeight="Bold"
                                                   FontSize="13"
                                                   Margin="0,0,0,10"
                                                   HorizontalAlignment="Center" />

                                        <!-- 控制按钮 -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,0,0,10">
                                            <Button Content="启动单步"
                                                    Command="{Binding StartSingleStepCommand}"
                                                    Style="{StaticResource SingleStepButtonStyle}"
                                                    ToolTip="启动单步执行模式" />

                                            <Button Content="下一步"
                                                    Command="{Binding NextStepCommand}"
                                                    Style="{StaticResource SingleStepButtonStyle}"
                                                    Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                                                    ToolTip="执行下一步操作"
                                                    IsEnabled="{Binding IsStepWaiting}" />

                                            <Button Content="停止单步"
                                                    Command="{Binding StopSingleStepCommand}"
                                                    Style="{StaticResource SingleStepButtonStyle}"
                                                    ToolTip="停止单步模式" />
                                        </StackPanel>

                                        <!-- 状态指示 -->
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Ellipse Width="12"
                                                     Height="12"
                                                     Fill="{Binding IsSingleStepMode, Converter={StaticResource BooleanToColorConverter}}"
                                                     Stroke="DarkGray"
                                                     StrokeThickness="1"
                                                     ToolTip="单步模式状态" />
                                            <!--<TextBlock Text="{Binding IsSingleStepMode, Converter={StaticResource BooleanToSingleStepTextConverter}}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold" />-->
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <!-- 其他TabItem -->
                <TabItem Header="参数设置">
                    <Border BorderThickness="1"
                            BorderBrush="{StaticResource WindowBackgroundBrush}"
                            VerticalAlignment="Stretch">
                        <Grid Background="{StaticResource WindowBackgroundBrush}">
                            <StackPanel Grid.ColumnSpan="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Height="25"
                                            Width="100"
                                            Margin="5"
                                            Content="加载参数" />
                                    <Button Height="25"
                                            Width="100"
                                            Margin="5"
                                            Content="保存参数"
                                            Command="{Binding Save}" />
                                </StackPanel>

                                <GroupBox Header="3D标定参数设置"
                                          Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="在此处可以设置详细的标定参数"
                                                   Margin="5"
                                                   TextWrapping="Wrap" />
                                        <Button Content="打开参数编辑器"
                                                Height="25"
                                                Width="130"
                                                Margin="5"
                                                Command="{Binding EditParametersCommand}" />
                                    </StackPanel>
                                </GroupBox>

                                <!-- 标定参数快速设置 -->
                                <Expander Header="标定参数设置"
                                          Margin="0,5,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="R轴步进角度:"
                                                       Grid.Row="0"
                                                       Grid.Column="0"
                                                       Margin="5" />
                                            <TextBox Text="{Binding RStepAngle, UpdateSourceTrigger=PropertyChanged}"
                                                     Grid.Row="0"
                                                     Grid.Column="1"
                                                     Margin="5"
                                                     Width="80" />

                                            <TextBlock Text="R轴扫描次数:"
                                                       Grid.Row="1"
                                                       Grid.Column="0"
                                                       Margin="5" />
                                            <TextBox Text="{Binding RScanCount, UpdateSourceTrigger=PropertyChanged}"
                                                     Grid.Row="1"
                                                     Grid.Column="1"
                                                     Margin="5"
                                                     Width="80" />

                                            <TextBlock Text="U轴步进角度:"
                                                       Grid.Row="2"
                                                       Grid.Column="0"
                                                       Margin="5" />
                                            <TextBox Text="{Binding UStepAngle, UpdateSourceTrigger=PropertyChanged}"
                                                     Grid.Row="2"
                                                     Grid.Column="1"
                                                     Margin="5"
                                                     Width="80" />

                                            <TextBlock Text="U轴单边次数:"
                                                       Grid.Row="3"
                                                       Grid.Column="0"
                                                       Margin="5" />
                                            <TextBox Text="{Binding UScanCountPerSide, UpdateSourceTrigger=PropertyChanged}"
                                                     Grid.Row="3"
                                                     Grid.Column="1"
                                                     Margin="5"
                                                     Width="80" />
                                        </Grid>
                                        <Button Content="应用参数"
                                                Command="{Binding ApplyCalibrationParametersCommand}"
                                                Style="{StaticResource OperationButtonStyle}"
                                                Margin="5" />
                                    </StackPanel>
                                </Expander>

                                <GroupBox Header="点胶测试"
                                          Margin="5">
                                    <StackPanel>
                                        <TextBlock Text="直线点胶"
                                                   Margin="5"
                                                   TextWrapping="Wrap" />
                                        <Button Content="开始点胶"
                                                Height="25"
                                                Width="130"
                                                Margin="5"
                                                Command="{Binding EditParametersCommand}" />
                                    </StackPanel>
                                </GroupBox>

                                <!-- 点阵点胶设置 -->
                                <GroupBox Header="点阵点胶设置"
                                          Grid.Row="4"
                                          Margin="0,5,0,0">
                                    <Grid Margin="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 起始点设置 -->
                                        <TextBlock Text="起始点设置:"
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="6"
                                                    FontWeight="Bold"
                                                    Margin="0,0,0,5" />

                                        <TextBlock Text="X起始位置:"
                                                   Grid.Row="1"
                                                   Grid.Column="0"
                                                   Margin="5"
                                                   VerticalAlignment="Center" />
                                        <TextBox Text="{Binding DotArrayStartX, UpdateSourceTrigger=PropertyChanged}"
                                                 Grid.Row="1"
                                                 Grid.Column="1"
                                                 Margin="5"
                                                 Width="80" />
                                        <TextBlock Text="Y起始位置:"
                                                   Grid.Row="1"
                                                   Grid.Column="3"
                                                   Margin="5"
                                                   VerticalAlignment="Center" />
                                        <TextBox Text="{Binding DotArrayStartY, UpdateSourceTrigger=PropertyChanged}"
                                                 Grid.Row="1"
                                                 Grid.Column="4"
                                                 Margin="5"
                                                 Width="80" />
                                        <!-- 阵列设置 -->
                                        <TextBlock Text="阵列设置:"
                                                   Grid.Row="2"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="6"
                                                   FontWeight="Bold"
                                                   Margin="0,10,0,5" />
                                        <TextBlock Text="行数:"
                                                    Grid.Row="3"
                                                    Grid.Column="0"
                                                    Margin="5"
                                                    VerticalAlignment="Center" />
                                        <TextBox Text="{Binding DotArrayRows, UpdateSourceTrigger=PropertyChanged}"
                                                 Grid.Row="3"
                                                 Grid.Column="1"
                                                 Margin="5"
                                                 Width="80" />
                                        <TextBlock Text="列数:"
                                                    Grid.Row="3"
                                                    Grid.Column="3"
                                                    Margin="5"
                                                    VerticalAlignment="Center" />
                                        <TextBox Text="{Binding DotArrayColumns, UpdateSourceTrigger=PropertyChanged}"
                                                 Grid.Row="3"
                                                 Grid.Column="4"
                                                 Margin="5"
                                                 Width="80" />
                                        <TextBlock Text="行间距:"
                                                    Grid.Row="4"
                                                    Grid.Column="0"
                                                    Margin="5"
                                                    VerticalAlignment="Center" />
                                        <TextBox Text="{Binding DotArrayRowSpacing, UpdateSourceTrigger=PropertyChanged}"
                                                  Grid.Row="4"
                                                  Grid.Column="1"
                                                  Margin="5"
                                                  Width="80" />
                                        <TextBlock Text="mm"
                                                    Grid.Row="4"
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center" />

                                        <TextBlock Text="列间距:"
                                                    Grid.Row="4"
                                                    Grid.Column="3"
                                                    Margin="5"
                                                    VerticalAlignment="Center" />
                                        <TextBox Text="{Binding DotArrayColumnSpacing, UpdateSourceTrigger=PropertyChanged}"
                                                  Grid.Row="4"
                                                  Grid.Column="4"
                                                  Margin="5"
                                                  Width="80" />
                                        <TextBlock Text="mm"
                                                    Grid.Row="4"
                                                    Grid.Column="5"
                                                    VerticalAlignment="Center" />

                                        <!-- 点胶参数 -->
                                        <TextBlock Text="点胶参数:"
                                                    Grid.Row="5"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="6"
                                                    FontWeight="Bold"
                                                    Margin="0,10,0,5" />

                                        <TextBlock Text="点胶时间:"
                                                    Grid.Row="6"
                                                    Grid.Column="0"
                                                    Margin="5"
                                                    VerticalAlignment="Center" />
                                        <TextBox Text="{Binding DotArrayDispensingTime, UpdateSourceTrigger=PropertyChanged}"
                                                  Grid.Row="6"
                                                  Grid.Column="1"
                                                  Margin="5"
                                                  Width="80" />
                                        <TextBlock Text="ms"
                                                   Grid.Row="6"
                                                   Grid.Column="2"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Text="移动速度:"
                                                    Grid.Row="6"
                                                    Grid.Column="3"
                                                    Margin="5"
                                                    VerticalAlignment="Center" />
                                        <TextBox Text="{Binding DotArrayMoveSpeed, UpdateSourceTrigger=PropertyChanged}"
                                                  Grid.Row="6"
                                                  Grid.Column="4"
                                                  Margin="5"
                                                  Width="80" />
                                        <TextBlock Text="mm/s"
                                                    Grid.Row="6"
                                                    Grid.Column="5"
                                                    VerticalAlignment="Center" />

                                        <!-- 控制按钮 -->
                                        <StackPanel Grid.Row="7"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="6"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,10,0,0">
                                            <Button Content="开始点阵点胶"
                                                     Command="{Binding StartDotArrayDispensingCommand}"
                                                     Width="120"
                                                     Height="30"
                                                     Margin="5"
                                                     Background="LightGreen" />
                                            <Button Content="停止点阵点胶"
                                                     Command="{Binding StopDotArrayDispensingCommand}"
                                                     Width="120"
                                                     Height="30"
                                                     Margin="5"
                                                     Background="LightCoral" />
                                            <Button Content="移动到起始点"
                                                     Command="{Binding MoveToDotArrayStartCommand}"
                                                     Width="120"
                                                     Height="30"
                                                     Margin="5" />
                                        </StackPanel>

                                        <!-- 状态显示 -->
                                        <Border Grid.Row="8"
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="6"
                                                 Background="{Binding DotArrayStatusColor}"
                                                 CornerRadius="3"
                                                 Padding="8,4"
                                                 Margin="5,10,5,5">
                                            <TextBlock Text="{Binding DotArrayStatus}"
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="White" />
                                        </Border>
                                    </Grid>
                                </GroupBox>

                            </StackPanel>
                        </Grid>
                    </Border>
                </TabItem>
                <TabItem Header="针头标定">
                    <view:NeedleCalibrationView />
                </TabItem>

                <TabItem Header="扩展参数设置">
                    <view:ExtensionParametersView />
                </TabItem>

                <TabItem Header="点胶参数">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 胶量选择和参数应用 -->
                        <GroupBox Header="胶量选择与参数应用"
                                  Grid.Row="0"
                                  Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="胶量百分比:"
                                           VerticalAlignment="Center"
                                           Margin="5,0" />
                                <Slider Value="{Binding SelectedGluePercentage}"
                                        Minimum="0"
                                        Maximum="100"
                                        Width="200"
                                        Margin="5,0"
                                        TickFrequency="10"
                                        IsSnapToTickEnabled="True" />
                                <TextBlock Text="{Binding SelectedGluePercentage, StringFormat={}{0}%}"
                                           VerticalAlignment="Center"
                                           Width="40" />

                                <Button Content="应用参数"
                                        Command="{Binding ApplyDispensingParametersCommand}"
                                        Margin="10,0,5,0"
                                        Width="120" />
                                <TextBlock Text="{Binding SelectedParameterSet.Name, StringFormat='当前参数组: {0}'}"
                                           VerticalAlignment="Center"
                                           Margin="10,0"
                                           FontWeight="Bold" />
                            </StackPanel>
                        </GroupBox>

                        <!-- 参数组列表 -->
                        <GroupBox Header="参数组列表"
                                  Grid.Row="1"
                                  Margin="0,0,0,5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DataGrid ItemsSource="{Binding ParameterSets}"
                                          SelectedItem="{Binding SelectedParameterSet}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          Margin="5">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="名称"
                                                            Binding="{Binding Name}"
                                                            Width="120" />
                                        <DataGridTextColumn Header="胶量(%)"
                                                            Binding="{Binding Percentage}"
                                                            Width="80" />
                                        <DataGridTextColumn Header="压力(MPa)"
                                                            Binding="{Binding Pressure, StringFormat=F3}"
                                                            Width="80" />
                                        <DataGridTextColumn Header="负压(MPa)"
                                                            Binding="{Binding Vacuum, StringFormat=F3}"
                                                            Width="80" />
                                        <DataGridTextColumn Header="时间(s)"
                                                            Binding="{Binding Time, StringFormat=F2}"
                                                            Width="80" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="5">
                                    <Button Content="加载参数"
                                            Command="{Binding LoadParametersCommand}"
                                            Width="100"
                                            Margin="0,0,5,0" />
                                    <Button Content="保存参数"
                                            Command="{Binding SaveParametersCommand}"
                                            Width="100"
                                            Margin="0,0,5,0" />
                                    <Button Content="删除参数组"
                                            Command="{Binding RemoveParameterSetCommand}"
                                            Width="100"
                                            Margin="0,0,5,0" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- 参数编辑 -->
                        <GroupBox Header="参数编辑"
                                  Grid.Row="2">
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 第一行 -->
                                <TextBlock Text="胶量百分比:"
                                           Grid.Row="0"
                                           Grid.Column="0"
                                           Margin="5"
                                           VerticalAlignment="Center" />
                                <TextBox Text="{Binding CurrentPercentage, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="5"
                                         Width="60" />
                                <TextBlock Text="%"
                                           Grid.Row="0"
                                           Grid.Column="2"
                                           VerticalAlignment="Center" />

                                <TextBlock Text="压力(MPa):"
                                           Grid.Row="0"
                                           Grid.Column="3"
                                           Margin="5"
                                           VerticalAlignment="Center" />
                                <TextBox Text="{Binding CurrentPressure, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="0"
                                         Grid.Column="4"
                                         Margin="5"
                                         Width="60" />

                                <TextBlock Text="负压(MPa):"
                                           Grid.Row="0"
                                           Grid.Column="5"
                                           Margin="5"
                                           VerticalAlignment="Center" />
                                <TextBox Text="{Binding CurrentVacuum, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="0"
                                         Grid.Column="6"
                                         Margin="5"
                                         Width="60" />

                                <TextBlock Text="时间(s):"
                                           Grid.Row="0"
                                           Grid.Column="7"
                                           Margin="5"
                                           VerticalAlignment="Center" />
                                <TextBox Text="{Binding CurrentTime, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Row="0"
                                         Grid.Column="8"
                                         Margin="5"
                                         Width="60" />

                                <!-- 第二行 -->
                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="9"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,5">
                                    <Button Content="添加参数组"
                                            Command="{Binding AddParameterSetCommand}"
                                            Width="120"
                                            Margin="5" />
                                    <Button Content="更新参数组"
                                            Command="{Binding UpdateParameterSetCommand}"
                                            Width="120"
                                            Margin="5" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>
                
                <TabItem Header="针头点胶">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 序号选择 -->
                            <GroupBox Header="序号选择" Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal"
                                            Margin="10">
                                    <TextBlock Text="选择序号:"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0" />
                                    <ComboBox ItemsSource="{Binding PhotoPositionIndices}"
                                              SelectedItem="{Binding SelectedPhotoPositionIndex}"
                                              Width="80"
                                              Margin="0,0,20,0" />
                                    <TextBlock Text="{Binding SelectedPhotoPositionIndex, StringFormat='当前选择: {0}号'}"
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </StackPanel>
                            </GroupBox>

                            <!-- 点胶参数设置 -->
                            <GroupBox Header="点胶参数设置" Grid.Row="1" Margin="0,0,0,10">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 基准高度 -->
                                    <TextBlock Text="基准高度:" 
                                               Grid.Row="0" Grid.Column="0"
                                               Margin="5" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding PillarDispensingHeight, UpdateSourceTrigger=PropertyChanged}"
                                             Grid.Row="0" Grid.Column="1"
                                             Width="80" Margin="5"/>
                                    <TextBlock Text="mm" 
                                             Grid.Row="0" Grid.Column="2"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- 高度偏移 -->
                                    <TextBlock Text="高度偏移ΔZ:" 
                                               Grid.Row="0" Grid.Column="3"
                                               Margin="10,0,10,0" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding PillarHeightDeltaZ, UpdateSourceTrigger=PropertyChanged}"
                                             Grid.Row="0" Grid.Column="4"
                                             Width="80" Margin="50,0,10,0"/>
                                    <TextBlock Text="mm" 
                                               Grid.Row="0" Grid.Column="5"
                                               Margin="180,0,10,0"
                                               VerticalAlignment="Center"/>

                                    <!-- 点胶时间 -->
                                    <TextBlock Text="点胶时间:"
                                               Grid.Row="1"
                                               Grid.Column="0"
                                               Margin="5"
                                               VerticalAlignment="Center" />
                                    <TextBox Text="{Binding PillarDispensingTime, UpdateSourceTrigger=PropertyChanged}"
                                             Grid.Row="1" Grid.Column="1"
                                             Width="80" Margin="5"/>
                                    <TextBlock Text="ms" 
                                               Grid.Row="1" Grid.Column="2"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- 自动下降 -->
                                    <CheckBox Content="自动下降点胶"
                                              IsChecked="{Binding AutoDescendForDispensing}"
                                              Grid.Row="1"
                                              Grid.Column="3"
                                              Grid.ColumnSpan="3"
                                              Margin="5"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </GroupBox>

                            <!-- 位置计算说明 -->
                            <GroupBox Header="位置计算说明" Grid.Row="2" Margin="0,0,0,10">
                                <StackPanel Margin="10">
                                    <TextBlock Text="点胶位置计算公式:" 
                                               FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock Text="• 点胶位置 = Pillar偏移位置(相机获得) + 相机与针尖固定距离(Δx1,Δy1) + 针头偏差(Δx2,Δy2)"
                                               Margin="0,2" TextWrapping="Wrap"/>
                                    <TextBlock Text="• 点胶高度 = Pillar点胶基准高度 + Pillar点胶高度Δz"
                                               Margin="0,2" TextWrapping="Wrap"/>
                                    <TextBlock Text="相机与针尖距离参数来自[针头校准]页面"
                                               Foreground="Gray" Margin="0,5,0,0" FontStyle="Italic"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- 操作控制 -->
                            <GroupBox Header="操作控制" Grid.Row="3" Margin="0,0,0,10">
                                <StackPanel Margin="10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="去Pillar1点胶"
                                                Command="{Binding DispensePillar1Command}"
                                                Width="120"
                                                Height="35"
                                                Margin="5"
                                                Background="LightGreen" />
                                        <Button Content="去Pillar2点胶"
                                                Command="{Binding DispensePillar2Command}"
                                                Width="120"
                                                Height="35"
                                                Margin="5"
                                                Background="LightGreen" />
                                        <Button Content="停止点胶"
                                                Command="{Binding StopPillarDispensingCommand}"
                                                Width="120"
                                                Height="35"
                                                Margin="5"
                                                Background="LightCoral" />
                                    </StackPanel>

                                    <TextBlock Text="动作流程:"
                                               FontWeight="Bold" Margin="0,10,0,5"/>
                                    <TextBlock Text="1. 移动相机到Pillar拍照位置"
                                               Margin="0,2"/>
                                    <TextBlock Text="2. 拍照获取视觉偏移位置"
                                               Margin="0,2"/>
                                    <TextBlock Text="3. 计算针头实际位置"
                                               Margin="0,2"/>
                                    <TextBlock Text="4. 移动到计算位置"
                                               Margin="0,2"/>
                                    <TextBlock Text="5. 下降到点胶高度并喷胶"
                                               Margin="0,2"/>
                                    <TextBlock Text="6. 完成返回安全位置"
                                               Margin="0,2"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- 状态显示 -->
                            <GroupBox Header="状态信息" Grid.Row="4" Margin="0,0,0,10">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 状态指示 -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Border Background="{Binding PillarDispensingStatusColor}"
                                                CornerRadius="3" Padding="10,5" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding PillarDispensingStatus}"
                                                       FontWeight="Bold" Foreground="White"/>
                                        </Border>

                                        <Ellipse Width="12"
                                                 Height="12"
                                                 Fill="{Binding IsPillarDispensing, Converter={StaticResource BooleanToColorConverter}}"
                                                 Stroke="DarkGray"
                                                 StrokeThickness="1"
                                                 VerticalAlignment="Center"
                                                 ToolTip="点胶运行状态" />
                                        <TextBlock Text="{Binding IsPillarDispensing, Converter={StaticResource BooleanToSingleStepTextConverter}}"
                                                   VerticalAlignment="Center" Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <!-- 当前参数显示 -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="当前参数: "
                                                   FontWeight="Bold" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding SelectedGluePercentage, StringFormat='胶量 {0}%'}"
                                                   Margin="5,0"/>
                                        <TextBlock Text="{Binding PillarDispensingTime, StringFormat='时间 {0}ms'}"
                                                   Margin="5,0"/>
                                        <TextBlock Text="{Binding AutoDescendForDispensing, Converter={StaticResource BooleanToSingleStepTextConverter}}"
                                                   Margin="5,0"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>

                            <!-- 安全提示 -->
                            <GroupBox Header="安全提示" Grid.Row="5">
                                <StackPanel Margin="10">
                                    <TextBlock Text="⚠️ 注意：点胶前请确保以下条件:"
                                               FontWeight="Bold" Foreground="OrangeRed" Margin="0,0,0,5"/>
                                    <TextBlock Text="1. 已完成针头校准"
                                               Margin="5,2"/>
                                    <TextBlock Text="2. 已设置正确的点胶参数"
                                               Margin="5,2"/>
                                    <TextBlock Text="3. 设备处于安全状态"
                                                Margin="5,2"/>
                                    <TextBlock Text="4. 有足够的胶水供应"
                                               Margin="5,2"/>
                                    <TextBlock Text="5. 点胶区域无障碍物"
                                               Margin="5,2"/>
                                </StackPanel>
                            </GroupBox>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                
                <TabItem Header="点胶路径">
                    <local:DispensingPathView />
                </TabItem>
            </TabControl>
        </ScrollViewer>

        <!-- 右侧日志区域 -->
        <Grid Grid.Column="1">
            <GroupBox Header="日志信息"
                      Margin="5">
                <StackPanel>
                    <TextBox Height="300"
                             Margin="5"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True"
                             Text="{Binding LogMessages}"
                             FontFamily="Consolas"
                             FontSize="11" />
                    <Button Content="清空日志"
                            Height="25"
                            Width="100"
                            HorizontalAlignment="Right"
                            Margin="5"
                            Command="{Binding ClearLogCommand}" />
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>