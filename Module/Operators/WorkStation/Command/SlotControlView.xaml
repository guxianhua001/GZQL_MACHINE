<UserControl x:Class="Module.Views.SlotControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:converters="clr-namespace:Framework.Converters;assembly=Framework"
             xmlns:converters1="clr-namespace:Framework.Converters"
             xmlns:converters2="clr-namespace:Module.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
            <converters1:BooleanToColorConverter x:Key="BooleanToColorConverter" />
            <converters2:ValueToColorConverter x:Key="ValueToColorConverter" />

            <!-- 用于使 TextBox 文本居中的样式 -->
            <Style x:Key="CenteredTextBox"
                   TargetType="TextBox"
                   BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="HorizontalContentAlignment"
                        Value="Center" />
                <Setter Property="VerticalContentAlignment"
                        Value="Center" />
                <Setter Property="TextAlignment"
                        Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">

                <!-- 拨动距离计算区域 -->
                <GroupBox Header="拨动距离计算"
                          Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Tab选择 -->
                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="选择Tab序号:"
                                       Margin="5"
                                       VerticalAlignment="Center" />

                            <!-- 修正ComboBox：移除重复的ItemsSource设置 -->
                            <ComboBox Grid.Row="0"
                                      Grid.Column="1"
                                      SelectedItem="{Binding SelectedTabIndex}"
                                      Margin="5"
                                      Width="80">
                                <ComboBox.ItemsSource>
                                    <x:Array Type="sys:Int32">
                                        <sys:Int32>1</sys:Int32>
                                        <sys:Int32>2</sys:Int32>
                                        <sys:Int32>3</sys:Int32>
                                        <sys:Int32>4</sys:Int32>
                                        <sys:Int32>5</sys:Int32>
                                        <sys:Int32>6</sys:Int32>
                                    </x:Array>
                                </ComboBox.ItemsSource>
                            </ComboBox>

                            <!-- 计算按钮 -->
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Command="{Binding CalculateDynamicDistanceCommand}"
                                    Content="计算选中Tab"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="120"
                                    Margin="5" />

                            <Button Grid.Row="0"
                                    Grid.Column="3"
                                    Command="{Binding CalculateAllTabsDistanceCommand}"
                                    Content="计算所有Tab"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Width="120"
                                    Margin="5" />

                            <!-- 动态距离报警信息 -->
                            <Border Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Background="#FFFFE6E6"
                                    BorderBrush="Red"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,10,0,0"
                                    Padding="10,5"
                                    Visibility="{Binding HasDynamicDistanceAlarm, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding DynamicDistanceAlarmMessage}"
                                           Foreground="Red"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- 计算状态 -->
                            <Border Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Background="{DynamicResource MaterialDesignBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="0,1,0,0"
                                    Margin="0,10,0,0"
                                    Padding="10,5">
                                <TextBlock Text="{Binding CalculateStatus}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                            </Border>

                            <!-- 计算公式说明 -->
                            <Border Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Background="#FFF0F8FF"
                                    BorderBrush="#FF87CEEB"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Margin="0,10,0,0"
                                    Padding="10">
                                <StackPanel>
                                    <TextBlock Text="计算公式说明:"
                                               FontWeight="Bold"
                                               Margin="0,0,0,5" />
                                    <TextBlock Text="1. H2Height > CurrentDistance2: 拨动距离 = H2Height - CurrentDistance2 (正值，轴向下运动，slot往上拨)"
                                               FontStyle="Italic" />
                                    <TextBlock Text="2. H2Height ≤ CurrentDistance2: 拨动距离 = CurrentDistance2 - H2Height (负值，轴向上运动，slot往下拨)"
                                               FontStyle="Italic"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="3. 计算公式: 下压高度 = H4 + 0.27 + 过压量(0.15mm)"
                                               FontStyle="Italic"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="说明：正值代表轴向下运动，slot往上拨；负值代表轴向上运动，slot往下拨"
                                               FontWeight="SemiBold"
                                               Foreground="Blue"
                                               Margin="0,5,0,0" />
                                    <TextBlock Text="报警：当H4拨动距离小于0时，显示红色报警，提示拨片距离不满足装配条件"
                                               FontWeight="SemiBold"
                                               Foreground="Red"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 6个Tab的拨动距离表格 -->
                        <Border Margin="0,15,0,0"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- 表头 -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource MaterialDesignHeader}"
                                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                                        BorderThickness="0,0,0,1">
                                    <Grid Margin="10,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <!-- Tab序号 -->
                                            <ColumnDefinition Width="100" />
                                            <!-- H2高度 -->
                                            <ColumnDefinition Width="140" />
                                            <!-- H1实时距离 -->
                                            <ColumnDefinition Width="120" />
                                            <!-- H4拨动距离 -->
                                            <ColumnDefinition Width="120" />
                                            <!-- 下压高度 -->
                                            <ColumnDefinition Width="150" />
                                            <!-- 方向说明 -->
                                            <ColumnDefinition Width="100" />
                                            <!-- 计算时间 -->
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Tab序号"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="H2高度(mm)"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2"
                                                   Text="H1实时距离(mm)"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="3"
                                                   Text="H4拨动距离(mm)"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="4"
                                                   Text="下压高度(mm)"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   ToolTip="计算公式: 下压高度 = H4拨动距离 + 0.27 + 过压量(0.15mm)" />
                                        <TextBlock Grid.Column="5"
                                                   Text="方向说明"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="6"
                                                   Text="计算时间"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- 数据行 -->
                                <ItemsControl Grid.Row="1"
                                              ItemsSource="{Binding TabStrippingDistances}"
                                              Margin="0,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                    BorderThickness="0,0,0,1"
                                                    Margin="0,0,0,2"
                                                    Padding="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="60" />
                                                        <!-- Tab序号 -->
                                                        <ColumnDefinition Width="100" />
                                                        <!-- H2高度 -->
                                                        <ColumnDefinition Width="120" />
                                                        <!-- CurrentDistance2 -->
                                                        <ColumnDefinition Width="120" />
                                                        <!-- 拨动距离 -->
                                                        <ColumnDefinition Width="120" />
                                                        <!-- 下压高度 -->
                                                        <ColumnDefinition Width="150" />
                                                        <!-- 方向说明 -->
                                                        <ColumnDefinition Width="100" />
                                                        <!-- 计算时间 -->
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Tab序号 -->
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding TabIndex}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource PrimaryHueMidBrush}" />

                                                    <!-- H2高度 -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding H2Height, StringFormat=F3}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="Black" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding H2Height}">
                                                                        <DataTrigger.Value>
                                                                            <x:Static Member="sys:Double.NaN" />
                                                                        </DataTrigger.Value>
                                                                        <Setter Property="Foreground"
                                                                                Value="Gray" />
                                                                        <Setter Property="Text"
                                                                                Value="N/A" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- CurrentDistance2 -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding CurrentDistance2, StringFormat=F3}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="Black" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding CurrentDistance2}">
                                                                        <DataTrigger.Value>
                                                                            <x:Static Member="sys:Double.NaN" />
                                                                        </DataTrigger.Value>
                                                                        <Setter Property="Foreground"
                                                                                Value="Gray" />
                                                                        <Setter Property="Text"
                                                                                Value="N/A" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <!-- 拨动距离 -->
                                                    <Border Grid.Column="3"
                                                            Background="Transparent"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StrippingDistance, StringFormat=F3}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding StrippingDistanceForeground}" />
                                                    </Border>

                                                    <!-- 下压高度 -->
                                                    <Border Grid.Column="4"
                                                            Background="Transparent"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            ToolTip="下压高度 = H4拨动距离 + 0.27 + 过压量">
                                                        <TextBlock Text="{Binding PressHeight, StringFormat=F3}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   FontWeight="Bold"
                                                                   Foreground="{Binding PressHeightForeground}" />
                                                    </Border>

                                                    <!-- 方向说明 -->
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding DirectionDescription}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center" />

                                                    <!-- 计算时间 -->
                                                    <TextBlock Grid.Column="6"
                                                               Text="{Binding CalculationTimeDisplay}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontStyle="Italic"
                                                               Foreground="#FF666666" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 操作按钮区域 -->
                <GroupBox Header="拨片操作流程"
                          Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 第一步：Slot角度纠正 -->
                        <Button Grid.Row="0"
                                Grid.Column="0"
                                Command="{Binding GoToAdjustSlotPositionCommand}"
                                Content="1. Slot角度纠正"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="5" />

                        <!-- 第二步：去拨片位置 -->
                        <Button Grid.Row="0"
                                Grid.Column="1"
                                Command="{Binding GoToPickSlotPositionCommand}"
                                Content="2. 去拨片位置"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="5" />

                        <!-- 第三步：开始拨片 -->
                        <Button Grid.Row="0"
                                Grid.Column="2"
                                Command="{Binding AutoPickSlotCommand}"
                                Content="3. 开始拨片"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Background="{DynamicResource PrimaryHueMidBrush}"
                                Margin="5" />

                        <!-- 第四步：拨完复检 -->
                        <Button Grid.Row="0"
                                Grid.Column="3"
                                Command="{Binding AutoInspectionSlotCommand}"
                                Content="4. 拨完复检"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="5" />

                        <!-- 动态拨片启用控制 -->
                        <Border Grid.Row="1"
                                Grid.ColumnSpan="4"
                                Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="5,10,5,0"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding EnableDynamicStripping}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,10,0">
                                    <TextBlock Text="启用动态拨片"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                </CheckBox>
                                <TextBlock Text="启用后使用动态计算的拨动距离，禁用后使用固定距离"
                                           VerticalAlignment="Center"
                                           FontStyle="Italic"
                                           Foreground="#FF666666" />
                            </StackPanel>
                        </Border>

                        <!-- 动态距离报警信息 -->
                        <Border Grid.Row="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Background="#FFFFE6E6"
                                BorderBrush="Red"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="5,5,5,0"
                                Padding="10,5"
                                Visibility="{Binding HasDynamicDistanceAlarm, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding DynamicDistanceAlarmMessage}"
                                       Foreground="Red"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- 状态显示 -->
                        <Border Grid.Row="3"
                                Grid.ColumnSpan="4"
                                Background="{DynamicResource MaterialDesignBackground}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="0,1,0,0"
                                Margin="0,10,0,0"
                                Padding="10,5">
                            <TextBlock Text="{Binding SlotOperationStatus}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </Grid>
                </GroupBox>

                <!-- 数据表格区域 -->
                <GroupBox Header="拨片位置数据"
                          Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 表头 - 扩展为两组数据 -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource MaterialDesignHeader}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="0,0,0,1">
                            <Grid Margin="10,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="类型"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <!-- 第一组数据标题 -->
                                <TextBlock Grid.Column="1"
                                           Text="X (mm)"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="Y (mm)"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Text="U (°)"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="4"
                                           Text="距离 (mm)"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <!-- 第二组数据标题 -->
                                <TextBlock Grid.Column="5"
                                           Text="X2 (mm)"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="6"
                                           Text="Y2 (mm)"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="7"
                                           Text="U2 (°)"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="8"
                                           Text="距离2 (mm)"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- 数据行 -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding SlotDataRows}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Height="auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}"
                                            BorderThickness="0,0,0,1"
                                            Margin="0,0,0,2"
                                            Padding="5">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 基准值行 -->
                                            <StackPanel Grid.Row="0"
                                                        Orientation="Horizontal">
                                                <TextBlock Text="基准值:"
                                                           Width="60"
                                                           FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <!-- 第一组基准值 -->
                                                    <TextBox Text="{Binding BaseX, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="基准X值 (mm)"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding BaseY, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="基准Y值 (mm)"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding BaseU, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="基准U值 (°)"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding BaseDistance, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="100"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="基准距离值 (mm)"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <!-- 第二组基准值 -->
                                                    <TextBox Text="{Binding BaseX2, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="基准X2值 (mm)"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding BaseY2, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="基准Y2值 (mm)"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding BaseU2, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="基准U2值 (°)"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding BaseDistance2, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="100"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="基准距离2值 (mm)"
                                                             Style="{StaticResource CenteredTextBox}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 当前值行 -->
                                            <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        Margin="0,5,0,0">
                                                <TextBlock Text="偏差值:"
                                                           Width="60"
                                                           FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <!-- 第一组当前值 -->
                                                    <TextBlock Text="{Binding CurrentX, StringFormat=F3}"
                                                               Width="80"
                                                               HorizontalAlignment="Center"
                                                               Margin="2"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding CurrentXForeground}" />

                                                    <TextBlock Text="{Binding CurrentY, StringFormat=F3}"
                                                               Width="80"
                                                               HorizontalAlignment="Center"
                                                               Margin="2"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding CurrentYForeground}" />

                                                    <TextBlock Text="{Binding CurrentU, StringFormat=F3}"
                                                               Width="80"
                                                               HorizontalAlignment="Center"
                                                               Margin="2"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding CurrentUForeground}" />

                                                    <Border Width="100"
                                                            HorizontalAlignment="Center"
                                                            Margin="2"
                                                            Background="{Binding DistanceBackground}">
                                                        <TextBlock Text="{Binding CurrentDistance, StringFormat=F3}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Padding="5"
                                                                   Foreground="{Binding CurrentDistanceForeground}" />
                                                    </Border>

                                                    <!-- 第二组当前值 -->
                                                    <TextBlock Text="{Binding CurrentX2, StringFormat=F3}"
                                                               Width="80"
                                                               HorizontalAlignment="Center"
                                                               Margin="2"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding CurrentX2Foreground}" />

                                                    <TextBlock Text="{Binding CurrentY2, StringFormat=F3}"
                                                               Width="80"
                                                               HorizontalAlignment="Center"
                                                               Margin="2"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding CurrentY2Foreground}" />

                                                    <TextBlock Text="{Binding CurrentU2, StringFormat=F3}"
                                                               Width="80"
                                                               HorizontalAlignment="Center"
                                                               Margin="2"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding CurrentU2Foreground}" />

                                                    <Border Width="100"
                                                            HorizontalAlignment="Center"
                                                            Margin="2"
                                                            Background="{Binding Distance2Background}">
                                                        <TextBlock Text="{Binding CurrentDistance2, StringFormat=F3}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Padding="5"
                                                                   Foreground="{Binding CurrentDistance2Foreground}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 补偿值行 -->
                                            <StackPanel Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        Margin="0,5,0,0">
                                                <TextBlock Text="补偿值:"
                                                           Width="60"
                                                           FontWeight="SemiBold" />
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Center">
                                                    <!-- 第一组补偿值 -->
                                                    <TextBox Text="{Binding CompensationX, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="补偿X值 (mm)"
                                                             Foreground="{Binding CompensationXForeground}"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding CompensationY, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="补偿Y值 (mm)"
                                                             Foreground="{Binding CompensationYForeground}"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding CompensationU, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="补偿U值 (°)"
                                                             Foreground="{Binding CompensationUForeground}"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding CompensationDistance, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="100"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="补偿距离值 (mm)"
                                                             Foreground="{Binding CompensationDistanceForeground}"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <!-- 第二组补偿值 -->
                                                    <TextBox Text="{Binding CompensationX2, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="补偿X2值 (mm)"
                                                             Foreground="{Binding CompensationX2Foreground}"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding CompensationY2, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="补偿Y2值 (mm)"
                                                             Foreground="{Binding CompensationY2Foreground}"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding CompensationU2, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="80"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="补偿U2值 (°)"
                                                             Foreground="{Binding CompensationU2Foreground}"
                                                             Style="{StaticResource CenteredTextBox}" />

                                                    <TextBox Text="{Binding CompensationDistance2, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                             Width="100"
                                                             HorizontalAlignment="Center"
                                                             Margin="2"
                                                             VerticalAlignment="Center"
                                                             ToolTip="补偿距离2值 (mm)"
                                                             Foreground="{Binding CompensationDistance2Foreground}"
                                                             Style="{StaticResource CenteredTextBox}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>

                <!-- 参数设置区域 -->
                <GroupBox Header="参数设置"
                          Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 动态拨片启用 -->
                        <!--<TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="启用动态拨片:"
                                   Margin="5"
                                   VerticalAlignment="Center" />
                        <CheckBox Grid.Row="0"
                                  Grid.Column="1"
                                  IsChecked="{Binding EnableDynamicStripping}"
                                  VerticalAlignment="Center"
                                  Margin="5" />-->

                        <!-- 向下拨动距离 -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="固定拨动距离:"
                                   Margin="5"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding StrippingDistance, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100"
                                 Margin="5" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="mm"
                                   Margin="5"
                                   VerticalAlignment="Center" />

                        <!-- Slot中心到底边距离下限 -->
                        <TextBlock Grid.Row="2"
                                   Grid.Column="0"
                                   Text="距离下限:"
                                   Margin="5"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding DistanceLowerLimit, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100"
                                 Margin="5" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="2"
                                   Text="mm"
                                   Margin="5"
                                   VerticalAlignment="Center" />

                        <!-- 自动拨片次数 -->
                        <TextBlock Grid.Row="3"
                                   Grid.Column="0"
                                   Text="自动拨片次数:"
                                   Margin="5"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding AutoStrippingCount, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100"
                                 Margin="5" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="2"
                                   Text="次"
                                   Margin="5"
                                   VerticalAlignment="Center" />

                        <!-- 报警阈值 -->
                        <TextBlock Grid.Row="4"
                                   Grid.Column="0"
                                   Text="报警阈值:"
                                   Margin="5"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding AlarmThreshold, UpdateSourceTrigger=PropertyChanged}"
                                 Width="100"
                                 Margin="5" />
                        <TextBlock Grid.Row="4"
                                   Grid.Column="2"
                                   Text="连续次数"
                                   Margin="5"
                                   VerticalAlignment="Center" />

                        <!-- 统计信息 -->
                        <Border Grid.Row="5"
                                Grid.Column="0"
                                Grid.ColumnSpan="4"
                                Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,10,0,0"
                                Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="当前拨片次数:"
                                               Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding CurrentStrippingCount}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,5,0,0">
                                    <TextBlock Text="连续不合格次数:"
                                               Margin="0,0,5,0" />
                                    <TextBlock Text="{Binding ContinuousFailureCount}"
                                               FontWeight="Bold"
                                               Foreground="{Binding HasAlarm, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='Red|Black'}" />
                                </StackPanel>
                                <TextBlock Text="{Binding AlarmMessage}"
                                           Foreground="Red"
                                           FontWeight="Bold"
                                           Margin="0,5,0,0"
                                           Visibility="{Binding HasAlarm, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </GroupBox>

                <!-- 按钮控制区 -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <Button Command="{Binding SaveParametersCommand}"
                            Content="保存参数"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Width="120"
                            Margin="5" />

                    <Button Command="{Binding LoadParametersCommand}"
                            Content="加载参数"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Width="120"
                            Margin="5" />

                    <Button Command="{Binding ResetParametersCommand}"
                            Content="重置参数"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Width="120"
                            Margin="5" />

                    <Button Command="{Binding ClearDataCommand}"
                            Content="清除数据"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Width="120"
                            Margin="5" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>