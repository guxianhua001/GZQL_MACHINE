<UserControl x:Class="Module.Views.ExtensionParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:converters="clr-namespace:Module.Converters"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="800">

    <UserControl.Resources>
        <!-- 现有资源保持不变 -->
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:BooleanToStatusConverter x:Key="BooleanToStatusConverter" />

        <Style x:Key="OutOfLimitStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="Black" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutOfLimit}"
                             Value="True">
                    <Setter Property="Foreground"
                            Value="Red" />
                    <Setter Property="FontWeight"
                            Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeaderTextBlockStyle"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="FontWeight"
                    Value="Bold" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题和操作按钮 -->
        <Border Grid.Row="0"
                Background="#FFE3F2FD"
                CornerRadius="3"
                Padding="10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="扩展参数 (Tab1-6)"
                           FontSize="16"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,20,0" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal">
                    <Button Content="执行3D扫描"
                            Command="{Binding RefreshAllCommand}"
                            Width="120"
                            Height="30"
                            Margin="5,0"
                            ToolTip="刷新所有Tab的实时高度"
                            IsEnabled="{Binding IsRefreshing, Converter={StaticResource InverseBooleanConverter}}" />

                    <Button Content="保存参数"
                            Command="{Binding SaveParametersCommand}"
                            Width="120"
                            Height="30"
                            Margin="5,0"
                            ToolTip="保存当前参数设置" />

                    <Button Content="加载参数"
                            Command="{Binding LoadParametersCommand}"
                            Width="120"
                            Height="30"
                            Margin="5,0"
                            ToolTip="加载已保存的参数" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 参数表格 -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Parameters}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  AlternatingRowBackground="#FFF5F5F5"
                  GridLinesVisibility="None"
                  HeadersVisibility="Column"
                  RowHeaderWidth="0">

            <DataGrid.Columns>
                <!-- 序号 -->
                <DataGridTextColumn Header="序号"
                                    Binding="{Binding Index}"
                                    Width="60"
                                    IsReadOnly="True" />

                <!-- 基准高度 -->
                <DataGridTemplateColumn Header="基准高度(mm)"
                                        Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding ReferenceHeight, StringFormat=F3, UpdateSourceTrigger=LostFocus}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 上限 -->
                <DataGridTemplateColumn Header="上限(mm)"
                                        Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding UpperLimit, StringFormat=F3, UpdateSourceTrigger=LostFocus}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 下限 -->
                <DataGridTemplateColumn Header="下限(mm)"
                                        Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding LowerLimit, StringFormat=F3, UpdateSourceTrigger=LostFocus}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 实时高度 -->
                <DataGridTemplateColumn Header="实时高度(mm)"
                                        Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center">
                                <TextBlock Text="{Binding RealTimeHeight, StringFormat=F3}"
                                           Style="{StaticResource OutOfLimitStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0" />

                                <Button Content="↻"
                                        Command="{Binding DataContext.RefreshSingleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Width="25"
                                        Height="25"
                                        ToolTip="刷新实时高度"
                                        FontSize="12"
                                        Padding="0">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource MaterialDesignFlatButton}">
                                            <Setter Property="Foreground"
                                                    Value="Blue" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutOfLimit}"
                                                             Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="Red" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- H2高度 -->
                <!-- H2高度 -->
                <DataGridTemplateColumn Header="H2高度(mm)"
                                        Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding H2Height, StringFormat=F3, Mode=OneWay}"
                                       Style="{StaticResource OutOfLimitStyle}"
                                       HorizontalAlignment="Center">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock>
                            H2高度 = 实时高度 - 0.4
                            <LineBreak />
                                     计算公式: <Run Text="{Binding RealTimeHeight, StringFormat=F3}" /> - 0.4 = <Run Text="{Binding H2Height, StringFormat=F3, Mode=OneWay}" />
                                        </TextBlock>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                             </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 高度补偿 -->
                <DataGridTemplateColumn Header="高度补偿(mm)"
                                        Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Compensation, StringFormat=F3, UpdateSourceTrigger=LostFocus}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     HorizontalContentAlignment="Center">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Foreground"
                                                Value="Black" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutOfLimit}"
                                                         Value="True">
                                                <Setter Property="Foreground"
                                                        Value="Red" />
                                                <Setter Property="FontWeight"
                                                        Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 状态 -->
                <DataGridTemplateColumn Header="状态"
                                        Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="Transparent"
                                    CornerRadius="3"
                                    Padding="5,2">
                                <TextBlock Text="{Binding IsOutOfLimit, Converter={StaticResource BooleanToStatusConverter}}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground"
                                                    Value="Green" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutOfLimit}"
                                                             Value="True">
                                                    <Setter Property="Foreground"
                                                            Value="Red" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness"
                            Value="0" />
                    <Setter Property="Padding"
                            Value="5" />
                    <Setter Property="VerticalAlignment"
                            Value="Center" />
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOutOfLimit}"
                                     Value="True">
                            <Setter Property="Background"
                                    Value="#FFFFE0E0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!-- 状态栏 -->
        <Border Grid.Row="2"
                Background="#FFF5F5F5"
                Margin="0,10,0,0"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="说明: "
                           FontStyle="Italic"
                           Margin="0,0,10,0" />
                <TextBlock Grid.Column="1"
                           Text="红色表示超出上下限范围；H2高度=实时高度-0.4mm"
                           FontStyle="Italic"
                           Foreground="Red" />
                <TextBlock Grid.Column="2"
                           Text="{Binding RefreshStatus}"
                           Margin="10,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>