<UserControl x:Class="Module.Views.NeedleCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Margin="5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="59*"/>
            <ColumnDefinition Width="91*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 校准步骤说明 -->
        <GroupBox Header="校准步骤"
                  Grid.Row="0"
                  Margin="0,0,0,66" Grid.ColumnSpan="2">
            <StackPanel>
                <TextBlock Text="第1步: 将上相机视野中心移到目标点对准，记录此时轴DispX和轴PlatY坐标"
                           Margin="5,2"
                           TextWrapping="Wrap" />
                <TextBlock Text="第2步: 将针头移到目标点对准，记录此时DispX和轴PlatY坐标及轴DispZ3高度(针尖高度)"
                           Margin="5,2"
                           TextWrapping="Wrap" />
                <TextBlock Text="第3步: 计算相机中心和针尖的距离，设置XYZ补偿"
                           Margin="5,2"
                           TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <!-- 校准操作区域 -->
        <GroupBox Header="校准操作"
                  Margin="0,116,0,5"
                  Grid.ColumnSpan="2"
                  Grid.RowSpan="2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <Grid Margin="5"
                      MinWidth="700">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <!-- 新增行 -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"
                                          MinWidth="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 第1步：相机中心坐标 -->
                    <TextBlock Text="第1步 - 相机中心坐标:"
                               Grid.Row="0"
                               Grid.Column="0"
                               Margin="5"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />
                    <!-- 相机中心坐标输入区域 -->
                    <Grid Grid.Row="0"
                          Grid.Column="1"
                          Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="DispX:"
                                   Grid.Column="0"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding CameraCenterX, StringFormat=F3}"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Background="LightGray" />
                        <TextBlock Text="mm"
                                   Grid.Column="2"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="PlatY:"
                                   Grid.Column="3"
                                   Margin="15,0,5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding CameraCenterY, StringFormat=F3}"
                                 Grid.Column="4"
                                 IsReadOnly="True"
                                 Background="LightGray" />
                        <TextBlock Text="mm"
                                   Grid.Column="5"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Button Content="示教相机中心"
                            Grid.Row="0"
                            Grid.Column="2"
                            Command="{Binding TeachCameraCenterCommand}"
                            Width="120"
                            Height="30"
                            Margin="5" />

                    <!-- 第2步：针尖坐标 -->
                    <TextBlock Text="第2步 - 针尖坐标:"
                               Grid.Row="1"
                               Grid.Column="0"
                               Margin="5"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />
                    <!-- 针尖坐标输入区域 -->
                    <Grid Grid.Row="1"
                          Grid.Column="1"
                          Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="DispX:"
                                   Grid.Column="0"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding NeedleTipX, StringFormat=F3}"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Background="LightGray" />
                        <TextBlock Text="mm"
                                   Grid.Column="2"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="PlatY:"
                                   Grid.Column="3"
                                   Margin="15,0,5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding NeedleTipY, StringFormat=F3}"
                                 Grid.Column="4"
                                 IsReadOnly="True"
                                 Background="LightGray" />
                        <TextBlock Text="mm"
                                   Grid.Column="5"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 针尖高度示教按钮 -->
                    <Button Content="示教针尖位置"
                            Grid.Row="1"
                            Grid.Column="2"
                            Command="{Binding TeachNeedleTipCommand}"
                            Width="120"
                            Height="30"
                            Margin="5" />

                    <!-- 第3步：3D基准面高度 -->
                    <TextBlock Text="第3步 - 3D基准面高度:"
                               Grid.Row="2"
                               Grid.Column="0"
                               Margin="5"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />
                    <!-- 3D基准面高度输入区域 -->
                    <Grid Grid.Row="2"
                          Grid.Column="1"
                          Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="BaseZ:"
                                   Grid.Column="0"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding BasePlaneZ, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Column="1"
                                 Background="White"
                                 Margin="5,0" />
                        <TextBlock Text="mm"
                                   Grid.Column="2"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />

                        <TextBlock Text="针尖高度:"
                                   Grid.Column="3"
                                   Margin="15,0,5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding NeedleTipZ, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Column="4"
                                 Background="White"
                                 Margin="5,0" />
                        <TextBlock Text="mm"
                                   Grid.Column="5"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 针尖高度示教按钮 -->
                    <Button Content="示教针尖高度"
                            Grid.Row="2"
                            Grid.Column="2"
                            Command="{Binding TeachNeedleTipZCommand}"
                            Width="120"
                            Height="30"
                            Margin="5" />

                    <!-- 当前目标3D平面高度 -->
                    <TextBlock Text="当前目标3D平面高度:"
                               Grid.Row="3"
                               Grid.Column="0"
                               Margin="5"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />
                    <!-- 当前目标3D平面高度输入区域 -->
                    <Grid Grid.Row="3"
                          Grid.Column="1"
                          Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="TargetZ:"
                                   Grid.Column="0"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding TargetPlaneZ, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Column="1"
                                 Background="LightYellow"
                                 Margin="5,0" />
                        <TextBlock Text="mm"
                                   Grid.Column="2"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />

                        <TextBlock Text="当前针头高度:"
                                   Grid.Column="3"
                                   Margin="15,0,5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding CurrentNeedleHeight, StringFormat=F3, Mode=OneWay}"
                                 Grid.Column="4"
                                 Background="LightGreen"
                                 Margin="5,0"
                                 IsReadOnly="True" />
                        <TextBlock Text="mm"
                                   Grid.Column="5"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 计算当前针头高度按钮 -->
                    <Button Content="计算针高度"
                            Grid.Row="3"
                            Grid.Column="2"
                            Command="{Binding CalculateCurrentNeedleHeightCommand}"
                            Width="120"
                            Height="30"
                            Margin="5"
                            Background="LightBlue"
                            ToolTip="根据目标3D平面高度和针尖高度计算当前针头高度" />

                    <!-- 计算结果 -->
                    <TextBlock Text="计算结果 - 相机与针尖距离:"
                               Grid.Row="4"
                               Grid.Column="0"
                               Margin="5"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />
                    <!-- 计算结果区域 -->
                    <Grid Grid.Row="4"
                          Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="ΔX:"
                                   Grid.Column="0"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding CalibrationDeltaX, StringFormat=F3}"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Background="LightYellow" />
                        <TextBlock Text="mm"
                                   Grid.Column="2"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />

                        <TextBlock Text="ΔY:"
                                   Grid.Column="3"
                                   Margin="15,0,5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding CalibrationDeltaY, StringFormat=F3}"
                                 Grid.Column="4"
                                 IsReadOnly="True"
                                 Background="LightYellow" />
                        <TextBlock Text="mm"
                                   Grid.Column="5"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 补偿设置 -->
                    <TextBlock Text="补偿设置:"
                               Grid.Row="5"
                               Grid.Column="0"
                               Margin="5"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />
                    <!-- 补偿设置输入区域 -->
                    <Grid Grid.Row="5"
                          Grid.Column="1"
                          Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="X补偿:"
                                   Grid.Column="0"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding CompensationX, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Column="1"
                                 Margin="5,0" />
                        <TextBlock Text="mm"
                                   Grid.Column="2"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Y补偿:"
                                   Grid.Column="3"
                                   Margin="15,0,5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding CompensationY, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Column="4"
                                 Margin="5,0" />
                        <TextBlock Text="mm"
                                   Grid.Column="5"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Z补偿:"
                                   Grid.Column="6"
                                   Margin="15,0,5,0"
                                   VerticalAlignment="Center" />
                        <TextBox Text="{Binding CompensationZ, UpdateSourceTrigger=PropertyChanged}"
                                 Grid.Column="7"
                                 Margin="5,0" />
                        <TextBlock Text="mm"
                                   Grid.Column="8"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <!-- 应用补偿和自动计算补偿按钮 -->
                    <StackPanel Grid.Row="6"
                                Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Button Content="应用补偿"
                                Command="{Binding ApplyCompensationCommand}"
                                Width="120"
                                Height="30"
                                Margin="10,0" />
                        <Button Content="自动计算补偿"
                                Command="{Binding AutoCalculateCompensationCommand}"
                                Width="120"
                                Height="30"
                                Margin="10,0" />
                    </StackPanel>

                    <!-- 状态信息 -->
                    <Border Grid.Row="7"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Background="{Binding CalibrationStatusColor}"
                            CornerRadius="3"
                            Padding="10,5"
                            Margin="0,10,0,0">
                        <TextBlock Text="{Binding CalibrationStatusMessage}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>
            </ScrollViewer>
        </GroupBox>

        <!-- 参数保存加载 -->
        <GroupBox Header="参数管理"
                  Grid.Row="2"
                  Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="5">
                <Button Content="加载校准参数"
                        Command="{Binding LoadCalibrationParametersCommand}"
                        Width="120"
                        Height="30"
                        Margin="5" />
                <Button Content="保存校准参数"
                        Command="{Binding SaveCalibrationParametersCommand}"
                        Width="120"
                        Height="30"
                        Margin="5" />
                <Button Content="重置校准数据"
                        Command="{Binding ResetCalibrationCommand}"
                        Width="120"
                        Height="30"
                        Margin="5" />
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
