<UserControl x:Class="Framework.Views.OverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Framework.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:Framework.ViewModels"
             xmlns:local1="clr-namespace:ModuleCore.Views;assembly=ModuleCore"
             xmlns:converters="clr-namespace:Framework.Converters"
             d:DataContext="{d:DesignInstance Type=viewmodels:OverViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource MaterialDesignPaper}"
          Margin="5">
        <!-- 主布局行列定义 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 顶部工具栏/Header -->
            <RowDefinition Height="*" />
            <!-- 主要内容区域 -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <!-- 左列（图表和传感器） -->
            <ColumnDefinition Width="600" />
            <!-- 右列（独立控制面板） -->
        </Grid.ColumnDefinitions>

        <!-- 传感器视图 -->
        <ScrollViewer Grid.Row="0"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      VerticalScrollBarVisibility="Auto"
                      Margin="5,5,5,10">
            <ItemsControl ItemsSource="{Binding Sensors}"
                          HorizontalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <local:SensorView Margin="5"
                                          Width="280"
                                          HorizontalAlignment="Left" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="0"
              Grid.Column="1"
              Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <!-- 产品型号 -->
                <RowDefinition Height="Auto" />
                <!-- 控制按钮区 -->
                <RowDefinition Height="Auto" />
                <!-- NG显示 -->
                <RowDefinition Height="Auto" />
                <!-- 状态视图（自动填充剩余空间） -->
                <RowDefinition Height="*" />
                <!-- 速度控制（固定在底部） -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 产品型号 -->
            <TextBlock Grid.Row="0"
                       Margin="5"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Text="{Binding RecipeName}" />

            <!-- 控制面板 -->
            <Grid Grid.Row="1"
                  Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 第一行：照明控制 -->
                <StackPanel Grid.Row="0"
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Margin="5">
                    <Button Content="打开照明"
                            Width="120"
                            Margin="5,0"
                            Command="{Binding OpenLightCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button Content="关闭照明"
                            Width="120"
                            Margin="5,0"
                            Command="{Binding CloseLightCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>

                <!-- 第一行：安全门控制 -->
                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Margin="5">
                    <Button Content="打开安全门"
                            Width="120"
                            Margin="5,0"
                            Command="{Binding OpenSafetyDoorCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button Content="关闭安全门"
                            Width="120"
                            Margin="5,0"
                            Command="{Binding CloseSafetyDoorCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>

                <!-- 第二行：胶针校准和日志窗口 -->
                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Margin="5,10">
                    <Button Content="胶针校准"
                            Width="120"
                            Margin="5,0"
                            Command="{Binding NeedleCalibrationCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button Content="日志窗口"
                            Width="120"
                            Margin="5,0"
                            Command="{Binding ShowLogCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>

                <!-- 第三行：其他功能按钮 -->
                <StackPanel Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Margin="5,10">
                    <!-- 这里可以添加其他功能按钮 -->
                </StackPanel>
            </Grid>

            <!-- 参数显示 -->
            <Border Grid.Row="2"
                    HorizontalAlignment="Center"
                    BorderBrush="{StaticResource MaterialDesignDivider}"
                    BorderThickness="0"
                    CornerRadius="4"
                    Margin="15 0 0 5"
                    Background="{StaticResource MaterialDesignPaper}">
                <StackPanel  Orientation="Horizontal">
                    <!-- 按钮1 -->
                    <Button Command="{Binding EditParametersCommand1}"
                            Margin="5 0"
                            Padding="8 4"
                            Width="120"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            ToolTip="编辑参数">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog"
                                                     Width="24"
                                                     Height="24"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="上料参数"
                                       Margin="8 0 0 0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 按钮2 -->
                    <Button Command="{Binding EditParametersCommand2}"
                            Margin="5 0"
                            Padding="8 4"
                            Width="120"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            ToolTip="编辑参数">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog"
                                                     Width="24"
                                                     Height="24"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="点胶参数"
                                       Margin="8 0 0 0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <!-- 按钮3 -->
                    <Button Command="{Binding EditParametersCommand3}"
                            Margin="5 0"
                            Padding="8 4"
                            Width="120"
                            Style="{StaticResource MaterialDesignFlatMidBgButton}"
                            ToolTip="编辑参数">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cog"
                                                     Width="24"
                                                     Height="24"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="组装参数"
                                       Margin="8 0 0 0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

            <!-- 工位选择区域 -->
            <!-- 工位选择区域 - 简化版 -->
            <Border Grid.Row="3"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    Margin="5,0,5,5"
                    BorderBrush="{StaticResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10">
                <StackPanel>
                    <TextBlock Text="组装工位选择"
                               FontSize="14"
                               FontWeight="Bold"
                               Margin="0,0,0,5" />

                    <!-- 单个工位选择 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="装配工位:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <!-- 下拉框选择单个工位 -->
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding StationOptions}"
                                  SelectedItem="{Binding SelectedStation}"
                                  Width="100"
                                  IsEnabled="{Binding IsSingleStationSelectionEnabled}"
                                  materialDesign:HintAssist.Hint="选择装配工位"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                            <ComboBox.ToolTip>
                                <TextBlock Text="选择要执行的装配工位" />
                            </ComboBox.ToolTip>
                        </ComboBox>
                    </Grid>

                    <!-- 执行模式选择 -->
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="执行模式:"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,5" />

                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="执行所选工位"
                                         IsChecked="{Binding IsSingleStationMode}"
                                         Margin="0,0,10,0"
                                         GroupName="ExecutionMode">
                                <RadioButton.ToolTip>
                                    <TextBlock Text="只执行当前选择的单个工位" />
                                </RadioButton.ToolTip>
                            </RadioButton>

                            <RadioButton Content="按顺序执行全部"
                                         IsChecked="{Binding IsSequentialMode}"
                                         GroupName="ExecutionMode">
                                <RadioButton.ToolTip>
                                    <TextBlock Text="按顺序执行所有选择的工位" />
                                </RadioButton.ToolTip>
                            </RadioButton>
                        </StackPanel>
                    </StackPanel>

                    <!-- 当前执行状态显示 -->
                    <Border Margin="0,10,0,0"
                            Padding="8"
                            Background="{StaticResource MaterialDesignCardBackground}"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="执行状态"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="当前工位:"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding CurrentExecutingStation}"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MaterialDesign.Brush.Secondary.Dark.Foreground}"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="执行模式:"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding ExecutionModeDescription}"
                                           Margin="5,0,0,0"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Grid>

                            <!-- 进度条 -->
                            <ProgressBar Value="{Binding StationProgress}"
                                         Maximum="6"
                                         Height="8"
                                         Margin="0,10,0,0"
                                         Style="{StaticResource MaterialDesignLinearProgressBar}">
                                <ProgressBar.ToolTip>
                                    <TextBlock Text="{Binding StationProgressText}" />
                                </ProgressBar.ToolTip>
                            </ProgressBar>
                        </StackPanel>
                    </Border>

                    <!-- 控制按钮 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Button Content="开始执行"
                                Command="{Binding StartStationsExecutionCommand}"
                                Width="100"
                                Margin="5"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <Button.ToolTip>
                                <TextBlock Text="开始执行选中的工位组装" />
                            </Button.ToolTip>
                        </Button>

                        <Button Content="停止执行"
                                Command="{Binding StopStationsExecutionCommand}"
                                Width="100"
                                Margin="5"
                                Style="{StaticResource MaterialDesignRaisedButton}">
                            <Button.ToolTip>
                                <TextBlock Text="停止当前执行的工位组装" />
                            </Button.ToolTip>
                        </Button>

                        <Button Content="暂停/继续"
                                Command="{Binding TogglePauseCommand}"
                                Width="100"
                                Margin="5"
                                Style="{StaticResource MaterialDesignFlatButton}">
                            <Button.ToolTip>
                                <TextBlock Text="暂停或继续当前执行" />
                            </Button.ToolTip>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 速度控制（底部定位） -->
            <Border Grid.Row="4"
                    Margin="5,0,5,5"
                    BorderBrush="{StaticResource MaterialDesignDivider}"
                    BorderThickness="0">
                <local:SpeedRatioView VerticalAlignment="Bottom"
                                      HorizontalAlignment="Right"
                                      MinWidth="560" />
            </Border>
        </Grid>

        <!-- MAP视图 -->
        <Grid Grid.Row="1"
              Grid.Column="0">
            <UniformGrid HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch">
                <local1:StatusDashboardView />
            </UniformGrid>
        </Grid>

    </Grid>

</UserControl>