<UserControl x:Class="Framework.Views.CamHighCmpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Framework.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:conv="clr-namespace:Framework.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="650"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <Style TargetType="Ellipse">
                <Setter Property="Width"
                        Value="18" />
                <Setter Property="Height"
                        Value="18" />
                <Setter Property="StrokeThickness"
                        Value="2" />
                <Setter Property="ToolTipService.ToolTip">
                    <Setter.Value>
                        <StackPanel>
                            <TextBlock Text="{Binding ArrayIndex, StringFormat='阵列: {0}'}" />
                            <TextBlock Text="{Binding Row, StringFormat='行: {0}'}" />
                            <TextBlock Text="{Binding Column, StringFormat='列: {0}'}" />
                            <TextBlock Text="{Binding Index, StringFormat='全局序号: {0}'}" />
                        </StackPanel>
                    </Setter.Value>
                </Setter>
            </Style>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <TabControl DockPanel.Dock="Top">
            <!-- MAP设置标签页 -->
            <TabItem Header="{Binding PinDisplayName}"
                     Background="{StaticResource MaterialDesignPaper}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="5">
                    <Grid Background="{StaticResource MaterialDesignPaper}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        
                        <!-- 行列配置 -->
                        <GroupBox Grid.Row="0"
                                  Header="基础阵列配置(相对位置)"
                                  IsEnabled="{Binding CanEditConfig, 
                                  Mode=OneWay,
                                  UpdateSourceTrigger=PropertyChanged}">
                            <StackPanel Orientation="Horizontal"
                                        Margin="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="行数:"
                                               VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding Rows}"
                                             Margin="5,0"
                                             Width="60" />

                                    <TextBlock Grid.Column="2"
                                               Text="列数:"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                    <TextBox Grid.Column="3"
                                             Text="{Binding Columns}"
                                             Margin="5,0"
                                             Width="60" />
                                </Grid>

                                <Button Content="初始化网格"
                                        Command="{Binding InitializeBaseOffsetsCommand}"
                                        Margin="10,0"
                                        Padding="10,3" />
                                <!-- 导出导入按钮 -->
                                <Button Content="导出网格"
                                        Command="{Binding ExportGridCommand}"
                                        Margin="10,0"
                                        Padding="10,3"
                                        ToolTip="导出当前网格配置" />
                                <Button Content="导入网格"
                                        Command="{Binding ImportGridCommand}"
                                        Margin="10,0"
                                        Padding="10,3"
                                        ToolTip="导入网格配置文件" />
                            </StackPanel>
                        </GroupBox>

                        <!-- 偏移网格 -->
                        <GroupBox Grid.Row="1"
                                  Header="拍照位配置网格">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              VirtualizingPanel.CacheLength="2,5"
                                              VirtualizingPanel.ScrollUnit="Pixel"
                                              ItemsSource="{Binding BasePoints}"
                                              IsEnabled="{Binding CanEditConfig, 
                                              Mode=OneWay,
                                              UpdateSourceTrigger=PropertyChanged}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2"
                                                              Width="120">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0"
                                                                     Text="{Binding X}"
                                                                     Margin="2"
                                                                     ToolTip="X坐标" />
                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Y}"
                                                                     Margin="2"
                                                                     ToolTip="Y坐标" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>

                        <!-- 编码器配置网格(Updated dynamic) -->
                        <GroupBox Grid.Row="2"
                                  Header="编码器配置网格">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl VirtualizingPanel.IsVirtualizing="True"
                                              ItemsSource="{Binding EncoderPoints}"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              IsEnabled="{Binding CanEditConfig, 
                                              Mode=OneWay,
                                              UpdateSourceTrigger=PropertyChanged}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding ., Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Width="100"
                                                                 Margin="2"
                                                                 ToolTip="编码器值"
                                                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>

                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>

                        <!-- 相机mark点偏移网格 默认3x3行列-->
                        <GroupBox Grid.Row="3"
                                  Header="相机Mark点拍照位网格"
                                  IsEnabled="{Binding CanEditConfig, 
                                  Mode=OneWay,
                                  UpdateSourceTrigger=PropertyChanged}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl  VirtualizingPanel.IsVirtualizing="False"
                                               VirtualizingPanel.VirtualizationMode="Recycling"
                                               ItemsSource="{Binding CameraMarkPoints}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ItemsControl ItemsSource="{Binding}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>

                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2"
                                                              Width="120">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox Grid.Column="0"
                                                                     Text="{Binding X}"
                                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                                     ToolTip="X坐标 (单位：mm)" />

                                                            <TextBox Grid.Column="1"
                                                                     Text="{Binding Y}"
                                                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                                                     ToolTip="Y坐标 (单位：mm)" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </GroupBox>

                        <!--  相机mark点编码器偏移网格 -->
                        <GroupBox Grid.Row="4"
                                  Header="相机Mark点编码器网格"
                                  IsEnabled="{Binding CanEditConfig, 
                                  Mode=OneWay,
                                  UpdateSourceTrigger=PropertyChanged}">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                <DataGrid EnableColumnVirtualization="True"
                                          EnableRowVirtualization="True"
                                          ItemsSource="{Binding MarkEncoderPoints}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="列1"
                                                            Width="100"
                                                            Binding="{Binding [0], Mode=TwoWay}" />
                                        <DataGridTextColumn Header="列2"
                                                            Width="100"
                                                            Binding="{Binding [1], Mode=TwoWay}" />
                                        <DataGridTextColumn Header="列3"
                                                            Width="100"
                                                            Binding="{Binding [2], Mode=TwoWay}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>
                        </GroupBox>

                        <!-- 控制区域 -->
                        <StackPanel Grid.Row="5"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                            <Button Content="生成基础阵列"
                                    Command="{Binding GenerateBaseCommand}"
                                    Margin="5"
                                    Padding="10,3"
                                    IsEnabled="{Binding CanEditConfig}"/>
                            <Button Content="清空所有阵列"
                                    Command="{Binding ClearAllCommand}"
                                    Margin="5"
                                    Padding="10,3"
                                    IsEnabled="{Binding CanEditConfig}" />
                            <!-- 新增按钮 -->
                            <Button Content="保存配方"
                                    Command="{Binding SaveRecipeCommand}"
                                    Margin="5"
                                    Padding="10,3"
                                    ToolTip="保存当前配置到文件"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    IsEnabled="{Binding CanEditConfig}" /> 

                            <Button Content="加载配方"
                                    Command="{Binding LoadRecipeCommand}"
                                    IsEnabled="{Binding CanEditConfig}" > 
                                <Button.Resources>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoading}"
                                                         Value="True">
                                                <Setter Property="Content"
                                                        Value="加载中..." />
                                                <Setter Property="IsEnabled"
                                                        Value="False" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                    </Grid>

                </ScrollViewer>
            </TabItem>

            <!-- 参数设置标签页 -->
            <TabItem Header="参数设置"
                     Background="{StaticResource MaterialDesignPaper}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 坐标点管理 -->
                        <GroupBox Header="坐标点管理"
                                  Margin="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="5">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Pin拍照位网格 -->
                                    <DataGrid Grid.Row="0"
                                              ItemsSource="{Binding AllPoints}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              EnableRowVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              IsEnabled="{Binding CanEditConfig}">
                                        <DataGrid.Columns>
                                            <!-- 序号 -->
                                            <DataGridTextColumn Header="序号"
                                                                Binding="{Binding Index}"
                                                                Width="Auto"
                                                                IsReadOnly="True" />
                                            <!-- X坐标 -->
                                            <DataGridTemplateColumn Header="X坐标">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="2"
                                                                 ToolTip="双击编辑X坐标" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- Y坐标 -->
                                            <DataGridTemplateColumn Header="Y坐标">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="2"
                                                                 ToolTip="双击编辑Y坐标" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 启用状态 -->
                                            <DataGridCheckBoxColumn Header="启用"
                                                                    Binding="{Binding IsActive}"
                                                                    Width="Auto" />
                                            <!-- 顺序号 -->
                                            <DataGridTemplateColumn Header="顺序">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Order, UpdateSourceTrigger=LostFocus}"
                                                                 Margin="2"
                                                                 Width="60"
                                                                 ToolTip="设置加工顺序" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <!-- 移动按钮 -->
                                            <DataGridTemplateColumn Header="操作">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="移动"
                                                                Command="{Binding DataContext.MoveToPointCommand, 
                                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="8,2"
                                                                Style="{StaticResource MaterialDesignFlatButton}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </ScrollViewer>
                        </GroupBox>

                        <!-- Mark点管理 -->
                        <GroupBox Header="Mark点管理"
                                  Margin="5">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Padding="5">
                                <Grid Margin="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Mark拍照位网格 -->
                                    <DataGrid Grid.Row="0"
                                              ItemsSource="{Binding AllMarkPoints}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              EnableRowVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              ScrollViewer.CanContentScroll="True"
                                              VerticalScrollBarVisibility="Auto"
                                              IsEnabled="{Binding CanEditConfig}">
                                        <DataGrid.Columns>
                                            <!-- 序号 -->
                                            <DataGridTextColumn Header="序号"
                                                                Binding="{Binding Index}"
                                                                Width="Auto"
                                                                IsReadOnly="True" />
                                            <DataGridTemplateColumn Header="X坐标">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="2"
                                                                 ToolTip="双击编辑X坐标" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="Y坐标">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"
                                                                 Margin="2"
                                                                 ToolTip="双击编辑Y坐标" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridCheckBoxColumn Header="IsMark"
                                                                    Binding="{Binding IsCameraMark}"
                                                                    Width="Auto" />
                                            <!-- 移动按钮 -->
                                            <DataGridTemplateColumn Header="操作">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="移动"
                                                                    Command="{Binding DataContext.MoveToMarkPointCommand, 
                                                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Padding="8,2"
                                                                    Style="{StaticResource MaterialDesignFlatButton}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </ScrollViewer>
                        </GroupBox>
                        <!-- 通用控制按钮 -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="10">
                            <Button Content="保存预设"
                                    Command="{Binding SaveRecipeCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="5"
                                    Padding="10,3" />
                            <Button Content="加载预设"
                                    Command="{Binding LoadRecipeCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="5"
                                    Padding="10,3" />
                            <Button Content="导出CSV"
                                    Command="{Binding ExportPointsCommand}"
                                    ToolTip="导出当前点列表"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Margin="5" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>

</UserControl>
