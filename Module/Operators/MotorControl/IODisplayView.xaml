<UserControl x:Class="Framework.Views.IODisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Framework.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:Framework.ViewModels"
             xmlns:z="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             d:DataContext="{d:DesignInstance Type=viewmodels:IODisplayViewModel}"
             xmlns:converters="clr-namespace:Framework.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 颜色区分激活状态 -->
            <!--<Style TargetType="ListBoxItem">
                <Setter Property="Foreground"
                        Value="{Binding StatusColor}" />
            </Style>-->
            <!-- DO项模板 -->
            <converters:StatusToColorConverter x:Key="StatusConverter" />
            <DataTemplate DataType="{x:Type viewmodels:DoChannelViewItem}">
                <Grid Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--状态指示灯-->
                    <Ellipse Width="20"
                             Height="20"
                             Fill="{Binding IsActive, Converter={StaticResource StatusConverter}}" />

                    <!-- 切换按钮 -->
                    <Button Grid.Column="1"
                            Content="切换"
                            Command="{Binding DataContext.ToggleDoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Margin="10,0" />

                    <!-- 通道属性 -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding ChannelType}"
                               VerticalAlignment="Center" />

                    <!-- 序号 -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding SetId}"
                               VerticalAlignment="Center" />

                    <!-- 端口号 -->
                    <TextBlock Grid.Column="4"
                               Text="{Binding Channel}"
                               VerticalAlignment="Center" />

                    <!-- 输出点名称 -->
                    <TextBlock Grid.Column="5"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               FontWeight="DemiBold" />
                </Grid>
            </DataTemplate>
            <!-- DI 项模板 -->
            <DataTemplate DataType="{x:Type viewmodels:DiChannelViewItem}">
                <Grid Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 状态指示灯 -->
                    <Ellipse Width="20"
                             Height="20"
                             Fill="{Binding IsActive, Converter={StaticResource StatusConverter}}" />

                    <!-- 通道类型 -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding ChannelType}"
                               VerticalAlignment="Center"
                               Margin="10,0" />

                    <!-- 序号 -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding SetId}"
                               VerticalAlignment="Center" />

                    <!-- 端口号 -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Channel}"
                               VerticalAlignment="Center"
                               Margin="10,0" />

                    <!-- 输入点名称 -->
                    <TextBlock Grid.Column="4"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               FontWeight="DemiBold" />
                </Grid>
            </DataTemplate>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <!-- DI 列表 -->
        <GroupBox Header="输入"
                  FontSize="16"
                  Margin="5">
            <ListBox ItemsSource="{Binding DIList}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding"
                                Value="5" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </GroupBox>
        <GroupBox Grid.Column="1"
                  FontSize="16"
                  Header="输出"
                  Margin="5">
            <ListBox Style="{x:Null}"
                     ItemsSource="{Binding DOList}">
                <d:Interaction.Triggers>
                    <d:EventTrigger EventName="Loaded">
                        <d:InvokeCommandAction Command="{Binding ToggleDoCommand}" />
                    </d:EventTrigger>
                </d:Interaction.Triggers>
            </ListBox>
        </GroupBox>
    </Grid>
</UserControl>
