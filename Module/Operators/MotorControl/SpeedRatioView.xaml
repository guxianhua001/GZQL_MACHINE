<UserControl x:Class="Framework.Views.SpeedRatioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Framework"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource MaterialDesignPaper}"
          Margin="8"
          VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 标题区域 -->
        <Label Grid.Row="0"
               Grid.ColumnSpan="2"
               Content="{DynamicResource Axis_Speed_Adjustment_Percentage}"
               ContentStringFormat=" {0}:" 
               FontSize="20"
               FontWeight="SemiBold"
               Foreground="{StaticResource MaterialDesignBody}"
               HorizontalContentAlignment="Left"
               Margin="0,0,0,8" />

        <!-- 滑动条 -->
        <Slider x:Name="SpeedSlider"
                Grid.Row="1"
                Grid.Column="0"
                Minimum="5"
                Maximum="100"
                SelectionEnd="100"
                SelectionStart="80"
                Value="{Binding Velocity}"
                Style="{StaticResource MaterialDesign3.MaterialDesignSlider}"
                TickFrequency="5"
                TickPlacement="BottomRight"
                AutoToolTipPlacement="TopLeft"
                AutoToolTipPrecision="1"
                IsSnapToTickEnabled="True"
                Margin="0,0,12,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
            <Slider.Effect>
                <DropShadowEffect BlurRadius="4"
                                  Opacity="0.1"
                                  ShadowDepth="2" />
            </Slider.Effect>
        </Slider>

        <!-- 动态数值显示 -->
        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0">
            <Label Content="{Binding Value, ElementName=SpeedSlider}"
                   ContentStringFormat="{}{0:N0}%"
                   FontSize="18"
                   FontWeight="Medium"
                   Foreground="{StaticResource MaterialDesignBody}"
                   Padding="12,4"
                   Background="{StaticResource MaterialDesignDarkSeparatorBackground}">
                <Label.Effect>
                    <DropShadowEffect BlurRadius="6"
                                      Opacity="0.15"
                                      ShadowDepth="2" />
                </Label.Effect>
            </Label>
        </StackPanel>

    </Grid>

</UserControl>
