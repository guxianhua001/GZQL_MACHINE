<UserControl x:Class="Module.Controls.Step4AlignPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:converters="clr-namespace:Module.Common.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InvertedBoolToVisibilityConverter x:Key="InvertedBoolToVisibilityConverter"/>
        <converters:NonEmptyToVisibilityConverter x:Key="NullOrEmptyToCollapsedConverter"/>
    </UserControl.Resources>
    <StackPanel Margin="12">

        <!-- 标题 + 帮助按钮（悬浮示意图） -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{lang:Lang Step4_Title}" FontSize="16" FontWeight="Bold" Grid.Column="0"/>
            <Button Grid.Column="1" HorizontalAlignment="Right"
                    Content="{lang:Lang Step4_Btn_ViewDiagram}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    FontSize="11"
                    Command="{Binding ShowSvgCommand}"
                    Margin="0,-4,0,0"/>
        </Grid>

        <TextBlock Text="{lang:Lang Step4_Description}"
                   FontSize="11" Foreground="#616161" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <!-- 对齐模式选择 -->
        <materialDesign:Card Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{lang:Lang Step4_Section_AlignMode}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>

                <!-- Mode 1：N点仿射（>=3点标定） -->
                <RadioButton GroupName="AlignMode" IsChecked="{Binding IsModeAffine}" Margin="0,4">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="RotateOrbit" VerticalAlignment="Center"
                                                     Foreground="#E65100" Width="20" Height="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{lang:Lang Step4_Mode_Affine}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{lang:Lang Step4_Mode_AffineDesc}" Foreground="#757575" FontSize="11" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{lang:Lang Step4_Mode_AffineDetail}"
                                           FontSize="10" Foreground="#00A913" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>

                <!-- Mode 2：逐点映射 -->
                <RadioButton GroupName="AlignMode" IsChecked="{Binding IsModePointMapping}" Margin="0,4">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Map" VerticalAlignment="Center"
                                                     Foreground="#FF9100" Width="20" Height="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{lang:Lang Step4_Mode_PointMapping}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{lang:Lang Step4_Mode_PointMappingDesc}" Foreground="#757575" FontSize="11" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{lang:Lang Step4_Mode_PointMappingDetail}"
                                           FontSize="10" Foreground="#9E9E9E" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
            </StackPanel>
        </materialDesign:Card>

        <!-- N点仿射标定面板 -->
        <materialDesign:Card Padding="10" Margin="0,0,0,8"
                              Visibility="{Binding IsModeAffine, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{lang:Lang Step4_Section_AffineCalibration}" FontWeight="Bold" FontSize="12" Grid.Column="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{lang:Lang Step4_Btn_AddAffinePoint}" Command="{Binding AddAffinePointCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                    </StackPanel>
                </Grid>

                <!-- 相机示教子开关：勾选后改用「移动相机示教」，针头机械坐标 = 相机坐标 + 相机针头固定距离 + NeedleTCP偏差 -->
                <Border Background="#FFF8E1" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsUseCameraTeach}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <materialDesign:PackIcon Kind="Camera" VerticalAlignment="Center"
                                                 Foreground="#F57C00" Width="18" Height="18" Margin="0,0,4,0"/>
                        <TextBlock Text="{lang:Lang Step4_Check_UseCameraTeach}" FontSize="11"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{lang:Lang Step4_UseCameraTeachHint}"
                           FontSize="10" Foreground="#9E9E9E" Margin="0,0,0,6" TextWrapping="Wrap"/>

                <!-- 仿射标定点 DataGrid -->
                <DataGrid ItemsSource="{Binding AffineCalibrationPoints}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                          HeadersVisibility="Column" FontSize="10" MaxHeight="200"
                          BorderThickness="1" GridLinesVisibility="Horizontal"
                          SelectedItem="{Binding SelectedAffinePoint}">
                    <DataGrid.Resources>
                        <!-- 列 Visibility 绑定代理：DataGridColumn 不在可视化树，需经代理访问 DataContext -->
                        <converters:BindingProxy x:Key="AffineVmProxy" Data="{Binding}"/>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pt" Binding="{Binding Name}" Width="36" IsReadOnly="True"/>
                        <DataGridTextColumn Header="CAD X" Binding="{Binding CadX, StringFormat=F3}" Width="55"/>
                        <DataGridTextColumn Header="CAD Y" Binding="{Binding CadY, StringFormat=F3}" Width="55"/>
                        <!-- 相机示教模式专用：相机机械坐标列 -->
                        <DataGridTextColumn Header="{lang:Lang Step4_Header_CamMX}"
                                            Binding="{Binding CameraMachineX, StringFormat=F3}" Width="58" IsReadOnly="True"
                                            Visibility="{Binding Data.IsUseCameraTeach, Source={StaticResource AffineVmProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <DataGridTextColumn Header="{lang:Lang Step4_Header_CamMY}"
                                            Binding="{Binding CameraMachineY, StringFormat=F3}" Width="58" IsReadOnly="True"
                                            Visibility="{Binding Data.IsUseCameraTeach, Source={StaticResource AffineVmProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <DataGridTextColumn Header="Mach X" Binding="{Binding MachineX, StringFormat=F3}" Width="58" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Mach Y" Binding="{Binding MachineY, StringFormat=F3}" Width="58" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Mach Dz" Binding="{Binding MachineDz, StringFormat=F3}" Width="55" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Residual" Binding="{Binding Residual, StringFormat=F4}" Width="55" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.PickAffineCadCoordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{lang:Lang Step4_Btn_PickFromCanvas}"
                                                Style="{StaticResource MaterialDesignIconButton}" Padding="0" Width="22" Height="22">
                                            <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.TeachAffineMachineCoordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding DataContext.AffineTeachButtonToolTip, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                Style="{StaticResource MaterialDesignIconButton}" Padding="0" Width="22" Height="22">
                                            <Grid>
                                                <!-- 相机示教模式图标 -->
                                                <materialDesign:PackIcon Kind="AxisArrow" Width="14" Height="14"
                                                                         Visibility="{Binding Data.IsUseCameraTeach, Source={StaticResource AffineVmProxy}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <!-- 针头示教模式图标 -->
                                                <materialDesign:PackIcon Kind="AxisArrow" Width="14" Height="14"
                                                                         Visibility="{Binding Data.IsUseCameraTeach, Source={StaticResource AffineVmProxy}, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                            </Grid>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteAffinePointCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{lang:Lang Step4_Btn_DeletePoint}"
                                                Style="{StaticResource MaterialDesignIconButton}" Padding="0" Width="22" Height="22">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="#D32F2F"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 计算仿射变换按钮 -->
                <Button Content="{lang:Lang Step4_Btn_ComputeAffine}" Command="{Binding ComputeAffineTransformCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Stretch" Padding="0,4" FontSize="12" Margin="0,8,0,0"/>

                <!-- 仿射结果面板 -->
                <Border Background="#E8F5E9" CornerRadius="4" Padding="8" Margin="0,6,0,0"
                        Visibility="{Binding AffineQualityText, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding AffineQualityText}" FontSize="11" Foreground="#2E7D32" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AffineResultDisplay}" FontSize="10" Foreground="#558B2F" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </materialDesign:Card>

        <!-- 逐点映射面板 -->
        <materialDesign:Card Padding="10" Margin="0,0,0,8"
                              Visibility="{Binding IsModePointMapping, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{lang:Lang Step4_Section_PointMapping}" FontWeight="Bold" FontSize="12" Grid.Column="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{lang:Lang Step4_Btn_AddMappingPoint}" Command="{Binding AddMappingPointCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" Padding="8,2" FontSize="11" Margin="0,0,4,0"/>
                    </StackPanel>
                </Grid>

                <!-- 逐点映射 DataGrid -->
                <DataGrid ItemsSource="{Binding PointMappingPoints}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          HeadersVisibility="Column" FontSize="10" MaxHeight="200"
                          BorderThickness="1" GridLinesVisibility="Horizontal"
                          SelectedItem="{Binding SelectedMappingPoint}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pt" Binding="{Binding Name}" Width="40" IsReadOnly="True"/>
                        <DataGridTextColumn Header="CAD X" Binding="{Binding CadX, StringFormat=F3}" Width="55"/>
                        <DataGridTextColumn Header="CAD Y" Binding="{Binding CadY, StringFormat=F3}" Width="55"/>
                        <DataGridTextColumn Header="Mach Dx" Binding="{Binding MachineDx, StringFormat=F3}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Mach Dy" Binding="{Binding MachineDy, StringFormat=F3}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Mach Dz" Binding="{Binding MachineDz, StringFormat=F3}" Width="60" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.PickMappingCadCoordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{lang:Lang Step4_Btn_PickFromCanvas}"
                                                Style="{StaticResource MaterialDesignIconButton}" Padding="0" Width="22" Height="22">
                                            <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.TeachMappingMachineCoordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{lang:Lang Step4_Btn_TeachMachine}"
                                                Style="{StaticResource MaterialDesignIconButton}" Padding="0" Width="22" Height="22">
                                            <materialDesign:PackIcon Kind="AxisArrow" Width="14" Height="14"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteMappingPointCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{lang:Lang Step4_Btn_DeletePoint}"
                                                Style="{StaticResource MaterialDesignIconButton}" Padding="0" Width="22" Height="22">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="#D32F2F"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </materialDesign:Card>

        <!-- 应用变换到轨迹段 -->
        <Button Content="{lang:Lang Step4_Btn_ApplyTransform}" Command="{Binding ApplyTransformToSegmentsCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}"
                HorizontalAlignment="Stretch" Padding="0,5"
                FontSize="13" IsEnabled="{Binding HasAffineResult}"/>

        <!-- 针头偏移来源确认（相机示教模式：展示 CalibrationDelta + TcpComp 以核对换算值） -->
        <Border Background="#E3F2FD" CornerRadius="4" Padding="8" Margin="0,6,0,0"
                Visibility="{Binding ShowNeedleOffsetInfo, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14"
                                             Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{lang:Lang Step4_Section_NeedleOffsetSource}" FontWeight="SemiBold"
                               FontSize="11" Foreground="#1565C0"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Step4_Label_CameraDelta}"
                               FontSize="10" Foreground="#616161" Margin="0,2,8,2" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding CameraCalibrationDeltaX, StringFormat='X={0:F3}'}"
                               FontSize="10" FontWeight="SemiBold" Foreground="#424242" Margin="0,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="{Binding CameraCalibrationDeltaY, StringFormat='Y={0:F3}'}"
                               FontSize="10" FontWeight="SemiBold" Foreground="#424242" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Step4_Label_NeedleTcpComp}"
                               FontSize="10" Foreground="#616161" Margin="0,2,8,2" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding NeedleTcpCompensationX, StringFormat='X={0:F3}'}"
                               FontSize="10" FontWeight="SemiBold" Foreground="#424242" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="{Binding NeedleTcpCompensationY, StringFormat='Y={0:F3}'}"
                               FontSize="10" FontWeight="SemiBold" Foreground="#424242" Margin="0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang Step4_Label_OffsetTotal}"
                               FontSize="10" Foreground="#1565C0" FontWeight="SemiBold" Margin="0,2,8,2" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{Binding NeedleOffsetTotalX, StringFormat='X={0:F3}'}"
                               FontSize="10" FontWeight="Bold" Foreground="#0D47A1" Margin="0,2"/>
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Text="{Binding NeedleOffsetTotalY, StringFormat='Y={0:F3}'}"
                               FontSize="10" FontWeight="Bold" Foreground="#0D47A1" Margin="0,2"/>
                </Grid>
                <TextBlock Text="{lang:Lang Step4_NeedleOffsetSourceHint}"
                           FontSize="9" Foreground="#9E9E9E" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 状态 -->
        <TextBlock Text="{Binding TransformStatus}" Margin="0,8" FontSize="11" Foreground="#2E7D32" TextWrapping="Wrap"/>

        <!-- 变换结果摘要（可折叠，默认折叠不占空间） -->
        <Expander Header="{Binding TransformMatrixDisplay}" Margin="0,4,0,0" FontSize="11"
                  IsExpanded="False" Visibility="{Binding TransformStatus, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
            <materialDesign:Card Padding="8" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="{lang:Lang Step4_Section_PreviewTitle}" FontSize="10" Foreground="#757575" Margin="0,0,0,4"/>
                    <DataGrid ItemsSource="{Binding TransformedPointsPreview}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="10" MaxHeight="120"
                              BorderThickness="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{lang:Lang Step4_Header_CADX}" Binding="{Binding X, StringFormat=F2}" Width="55"/>
                            <DataGridTextColumn Header="{lang:Lang Step4_Header_CADY}" Binding="{Binding Y, StringFormat=F2}" Width="55"/>
                            <DataGridTextColumn Header="{lang:Lang Step4_Header_MX}" Binding="{Binding MachineX, StringFormat=F2}" Width="55"/>
                            <DataGridTextColumn Header="{lang:Lang Step4_Header_MY}" Binding="{Binding MachineY, StringFormat=F2}" Width="55"/>
                            <DataGridTextColumn Header="{lang:Lang Step4_Header_MZ}" Binding="{Binding MachineZ, StringFormat=F2}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>
        </Expander>



    </StackPanel>
</UserControl>