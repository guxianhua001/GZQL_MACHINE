<UserControl x:Class="Module.Controls.Step4AlignPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:converters="clr-namespace:Module.Common.Converters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NonEmptyToVisibilityConverter x:Key="NullOrEmptyToCollapsedConverter"/>
    </UserControl.Resources>
    <StackPanel Margin="12">

        <!-- 标题 + 帮助按钮（悬浮示意图） -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{lang:Lang Step4_Title}" FontSize="16" FontWeight="Bold" Grid.Column="0"/>
            <Button Grid.Column="1" HorizontalAlignment="Right"
                    Content="{lang:Lang Step4_Btn_ViewDiagram}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    FontSize="11"
                    Command="{Binding ShowSvgCommand}"
                    Margin="0,-4,0,0"/>
        </Grid>

        <TextBlock Text="{lang:Lang Step4_Description}"
                   FontSize="11" Foreground="#616161" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <!-- 对齐模式选择 -->
        <materialDesign:Card Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{lang:Lang Step4_Section_AlignMode}" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>

                <!-- Mode 1：单基准点 平移 -->
                <RadioButton GroupName="AlignMode" IsChecked="{Binding IsModeFirstPoint}" Margin="0,4">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowExpand" VerticalAlignment="Center" 
                                                     Foreground="#1976D2" Width="20" Height="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{lang:Lang Step4_Mode_FirstPointOffset}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{lang:Lang Step4_Mode_FirstPointDesc}" Foreground="#757575" FontSize="11" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{lang:Lang Step4_Mode_FirstPointDetail}" 
                                           FontSize="10" Foreground="#9E9E9E" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>

                <!-- Mode 3：两点仿射（自动方向点）圆弧专用 -->
                <RadioButton GroupName="AlignMode" IsChecked="{Binding IsModeAffine}" Margin="0,4">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="RotateOrbit" VerticalAlignment="Center" 
                                                     Foreground="#E65100" Width="20" Height="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{lang:Lang Step4_Mode_Affine}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{lang:Lang Step4_Mode_AffineDesc}" Foreground="#757575" FontSize="11" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{lang:Lang Step4_Mode_AffineDetail}" 
                                           FontSize="10" Foreground="#00A913" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>

                <!-- Mode 2：逐点映射 -->
                <RadioButton GroupName="AlignMode" IsChecked="{Binding IsModeAllPoints}" Margin="0,4">
                    <RadioButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Map" VerticalAlignment="Center" 
                                                     Foreground="#FF9100" Width="20" Height="20" Margin="0,0,8,0"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{lang:Lang Step4_Mode_PointMapping}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{lang:Lang Step4_Mode_PointMappingDesc}" Foreground="#757575" FontSize="11" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{lang:Lang Step4_Mode_PointMappingDetail}" 
                                           FontSize="10" Foreground="#9E9E9E" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </RadioButton.Content>
                </RadioButton>
            </StackPanel>
        </materialDesign:Card>

        <!-- 图纸基准点 A -->
        <materialDesign:Card Padding="10" Margin="0,0,0,8" Background="#E3F2FD">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{lang:Lang Step4_Section_MapFiducial}" FontWeight="Bold" FontSize="12" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="{lang:Lang Step4_Btn_PickFromCanvas}" Command="{Binding TeachMapFiducialCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Padding="8,2" FontSize="11"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Foreground="#1976D2" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Y" Foreground="#1976D2" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Z" Foreground="#1976D2" FontWeight="Bold"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding MapFiducialX, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,4,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MapFiducialY, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,4,0"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding MapFiducialZ, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,0"/>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- 机械基准点 A -->
        <materialDesign:Card Padding="10" Margin="0,0,0,8" Background="#FFF3E0">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{lang:Lang Step4_Section_MachineFiducial}" FontWeight="Bold" FontSize="12" Grid.Column="0"/>
                    <Button Grid.Column="1" Content="{lang:Lang Step4_Btn_TeachCurrentPosition}" Command="{Binding TeachMachineFiducialCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Padding="8,2" FontSize="11"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Foreground="#E65100" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Y" Foreground="#E65100" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Z" Foreground="#E65100" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Rx" Foreground="#E65100" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Rz" Foreground="#E65100" FontWeight="Bold" FontSize="11"/>
                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding MachineFidX, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,2,3,0" FontSize="11"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MachineFidY, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,2,3,0" FontSize="11"/>
                    <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding MachineFidZ, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,2,3,0" FontSize="11"/>
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding MachineFidRx, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,2,3,0" FontSize="11"/>
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding MachineFidRz, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Margin="0,2,0,0" FontSize="11"/>
                </Grid>
            </StackPanel>
        </materialDesign:Card>

        <!-- 方向点距离（仿射模式专用） -->
        <materialDesign:Card Padding="10" Margin="0,0,0,8" Background="#F3E5F5"
                              Visibility="{Binding IsModeAffine, Converter={StaticResource BoolToVisibilityConverter}}">
            <DockPanel>
                <TextBlock Text="{lang:Lang Step4_Label_DirectionDistance}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Margin="0,0,6,0"/>
                <TextBox Text="{Binding DirectionLength, UpdateSourceTrigger=PropertyChanged}" 
                         Width="60" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"/>
                <TextBlock Text="{lang:Lang Step4_Desc_DirectionDistance}" 
                           VerticalAlignment="Center" FontSize="10" Foreground="#9E9E9E"/>
            </DockPanel>
        </materialDesign:Card>

        <!-- 自动计算 -->
        <Button Content="{lang:Lang Step4_Btn_CalculateTransform}" Command="{Binding AutoCalculateCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}"
                HorizontalAlignment="Stretch" Padding="0,5"
                FontSize="13" IsEnabled="{Binding IsAutoCalculateEnabled}"/>

        <!-- 状态 -->
        <TextBlock Text="{Binding TransformStatus}" Margin="0,8" FontSize="11" Foreground="#2E7D32" TextWrapping="Wrap"/>

        <!-- 变换结果摘要（可折叠，默认折叠不占空间） -->
        <Expander Header="{Binding TransformMatrixDisplay}" Margin="0,4,0,0" FontSize="11"
                  IsExpanded="False" Visibility="{Binding TransformStatus, Converter={StaticResource NullOrEmptyToCollapsedConverter}}">
            <materialDesign:Card Padding="8" Margin="0,4,0,0">
                <StackPanel>
                    <TextBlock Text="{lang:Lang Step4_Section_PreviewTitle}" FontSize="10" Foreground="#757575" Margin="0,0,0,4"/>
                    <DataGrid ItemsSource="{Binding TransformedPointsPreview}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" FontSize="10" MaxHeight="120"
                              BorderThickness="0" GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{lang:Lang Step4_Header_CADX}" Binding="{Binding X, StringFormat=F2}" Width="55"/>
                            <DataGridTextColumn Header="{lang:Lang Step4_Header_CADY}" Binding="{Binding Y, StringFormat=F2}" Width="55"/>
                            <DataGridTextColumn Header="{lang:Lang Step4_Header_MX}" Binding="{Binding MachineX, StringFormat=F2}" Width="55"/>
                            <DataGridTextColumn Header="{lang:Lang Step4_Header_MY}" Binding="{Binding MachineY, StringFormat=F2}" Width="55"/>
                            <DataGridTextColumn Header="{lang:Lang Step4_Header_MZ}" Binding="{Binding MachineZ, StringFormat=F2}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </materialDesign:Card>
        </Expander>

        <!-- 轨迹段保存/加载 -->
        <Separator Margin="0,12,0,8"/>
        <TextBlock Text="{lang:Lang Step4_Section_Persistence}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#424242"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button Content="{lang:Lang Step4_Btn_SaveSegments}" Command="{Binding SaveSegmentsCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="8,4" FontSize="12" Margin="0,0,8,0"
                    ToolTip="{lang:Lang Step4_ToolTip_SaveSegments}"/>
            <!--<Button Content="📂 加载轨迹段" Command="{Binding LoadSegmentsCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="8,4" FontSize="12"
                    ToolTip="从 JSON 文件加载之前保存的轨迹段"/>-->
        </StackPanel>

    </StackPanel>
</UserControl>