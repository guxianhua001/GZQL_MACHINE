<UserControl x:Class="Module.Views.CadPointEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:Module.Converters"
             xmlns:controls="clr-namespace:Module.Controls"
             MinHeight="500">
    <!-- 薄包装：内嵌新的 CadPointEditorControl -->
    <controls:CadPointEditorControl x:Name="CadEditor"
        Segments="{Binding Segments}"
        CurrentStep="{Binding CurrentStep}"
        FilePath="{Binding FilePath}"/>
</UserControl>