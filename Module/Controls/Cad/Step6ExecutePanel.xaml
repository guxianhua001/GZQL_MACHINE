<UserControl x:Class="Module.Controls.Step6ExecutePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core">
    <StackPanel Margin="12">
        <!-- 标题 -->
        <TextBlock Text="{lang:Lang Step6_Title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="{lang:Lang Step6_Description}" FontSize="11" Foreground="#616161" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- 目标线段选择 -->
        <materialDesign:Card Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{lang:Lang Step6_Section_TargetSelection}" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                <ComboBox ItemsSource="{Binding SegmentIds}"
                          SelectedItem="{Binding SelectedSegmentId}"
                          materialDesign:HintAssist.Hint="{lang:Lang Step6_Hint_SelectSegment}"
                          MinHeight="32"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- 执行模式选择（互斥） -->
        <materialDesign:Card Padding="10" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{lang:Lang Step6_Section_ExecMode}" FontWeight="Bold" FontSize="12" Margin="0,0,0,6"/>
                <RadioButton Content="{lang:Lang Step6_Radio_ContinuousInterpolation}"
                             IsChecked="{Binding IsContinuousInterpolationMode}"
                             GroupName="Step6ExecMode" Margin="0,2"/>
                <TextBlock Text="{lang:Lang Step6_Desc_ContinuousInterpolation}"
                           FontSize="10" Foreground="#9E9E9E" TextWrapping="Wrap" Margin="24,2,0,4"/>
                <RadioButton Content="{lang:Lang Step6_Radio_SinglePoint}"
                             IsChecked="{Binding IsSinglePointMode}"
                             GroupName="Step6ExecMode" Margin="0,4,0,0"/>
                <TextBlock Text="{lang:Lang Step6_Desc_SinglePoint}"
                           FontSize="10" Foreground="#9E9E9E" TextWrapping="Wrap" Margin="24,2,0,4"/>
                <CheckBox Content="{lang:Lang Step6_CheckBox_ZCorrection}" IsChecked="{Binding ZCorrectionEnabled}" Margin="0,8,0,0"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- ⚠️ 安全警告 -->
        <Border Background="#FFEBEE" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{lang:Lang Step6_Section_SafetyWarning}" FontWeight="Bold" FontSize="12" Foreground="#C62828"/>
                <TextBlock Text="{lang:Lang Step6_Warning_NeedleInstalled}" FontSize="11" Foreground="#B71C1C" Margin="0,2,0,0"/>
                <TextBlock Text="{lang:Lang Step6_Warning_NoObstacles}" FontSize="11" Foreground="#B71C1C"/>
                <TextBlock Text="{lang:Lang Step6_Warning_GlueSupplyNormal}" FontSize="11" Foreground="#B71C1C"/>
                <TextBlock Text="{lang:Lang Step6_Warning_KeepHandsOut}" FontSize="11" Foreground="#B71C1C"/>
            </StackPanel>
        </Border>

        <!-- 执行主按钮 -->
        <Button Content="{Binding ExecuteButtonText}"
                Command="{Binding ExecutePathCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}"
                HorizontalAlignment="Stretch" Padding="0,6"
                FontSize="15" FontWeight="Bold"
                IsEnabled="{Binding CanExecute, FallbackValue=False}"
                Margin="0,0,0,6"/>

        <!-- 停止按钮——安全优先，始终使能 -->
        <Button Content="{lang:Lang Step6_Btn_Stop}" Command="{Binding StopSimCommand}"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                HorizontalAlignment="Stretch" Padding="0,6"
                FontSize="13" FontWeight="Bold"
                Foreground="#D32F2F" BorderBrush="#D32F2F"
                Margin="0,0,0,6"/>
    </StackPanel>
</UserControl>
