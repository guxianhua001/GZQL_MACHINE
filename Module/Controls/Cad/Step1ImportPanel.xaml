<UserControl x:Class="Module.Controls.Step1ImportPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:conv="clr-namespace:Module.Converters">
    <UserControl.Resources>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisConv"/>
    </UserControl.Resources>
    <StackPanel Margin="12">
        <!-- 标题 -->
        <TextBlock Text="{lang:Lang Step1_Title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock Text="{lang:Lang Step1_Description}" FontSize="12" Foreground="#616161" Margin="0,0,0,16" TextWrapping="Wrap"/>

        <!-- DXF 文件导入卡片 -->
        <materialDesign:Card Padding="12" Margin="0,0,0,4">
            <StackPanel>
                <TextBlock Text="{lang:Lang Step1_Section_DxfImport}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#424242"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" materialDesign:HintAssist.Hint="{lang:Lang Step1_Hint_DxfFilePath}"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="{lang:Lang Step1_Btn_Browse}" Command="{Binding SelectFileCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" MinWidth="70"/>
                </Grid>
                <Button Content="{lang:Lang Step1_Btn_ImportDxf}" Command="{Binding ImportDxfCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Stretch" Padding="2" FontSize="14"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- 轨迹段加载卡片 -->
        <materialDesign:Card Padding="12" Margin="0,8,0,4">
            <StackPanel>
                <TextBlock Text="{lang:Lang Step1_Section_TrajectoryLoad}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#424242"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding SegmentFilePath, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="True" materialDesign:HintAssist.Hint="{lang:Lang Step1_Hint_SegmentFilePath}"
                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden" Margin="0,0,8,0"/>
                    <Button Grid.Column="1" Content="{lang:Lang Step1_Btn_Browse}" Command="{Binding SelectSegmentFileCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" MinWidth="70"/>
                </Grid>
                <Button Content="{lang:Lang Step1_Btn_LoadSegments}" Command="{Binding LoadSegmentsCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        HorizontalAlignment="Stretch" Padding="2" FontSize="14"
                        ToolTip="{lang:Lang Step1_ToolTip_LoadSegments}"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- 状态消息 -->
        <Border Background="#FFF3E0" CornerRadius="4" Padding="10" Margin="0,8,0,0"
                Visibility="{Binding ImportStatusMessage, Converter={StaticResource StringNotEmptyToVisConv}, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding ImportStatusMessage}" FontSize="12" Foreground="#E65100" TextWrapping="Wrap"/>
        </Border>
    </StackPanel>
</UserControl>
