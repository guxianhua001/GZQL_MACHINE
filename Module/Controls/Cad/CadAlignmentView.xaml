<UserControl x:Class="Module.Views.CadAlignmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:conv="clr-namespace:Module.Converters"
             xmlns:controls="clr-namespace:Module.Controls"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <conv:StepBgConverter x:Key="StepBgConverter"/>
        <conv:StepCompletedBorderConverter x:Key="StepCompletedBorderConverter"/>
        <conv:IntMinusOneConverter x:Key="IntMinusOneConverter"/>
        <conv:StepTextBrushConv x:Key="StepTextBrushConv"/>
        <conv:BoolToShadowOpacity x:Key="BoolToShadowOpacity"/>
        <conv:StepDotColor1 x:Key="StepDotColor1"/>
        <conv:StepDotColor2 x:Key="StepDotColor2"/>
        <conv:StepDotColor3 x:Key="StepDotColor3"/>
        <conv:StepDotColor4 x:Key="StepDotColor4"/>
        <conv:StepDotColor5 x:Key="StepDotColor5"/>
        <conv:BoolToBackgroundConverter x:Key="BoolToBgConv"/>
        <conv:BoolToInverseBackgroundConverter x:Key="BoolToBgInvConv"/>
        <conv:BoolToInverseVisibilityConverter x:Key="BoolToCollapsedConv"/>
        <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVis"/>
        <conv:CanvasOffsetConverter x:Key="CanvasOffsetConverter"/>
        <conv:RoleVisibilityConverter x:Key="RoleVisibilityConverter"/>
        <conv:RoleTextConverter x:Key="RoleTextConverter"/>

        <!-- 结果数值展示卡片 -->
        <Style x:Key="ResultBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="#F5F7FA"/>
            <Setter Property="Width" Value="86"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 分区标题卡片：左侧彩色竖条 + 标题 -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,10,12,12"/>
        </Style>

        <!-- 基准位三列卡片 -->
        <Style x:Key="RefCard" TargetType="Border">
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <!-- 主操作按钮（蓝色强调） -->
        <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
        </Style>

        <!-- 次要操作按钮（轮廓） -->
        <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="5"/>
        </Style>

        <!-- 警告按钮（橙色强调） -->
        <Style x:Key="WarningActionButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════ Row 0: 步骤指示器 ═════════════════ -->
        <Border Grid.Row="0" Background="#FAFCFF"
                BorderBrush="#DDE3EB" BorderThickness="0,0,0,1.5" Padding="18,12,18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：工具标识 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="6" Padding="8,6"
                            VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AxisArrowInfo" Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{lang:Lang CadAlignment_Title}" FontWeight="Bold" FontSize="14"
                                   Foreground="#1A2332" LineHeight="16"/>
                        <TextBlock Text="{lang:Lang CadAlignment_Subtitle}" FontSize="9.5"
                                   Foreground="#8892A0" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 中间：步骤指示器 -->
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Steps}"
                              VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="10,0">
                                <Grid Width="36" Height="36" VerticalAlignment="Center">
                                    <Ellipse Fill="{Binding IsCurrent, Converter={StaticResource StepBgConverter}}"
                                             Stroke="{Binding IsCompleted, Converter={StaticResource StepCompletedBorderConverter}}"
                                             StrokeThickness="2.5">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#1976D2" BlurRadius="6" ShadowDepth="0"
                                                              Opacity="{Binding IsCurrent, Converter={StaticResource BoolToShadowOpacity}}"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Number}" Foreground="White"
                                               FontSize="13" FontWeight="ExtraBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding IsCurrent, Converter={StaticResource StepTextBrushConv}}"/>
                                    <TextBlock Text="{Binding Hint}" FontSize="9" Foreground="#95A0B0" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Border Width="44" Height="3" CornerRadius="1.5" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding ConnectorColor, FallbackValue=#D0D5DD}"
                                        Visibility="{Binding ShowConnector, Converter={StaticResource BoolToVis}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.15"/>
                                    </Border.Effect>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 右侧：状态徽章 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E8F5E9" CornerRadius="6" Padding="14,5"
                            VerticalAlignment="Center" BorderBrush="#C8E6C9" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#43A047" VerticalAlignment="Center">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.Opacity)"
                                                             From="1" To="0.3" Duration="0:0:1.5" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="{lang:Lang Maintenance_Status_Ready}" FontSize="11" Foreground="#2E7D32"
                                   VerticalAlignment="Center" FontWeight="Medium" Margin="6,0,0,0"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════ Row 1: Tab内容区(5个Tab) ═════════════════ -->
        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}"
                    Margin="0" Padding="0"
                    SelectedIndex="{Binding CurrentStep, Converter={StaticResource IntMinusOneConverter}, Mode=TwoWay}">

            <!-- ═════════════════ Tab 1 — 回转中心 ═════════════════ -->
            <TabItem Padding="0">
                <TabItem.Header>
                    <DockPanel Margin="14,10" LastChildFill="True">
                        <materialDesign:PackIcon Kind="CogOutline" Width="17" Height="17"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{lang:Lang Principle_Bar1}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                    </DockPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>

                        <!-- SectionCard 1: 四点拟合输入 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="TargetVariant" Width="18" Height="18"
                                                           Foreground="#1976D2" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang CadAlignment_RzFitTitle}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding FitPoints}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          materialDesign:DataGridAssist.CellPadding="4,2"
                                          MaxHeight="220" FontSize="10.5"
                                          BorderThickness="1"
                                          BorderBrush="#E0E0E0"
                                          RowBackground="White"
                                          AlternatingRowBackground="#FAFBFD"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#F0F0F0"
                                          HeadersVisibility="Column">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="Background" Value="#F5F6F8"/>
                                            <Setter Property="Foreground" Value="#555"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="10.5"/>
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Setter Property="SeparatorBrush" Value="#E0E0E0"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{lang:Lang CAD_Angle}" Binding="{Binding AngleLabel}" Width="*"/>
                                        <DataGridTextColumn Header="{lang:Lang CAD_Fit_X}" Binding="{Binding FitX}" Width="*"/>
                                        <DataGridTextColumn Header="{lang:Lang CAD_Fit_Y}" Binding="{Binding FitY}" Width="*"/>
                                        <DataGridTemplateColumn Header="{lang:Lang WaypointEdit_Column_Actions}" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.TeachFitPointCommand,
                                                                RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding Index}"
                                                            Style="{StaticResource SecondaryActionButton}"
                                                            Padding="6,2" FontSize="9"
                                                            ToolTip="{lang:Lang CadAlignment_TeachAngleTip}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="CrosshairsGps" Width="12" Height="12"
                                                                                     VerticalAlignment="Center"/>
                                                            <TextBlock Text="{lang:Lang AssemblyStep_Button_Teach}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="9"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <DockPanel Margin="0,10,0,0">
                                    <Button Command="{Binding ShowPrincipleCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="10,4"
                                            ToolTip="{lang:Lang CadAlignment_PrincipleTip}"
                                            materialDesign:ButtonAssist.CornerRadius="6"
                                            BorderBrush="#E3F2FD" Background="#E3F2FD"
                                            DockPanel.Dock="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ImageOutline" Width="16" Height="16"
                                                                     Foreground="#1565C0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang CadAlignment_PrincipleBtn}" Foreground="#1565C0" FontSize="11"
                                                       FontWeight="Medium" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding FitRotationCenterCommand}"
                                            Style="{StaticResource PrimaryActionButton}"
                                            HorizontalAlignment="Right">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="RotateRight" Width="15" Height="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang Principle_Step1}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- SectionCard 2: 拟合结果 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="CheckDecagram" Width="18" Height="18"
                                                           Foreground="#388E3C" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang CadAlignment_FitResultTitle}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Mox" FontSize="10" Foreground="#888" Margin="0,0,0,3"/>
                                        <Border Style="{StaticResource ResultBorder}">
                                            <TextBlock Text="{Binding Mox, StringFormat=N3}" HorizontalAlignment="Right" FontWeight="Medium" FontSize="12" Foreground="#1565C0"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{lang:Lang CadAlignment_LabelMoy}" FontSize="10" Foreground="#888" Margin="0,0,0,3"/>
                                        <Border Style="{StaticResource ResultBorder}">
                                            <TextBlock Text="{Binding Moy, StringFormat=N3}" HorizontalAlignment="Right" FontWeight="Medium" FontSize="12" Foreground="#1565C0"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="FitRadius" FontSize="10" Foreground="#888" Margin="0,0,0,3"/>
                                        <Border Style="{StaticResource ResultBorder}">
                                            <TextBlock Text="{Binding FitRadius, StringFormat=N3}" HorizontalAlignment="Right" FontWeight="Medium" FontSize="12" Foreground="#1565C0"/>
                                        </Border>
                                    </StackPanel>
                                </WrapPanel>
                                <Border Background="#FFF8E1" CornerRadius="5" Padding="10,5" BorderBrush="#FFE082" BorderThickness="1">
                                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontStyle="Italic" Foreground="#F57C00"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SectionCard 3: 拟合点与回转中心可视化画布 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="ChartScatterPlot" Width="18" Height="18"
                                                           Foreground="#1565C0" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang CAD_RotationCenter_VisualTitle}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>
                                <!-- 图例 -->
                                <WrapPanel Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Ellipse Width="8" Height="8" Fill="#1976D2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{lang:Lang CAD_RotationCenter_LegendFit}" FontSize="10" Foreground="#666" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                        <Line X1="0" Y1="4" X2="10" Y2="4" Stroke="#E53935" StrokeThickness="2" Margin="0,0,4,0"/>
                                        <TextBlock Text="{lang:Lang CAD_RotationCenter_LegendCenter}" FontSize="10" Foreground="#666" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="10" Height="10" Stroke="#1976D2" StrokeThickness="1" StrokeDashArray="3 2" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{lang:Lang CAD_RotationCenter_LegendCircle}" FontSize="10" Foreground="#666" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </WrapPanel>
                                <!-- 画布 -->
                                <Border Background="#FAFAFA" CornerRadius="5" BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Canvas x:Name="RotationCenterCanvas" Height="260" ClipToBounds="True"
                                            SizeChanged="RotationCenterCanvas_SizeChanged">
                                        <!-- 拟合圆（虚线） -->
                                        <Ellipse Canvas.Left="{Binding CircleCanvasLeft}"
                                                 Canvas.Top="{Binding CircleCanvasTop}"
                                                 Width="{Binding CircleDiameter}"
                                                 Height="{Binding CircleDiameter}"
                                                 Stroke="#1976D2" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="Transparent">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRotationCenterVisual}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <!-- 回转中心十字线 -->
                                        <Line X1="{Binding CenterScreenX, Converter={StaticResource CanvasOffsetConverter}, ConverterParameter=-12}"
                                              Y1="{Binding CenterScreenY}"
                                              X2="{Binding CenterScreenX, Converter={StaticResource CanvasOffsetConverter}, ConverterParameter=12}"
                                              Y2="{Binding CenterScreenY}"
                                              Stroke="#E53935" StrokeThickness="2"/>
                                        <Line X1="{Binding CenterScreenX}"
                                              Y1="{Binding CenterScreenY, Converter={StaticResource CanvasOffsetConverter}, ConverterParameter=-12}"
                                              X2="{Binding CenterScreenX}"
                                              Y2="{Binding CenterScreenY, Converter={StaticResource CanvasOffsetConverter}, ConverterParameter=12}"
                                              Stroke="#E53935" StrokeThickness="2"/>
                                        <!-- 回转中心坐标标签 -->
                                        <Border Canvas.Left="{Binding CenterScreenX, Converter={StaticResource CanvasOffsetConverter}, ConverterParameter=14}"
                                                Canvas.Top="{Binding CenterScreenY, Converter={StaticResource CanvasOffsetConverter}, ConverterParameter=-18}"
                                                Background="White" CornerRadius="3" Padding="4,1" BorderBrush="#E53935" BorderThickness="0.5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRotationCenterVisual}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="9" Foreground="#E53935" FontWeight="Medium">
                                                <Run Text="M("/><Run Text="{Binding Mox, StringFormat=F1, Mode=OneWay}"/><Run Text=", "/><Run Text="{Binding Moy, StringFormat=F1, Mode=OneWay}"/><Run Text=")"/>
                                            </TextBlock>
                                        </Border>
                                        <!-- 拟合点 -->
                                        <ItemsControl ItemsSource="{Binding VisualFitPoints}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Canvas/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Width="30" Height="30">
                                                        <Ellipse Width="8" Height="8" Fill="#1976D2" Stroke="White" StrokeThickness="1.5"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Label}" FontSize="8" Foreground="#1976D2" FontWeight="Medium"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="Canvas.Left" Value="{Binding ScreenX, Converter={StaticResource CanvasOffsetConverter}, ConverterParameter=-15}"/>
                                                    <Setter Property="Canvas.Top" Value="{Binding ScreenY, Converter={StaticResource CanvasOffsetConverter}, ConverterParameter=-15}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                        </ItemsControl>
                                    </Canvas>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SectionCard 4: 公式说明 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="18" Height="18"
                                                           Foreground="#78909C" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang CadAlignment_FormulaDesc}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Background="#F5F5F5" CornerRadius="5" Padding="12,10">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#CE93D8" LineHeight="16">
                                        <Run Text="{DynamicResource CAD_Fit_Algorithm_Desc}"/><LineBreak/>
                                        <Run Text="{DynamicResource CAD_Fit_Principle}"/><LineBreak/>
                                        <Run Text="{DynamicResource CAD_Fit_Note}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═════════════════ Tab 2 — 全局偏移 ═════════════════ -->
            <TabItem Padding="0">
                <TabItem.Header>
                    <DockPanel Margin="14,10" LastChildFill="True">
                        <materialDesign:PackIcon Kind="ArrowExpandHorizontal" Width="17" Height="17"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{lang:Lang Principle_Bar2}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                    </DockPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>

                        <!-- N点仿射标定模式提示（固定使用仿射模式） -->
                        <Border Background="#F3E5F5" CornerRadius="5" Padding="10,8" BorderBrush="#CE93D8" BorderThickness="1" Margin="0,0,0,10">
                            <DockPanel>
                                <materialDesign:PackIcon Kind="GridLarge" Width="16" Height="16"
                                                       Foreground="#7B1FA2" VerticalAlignment="Center"
                                                       DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                <TextBlock Text="{lang:Lang CAD_AffineMode_Title}" FontSize="11" FontWeight="SemiBold" Foreground="#6A1B9A" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <!-- SectionCard: N点仿射标定模式 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="GridLarge" Width="18" Height="18"
                                                           Foreground="#7B1FA2" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang CAD_AffineMode_Title}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Background="#F3E5F5" CornerRadius="5" Padding="10,6" BorderBrush="#CE93D8" BorderThickness="1" Margin="0,0,0,10">
                                    <TextBlock Text="{lang:Lang CAD_AffineMode_Hint}" TextWrapping="Wrap" FontSize="11" Foreground="#6A1B9A" LineHeight="15"/>
                                </Border>
                                <DataGrid ItemsSource="{Binding AffineCalibrationPoints}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          materialDesign:DataGridAssist.CellPadding="4,2"
                                          MaxHeight="220" FontSize="10.5"
                                          BorderThickness="1" BorderBrush="#E0E0E0"
                                          RowBackground="White" AlternatingRowBackground="#FAFBFD">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                            <Setter Property="Background" Value="#F5F6F8"/>
                                            <Setter Property="Foreground" Value="#555"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="FontSize" Value="10.5"/>
                                            <Setter Property="Padding" Value="8,5"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{lang:Lang CadAlignment_PointName}" Binding="{Binding Name}" Width="50" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="CAD_X" Binding="{Binding CadX, StringFormat=N3}" Width="*"/>
                                        <DataGridTextColumn Header="CAD_Y" Binding="{Binding CadY, StringFormat=N3}" Width="*"/>
                                        <DataGridTextColumn Header="{lang:Lang CAD_Machine_X}" Binding="{Binding MachineX, StringFormat=N3}" Width="*"/>
                                        <DataGridTextColumn Header="{lang:Lang CAD_Machine_Y}" Binding="{Binding MachineY, StringFormat=N3}" Width="*"/>
                                        <DataGridTextColumn Header="{lang:Lang CAD_Affine_Residual}" Binding="{Binding Residual, StringFormat=N4}" Width="65" IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="{lang:Lang WaypointEdit_Column_Actions}" Width="70">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Command="{Binding DataContext.TeachAffineMachineCoordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryActionButton}"
                                                            Padding="4,2" FontSize="9">
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="CrosshairsGps" Width="12" Height="12" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{lang:Lang CadAlignment_Teach}" VerticalAlignment="Center" FontSize="9" Margin="3,0,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,8">
                                    <Button Command="{Binding AddAffineCalibrationPointCommand}" Style="{StaticResource SecondaryActionButton}" Padding="8,3">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="PlusCircleOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang CadAlignment_AddPoint}" VerticalAlignment="Center" FontSize="10" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{lang:Lang CAD_Affine_NeedMin3}" VerticalAlignment="Center" FontSize="10" Foreground="#888" Margin="12,0,0,0"/>
                                </StackPanel>
                                <Border Background="#F3E5F5" CornerRadius="5" Padding="12,8" BorderBrush="#CE93D8" BorderThickness="1"
                                        Visibility="{Binding Step2Done, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{lang:Lang CAD_Affine_Params}" FontWeight="SemiBold" FontSize="11" Foreground="#4A148C" Margin="0,0,0,6"/>
                                        <WrapPanel>
                                            <StackPanel Margin="0,0,10,6">
                                                <TextBlock Text="A" FontSize="9" Foreground="#888" Margin="0,0,0,2"/>
                                                <Border Style="{StaticResource ResultBorder}" Width="85">
                                                    <TextBlock Text="{Binding AffineA, StringFormat=N6}" HorizontalAlignment="Right" FontSize="11" Foreground="#6A1B9A"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,6">
                                                <TextBlock Text="B" FontSize="9" Foreground="#888" Margin="0,0,0,2"/>
                                                <Border Style="{StaticResource ResultBorder}" Width="85">
                                                    <TextBlock Text="{Binding AffineB, StringFormat=N6}" HorizontalAlignment="Right" FontSize="11" Foreground="#6A1B9A"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,6">
                                                <TextBlock Text="C" FontSize="9" Foreground="#888" Margin="0,0,0,2"/>
                                                <Border Style="{StaticResource ResultBorder}" Width="85">
                                                    <TextBlock Text="{Binding AffineC, StringFormat=N6}" HorizontalAlignment="Right" FontSize="11" Foreground="#6A1B9A"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,6">
                                                <TextBlock Text="D" FontSize="9" Foreground="#888" Margin="0,0,0,2"/>
                                                <Border Style="{StaticResource ResultBorder}" Width="85">
                                                    <TextBlock Text="{Binding AffineD, StringFormat=N6}" HorizontalAlignment="Right" FontSize="11" Foreground="#6A1B9A"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,6">
                                                <TextBlock Text="Tx" FontSize="9" Foreground="#888" Margin="0,0,0,2"/>
                                                <Border Style="{StaticResource ResultBorder}" Width="85">
                                                    <TextBlock Text="{Binding AffineTx, StringFormat=N3}" HorizontalAlignment="Right" FontSize="11" Foreground="#6A1B9A"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,6">
                                                <TextBlock Text="Ty" FontSize="9" Foreground="#888" Margin="0,0,0,2"/>
                                                <Border Style="{StaticResource ResultBorder}" Width="85">
                                                    <TextBlock Text="{Binding AffineTy, StringFormat=N3}" HorizontalAlignment="Right" FontSize="11" Foreground="#6A1B9A"/>
                                                </Border>
                                            </StackPanel>
                                        </WrapPanel>
                                        <WrapPanel Margin="0,4,0,0">
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="{lang:Lang CAD_Affine_RMS}" FontSize="9" Foreground="#888" Margin="0,0,0,2"/>
                                                <Border Style="{StaticResource ResultBorder}" Width="85">
                                                    <TextBlock Text="{Binding AffineRmsError, StringFormat=N4}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11" Foreground="#C62828"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,14,0">
                                                <TextBlock Text="θ (equiv)" FontSize="9" Foreground="#888" Margin="0,0,0,2"/>
                                                <Border Style="{StaticResource ResultBorder}" Width="85">
                                                    <TextBlock HorizontalAlignment="Right" FontSize="11" Foreground="#6A1B9A">
                                                        <Run Text="{Binding AffineRotDeg, StringFormat=N3, Mode=OneWay}"/><Run Text="°"/>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="{lang:Lang CadAlignment_QualityLabel}" FontSize="9" Foreground="#888" Margin="0,0,0,2"/>
                                                <Border Style="{StaticResource ResultBorder}" Width="110">
                                                    <TextBlock Text="{Binding AffineQualityText}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="#2E7D32"/>
                                                </Border>
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <!-- 计算全局偏移按钮 -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Command="{Binding ComputeGlobalOffsetCommand}"
                                            Style="{StaticResource PrimaryActionButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ArrowExpandHorizontal" Width="15" Height="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang Principle_Step2}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═════════════════ Tab 3 — 旋转角度 ═════════════════ -->
            <TabItem Padding="0">
                <TabItem.Header>
                    <DockPanel Margin="14,10" LastChildFill="True">
                        <materialDesign:PackIcon Kind="AngleAcute" Width="17" Height="17"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{lang:Lang Principle_Bar3}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                    </DockPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>

                        <!-- SectionCard 1: 点对选择 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="CompassOutline" Width="18" Height="18"
                                                           Foreground="#7B1FA2" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang CAD_Vector_Angle_Title}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- ① 导入DXF文件 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button Command="{Binding ImportDxfCommand}" Style="{StaticResource SecondaryActionButton}" Padding="8,3">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="FileImportOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang CAD_Import_DXF_Btn}" VerticalAlignment="Center" FontSize="11" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding AutoRecommendLinesCommand}" Style="{StaticResource SecondaryActionButton}" Padding="8,3"
                                            Margin="6,0,0,0"
                                            Visibility="{Binding HasCadDrawingLoaded, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="LightbulbOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang CAD_Smart_Recommend}" VerticalAlignment="Center" FontSize="11" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{Binding CadFilePath}" Foreground="#666" FontSize="10"
                                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding CadFilePath, Converter={StaticResource StringNotEmptyToVis}}"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 基准线段 -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang CadAlignment_BaselineLabel}" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#555" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BaselineDisplayText}"
                                               FontSize="11" VerticalAlignment="Center" Foreground="#1565C0"
                                               FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                               materialDesign:HintAssist.Hint="选取后显示坐标"/>
                                    <Button Grid.Row="0" Grid.Column="2" Command="{Binding PickBaselineFromCadCommand}"
                                            Style="{StaticResource SecondaryActionButton}" Padding="8,3" Margin="6,0,0,0"
                                            ToolTip="{lang:Lang CadAlignment_PickBaselineTip}"
                                            IsEnabled="{Binding HasCadDrawingLoaded}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CrosshairsGps" Width="13" Height="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang CadAlignment_PickFromCad}" VerticalAlignment="Center" FontSize="10" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="0" Grid.Column="3" Command="{Binding ShowBaselineSegmentCommand}"
                                            Style="{StaticResource SecondaryActionButton}" Padding="8,3" Margin="4,0,0,0"
                                            ToolTip="{lang:Lang CadAlignment_ShowSegmentTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="13" Height="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang CadAlignment_ShowSegment}" VerticalAlignment="Center" FontSize="10" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- 目标线段 -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang CadAlignment_TargetlineLabel}" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#555" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TargetlineDisplayText}"
                                               FontSize="11" VerticalAlignment="Center" Foreground="#C62828"
                                               FontWeight="Medium" TextTrimming="CharacterEllipsis"
                                               materialDesign:HintAssist.Hint="选取后显示坐标"/>
                                    <Button Grid.Row="1" Grid.Column="2" Command="{Binding PickTargetFromCadCommand}"
                                            Style="{StaticResource SecondaryActionButton}" Padding="8,3" Margin="6,0,0,0"
                                            ToolTip="{lang:Lang CadAlignment_PickTargetTip}"
                                            IsEnabled="{Binding HasCadDrawingLoaded}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="VectorIntersection" Width="13" Height="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang CadAlignment_PickFromCad}" VerticalAlignment="Center" FontSize="10" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Row="1" Grid.Column="3" Command="{Binding ShowTargetlineSegmentCommand}"
                                            Style="{StaticResource SecondaryActionButton}" Padding="8,3" Margin="4,0,0,0"
                                            ToolTip="{lang:Lang CadAlignment_ShowSegmentTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="13" Height="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang CadAlignment_ShowSegment}" VerticalAlignment="Center" FontSize="10" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 选取状态提示 -->
                                <TextBlock Text="{Binding CadPickStatus}" FontSize="10" FontStyle="Italic"
                                           Foreground="#FF5722" HorizontalAlignment="Left" Margin="0,4,0,0"
                                           TextWrapping="Wrap" MaxWidth="500" LineHeight="15"/>

                                <!-- CAD 图形预览与交互选取区域 (仅导入后显示) -->
                                <Border Style="{StaticResource RefCard}" Margin="0,8,0,0"
                                              Visibility="{Binding HasCadDrawingLoaded, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" FontSize="10.5" Foreground="#555" Margin="0,0,0,6">
                                                        <Run Text="{lang:Lang CadAlignment_CADPreview}"/>
                                                        <Run Foreground="#7B1FA2" FontWeight="SemiBold" Text="{lang:Lang CAD_Pick_Points_Hint}"/>
                                        </TextBlock>

                                        <!-- 图形区域：靠左 + 固定尺寸 -->
                                        <controls:HalconCanvasControl Grid.Row="1"
                                                                                                x:Name="alignmentCanvas"
                                                                                                Height="260"
                                                                                                Width="480"
                                                                                                HorizontalAlignment="Left"
                                                                                                Entities="{Binding CanvasDisplayEntities}"
                                                                                                SelectedSegmentPoints="{Binding CadSelectedSegmentPoints}"
                                                                                                SelectedPointIndex="{Binding CadSelectedPointIndex}"
                                                                                                Loaded="OnCanvasLoaded"/>
                                    </Grid>
                                </Border>

                                <!-- 导入点位摘要 DataGrid (仅导入后显示) -->
                                <Border Style="{StaticResource RefCard}" Margin="0,8,0,0"
                                        Visibility="{Binding HasCadDrawingLoaded, Converter={StaticResource BoolToVis}}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" FontSize="10.5" Foreground="#555" Margin="0,0,0,6">
                                            <Run Text="{lang:Lang CadAlignment_SelectedPointsSummary}"/>
                                            <Run Foreground="#7B1FA2" FontWeight="SemiBold" Text="{lang:Lang CAD_Click_Row_Hint}"/>
                                        </TextBlock>
                                        <DataGrid ItemsSource="{Binding ImportedCadPoints}"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                  IsReadOnly="True" SelectionMode="Single"
                                                  SelectedItem="{Binding SelectedCadPoint, Mode=TwoWay}"
                                                  Height="180" FontSize="10.5" RowHeight="29"
                                                  BorderThickness="1" BorderBrush="#E0E0E0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="40"/>
                                                <DataGridTextColumn Header="CAD_X" Binding="{Binding X, StringFormat=F2}" Width="72"/>
                                                <DataGridTextColumn Header="CAD_Y" Binding="{Binding Y, StringFormat=F2}" Width="72"/>
                                                <DataGridTextColumn Header="{lang:Lang CAD_Machine_X}" Binding="{Binding MachineX, StringFormat=F2, TargetNullValue=''}" Width="80"/>
                                                <DataGridTextColumn Header="{lang:Lang CAD_Machine_Y}" Binding="{Binding MachineY, StringFormat=F2, TargetNullValue=''}" Width="80"/>
                                                <!-- Img Col / Img Row 列：使用TemplateColumn确保nullable double正确显示 -->
                                                <DataGridTemplateColumn Header="{lang:Lang CAD_Image_Col}" Width="58">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Text="{Binding ImageCol, StringFormat=F1}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="{lang:Lang CAD_Image_Row}" Width="58">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Text="{Binding ImageRow, StringFormat=F1}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!-- Base_Start 列：仅在AssySite匹配"基准起点"时显示 -->
                                                <DataGridTemplateColumn Header="{lang:Lang CAD_Base_Start}" Width="62">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       FontWeight="Bold" FontSize="10" Foreground="#1565C0"
                                                                       Text="{Binding AssySite, Converter={StaticResource RoleTextConverter}, ConverterParameter=Base_Start}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!-- Base_End 列 -->
                                                <DataGridTemplateColumn Header="{lang:Lang CAD_Base_End}" Width="62">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       FontWeight="Bold" FontSize="10" Foreground="#2E7D32"
                                                                       Text="{Binding AssySite, Converter={StaticResource RoleTextConverter}, ConverterParameter=Base_End}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!-- Target_Start 列 -->
                                                <DataGridTemplateColumn Header="{lang:Lang CAD_Target_Start}" Width="62">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       FontWeight="Bold" FontSize="10" Foreground="#7B1FA2"
                                                                       Text="{Binding AssySite, Converter={StaticResource RoleTextConverter}, ConverterParameter=Target_Start}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <!-- Target_End 列 -->
                                                <DataGridTemplateColumn Header="{lang:Lang CAD_Target_End}" Width="62">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       FontWeight="Bold" FontSize="10" Foreground="#C62828"
                                                                       Text="{Binding AssySite, Converter={StaticResource RoleTextConverter}, ConverterParameter=Target_End}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>

                                <!-- 已选点位变换坐标摘要（仅4点都选取后显示） -->
                                <Border Style="{StaticResource RefCard}" Margin="0,8,0,0"
                                        Visibility="{Binding HasStep3TransformResult, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="14" Height="14"
                                                                     Foreground="#388E3C" VerticalAlignment="Center"
                                                                     Margin="0,0,6,0"/>
                                            <TextBlock Text="{lang:Lang CadAlignment_TransformSummaryTitle}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="#388E3C" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang CAD_Base_Start}" FontSize="10"
                                                       Foreground="#1565C0" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,0,6,4"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding BaseStartTransformedText}"
                                                       FontSize="10" Foreground="#555" TextWrapping="Wrap" LineHeight="14"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang CAD_Base_End}" FontSize="10"
                                                       Foreground="#2E7D32" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,0,6,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BaseEndTransformedText}"
                                                       FontSize="10" Foreground="#555" TextWrapping="Wrap" LineHeight="14"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang CAD_Target_Start}" FontSize="10"
                                                       Foreground="#7B1FA2" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,0,6,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TargetStartTransformedText}"
                                                       FontSize="10" Foreground="#555" TextWrapping="Wrap" LineHeight="14"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{lang:Lang CAD_Target_End}" FontSize="10"
                                                       Foreground="#C62828" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,0,6,4"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TargetEndTransformedText}"
                                                       FontSize="10" Foreground="#555" TextWrapping="Wrap" LineHeight="14"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding ComputeCadRotationAngleCommand}"
                                            Style="{StaticResource PrimaryActionButton}" Margin="0,6,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AngleAcute" Width="15" Height="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang Principle_Step3}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SectionCard 2: 角度结果 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="ChartArc" Width="18" Height="18"
                                                           Foreground="#388E3C" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang CadAlignment_AngleResultTitle}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>
                                <WrapPanel Margin="0,0,0,10">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{lang:Lang CadAlignment_LabelAlphaBaseDeg}" FontSize="10" Foreground="#888" Margin="0,0,0,3"/>
                                        <Border Style="{StaticResource ResultBorder}" Width="100">
                                            <TextBlock HorizontalAlignment="Right" FontWeight="Medium" FontSize="12" Foreground="#1565C0">
                                                <Run Text="{Binding AlphaBaseDeg, StringFormat=N3, Mode=OneWay}"/><Run Text="°"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="{lang:Lang CadAlignment_LabelAlphaTargetDeg}" FontSize="10" Foreground="#888" Margin="0,0,0,3"/>
                                        <Border Style="{StaticResource ResultBorder}" Width="100">
                                            <TextBlock HorizontalAlignment="Right" FontWeight="Medium" FontSize="12" Foreground="#1565C0">
                                                <Run Text="{Binding AlphaTargetDeg, StringFormat=N3, Mode=OneWay}"/><Run Text="°"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </WrapPanel>
                                <!-- ThetaDeg 大字高亮 -->
                                <Border Background="#E8F5E9" CornerRadius="6" Padding="14,10"
                                        BorderBrush="#A5D6A7" BorderThickness="1.5" Margin="0,0,0,10">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{lang:Lang CadAlignment_ThetaLabel}" FontSize="11" Foreground="#2E7D32"
                                                   HorizontalAlignment="Center" FontWeight="Medium" Margin="0,0,0,4"/>
                                        <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="ExtraBold"
                                                   Foreground="#1B5E20">
                                            <Run Text="{Binding ThetaDeg, StringFormat=N3, Mode=OneWay}"/><Run Text="°"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{lang:Lang CadAlignment_ThetaDirectionHint}" FontSize="11" FontStyle="Italic"
                                           Foreground="#666" HorizontalAlignment="Center"/>

                                <!-- 产品对齐角度 + 移动目标角度 -->
                                <Border Background="#E3F2FD" CornerRadius="6" Padding="14,10"
                                        BorderBrush="#90CAF9" BorderThickness="1.5" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{lang:Lang CAD_Align_Angle_Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#1565C0" Margin="0,0,0,8"/>
                                        <!-- 对齐角度：手动输入 + 全局变量链接 -->
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{lang:Lang CAD_Align_Angle_Title}" FontSize="11"
                                                       Foreground="#555" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                            <TextBox Grid.Column="1" Text="{Binding AlignmentAngle, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}"
                                                     FontSize="11" materialDesign:HintAssist.Hint="°" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="°" FontSize="12" Foreground="#888" VerticalAlignment="Center" Margin="4,0,8,0"/>
                                            <common:GlobalVariableLinkControl Grid.Column="3"
                                                DisplayValue="{Binding AlignmentAngle, Mode=OneWay}"
                                                DisplayForeground="#1565C0"
                                                IsLinked="{Binding IsAlignmentAngleLinked}"
                                                UnlinkCommand="{Binding UnlinkAlignmentAngleCommand}"
                                                LinkedVariableName="{Binding AlignmentAngleLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                                LinkableGlobalVariables="{Binding LinkableGlobalVariables}"
                                                ComboBoxWidth="160"/>
                                        </Grid>
                                        <!-- 产品旋转角度显示 -->
                                        <WrapPanel Margin="0,0,0,8">
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{lang:Lang CAD_Product_Rotation_Angle}" FontSize="10" Foreground="#888" Margin="0,0,0,3"/>
                                                <Border Style="{StaticResource ResultBorder}" Width="120">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding ProductRotationAngle, StringFormat=N3}" FontWeight="Bold" FontSize="12" Foreground="#E65100"/>
                                                        <TextBlock Text="°" FontWeight="Bold" FontSize="12" Foreground="#E65100"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </WrapPanel>
                                        <TextBlock Text="{lang:Lang CAD_Align_Angle_Hint}" FontSize="10" Foreground="#666" FontStyle="Italic" Margin="0,0,0,8"/>
                                        <!-- 移动目标角度按钮 -->
                                        <Button Command="{Binding MoveTargetAngleCommand}"
                                                Style="{StaticResource WarningActionButton}"
                                                HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AxisArrow" Width="15" Height="15" VerticalAlignment="Center"/>
                                                <TextBlock Text="{lang:Lang CAD_Move_Target_Angle}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SectionCard 3: 公式参考 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="CalculatorVariant" Width="18" Height="18"
                                                           Foreground="#546E7A" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang CadAlignment_FormulaRef}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Background="#F5F5F5" CornerRadius="5" Padding="12,10">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555" LineHeight="17" FontFamily="Consolas,Microsoft YaHei UI">
                                        <Run Text="{DynamicResource CAD_Formula_Theta}"/><LineBreak/>
                                        <Run Text="{DynamicResource CAD_Formula_Alpha}"/><LineBreak/>
                                        <Run Text="{DynamicResource CAD_Formula_DyDx}"/><LineBreak/>
                                        <Run Text="{DynamicResource CAD_Formula_Atan2_Range}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═════════════════ Tab 4 — 坐标变换 ═════════════════ -->
            <TabItem Padding="0">
                <TabItem.Header>
                    <DockPanel Margin="14,10" LastChildFill="True">
                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="17" Height="17"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{lang:Lang Principle_Bar4}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                    </DockPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>

                        <!-- SectionCard 1: 点位选择与输入 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="ArrowRightBoldHexagonOutline" Width="18" Height="18"
                                                           Foreground="#1565C0" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang CadAlignment_TransformTitle}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Command="{Binding InheritTargetFromStep3Command}"
                                            Style="{StaticResource SecondaryActionButton}" Padding="8,3"
                                            ToolTip="自动使用步骤3的目标线段起点作为变换目标"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ArrowDownBoldHexagonOutline" Width="13" Height="13"
                                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang CadAlignment_UseStep3Target}" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- X/Y/θ角度取反开关 -->
                                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                                        <ToggleButton IsChecked="{Binding InvertXAngle}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{lang:Lang CAD_InvertXAngle}" FontSize="10" Foreground="#888" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        <ToggleButton IsChecked="{Binding InvertYAngle}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <TextBlock Text="{lang:Lang CAD_InvertYAngle}" FontSize="10" Foreground="#888" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        <ToggleButton IsChecked="{Binding InvertThetaAngle}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                        <TextBlock Text="{lang:Lang CAD_InvertThetaAngle}" FontSize="10" Foreground="#888" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- 目标位坐标显示 -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang CadAlignment_CADCoord}" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="0,0,8,4" Foreground="#555" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Step4TargetCadText}"
                                               FontSize="11" VerticalAlignment="Center" Foreground="#7B1FA2" FontWeight="Medium"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Cad_AfterTranslateLabel}" FontSize="11.5"
                                               VerticalAlignment="Center" Margin="0,0,8,4" Foreground="#555" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Step4TargetOffsetText}"
                                               FontSize="11" VerticalAlignment="Center" Foreground="#1565C0" FontWeight="Medium"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Command="{Binding ExecuteTransformCommand}"
                                            Style="{StaticResource PrimaryActionButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="15" Height="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang CadAlignment_SingleTransform}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SectionCard 2: 中间过程展示 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="CalculatorVariant" Width="18" Height="18"
                                                           Foreground="#00838F" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang CAD_Transform_Process}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>
                                <!-- 行1: 未旋转机械坐标 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{lang:Lang CAD_Step1_Unrotated}" FontSize="10.5" Foreground="#777" VerticalAlignment="Center" Width="110" FontWeight="Medium"/>
                                    <Border Style="{StaticResource ResultBorder}" Margin="6,0,6,0">
                                        <TextBlock HorizontalAlignment="Right" FontWeight="Medium" FontSize="11.5" Foreground="#1565C0">
                                            <Run Text="Xm="/><Run Text="{Binding TransXm, StringFormat=N3, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Style="{StaticResource ResultBorder}">
                                        <TextBlock HorizontalAlignment="Right" FontWeight="Medium" FontSize="11.5" Foreground="#1565C0">
                                            <Run Text="Ym="/><Run Text="{Binding TransYm, StringFormat=N3, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <!-- 行2: 相对中心偏移 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{lang:Lang CAD_Step2_Relative_Offset}" FontSize="10.5" Foreground="#777" VerticalAlignment="Center" Width="110" FontWeight="Medium"/>
                                    <Border Style="{StaticResource ResultBorder}" Margin="6,0,6,0">
                                        <TextBlock HorizontalAlignment="Right" FontWeight="Medium" FontSize="11.5" Foreground="#1565C0">
                                            <Run Text="dx="/><Run Text="{Binding TransDx, StringFormat=N3, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Style="{StaticResource ResultBorder}">
                                        <TextBlock HorizontalAlignment="Right" FontWeight="Medium" FontSize="11.5" Foreground="#1565C0">
                                            <Run Text="dy="/><Run Text="{Binding TransDy, StringFormat=N3, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <!-- 行3: 旋转角度 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{lang:Lang CAD_Step3_Rotation_Angle}" FontSize="10.5" Foreground="#777" VerticalAlignment="Center" Width="110" FontWeight="Medium"/>
                                    <Border Style="{StaticResource ResultBorder}" Width="Auto" MinWidth="86" Margin="6,0,6,0">
                                        <TextBlock HorizontalAlignment="Center" FontWeight="Medium" FontSize="11.5" Foreground="#1565C0">
                                            <Run Text="θ = "/><Run Text="{Binding ThetaDeg, StringFormat=N3}"/><Run Text="°"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <!-- 行4: 最终结果 - 绿色高亮 -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{lang:Lang CAD_Step4_Final_Result}" FontSize="10.5" Foreground="#2E7D32" VerticalAlignment="Center" Width="110" FontWeight="SemiBold"/>
                                    <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                                            CornerRadius="4" Padding="6,3" Margin="6,0,6,0">
                                        <TextBlock HorizontalAlignment="Right" FontWeight="Bold" FontSize="12.5" Foreground="#1B5E20">
                                            <Run Text="X="/><Run Text="{Binding TransResultX, StringFormat=N3, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <Border Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1"
                                            CornerRadius="4" Padding="6,3">
                                        <TextBlock HorizontalAlignment="Right" FontWeight="Bold" FontSize="12.5" Foreground="#1B5E20">
                                            <Run Text="Y="/><Run Text="{Binding TransResultY, StringFormat=N3, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Border>
                                    <!-- 移动目标位按钮 -->
                                    <Button Command="{Binding MoveTargetPositionCommand}"
                                            Style="{StaticResource WarningActionButton}"
                                            Margin="12,0,0,0" Padding="8,3">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="AxisArrow" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang CAD_Move_Target_Position}" Margin="5,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SectionCard 3: 变换公式卡片 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <materialDesign:PackIcon Kind="CalculatorVariant" Width="18" Height="18"
                                                           Foreground="#455A64" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang CadAlignment_TransformFormulaTitle}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Border Background="#F5F5F5" CornerRadius="5" Padding="12,10">
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#555" LineHeight="17" FontFamily="Consolas,Microsoft YaHei UI">
                                        <Run Text="{lang:Lang CAD_Formula_Translate}"/><LineBreak/>
                                        <Run Text="{lang:Lang CAD_Formula_Relative}"/><LineBreak/>
                                        <Run Text="{DynamicResource CAD_Formula_RelativeY}"/><LineBreak/>
                                        <Run Text="{DynamicResource CAD_Formula_RotateX}"/><LineBreak/>
                                        <Run Text="{DynamicResource CAD_Formula_RotateY}"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═════════════════ Tab 5 — 夹爪定位 ═════════════════ -->
            <TabItem Padding="0">
                <TabItem.Header>
                    <DockPanel Margin="14,10" LastChildFill="True">
                        <materialDesign:PackIcon Kind="RobotIndustrial" Width="17" Height="17"
                                                 VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="{lang:Lang Principle_Bar5}" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold"/>
                    </DockPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>

                        <!-- SectionCard 1: 5步夹爪定位流程 -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <materialDesign:PackIcon Kind="RobotIndustrial" Width="18" Height="18"
                                                           Foreground="#3F51B5" VerticalAlignment="Center"
                                                           DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                    <TextBlock Text="{lang:Lang Principle_Step5}" FontWeight="Bold" FontSize="13"
                                               Foreground="#1A2332" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- ─── 基准点设置区 ─── -->
                                <Border Background="#E8EAF6" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Target" Width="14" Height="14" Foreground="#283593" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{lang:Lang CAD_Section_Ref_Setup}" FontSize="11" FontWeight="SemiBold" Foreground="#283593" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 步骤1：设置相机基准位 -->
                                <Border Background="#E3F2FD" CornerRadius="5" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#1565C0" VerticalAlignment="Center">
                                            <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{lang:Lang CAD_Camera_Ref_Position}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" FontSize="11" Foreground="#555" VerticalAlignment="Center">
                                            <Run Text="X="/><Run Text="{Binding CameraRefX, StringFormat=F3, Mode=OneWay}"/>
                                            <Run Text="  Y="/><Run Text="{Binding CameraRefY, StringFormat=F3, Mode=OneWay}"/>
                                            <Run Text="  Z="/><Run Text="{Binding CameraRefZ, StringFormat=F3, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Button Grid.Column="3" Command="{Binding SetCameraRefCommand}"
                                                Style="{StaticResource PrimaryActionButton}" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Target" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{lang:Lang CAD_Set_Camera_Ref}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 步骤2：示教夹爪基准位 -->
                                <Border Background="#F3E5F5" CornerRadius="5" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#7B1FA2" VerticalAlignment="Center">
                                            <TextBlock Text="2" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{lang:Lang CAD_Gripper_Ref_Position}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#7B1FA2" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" FontSize="11" Foreground="#555" VerticalAlignment="Center">
                                            <Run Text="X="/><Run Text="{Binding GripperRefX, StringFormat=F3, Mode=OneWay}"/>
                                            <Run Text="  Y="/><Run Text="{Binding GripperRefY, StringFormat=F3, Mode=OneWay}"/>
                                            <Run Text="  Z="/><Run Text="{Binding GripperRefZ, StringFormat=F3, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Button Grid.Column="3" Command="{Binding TeachGripperRefCommand}"
                                                Style="{StaticResource PrimaryActionButton}" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CrosshairsGps" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{lang:Lang CAD_Teach_Gripper_Ref}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ─── 位置计算区 ─── -->
                                <Border Background="#FFF8E1" CornerRadius="4" Padding="8,4" Margin="0,6,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CalculatorVariant" Width="14" Height="14" Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{lang:Lang CAD_Section_Position_Calc}" FontSize="11" FontWeight="SemiBold" Foreground="#E65100" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 步骤3：计算相机偏移 -->
                                <Border Background="#FFF3E0" CornerRadius="5" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#E65100" VerticalAlignment="Center">
                                            <TextBlock Text="3" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{lang:Lang CAD_Camera_Offset}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" FontSize="11" Foreground="#555" VerticalAlignment="Center">
                                            <Run Text="ΔX="/><Run Text="{Binding CameraOffsetX, StringFormat=F3, Mode=OneWay}"/>
                                            <Run Text="  ΔY="/><Run Text="{Binding CameraOffsetY, StringFormat=F3, Mode=OneWay}"/>
                                        </TextBlock>
                                        <Button Grid.Column="3" Command="{Binding CalcCameraOffsetCommand}"
                                                Style="{StaticResource SecondaryActionButton}" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CalculatorVariant" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{lang:Lang CAD_Calc_Camera_Offset}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 步骤4：计算夹爪最终位置 -->
                                <Border Background="#E8F5E9" CornerRadius="5" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#2E7D32" VerticalAlignment="Center">
                                            <TextBlock Text="4" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{lang:Lang CAD_Gripper_Final_Position}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock FontSize="11" Foreground="#1B5E20" FontWeight="Bold">
                                                <Run Text="X="/><Run Text="{Binding GripperFinalX, StringFormat=F3, Mode=OneWay}"/>
                                                <Run Text="  Y="/><Run Text="{Binding GripperFinalY, StringFormat=F3, Mode=OneWay}"/>
                                                <Run Text="  Z="/><Run Text="{Binding GripperFinalZ, StringFormat=F3, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="3" Command="{Binding CalcGripperFinalCommand}"
                                                Style="{StaticResource WarningActionButton}" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CalculatorVariant" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{lang:Lang CAD_Calc_Gripper_Final}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- 步骤5：写入全局变量 -->
                                <Border Background="#ECEFF1" CornerRadius="5" Padding="12,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="22" Height="22" CornerRadius="11" Background="#455A64" VerticalAlignment="Center">
                                            <TextBlock Text="5" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{lang:Lang CAD_Write_Global_Var}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="#455A64" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <!-- 全局变量链接控件 -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <common:GlobalVariableLinkControl
                                                DisplayValue="{Binding GripperFinalX}"
                                                DisplayForeground="#2E7D32"
                                                IsLinked="{Binding IsGripperXLinked}"
                                                UnlinkCommand="{Binding UnlinkGripperXCommand}"
                                                LinkedVariableName="{Binding FinalGripperXLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                                LinkableGlobalVariables="{Binding LinkableGlobalVariables}"
                                                ComboBoxWidth="160"/>
                                            <common:GlobalVariableLinkControl Margin="8,0,0,0"
                                                DisplayValue="{Binding GripperFinalY}"
                                                DisplayForeground="#2E7D32"
                                                IsLinked="{Binding IsGripperYLinked}"
                                                UnlinkCommand="{Binding UnlinkGripperYCommand}"
                                                LinkedVariableName="{Binding FinalGripperYLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                                LinkableGlobalVariables="{Binding LinkableGlobalVariables}"
                                                ComboBoxWidth="160"/>
                                            <common:GlobalVariableLinkControl Margin="8,0,0,0"
                                                DisplayValue="{Binding GripperFinalZ}"
                                                DisplayForeground="#2E7D32"
                                                IsLinked="{Binding IsGripperZLinked}"
                                                UnlinkCommand="{Binding UnlinkGripperZCommand}"
                                                LinkedVariableName="{Binding FinalGripperZLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                                LinkableGlobalVariables="{Binding LinkableGlobalVariables}"
                                                ComboBoxWidth="160"/>
                                        </StackPanel>
                                        <Button Grid.Column="3" Command="{Binding WriteToGlobalVariablesCommand}"
                                                Style="{StaticResource SecondaryActionButton}" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="DatabaseExport" Width="12" Height="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="{lang:Lang CAD_Write_Global_Var}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ════════════════ Row 2: 底部状态栏（含导航+5个进度圆点） ═════════════════ -->
        <StatusBar Grid.Row="2" Background="#263238" Padding="12,0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AxisArrowInfo" Width="14" Height="14" Foreground="#78909C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{lang:Lang Principle_Bar1}" Foreground="#CFD8DC" FontSize="11" FontWeight="Medium"/>
                    <Separator Margin="10,0" Foreground="#455A64"/>
                    <TextBlock Text="{lang:Lang CadAlignment_ManualCalibMode}" Foreground="#90A4AE" FontSize="10.5"/>
                </StackPanel>
            </StatusBarItem>

            <Separator Foreground="#37474F"/>

            <StatusBarItem HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">

                    <!-- 上一步 -->
                    <Button Command="{Binding GoPrevCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#B0BEC5"
                            Padding="8,3" materialDesign:ButtonAssist.CornerRadius="4"
                            ToolTip="{lang:Lang CadAlignment_PrevStepTip}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{lang:Lang CadAlignment_PrevStep}" Margin="3,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <!-- 5个进度圆点 -->
                    <StackPanel Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding CurrentStep, Converter={StaticResource StepDotColor1}}" Stroke="#37474F" StrokeThickness="1.5" Margin="0,0,4,0"/>
                        <Ellipse Width="8" Height="8" Fill="{Binding CurrentStep, Converter={StaticResource StepDotColor2}}" Stroke="#37474F" StrokeThickness="1.5" Margin="0,0,4,0"/>
                        <Ellipse Width="8" Height="8" Fill="{Binding CurrentStep, Converter={StaticResource StepDotColor3}}" Stroke="#37474F" StrokeThickness="1.5" Margin="0,0,4,0"/>
                        <Ellipse Width="8" Height="8" Fill="{Binding CurrentStep, Converter={StaticResource StepDotColor4}}" Stroke="#37474F" StrokeThickness="1.5" Margin="0,0,4,0"/>
                        <Ellipse Width="8" Height="8" Fill="{Binding CurrentStep, Converter={StaticResource StepDotColor5}}" Stroke="#37474F" StrokeThickness="1.5"/>
                    </StackPanel>

                    <!-- 当前步骤 Badge: 动态图标切换5种Kind -->
                    <Border Background="#37474F" CornerRadius="12" Padding="10,3" Margin="10,0,0,0"
                            BorderBrush="#455A64" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="12" Height="12" Foreground="#80CBC4" VerticalAlignment="Center" Margin="0,0,4,0">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                                <Setter Property="Kind" Value="CogOutline"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                                <Setter Property="Kind" Value="ArrowExpandHorizontal"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                                <Setter Property="Kind" Value="AngleAcute"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="4">
                                                <Setter Property="Kind" Value="SwapHorizontal"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentStep}" Value="5">
                                                <Setter Property="Kind" Value="RobotIndustrial"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{Binding CurrentStepTitle}"
                                       Foreground="#80CBC4" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 下一步 -->
                    <Button Command="{Binding GoNextCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#80CBC4"
                            Padding="8,3" materialDesign:ButtonAssist.CornerRadius="4"
                            ToolTip="{lang:Lang CadAlignment_NextStepTip}" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{lang:Lang NextStep}" VerticalAlignment="Center" FontSize="11" Margin="0,0,3,0"/>
                            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </StatusBarItem>

            <Separator Foreground="#37474F"/>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="12" Height="12" Foreground="#80CBC4" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding CurrentFileName, Mode=OneWay}" Foreground="#90A4AE" FontSize="10" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                    <Button Command="{Binding LoadConfigCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#80CBC4" Padding="6,2" materialDesign:ButtonAssist.CornerRadius="4" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FolderOpen" Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{lang:Lang CadAlignment_LoadFile}" FontSize="9" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveConfigCommand}" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#80CBC4" Padding="6,2" materialDesign:ButtonAssist.CornerRadius="4" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{lang:Lang CadAlignment_SaveFile}" FontSize="9" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StatusBarItem>

            <Separator Foreground="#37474F"/>

            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Ruler" Width="12" Height="12" Foreground="#607D8B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock Text="{lang:Lang CadAlignment_UnitLabel}" Foreground="#78909C" FontSize="10.5" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>