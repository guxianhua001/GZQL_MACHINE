<UserControl x:Class="Module.Controls.Step2ConfirmPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core">
    <StackPanel Margin="12">
        <!-- 标题 -->
        <TextBlock Text="{lang:Lang Step2_Title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock Text="{lang:Lang Step2_Description}" FontSize="12" Foreground="#616161" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- 摘要信息 -->
        <materialDesign:Card Padding="12" Margin="0,0,0,10" Background="#E8F5E9">
            <StackPanel>
                <TextBlock Text="{lang:Lang Step2_Section_ParseSummary}" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="{Binding SegmentSummaryDisplay}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </materialDesign:Card>

        <!-- 图层列表标题 -->
        <TextBlock Text="{lang:Lang Step2_Section_LayerVisibility}" FontSize="13" FontWeight="Medium" Margin="0,4,0,6"/>

        <!-- 图层 CheckBox 列表 -->
        <ListBox ItemsSource="{Binding LayerCheckList}"
                 BorderThickness="1" BorderBrush="#E0E0E0"
                 MaxHeight="220" MinHeight="80">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsVisible, UpdateSourceTrigger=PropertyChanged}"
                              Content="{Binding LayerName}" Margin="4,2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
