<UserControl x:Class="Module.Views.FeatureEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             Width="450"
             Height="Auto">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="1">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FeatureType}" Value="Component">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBox Text="{Binding ComponentFeatureId}"
                                                         materialDesign:HintAssist.Hint="{lang:Lang Dialog_ID}"
                                                         Margin="0,4" />
                                                <TextBox Text="{Binding ComponentFeatureName}"
                                                         materialDesign:HintAssist.Hint="{lang:Lang Dialog_Name}"
                                                         Margin="0,4" />
                                                <TextBox Text="{Binding ComponentFeatureDescription}"
                                                         materialDesign:HintAssist.Hint="{lang:Lang Dialog_Description}"
                                                         Margin="0,4" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding FeatureType}" Value="Site">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBox Text="{Binding SiteFeatureId}"
                                                         materialDesign:HintAssist.Hint="{lang:Lang Dialog_ID}"
                                                         Margin="0,4" />
                                                <TextBox Text="{Binding SiteFeatureName}"
                                                         materialDesign:HintAssist.Hint="{lang:Lang Dialog_Name}"
                                                         Margin="0,4" />
                                                <ComboBox ItemsSource="{Binding DataContext.SiteFeatureTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding SiteFeatureTypeString}"
                                                          Margin="0,4"
                                                          materialDesign:HintAssist.Hint="{lang:Lang Dialog_Type}" />
                                                <TextBox Text="{Binding SubAssy}"
                                                         materialDesign:HintAssist.Hint="{lang:Lang Dialog_Description}"
                                                         Margin="0,4" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="{lang:Lang Dialog_Cancel}"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Margin="0,0,8,0" />
            <Button Content="{lang:Lang Dialog_Save}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" />
        </StackPanel>
    </Grid>
</UserControl>
