<UserControl x:Class="Module.Views.BatchSetParamsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             Width="450" Height="Auto">
    <StackPanel Margin="20,16">
        <TextBlock Text="{lang:Lang Step3_BatchSet_Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding BatchParamItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,4" LastChildFill="True">
                            <CheckBox DockPanel.Dock="Left"
                                      IsChecked="{Binding IsEnabled}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0"/>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       MinWidth="100"/>
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center"
                                     Margin="4,0,0,0"
                                     IsEnabled="{Binding IsEnabled}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Padding="6,2" FontSize="11"/>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Unit}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Foreground="#757575"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Separator Margin="0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{lang:Lang Step3_BatchSet_Cancel}" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="{lang:Lang Step3_BatchSet_Confirm}" Command="{Binding ConfirmCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="16,4"
                    Background="#1565C0" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</UserControl>