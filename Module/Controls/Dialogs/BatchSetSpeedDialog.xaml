<UserControl x:Class="Module.Views.BatchSetSpeedDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             Width="320" Height="Auto">
    <StackPanel Margin="20,16">
        <TextBlock Text="{lang:Lang Step3_BatchSet_SpeedTitle}" FontWeight="Bold" FontSize="14" Margin="0,0,0,16"/>

        <Grid Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Step3_Label_JumpSpeed}"
                       VerticalAlignment="Center" Margin="0,0,8,8" FontSize="12"/>
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding JumpSpeed, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,0,4,8"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="6,2" FontSize="12"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{lang:Lang Unit_MmPerS}" VerticalAlignment="Center" Margin="0,0,0,8"
                       Foreground="#757575" FontSize="12"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Step3_Label_InterpolationSpeed}"
                       VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MoveSpeed, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Center" Margin="0,0,4,0"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="6,2" FontSize="12"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{lang:Lang Unit_MmPerS}" VerticalAlignment="Center"
                       Foreground="#757575" FontSize="12"/>
        </Grid>

        <Separator Margin="0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{lang:Lang Step3_BatchSet_Cancel}" Command="{Binding CancelCommand}"
                    Style="{StaticResource MaterialDesignFlatButton}" Padding="12,4" Margin="0,0,8,0"/>
            <Button Content="{lang:Lang Step3_BatchSet_Confirm}" Command="{Binding ConfirmCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="16,4"
                    Background="#1565C0" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</UserControl>