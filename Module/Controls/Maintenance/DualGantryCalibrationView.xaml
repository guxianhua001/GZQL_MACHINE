                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="4,2" Margin="0,0,2,0">
                                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                                    </Button>
                                                    <Button ToolTip="{lang:Lang DualGantryCalib_Move}"
                                                            Command="{Binding DataContext.MoveGantry1PointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="4,2" Margin="2,0,2,0">
                                                        <materialDesign:PackIcon Kind="ArrowRight" Width="14" Height="14" />
                                                    </Button>
                                                    <Button ToolTip="{lang:Lang DualGantryCalib_Delete}"
                                                            Command="{Binding DataContext.DeleteGantry1PointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="4,2" Margin="2,0,0,0">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14"
                                                                                 Foreground="#E53935" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 龙门1标定结果 -->
                            <Rectangle Height="1" Fill="#E0E0E0" Margin="0,8,0,8" />
                            <TextBlock Text="{lang:Lang DualGantryCalib_CalibResult}" Style="{StaticResource StepLabelStyle}" />
                            <!-- 仿射参数 A/B/Tx -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="A" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Gantry1CalibrationResult.A, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="B" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gantry1CalibrationResult.B, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Tx" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Gantry1CalibrationResult.Tx, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                            </Grid>
                            <!-- 仿射参数 C/D/Ty -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="C" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Gantry1CalibrationResult.C, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="D" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gantry1CalibrationResult.D, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Ty" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Gantry1CalibrationResult.Ty, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                            </Grid>
                            <!-- 统计信息 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang DualGantryCalib_RmsError}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Gantry1CalibrationResult.RmsError, StringFormat=F6, FallbackValue=-}"
                                           FontWeight="Bold" FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang DualGantryCalib_RotationAngle}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Gantry1CalibrationResult.EquivalentRotationDeg, StringFormat=F4, FallbackValue=-}"
                                           FontWeight="Bold" FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang DualGantryCalib_ScaleFactor}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="X:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding Gantry1CalibrationResult.EquivalentScaleX, StringFormat=F6, FallbackValue=-}"
                                               FontWeight="Bold" FontSize="12" Foreground="#424242"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Y:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding Gantry1CalibrationResult.EquivalentScaleY, StringFormat=F6, FallbackValue=-}"
                                               FontWeight="Bold" FontSize="12" Foreground="#424242"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ==================================================== -->
                    <!-- 龙门2标定卡片 (主色 #00897B)                           -->
                    <!-- ==================================================== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <!-- 卡片标题 -->
                            <StackPanel Style="{StaticResource CardHeaderStyle}">
                                <materialDesign:PackIcon Kind="Numeric2BoxOutline" Width="18" Height="18"
                                                         Foreground="#00897B" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang DualGantryCalib_Gantry2Calibration}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Foreground="#00897B" />
                            </StackPanel>

                            <!-- Y轴互锁提示 -->
                            <Border Background="#FFF3E0" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertOutline" Width="14" Height="14"
                                                             Foreground="#FF9800" Margin="0,0,6,0"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{lang:Lang DualGantryCalib_CommonYInterlock}"
                                               FontSize="11" Foreground="#E65100" TextWrapping="Wrap"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- 操作按钮区 -->
                            <WrapPanel Margin="0,0,0,8">
                                <Button Command="{Binding AddGantry2PointCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="6,4" Margin="0,0,6,4"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang DualGantryCalib_AddPoint}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StartGantry2AutoCalibCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="6,4" Margin="0,0,6,4"
                                        materialDesign:ButtonAssist.CornerRadius="4"
                                        ToolTip="{lang:Lang DualGantryCalib_StartAutoCalib}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Play" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang DualGantryCalib_StartAutoCalib}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StopGantry2AutoCalibCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="6,4" Margin="0,0,6,4"
                                        BorderBrush="#FF9800" Foreground="#E65100"
                                        materialDesign:ButtonAssist.CornerRadius="4"
                                        ToolTip="{lang:Lang DualGantryCalib_StopAutoCalib}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Stop" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang DualGantryCalib_StopAutoCalib}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ComputeGantry2CalibrationCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="6,4" Margin="0,0,0,4"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Calculator" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang DualGantryCalib_Compute}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- 龙门2标定数据表格 -->
                            <DataGrid ItemsSource="{Binding Gantry2Points}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      materialDesign:DataGridAssist.CellPadding="4"
                                      HeadersVisibility="Column"
                                      FontSize="12"
                                      MaxHeight="300">
                                <DataGrid.Resources>
                                    <Style x:Key="G2CenterHeaderStyle" TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                    <Style x:Key="G2CenterCellTextStyle" TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <!-- 序号 -->
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="36"
                                                         IsReadOnly="True"
                                                         HeaderStyle="{StaticResource G2CenterHeaderStyle}"
                                                         ElementStyle="{StaticResource G2CenterCellTextStyle}" />
                                    <!-- 名称 -->
                                    <DataGridTextColumn Header="{lang:Lang DualGantryCalib_PointName}"
                                                         Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="56"
                                                         HeaderStyle="{StaticResource G2CenterHeaderStyle}"
                                                         ElementStyle="{StaticResource G2CenterCellTextStyle}" />
                                    <!-- 机械X -->
                                    <DataGridTextColumn Header="{lang:Lang DualGantryCalib_MachineX}"
                                                         Binding="{Binding MachineX, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="80"
                                                         HeaderStyle="{StaticResource G2CenterHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E53935" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- 机械Y -->
                                    <DataGridTextColumn Header="{lang:Lang DualGantryCalib_MachineY}"
                                                         Binding="{Binding MachineY, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="80"
                                                         HeaderStyle="{StaticResource G2CenterHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#43A047" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- 视觉X -->
                                    <DataGridTextColumn Header="{lang:Lang DualGantryCalib_VisionX}"
                                                         Binding="{Binding VisionX, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="80"
                                                         HeaderStyle="{StaticResource G2CenterHeaderStyle}"
                                                         ElementStyle="{StaticResource G2CenterCellTextStyle}">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="IsEnabled"
                                                        Value="{Binding DataContext.EnableVisionData, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <!-- 视觉Y -->
                                    <DataGridTextColumn Header="{lang:Lang DualGantryCalib_VisionY}"
                                                         Binding="{Binding VisionY, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="80"
                                                         HeaderStyle="{StaticResource G2CenterHeaderStyle}"
                                                         ElementStyle="{StaticResource G2CenterCellTextStyle}">
                                        <DataGridTextColumn.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="IsEnabled"
                                                        Value="{Binding DataContext.EnableVisionData, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            </Style>
                                        </DataGridTextColumn.CellStyle>
                                    </DataGridTextColumn>
                                    <!-- 状态 -->
                                    <DataGridTemplateColumn Header="{lang:Lang DualGantryCalib_Status}" Width="46"
                                                             HeaderStyle="{StaticResource G2CenterHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{Binding StatusColor}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- 操作列 -->
                                    <DataGridTemplateColumn Header="{lang:Lang DualGantryCalib_Operation}" Width="*" MinWidth="140"
                                                             HeaderStyle="{StaticResource G2CenterHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button ToolTip="{lang:Lang DualGantryCalib_Teach}"
                                                            Command="{Binding DataContext.TeachGantry2PointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="4,2" Margin="0,0,2,0">
                                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                                    </Button>
                                                    <Button ToolTip="{lang:Lang DualGantryCalib_Move}"
                                                            Command="{Binding DataContext.MoveGantry2PointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="4,2" Margin="2,0,2,0">
                                                        <materialDesign:PackIcon Kind="ArrowRight" Width="14" Height="14" />
                                                    </Button>
                                                    <Button ToolTip="{lang:Lang DualGantryCalib_Delete}"
                                                            Command="{Binding DataContext.DeleteGantry2PointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="4,2" Margin="2,0,0,0">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14"
                                                                                 Foreground="#E53935" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 龙门2标定结果 -->
                            <Rectangle Height="1" Fill="#E0E0E0" Margin="0,8,0,8" />
                            <TextBlock Text="{lang:Lang DualGantryCalib_CalibResult}" Style="{StaticResource StepLabelStyle}" />
                            <!-- 仿射参数 A/B/Tx -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="A" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Gantry2CalibrationResult.A, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="B" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gantry2CalibrationResult.B, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Tx" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Gantry2CalibrationResult.Tx, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                            </Grid>
                            <!-- 仿射参数 C/D/Ty -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="C" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Gantry2CalibrationResult.C, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="D" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Gantry2CalibrationResult.D, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Ty" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Gantry2CalibrationResult.Ty, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                            </Grid>
                            <!-- 统计信息 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang DualGantryCalib_RmsError}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Gantry2CalibrationResult.RmsError, StringFormat=F6, FallbackValue=-}"
                                           FontWeight="Bold" FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang DualGantryCalib_RotationAngle}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Gantry2CalibrationResult.EquivalentRotationDeg, StringFormat=F4, FallbackValue=-}"
                                           FontWeight="Bold" FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang DualGantryCalib_ScaleFactor}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="X:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding Gantry2CalibrationResult.EquivalentScaleX, StringFormat=F6, FallbackValue=-}"
                                               FontWeight="Bold" FontSize="12" Foreground="#424242"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Y:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding Gantry2CalibrationResult.EquivalentScaleY, StringFormat=F6, FallbackValue=-}"
                                               FontWeight="Bold" FontSize="12" Foreground="#424242"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ==================================================== -->
                    <!-- 跨龙门对齐卡片 (主色 #6A1B9A)                           -->
                    <!-- ==================================================== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,0"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <!-- 卡片标题 -->
                            <StackPanel Style="{StaticResource CardHeaderStyle}">
                                <materialDesign:PackIcon Kind="LinkVariant" Width="18" Height="18"
                                                         Foreground="#6A1B9A" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang DualGantryCalib_CrossGantryAlignment}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Foreground="#6A1B9A" />
                            </StackPanel>

                            <!-- 公共基准点标题 -->
                            <TextBlock Text="{lang:Lang DualGantryCalib_ReferencePoints}"
                                       Style="{StaticResource StepLabelStyle}" />

                            <!-- 公共基准点表格 -->
                            <DataGrid ItemsSource="{Binding CommonReferencePoints}"
                                      SelectedItem="{Binding SelectedCommonReferencePoint, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      materialDesign:DataGridAssist.CellPadding="4"
                                      HeadersVisibility="Column"
                                      FontSize="12"
                                      MaxHeight="200"
                                      Margin="0,0,0,8">
                                <DataGrid.Resources>
                                    <Style x:Key="RefCenterHeaderStyle" TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                    <Style x:Key="RefCenterCellTextStyle" TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <!-- 序号 -->
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="36"
                                                         IsReadOnly="True"
                                                         HeaderStyle="{StaticResource RefCenterHeaderStyle}"
                                                         ElementStyle="{StaticResource RefCenterCellTextStyle}" />
                                    <!-- Cam1采集时的Y坐标 -->
                                    <DataGridTextColumn Header="{lang:Lang DualGantryCalib_CommonY1}"
                                                         Binding="{Binding CommonY1, StringFormat=F3}"
                                                         Width="90"
                                                         IsReadOnly="True"
                                                         HeaderStyle="{StaticResource RefCenterHeaderStyle}"
                                                         ElementStyle="{StaticResource RefCenterCellTextStyle}" />
                                    <!-- Cam2采集时的Y坐标 -->
                                    <DataGridTextColumn Header="{lang:Lang DualGantryCalib_CommonY2}"
                                                         Binding="{Binding CommonY2, StringFormat=F3}"
                                                         Width="90"
                                                         IsReadOnly="True"
                                                         HeaderStyle="{StaticResource RefCenterHeaderStyle}"
                                                         ElementStyle="{StaticResource RefCenterCellTextStyle}" />
                                    <!-- 龙门1视觉X -->
                                    <DataGridTextColumn Header="{lang:Lang DualGantryCalib_VisionX}"
                                                         Binding="{Binding Gantry1VisionX, StringFormat=F3}"
                                                         Width="90"
                                                         IsReadOnly="True"
                                                         HeaderStyle="{StaticResource RefCenterHeaderStyle}"
                                                         ElementStyle="{StaticResource RefCenterCellTextStyle}" />
                                    <!-- 龙门1视觉Y -->
                                    <DataGridTextColumn Header="{lang:Lang DualGantryCalib_VisionY}"
                                                         Binding="{Binding Gantry1VisionY, StringFormat=F3}"
                                                         Width="90"
                                                         IsReadOnly="True"
                                                         HeaderStyle="{StaticResource RefCenterHeaderStyle}"
                                                         ElementStyle="{StaticResource RefCenterCellTextStyle}" />
                                    <!-- 龙门2视觉X -->
                                    <DataGridTextColumn Header="{lang:Lang DualGantryCalib_VisionX}"
                                                         Binding="{Binding Gantry2VisionX, StringFormat=F3}"
                                                         Width="90"
                                                         IsReadOnly="True"
                                                         HeaderStyle="{StaticResource RefCenterHeaderStyle}"
                                                         ElementStyle="{StaticResource RefCenterCellTextStyle}" />
                                    <!-- 龙门2视觉Y -->
                                    <DataGridTextColumn Header="{lang:Lang DualGantryCalib_VisionY}"
                                                         Binding="{Binding Gantry2VisionY, StringFormat=F3}"
                                                         Width="90"
                                                         IsReadOnly="True"
                                                         HeaderStyle="{StaticResource RefCenterHeaderStyle}"
                                                         ElementStyle="{StaticResource RefCenterCellTextStyle}" />
                                    <!-- 采集状态 -->
                                    <DataGridTemplateColumn Header="{lang:Lang DualGantryCalib_Status}" Width="46"
                                                             HeaderStyle="{StaticResource RefCenterHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{Binding IsCaptured, Converter={StaticResource BoolToBrush}}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 添加 + 采集Cam1 + 采集Cam2 + 计算按钮 -->
                            <WrapPanel Margin="0,0,0,8">
                                <Button Command="{Binding AddReferencePointCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="6,4" Margin="0,0,6,4"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang DualGantryCalib_AddPoint}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CaptureGantry1ReferenceCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="6,4" Margin="0,0,6,4"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Camera" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang DualGantryCalib_CaptureGantry1}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding CaptureGantry2ReferenceCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="6,4" Margin="0,0,6,4"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Camera" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang DualGantryCalib_CaptureGantry2}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ComputeGantryTransformCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="6,4" Margin="0,0,0,4"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Link" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang DualGantryCalib_ComputeTransform}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- 变换参数显示 -->
                            <Rectangle Height="1" Fill="#E0E0E0" Margin="0,4,0,8" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang DualGantryCalib_OffsetX}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding GantryTransform.OffsetX, StringFormat=F4, FallbackValue=-}"
                                           FontWeight="Bold" FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{lang:Lang DualGantryCalib_OffsetY}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="{Binding GantryTransform.OffsetY, StringFormat=F4, FallbackValue=-}"
                                           FontWeight="Bold" FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang DualGantryCalib_RotationDeg}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding GantryTransform.RotationDeg, StringFormat=F4, FallbackValue=-}"
                                           FontWeight="Bold" FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{lang:Lang DualGantryCalib_Scale}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="3" Text="{Binding GantryTransform.Scale, StringFormat=F6, FallbackValue=-}"
                                           FontWeight="Bold" FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang DualGantryCalib_Residual}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding GantryTransform.Residual, StringFormat=F6, FallbackValue=-}"
                                           FontWeight="Bold" FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- 坐标变换验证区 -->
                            <Rectangle Height="1" Fill="#E0E0E0" Margin="0,4,0,8" />
                            <TextBlock Text="{lang:Lang DualGantryCalib_VerifyTransform}"
                                       Style="{StaticResource StepLabelStyle}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang DualGantryCalib_InputX}"
                                           Style="{StaticResource ParamLabelStyle}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding VerifyInputX, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="4,2" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{lang:Lang DualGantryCalib_InputY}"
                                           Style="{StaticResource ParamLabelStyle}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding VerifyInputY, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="4,2" Margin="0,0,8,0" />
                                <Button Grid.Column="4" Command="{Binding VerifyTransformCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="6,4"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircleOutline" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang DualGantryCalib_Verify}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang DualGantryCalib_OutputX}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Column="1" Text="{Binding VerifyOutputX, Mode=OneWay, StringFormat=F4, FallbackValue=-}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                                <TextBlock Grid.Column="2" Text="{lang:Lang DualGantryCalib_OutputY}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Column="3" Text="{Binding VerifyOutputY, Mode=OneWay, StringFormat=F4, FallbackValue=-}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================ -->
        <!-- 状态栏                                                        -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Background="{Binding StatusColor}"
                Padding="16,10" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18"
                                         Foreground="#333333" Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#333333" FontWeight="SemiBold"
                           FontSize="13" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
