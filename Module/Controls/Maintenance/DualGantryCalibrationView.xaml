                                                         VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- 操作列 -->
                                    <DataGridTemplateColumn Header="{lang:Lang DualGantryCalib_Operation}" Width="*" MinWidth="140"
                                                             HeaderStyle="{StaticResource G1CenterHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button ToolTip="{lang:Lang DualGantryCalib_Teach}"
                                                            Command="{Binding DataContext.TeachGantry1PointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
