<UserControl x:Class="Module.Views.NeedleAlignerView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

             xmlns:prism="http://prismlibrary.com/"

             xmlns:converters="clr-namespace:Module.Converters"

             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"

             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"

             prism:ViewModelLocator.AutoWireViewModel="True"

             mc:Ignorable="d"

             d:DesignHeight="700"

             d:DesignWidth="1100"

             Background="#EEF2F5">

    <UserControl.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="/Module;component/Controls/Maintenance/MaintenanceSharedStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>



            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />

            <converters:NullToVisibilityConverter x:Key="NullToVis" />

            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />

            <converters:StepStateToBrushConverter x:Key="StepStateToBrush" />

            <converters:StepStateToTextBrushConverter x:Key="StepStateToTextBrush" />

            <converters:StepStateToConnectorBrushConverter x:Key="StepStateToConnectorBrush" />



            <Style x:Key="SideCardHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline6TextBlock}">

                <Setter Property="TextWrapping" Value="Wrap" />

            </Style>

            <!-- Margin 行间距：Grid / StackPanel 通用 -->
            <Style x:Key="ParamRowStyle" TargetType="FrameworkElement">

                <Setter Property="Margin" Value="0,0,0,4" />

            </Style>

            <Style x:Key="ParamLabelStyle" TargetType="TextBlock">

                <Setter Property="FontSize" Value="12" />

                <Setter Property="Foreground" Value="#616161" />

                <Setter Property="VerticalAlignment" Value="Center" />

                <Setter Property="TextWrapping" Value="Wrap" />

            </Style>

            <Style x:Key="ParamTextBoxStyle" TargetType="TextBox">

                <Setter Property="FontSize" Value="12" />

                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />

            </Style>

            <Style x:Key="ResultValueStyle" TargetType="TextBlock">

                <Setter Property="FontSize" Value="13" />

                <Setter Property="FontFamily" Value="Consolas" />

                <Setter Property="Foreground" Value="#424242" />

                <Setter Property="VerticalAlignment" Value="Center" />

            </Style>

            <Style x:Key="ResultLabelStyle" TargetType="TextBlock">

                <Setter Property="FontSize" Value="11" />

                <Setter Property="Foreground" Value="#9E9E9E" />

                <Setter Property="VerticalAlignment" Value="Center" />

                <Setter Property="Margin" Value="0,0,6,0" />

            </Style>

        </ResourceDictionary>

    </UserControl.Resources>



    <Grid>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>



        <!-- 顶部：两步指示 + 系统切换 -->

        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,10">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>



                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

                    <!-- Step 1 -->

                    <StackPanel Orientation="Horizontal">

                        <Border Width="32" Height="32" CornerRadius="16"

                                Background="{Binding Step1State, Converter={StaticResource StepStateToBrush}}">

                            <TextBlock Text="1" Foreground="White" FontSize="13" FontWeight="Bold"

                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">

                            <TextBlock Text="{lang:Lang NeedleAligner_Step1_Title}" FontSize="12" FontWeight="Medium"

                                       Foreground="{Binding Step1State, Converter={StaticResource StepStateToTextBrush}}" />

                            <TextBlock Text="{lang:Lang NeedleAligner_Step1_Desc}" FontSize="10" Foreground="#757575" />

                        </StackPanel>

                    </StackPanel>

                    <Border Width="56" Height="3" Margin="14,0" VerticalAlignment="Center"

                            Background="{Binding Step1State, Converter={StaticResource StepStateToConnectorBrush}}" />

                    <!-- Step 2 -->

                    <StackPanel Orientation="Horizontal">

                        <Border Width="32" Height="32" CornerRadius="16"

                                Background="{Binding Step2State, Converter={StaticResource StepStateToBrush}}">

                            <TextBlock Text="2" Foreground="White" FontSize="13" FontWeight="Bold"

                                       HorizontalAlignment="Center" VerticalAlignment="Center" />

                        </Border>

                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">

                            <TextBlock Text="{lang:Lang NeedleAligner_Step2_Title}" FontSize="12" FontWeight="Medium"

                                       Foreground="{Binding Step2State, Converter={StaticResource StepStateToTextBrush}}" />

                            <TextBlock Text="{lang:Lang NeedleAligner_Step2_Desc}" FontSize="10" Foreground="#757575" />

                        </StackPanel>

                    </StackPanel>

                </StackPanel>



                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <RadioButton Content="{lang:Lang NeedleSystem1}"

                                 Command="{Binding System1Command}"

                                 IsChecked="{Binding SystemNumber, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"

                                 Style="{StaticResource MaterialDesignRadioButton}" Margin="0,0,12,0" />

                    <RadioButton Content="{lang:Lang NeedleSystem2}"

                                 Command="{Binding System2Command}"

                                 IsChecked="{Binding SystemNumber, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}"

                                 Style="{StaticResource MaterialDesignRadioButton}" />

                </StackPanel>

            </Grid>

        </Border>



        <!-- 主内容 -->

        <Grid Grid.Row="1" Margin="8,6,8,4">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*" MinWidth="240" MaxWidth="360" />

                <ColumnDefinition Width="1.6*" MinWidth="400" />

                <ColumnDefinition Width="*" MinWidth="220" MaxWidth="300" />

            </Grid.ColumnDefinitions>



            <!-- ========== Step 1：配置示教 ========== -->

            <Grid Visibility="{Binding IsStep1Active, Converter={StaticResource BoolToVis}}" Grid.ColumnSpan="3">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" MinWidth="240" MaxWidth="360" />

                    <ColumnDefinition Width="1.6*" MinWidth="400" />

                    <ColumnDefinition Width="*" MinWidth="220" MaxWidth="300" />

                </Grid.ColumnDefinitions>



                <!-- 左：运动参数 -->

                <ScrollViewer Grid.Column="0" Style="{StaticResource AlwaysVisibleScrollViewerStyle}" Margin="0,0,6,0">

                    <materialDesign:Card UniformCornerRadius="8" Padding="12" Background="{DynamicResource MaterialDesignCardBackground}">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                                <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" />

                                <TextBlock Text="{lang:Lang NeedleAligner_MotionParameters}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />

                            </StackPanel>

                            <Grid Style="{StaticResource ParamRowStyle}">

                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">

                                    <TextBlock Text="{lang:Lang NeedleAligner_SearchRange}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_SearchRangeTip}" />

                                    <TextBox Text="{Binding Parameters.SearchRange, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />

                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,0,0">

                                    <TextBlock Text="{lang:Lang NeedleAligner_ZSearchCount}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_ZSearchCountTip}" />

                                    <TextBox Text="{Binding Parameters.ZSearchCount}" Style="{StaticResource ParamTextBoxStyle}" />

                                </StackPanel>

                            </Grid>

                            <Grid Style="{StaticResource ParamRowStyle}">

                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">

                                    <TextBlock Text="{lang:Lang NeedleAligner_SearchSpeed}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_SearchSpeedTip}" />

                                    <TextBox Text="{Binding Parameters.SearchSpeed, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />

                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,0,0">

                                    <TextBlock Text="{lang:Lang NeedleAligner_FineSearchSpeed}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_FineSearchSpeedTip}" />

                                    <TextBox Text="{Binding Parameters.FineSearchSpeed, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />

                                </StackPanel>

                            </Grid>

                            <StackPanel Style="{StaticResource ParamRowStyle}">

                                <TextBlock Text="{lang:Lang NeedleAligner_SafeHeight}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_SafeHeightTip}" />

                                <TextBox Text="{Binding Parameters.SafeHeight, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />

                            </StackPanel>

                            <Grid Style="{StaticResource ParamRowStyle}">

                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,4,0">

                                    <TextBlock Text="{lang:Lang NeedleAligner_SensorDiX}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_SensorDiXTip}" />

                                    <TextBox Text="{Binding SensorDiX, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ParamTextBoxStyle}" />

                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="4,0,0,0">

                                    <TextBlock Text="{lang:Lang NeedleAligner_SensorDiY}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_SensorDiYTip}" />

                                    <TextBox Text="{Binding SensorDiY, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ParamTextBoxStyle}" />

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </materialDesign:Card>

                </ScrollViewer>



                <!-- 中：固定基准 + 对针位置 + 示教指引 -->

                <ScrollViewer Grid.Column="1" Style="{StaticResource AlwaysVisibleScrollViewerStyle}" Margin="0,0,6,0"

                              IsEnabled="{Binding IsCalibrating, Converter={StaticResource InverseBooleanConverter}}">

                    <StackPanel>

                        <Border Background="#E3F2FD" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">

                            <StackPanel Orientation="Horizontal">

                                <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="#1565C0" Margin="0,2,8,0" VerticalAlignment="Top" />

                                <TextBlock Text="{lang:Lang NeedleAligner_Step1_Guide}" Foreground="#1565C0" FontSize="12" TextWrapping="Wrap" />

                            </StackPanel>

                        </Border>



                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6" Background="{DynamicResource MaterialDesignCardBackground}">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                                    <materialDesign:PackIcon Kind="MapMarker" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" />

                                    <TextBlock Text="{lang:Lang NeedleAligner_ReferenceCoordinates}" ToolTip="{lang:Lang NeedleAligner_ReferenceCoordinatesTip}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />

                                </StackPanel>

                                <Grid>

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">

                                        <TextBlock Text="X" Style="{StaticResource ParamLabelStyle}" Foreground="#E53935" FontWeight="SemiBold" />

                                        <TextBox Text="{Binding Parameters.ReferenceXYZ.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="4,0">

                                        <TextBlock Text="Y" Style="{StaticResource ParamLabelStyle}" Foreground="#43A047" FontWeight="SemiBold" />

                                        <TextBox Text="{Binding Parameters.ReferenceXYZ.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />

                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="4,0,0,0">

                                        <TextBlock Text="Z" Style="{StaticResource ParamLabelStyle}" Foreground="#7E57C2" FontWeight="SemiBold" />

                                        <TextBox Text="{Binding Parameters.ReferenceXYZ.Z, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />

                                    </StackPanel>

                                </Grid>

                            </StackPanel>

                        </materialDesign:Card>



                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Background="{DynamicResource MaterialDesignCardBackground}">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                                    <materialDesign:PackIcon Kind="Target" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" />

                                    <TextBlock Text="{Binding CurrentAlignPositionTitle}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />

                                </StackPanel>

                                <Grid Style="{StaticResource ParamRowStyle}">

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">

                                        <TextBlock Text="X" Style="{StaticResource ParamLabelStyle}" Foreground="#E53935" FontWeight="SemiBold" />

                                        <TextBox Text="{Binding CurrentAlignX, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ParamTextBoxStyle}" />

                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="4,0">

                                        <TextBlock Text="Y" Style="{StaticResource ParamLabelStyle}" Foreground="#43A047" FontWeight="SemiBold" />

                                        <TextBox Text="{Binding CurrentAlignY, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ParamTextBoxStyle}" />

                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="4,0">

                                        <TextBlock Text="Z" Style="{StaticResource ParamLabelStyle}" Foreground="#7E57C2" FontWeight="SemiBold" />

                                        <TextBox Text="{Binding CurrentAlignZ, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ParamTextBoxStyle}" />

                                    </StackPanel>

                                    <Button Grid.Column="3" VerticalAlignment="Bottom" Command="{Binding TeachAlignPositionCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Padding="8,6" Margin="4,0,0,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachAlignPosition}">

                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="16" Height="16" />

                                    </Button>

                                </Grid>

                            </StackPanel>

                        </materialDesign:Card>

                    </StackPanel>

                </ScrollViewer>



                <!-- 右：搜索点 + 参数存取 -->

                <ScrollViewer Grid.Column="2" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"

                              IsEnabled="{Binding IsCalibrating, Converter={StaticResource InverseBooleanConverter}}">

                    <StackPanel>

                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6" Background="{DynamicResource MaterialDesignCardBackground}">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                                    <materialDesign:PackIcon Kind="CrosshairsGps" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" />

                                    <TextBlock Text="{lang:Lang NeedleAligner_SearchPointSettings}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />

                                </StackPanel>

                                <Grid Style="{StaticResource ParamRowStyle}">

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="P1" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />

                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint1.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,4,0" />

                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint1.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,4,0" />

                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="1" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">

                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />

                                    </Button>

                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="P2" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />

                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint2.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,4,0" />

                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint2.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,4,0" />

                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="2" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">

                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />

                                    </Button>

                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="P3" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />

                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint3.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,4,0" />

                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint3.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,4,0" />

                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="3" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">

                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />

                                    </Button>

                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="P4" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />

                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint4.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,4,0" />

                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint4.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" Margin="0,0,4,0" />

                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="4" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">

                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />

                                    </Button>

                                </Grid>

                            </StackPanel>

                        </materialDesign:Card>



                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Background="{DynamicResource MaterialDesignCardBackground}">

                            <StackPanel>

                                <Button Command="{Binding SaveParametersCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Stretch" Padding="8,5" Margin="0,0,0,4" ToolTip="{lang:Lang NeedleAligner_SaveParameters}">

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,6,0" />

                                        <TextBlock Text="{lang:Lang NeedleAligner_SaveParameters}" />

                                    </StackPanel>

                                </Button>

                                <Button Command="{Binding LoadParametersCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Stretch" Padding="8,5" ToolTip="{lang:Lang NeedleAligner_LoadParameters}">

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                                        <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" Margin="0,0,6,0" />

                                        <TextBlock Text="{lang:Lang NeedleAligner_LoadParameters}" />

                                    </StackPanel>

                                </Button>

                                <Border Background="#FAFAFA" CornerRadius="6" Padding="8,5" Margin="0,8,0,0" Visibility="{Binding CurrentFilePath, Converter={StaticResource NullToVis}}">

                                    <TextBlock Text="{Binding CurrentFileName}" Foreground="#7E57C2" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" ToolTip="{Binding CurrentFilePath}" />

                                </Border>

                            </StackPanel>

                        </materialDesign:Card>

                    </StackPanel>

                </ScrollViewer>

            </Grid>



            <!-- ========== Step 2：校准应用 ========== -->

            <Grid Visibility="{Binding IsStep2Active, Converter={StaticResource BoolToVis}}" Grid.ColumnSpan="3">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" MinWidth="240" MaxWidth="360" />

                    <ColumnDefinition Width="1.6*" MinWidth="400" />

                    <ColumnDefinition Width="*" MinWidth="220" MaxWidth="300" />

                </Grid.ColumnDefinitions>



                <!-- 左：测量与 TCP 摘要 -->

                <ScrollViewer Grid.Column="0" Style="{StaticResource AlwaysVisibleScrollViewerStyle}" Margin="0,0,6,0">

                    <materialDesign:Card UniformCornerRadius="8" Padding="12" Background="{DynamicResource MaterialDesignCardBackground}">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                                <materialDesign:PackIcon Kind="ClipboardCheck" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" />

                                <TextBlock Text="{lang:Lang NeedleAligner_CalibrationResults}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />

                            </StackPanel>

                            <TextBlock Text="{lang:Lang NeedleAligner_CurrentXYZ}" FontSize="11" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,4" />

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal"><TextBlock Text="X=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding Parameters.CurrentXYZ.X, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#E53935" /></StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Y=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding Parameters.CurrentXYZ.Y, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#43A047" /></StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Z=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding Parameters.CurrentXYZ.Z, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#7E57C2" /></StackPanel>

                            </Grid>

                            <TextBlock Text="{lang:Lang NeedleAligner_TcpTotalOffset}" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,0,4" />

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal"><TextBlock Text="X=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding TcpTotalOffsetX, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#E53935" /></StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Y=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding TcpTotalOffsetY, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#43A047" /></StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Z=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding TcpTotalOffsetZ, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#1E88E5" /></StackPanel>

                            </Grid>

                            <TextBlock Text="{lang:Lang NeedleAligner_PendingIncrement}" FontSize="11" FontWeight="SemiBold" Foreground="#F57C00" Margin="0,0,0,4" />

                            <Grid>

                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal"><TextBlock Text="X=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding PendingIncrementX, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#E53935" /></StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Y=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding PendingIncrementY, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#43A047" /></StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Z=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding PendingIncrementZ, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#1E88E5" /></StackPanel>

                            </Grid>

                        </StackPanel>

                    </materialDesign:Card>

                </ScrollViewer>



                <!-- 中：校准控制 + TCP 应用 -->

                <ScrollViewer Grid.Column="1" Style="{StaticResource AlwaysVisibleScrollViewerStyle}" Margin="0,0,6,0">

                    <StackPanel>

                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6" Background="{DynamicResource MaterialDesignCardBackground}">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                                    <materialDesign:PackIcon Kind="PlayCircle" Width="18" Height="18" Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,8,0" />

                                    <TextBlock Text="{lang:Lang NeedleAligner_CalibrationControl}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource SecondaryHueMidBrush}" />

                                </StackPanel>

                                <WrapPanel Margin="0,0,0,10">

                                    <Button Command="{Binding StartCalibrationCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" Foreground="White" Padding="14,6" Margin="0,0,8,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_StartCalibration}">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="Play" Width="16" Height="16" Margin="0,0,6,0" />

                                            <TextBlock Text="{lang:Lang NeedleAligner_StartCalibration}" />

                                        </StackPanel>

                                    </Button>

                                    <Button Command="{Binding StopCalibrationCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="14,6" BorderBrush="#EF5350" Foreground="#C62828" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_StopCalibration}">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" Margin="0,0,6,0" />

                                            <TextBlock Text="{lang:Lang NeedleAligner_StopCalibration}" />

                                        </StackPanel>

                                    </Button>

                                </WrapPanel>

                                <ProgressBar Value="{Binding CalibrationProgress}" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,8" Foreground="{DynamicResource SecondaryHueMidBrush}" />

                                <TextBlock Text="{Binding CalibrationStatus}" FontSize="12" Foreground="#5E35B1" FontWeight="Medium" TextWrapping="Wrap" />

                            </StackPanel>

                        </materialDesign:Card>



                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Background="{DynamicResource MaterialDesignCardBackground}"

                                             IsEnabled="{Binding IsCalibrating, Converter={StaticResource InverseBooleanConverter}}">

                            <StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                                    <materialDesign:PackIcon Kind="MathCompass" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" />

                                    <TextBlock Text="{lang:Lang NeedleAligner_CompensationDetails}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />

                                </StackPanel>

                                <!-- X -->

                                <Grid Margin="0,0,0,6">

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisXArrow" Width="16" Height="16" Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,6,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding PendingIncrementX, StringFormat=F3}" FontSize="11" FontWeight="SemiBold" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{lang:Lang NeedleAligner_PendingIncrement}" />

                                    <TextBox Grid.Column="2" Text="{Binding CompensationXExpression, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="0,0,4,0" materialDesign:HintAssist.Hint="Expr" />

                                    <TextBlock Grid.Column="3" Text="{Binding CalculatedCompX, StringFormat='= {0:F3}'}" FontSize="11" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="{lang:Lang NeedleAligner_TcpTotalAfterApply}" />

                                    <common:GlobalVariableLinkControl Grid.Column="4" DisplayValue="{Binding CalculatedCompX}" DisplayForeground="#E53935" IsLinked="{Binding IsCompensationXLinked}" UnlinkCommand="{Binding UnlinkCompensationXCommand}" LinkedVariableName="{Binding CompensationXLinkedVar, UpdateSourceTrigger=PropertyChanged}" LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="110" />

                                </Grid>

                                <!-- Y -->

                                <Grid Margin="0,0,0,6">

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisYArrow" Width="16" Height="16" Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,6,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding PendingIncrementY, StringFormat=F3}" FontSize="11" FontWeight="SemiBold" Foreground="#43A047" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                    <TextBox Grid.Column="2" Text="{Binding CompensationYExpression, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="0,0,4,0" materialDesign:HintAssist.Hint="Expr" />

                                    <TextBlock Grid.Column="3" Text="{Binding CalculatedCompY, StringFormat='= {0:F3}'}" FontSize="11" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                    <common:GlobalVariableLinkControl Grid.Column="4" DisplayValue="{Binding CalculatedCompY}" DisplayForeground="#43A047" IsLinked="{Binding IsCompensationYLinked}" UnlinkCommand="{Binding UnlinkCompensationYCommand}" LinkedVariableName="{Binding CompensationYLinkedVar, UpdateSourceTrigger=PropertyChanged}" LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="110" />

                                </Grid>

                                <!-- Z -->

                                <Grid Margin="0,0,0,10">

                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisZArrow" Width="16" Height="16" Foreground="#1E88E5" VerticalAlignment="Center" Margin="0,0,6,0" />

                                    <TextBlock Grid.Column="1" Text="{Binding PendingIncrementZ, StringFormat=F3}" FontSize="11" FontWeight="SemiBold" Foreground="#1E88E5" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                    <TextBox Grid.Column="2" Text="{Binding CompensationZExpression, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="0,0,4,0" materialDesign:HintAssist.Hint="Expr" />

                                    <TextBlock Grid.Column="3" Text="{Binding CalculatedCompZ, StringFormat='= {0:F3}'}" FontSize="11" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                    <common:GlobalVariableLinkControl Grid.Column="4" DisplayValue="{Binding CalculatedCompZ}" DisplayForeground="#1E88E5" IsLinked="{Binding IsCompensationZLinked}" UnlinkCommand="{Binding UnlinkCompensationZCommand}" LinkedVariableName="{Binding CompensationZLinkedVar, UpdateSourceTrigger=PropertyChanged}" LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="110" />

                                </Grid>

                                <WrapPanel HorizontalAlignment="Stretch">

                                    <Button Command="{Binding ApplyCompensationCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" Foreground="White" Padding="12,6" Margin="0,0,8,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_ApplyCompensation}">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" Margin="0,0,6,0" />

                                            <TextBlock Text="{lang:Lang NeedleAligner_ApplyCompensation}" FontWeight="SemiBold" />

                                        </StackPanel>

                                    </Button>

                                    <Button Command="{Binding ResetCompensationCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,6" Margin="0,0,8,0" BorderBrush="#FF9800" Foreground="#E65100" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_ResetCompensation}">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,4,0" />

                                            <TextBlock Text="{lang:Lang NeedleAligner_ResetCompensation}" FontSize="12" />

                                        </StackPanel>

                                    </Button>

                                    <Button Command="{Binding ShowCompensationHistoryCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="10,6" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_ShowCompensationHistory}">

                                        <StackPanel Orientation="Horizontal">

                                            <materialDesign:PackIcon Kind="History" Width="14" Height="14" Margin="0,0,4,0" />

                                            <TextBlock Text="{lang:Lang NeedleAligner_ShowCompensationHistory}" FontSize="12" />

                                        </StackPanel>

                                    </Button>

                                </WrapPanel>

                            </StackPanel>

                        </materialDesign:Card>

                    </StackPanel>

                </ScrollViewer>



                <!-- 右：日志 -->

                <ScrollViewer Grid.Column="2" Style="{StaticResource AlwaysVisibleScrollViewerStyle}">

                    <materialDesign:Card UniformCornerRadius="8" Padding="12" Background="{DynamicResource MaterialDesignCardBackground}">

                        <StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">

                                <materialDesign:PackIcon Kind="TextBox" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" />

                                <TextBlock Text="{lang:Lang NeedleAligner_CalibrationLog}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />

                            </StackPanel>

                            <ScrollViewer Style="{StaticResource AlwaysVisibleScrollViewerStyle}" MaxHeight="420" MinHeight="200">

                                <ListBox ItemsSource="{Binding CalibrationLogs}" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderBrush="#E0E0E0" FontFamily="Consolas" FontSize="11">

                                    <ListBox.ItemContainerStyle>

                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">

                                            <Setter Property="Padding" Value="4,2" />

                                            <Setter Property="MinHeight" Value="20" />

                                        </Style>

                                    </ListBox.ItemContainerStyle>

                                </ListBox>

                            </ScrollViewer>

                            <Button Command="{Binding ClearLogCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Right" FontSize="11" ToolTip="{lang:Lang NeedleAligner_ClearLog}">

                                <StackPanel Orientation="Horizontal">

                                    <materialDesign:PackIcon Kind="DeleteSweep" Width="14" Height="14" Margin="0,0,4,0" />

                                    <TextBlock Text="{lang:Lang NeedleAligner_ClearLog}" />

                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </materialDesign:Card>

                </ScrollViewer>

            </Grid>

        </Grid>



        <!-- 底部导航 -->

        <Border Grid.Row="2" Background="#37474F" Padding="16,6">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">

                    <materialDesign:PackIcon Kind="Information" Width="14" Height="14" Foreground="#80CBC4" VerticalAlignment="Center" Margin="0,0,6,0" />

                    <TextBlock Text="{Binding CurrentStepTitle}" Foreground="#80CBC4" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />

                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding CalibrationStatus}" Foreground="#B0BEC5" FontSize="11"

                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"

                           Visibility="{Binding IsStep2Active, Converter={StaticResource BoolToVis}}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Command="{Binding GoPrevCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="10,4" Foreground="White" materialDesign:ButtonAssist.CornerRadius="4">

                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" VerticalAlignment="Center" />

                            <TextBlock Text="{lang:Lang NeedleAligner_PrevStep}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12" />

                        </StackPanel>

                    </Button>

                    <Border Width="1" Height="20" Background="#546E7A" Margin="8,0" VerticalAlignment="Center" />

                    <Button Command="{Binding GoNextCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="10,4" Foreground="White" materialDesign:ButtonAssist.CornerRadius="4">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="{lang:Lang NeedleAligner_NextStep}" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" />

                            <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />

                        </StackPanel>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>

