<UserControl x:Class="Module.Views.NeedleAlignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:Module.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             MinWidth="1100"
             MinHeight="700"
             Background="#EEF2F5">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BooleanToBrushConverter x:Key="LinkedToBrushConverter"
                                                TrueBrush="#1565C0" FalseBrush="#BDBDBD" />

            <Style x:Key="CardHeaderStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="StatusPill" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Background" Value="#F5F5F5" />
            </Style>

            <Style x:Key="ParamRowStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#616161" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <Style x:Key="ParamTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>

            <Style x:Key="ResultValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="Foreground" Value="#424242" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ResultLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="#9E9E9E" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="260" />
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition Width="300" MinWidth="280" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ -->
        <!-- LEFT COLUMN: 参数设置                                          -->
        <!-- ============================================================ -->
        <ScrollViewer Grid.Column="0" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto"
                      IsEnabled="{Binding IsCalibrating, Converter={StaticResource InverseBooleanConverter}}"
                      Margin="0,0,10,0">
            <StackPanel>

                <!-- 搜索点设置卡片 -->
                <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                     Background="{DynamicResource MaterialDesignCardBackground}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="CrosshairsGps" Width="18" Height="18"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lang:Lang NeedleAligner_SearchPointSettings}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        </StackPanel>

                        <!-- 搜索点1 -->
                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="P1" Style="{StaticResource ParamLabelStyle}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint1.X, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                            <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint1.Y, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="1"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="6,2" Margin="4,0,0,0"
                                    materialDesign:ButtonAssist.CornerRadius="4"
                                    ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                            </Button>
                        </Grid>

                        <!-- 搜索点2 -->
                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="P2" Style="{StaticResource ParamLabelStyle}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint2.X, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center"/>
                            <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint2.Y, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="2"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="6,2" Margin="4,0,0,0"
                                    materialDesign:ButtonAssist.CornerRadius="4"
                                    ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                            </Button>
                        </Grid>

                        <!-- 搜索点3 -->
                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="P3" Style="{StaticResource ParamLabelStyle}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint3.X, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                            <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint3.Y, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                            <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="3"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="6,2" Margin="4,0,0,0"
                                    materialDesign:ButtonAssist.CornerRadius="4"
                                    ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                            </Button>
                        </Grid>

                        <!-- 搜索点4 -->
                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="P4" Style="{StaticResource ParamLabelStyle}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint4.X, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center"/>
                            <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint4.Y, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                            <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="4"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="6,2" Margin="4,0,0,0"
                                    materialDesign:ButtonAssist.CornerRadius="4"
                                    ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 参考坐标卡片 -->
                <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                     Background="{DynamicResource MaterialDesignCardBackground}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="MapMarker" Width="18" Height="18"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lang:Lang NeedleAligner_ReferenceCoordinates}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        </StackPanel>

                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="AxisXArrow" Width="16" Height="16"
                                                     Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Grid.Column="1" Text="{Binding Parameters.ReferenceXYZ.X, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="AxisYArrow" Width="16" Height="16"
                                                     Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Grid.Column="1" Text="{Binding Parameters.ReferenceXYZ.Y, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}" />
                        </Grid>
                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="AxisZArrow" Width="16" Height="16"
                                                     Foreground="#1E88E5" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Grid.Column="1" Text="{Binding Parameters.ReferenceXYZ.Z, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 运动参数卡片 -->
                <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,0"
                                     Background="{DynamicResource MaterialDesignCardBackground}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="Tune" Width="18" Height="18"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lang:Lang NeedleAligner_MotionParameters}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        </StackPanel>

                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Radius" Width="16" Height="16"
                                                     Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_SearchRange}"
                                       Style="{StaticResource ParamLabelStyle}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding Parameters.SearchRange, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}"
                                     ToolTip="{lang:Lang NeedleAligner_SearchRangeTip}" />
                        </Grid>
                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Repeat" Width="16" Height="16"
                                                     Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_ZSearchCount}"
                                       Style="{StaticResource ParamLabelStyle}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding Parameters.ZSearchCount}"
                                     Style="{StaticResource ParamTextBoxStyle}"
                                     ToolTip="{lang:Lang NeedleAligner_ZSearchCountTip}" />
                        </Grid>
                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Speedometer" Width="16" Height="16"
                                                     Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_SearchSpeed}"
                                       Style="{StaticResource ParamLabelStyle}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding Parameters.SearchSpeed, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}"
                                     ToolTip="{lang:Lang NeedleAligner_SearchSpeedTip}" />
                        </Grid>
                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="SpeedometerSlow" Width="16" Height="16"
                                                     Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_FineSearchSpeed}"
                                       Style="{StaticResource ParamLabelStyle}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding Parameters.FineSearchSpeed, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}"
                                     ToolTip="{lang:Lang NeedleAligner_FineSearchSpeedTip}" />
                        </Grid>
                        <Grid Style="{StaticResource ParamRowStyle}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Grid.Column="0" Kind="Ruler" Width="16" Height="16"
                                                     Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_NeedleBaseHeight}"
                                       Style="{StaticResource ParamLabelStyle}" Margin="0,0,6,0" />
                            <TextBox Grid.Column="2"
                                     Text="{Binding Parameters.NeedleBaseHeight, StringFormat=F3}"
                                     Style="{StaticResource ParamTextBoxStyle}"
                                     ToolTip="{lang:Lang NeedleAligner_NeedleBaseHeightTip}" />
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 当前文件路径信息 -->
                <Border Background="#E3F2FD" CornerRadius="6" Padding="10,6" Margin="0,16,0,0"
                        Visibility="{Binding CurrentFilePath, Converter={StaticResource NullToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14"
                                                     Foreground="#1565C0" Margin="0,0,6,0"
                                                     VerticalAlignment="Center" />
                            <TextBlock Text="{lang:Lang NeedleAligner_CurrentFile}"
                                       Foreground="#1565C0" FontSize="10" FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding CurrentFilePath}"
                                   Foreground="#1976D2" FontSize="9" FontFamily="Consolas"
                                   TextWrapping="Wrap" Margin="0,2,0,0"
                                   ToolTip="{Binding CurrentFilePath}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!-- CENTER COLUMN: 校准控制 + 结果                                 -->
        <!-- ============================================================ -->
        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>

                <!-- 校准控制卡片 -->
                <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                     Background="{DynamicResource MaterialDesignCardBackground}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="PlayCircle" Width="18" Height="18"
                                                     Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lang:Lang NeedleAligner_CalibrationControl}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Foreground="{DynamicResource SecondaryHueMidBrush}" />
                        </StackPanel>

                        <WrapPanel Margin="0,0,0,12">
                            <Button Command="{Binding StartCalibrationCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#4CAF50" Foreground="White"
                                    Padding="14,6" Margin="0,0,8,0"
                                    materialDesign:ButtonAssist.CornerRadius="4"
                                    ToolTip="{lang:Lang NeedleAligner_StartCalibration}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Play" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="{lang:Lang NeedleAligner_StartCalibration}" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding StopCalibrationCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="14,6"
                                    BorderBrush="#EF5350" Foreground="#C62828"
                                    materialDesign:ButtonAssist.CornerRadius="4"
                                    ToolTip="{lang:Lang NeedleAligner_StopCalibration}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="{lang:Lang NeedleAligner_StopCalibration}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <ProgressBar Value="{Binding CalibrationProgress}" Minimum="0" Maximum="100"
                                     Height="6" Margin="0,0,0,8"
                                     Foreground="{DynamicResource SecondaryHueMidBrush}" />

                        <Border Background="#FAFAFA" CornerRadius="6" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Information" Width="16" Height="16"
                                                         Foreground="#1565C0" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding CalibrationStatus}"
                                           FontSize="12" Foreground="#1565C0" FontWeight="Medium"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 校准结果卡片 -->
                <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,0"
                                     Background="{DynamicResource MaterialDesignCardBackground}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="ClipboardCheck" Width="18" Height="18"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lang:Lang NeedleAligner_CalibrationResults}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        </StackPanel>

                        <!-- 当前坐标 -->
                        <Border Background="#FAFAFA" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{lang:Lang NeedleAligner_CurrentXYZ}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock Text="X=" Style="{StaticResource ResultLabelStyle}" />
                                        <TextBlock Text="{Binding Parameters.CurrentXYZ.X, StringFormat=F3}"
                                                   Style="{StaticResource ResultValueStyle}" Foreground="#E53935" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="Y=" Style="{StaticResource ResultLabelStyle}" />
                                        <TextBlock Text="{Binding Parameters.CurrentXYZ.Y, StringFormat=F3}"
                                                   Style="{StaticResource ResultValueStyle}" Foreground="#43A047" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock Text="Z=" Style="{StaticResource ResultLabelStyle}" />
                                        <TextBlock Text="{Binding Parameters.CurrentXYZ.Z, StringFormat=F3}"
                                                   Style="{StaticResource ResultValueStyle}" Foreground="#1E88E5" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 补偿详情 - 带全局变量链接 -->
                        <Border Background="#FAFAFA" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{lang:Lang NeedleAligner_CompensationDetails}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,8" />

                                <!-- 补偿X -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisXArrow" Width="16" Height="16"
                                                             Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding CompensationManager.CompensationX, StringFormat=F3}"
                                               Style="{StaticResource ResultValueStyle}" Foreground="#E53935" FontWeight="Bold" />
                                    <Button Grid.Column="2" Command="{Binding UnlinkCompensationXCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Padding="0" Width="22" Height="22"
                                            ToolTip="{lang:Lang NeedleAligner_UnlinkGlobalVariable}">
                                        <materialDesign:PackIcon Kind="LinkOff" Width="14" Height="14"
                                                                 Foreground="{Binding IsCompensationXLinked, Converter={StaticResource LinkedToBrushConverter}}"
                                                                 VerticalAlignment="Center" />
                                    </Button>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableGlobalVariables}"
                                              SelectedValuePath="Name"
                                              DisplayMemberPath="Name"
                                              SelectedValue="{Binding CompensationXLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                              Width="120" FontSize="10"
                                              materialDesign:HintAssist.Hint="{lang:Lang NeedleAligner_LinkGlobalVariable}" />
                                </Grid>

                                <!-- 补偿Y -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisYArrow" Width="16" Height="16"
                                                             Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding CompensationManager.CompensationY, StringFormat=F3}"
                                               Style="{StaticResource ResultValueStyle}" Foreground="#43A047" FontWeight="Bold" />
                                    <Button Grid.Column="2" Command="{Binding UnlinkCompensationYCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Padding="0" Width="22" Height="22"
                                            ToolTip="{lang:Lang NeedleAligner_UnlinkGlobalVariable}">
                                        <materialDesign:PackIcon Kind="LinkOff" Width="14" Height="14"
                                                                 Foreground="{Binding IsCompensationYLinked, Converter={StaticResource LinkedToBrushConverter}}"
                                                                 VerticalAlignment="Center" />
                                    </Button>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableGlobalVariables}"
                                              SelectedValuePath="Name"
                                              DisplayMemberPath="Name"
                                              SelectedValue="{Binding CompensationYLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                              Width="120" FontSize="10"
                                              materialDesign:HintAssist.Hint="{lang:Lang NeedleAligner_LinkGlobalVariable}" />
                                </Grid>

                                <!-- 补偿Z -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisZArrow" Width="16" Height="16"
                                                             Foreground="#1E88E5" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding CompensationManager.CompensationZ, StringFormat=F3}"
                                               Style="{StaticResource ResultValueStyle}" Foreground="#1E88E5" FontWeight="Bold" />
                                    <Button Grid.Column="2" Command="{Binding UnlinkCompensationZCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}"
                                            Padding="0" Width="22" Height="22"
                                            ToolTip="{lang:Lang NeedleAligner_UnlinkGlobalVariable}">
                                        <materialDesign:PackIcon Kind="LinkOff" Width="14" Height="14"
                                                                 Foreground="{Binding IsCompensationZLinked, Converter={StaticResource LinkedToBrushConverter}}"
                                                                 VerticalAlignment="Center" />
                                    </Button>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding AvailableGlobalVariables}"
                                              SelectedValuePath="Name"
                                              DisplayMemberPath="Name"
                                              SelectedValue="{Binding CompensationZLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                              Width="120" FontSize="10"
                                              materialDesign:HintAssist.Hint="{lang:Lang NeedleAligner_LinkGlobalVariable}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!-- RIGHT COLUMN: 补偿管理                                          -->
        <!-- ============================================================ -->
        <StackPanel Grid.Column="2" Grid.Row="0">

            <!-- 参数操作卡片 -->
            <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                 Background="{DynamicResource MaterialDesignCardBackground}">
                <StackPanel IsEnabled="{Binding IsCalibrating, Converter={StaticResource InverseBooleanConverter}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{lang:Lang NeedleAligner_ParameterOperations}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    </StackPanel>

                    <WrapPanel>
                        <Button Command="{Binding SaveParametersCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="10,4" Margin="0,0,6,6"
                                ToolTip="{lang:Lang NeedleAligner_SaveParameters}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="{lang:Lang NeedleAligner_SaveParameters}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding LoadParametersCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="10,4" Margin="0,0,6,6"
                                ToolTip="{lang:Lang NeedleAligner_LoadParameters}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="{lang:Lang NeedleAligner_LoadParameters}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>

            <!-- 补偿管理卡片 -->
            <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                 Background="{DynamicResource MaterialDesignCardBackground}">
                <StackPanel IsEnabled="{Binding IsCalibrating, Converter={StaticResource InverseBooleanConverter}}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <materialDesign:PackIcon Kind="MathCompass" Width="18" Height="18"
                                                 Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{lang:Lang NeedleAligner_CompensationManagement}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Foreground="{DynamicResource SecondaryHueMidBrush}" />
                    </StackPanel>

                    <StackPanel>
                        <Button Command="{Binding ResetCompensationCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="10,4" Margin="0,0,0,6"
                                BorderBrush="#FF9800" Foreground="#E65100"
                                HorizontalAlignment="Stretch"
                                materialDesign:ButtonAssist.CornerRadius="4"
                                ToolTip="{lang:Lang NeedleAligner_ResetCompensation}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="{lang:Lang NeedleAligner_ResetCompensation}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ShowCompensationHistoryCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="10,4" Margin="0,0,0,6"
                                HorizontalAlignment="Stretch"
                                materialDesign:ButtonAssist.CornerRadius="4"
                                ToolTip="{lang:Lang NeedleAligner_ShowCompensationHistory}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="14" Height="14" Margin="0,0,5,0" />
                                <TextBlock Text="{lang:Lang NeedleAligner_ShowCompensationHistory}" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ApplyCompensationCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#4CAF50" Foreground="White"
                                Padding="10,6" Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                materialDesign:ButtonAssist.CornerRadius="4"
                                ToolTip="{lang:Lang NeedleAligner_ApplyCompensation}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" Margin="0,0,6,0" />
                                <TextBlock Text="{lang:Lang NeedleAligner_ApplyCompensation}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </materialDesign:Card>

        </StackPanel>

        <!-- ============================================================ -->
        <!-- BOTTOM ROW: 校准日志 (跨第2列和第3列)                             -->
        <!-- ============================================================ -->
        <materialDesign:Card Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                             UniformCornerRadius="8" Padding="16" Margin="0,10,0,0"
                             Background="{DynamicResource MaterialDesignCardBackground}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="TextBox" Width="18" Height="18"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{lang:Lang NeedleAligner_CalibrationLog}"
                               Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding CalibrationLogs}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MaxHeight="200"
                         MinHeight="120"
                         Background="Transparent"
                         BorderBrush="#E0E0E0"
                         FontFamily="Consolas"
                         FontSize="11">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="Padding" Value="4,2" />
                            <Setter Property="MinHeight" Value="20" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Button Command="{Binding ClearLogCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="10,4" Margin="0,8,0,0"
                        HorizontalAlignment="Right"
                        materialDesign:ButtonAssist.CornerRadius="4"
                        ToolTip="{lang:Lang NeedleAligner_ClearLog}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteSweep" Width="14" Height="14" Margin="0,0,5,0" />
                        <TextBlock Text="{lang:Lang NeedleAligner_ClearLog}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</UserControl>
