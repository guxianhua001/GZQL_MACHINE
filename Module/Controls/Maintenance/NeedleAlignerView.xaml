<UserControl x:Class="Module.Views.NeedleAlignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:Module.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1100"
             Background="{DynamicResource MaterialDesignPaper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Module;component/Controls/Maintenance/MaintenanceSharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:StepStateToBrushConverter x:Key="StepStateToBrush" />
            <converters:StepStateToTextBrushConverter x:Key="StepStateToTextBrush" />
            <converters:StepStateToConnectorBrushConverter x:Key="StepStateToConnectorBrush" />

            <Style x:Key="GroupBoxBlueHeader" TargetType="GroupBox">
                <Setter Property="Foreground" Value="#1565C0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>
            <Style x:Key="GroupBoxRedHeader" TargetType="GroupBox">
                <Setter Property="Foreground" Value="#C62828"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="8,0,0,8"/>
            </Style>
            <Style x:Key="GroupBoxTealHeader" TargetType="GroupBox">
                <Setter Property="Foreground" Value="#00838F"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style x:Key="GroupBoxAmberHeader" TargetType="GroupBox">
                <Setter Property="Foreground" Value="#F57C00"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="8,0,0,0"/>
            </Style>

            <Style x:Key="ParamLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#FF607D8B"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ReadOnlyValueText" TargetType="TextBlock">
                <Setter Property="Background" Value="#F5F5F5"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <materialDesign:Card UniformCornerRadius="8" Margin="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ========== 顶部标题栏 ========== -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryHueLightBrush}" Padding="12,8"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Needle" Width="24" Height="24"
                                                     Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{lang:Lang NeedleAligner_Title}" FontSize="18" FontWeight="Medium"
                                       Foreground="{DynamicResource PrimaryHueDarkBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                            <!-- 步骤指示器：紧跟标题靠左 -->
                            <Border Width="26" Height="26" CornerRadius="13"
                                    Background="{Binding Step1State, Converter={StaticResource StepStateToBrush}}">
                                <TextBlock Text="1" Foreground="White" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{lang:Lang NeedleAligner_Step1_Title}" FontSize="10" FontWeight="Medium"
                                           Foreground="{Binding Step1State, Converter={StaticResource StepStateToTextBrush}}"/>
                            </StackPanel>
                            <Border Width="32" Height="2" Margin="6,0" VerticalAlignment="Center"
                                    Background="{Binding Step1State, Converter={StaticResource StepStateToConnectorBrush}}"/>
                            <Border Width="26" Height="26" CornerRadius="13"
                                    Background="{Binding Step2State, Converter={StaticResource StepStateToBrush}}">
                                <TextBlock Text="2" Foreground="White" FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{lang:Lang NeedleAligner_Step2_Title}" FontSize="10" FontWeight="Medium"
                                           Foreground="{Binding Step2State, Converter={StaticResource StepStateToTextBrush}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ========== 主内容区 ========== -->
                <Grid Grid.Row="1" Margin="12">

                    <!-- ===== Step 1：配置示教 ===== -->
                    <Grid Visibility="{Binding IsStep1Active, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左列：运动参数 + 传感器参数 -->
                            <GroupBox Grid.Column="0" Style="{StaticResource GroupBoxBlueHeader}">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{lang:Lang NeedleAligner_MotionParameters}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <TextBlock Text="{lang:Lang NeedleAligner_SearchRange}" Style="{StaticResource ParamLabel}"/>
                                    <materialDesign:DecimalUpDown Value="{Binding Parameters.SearchRange}"
                                                                  ValueStep="0.1" Minimum="0.1" Maximum="10.0"/>
                                    <TextBlock Text="{lang:Lang NeedleAligner_ZSearchCount}" Style="{StaticResource ParamLabel}"/>
                                    <materialDesign:DecimalUpDown Value="{Binding Parameters.ZSearchCount}"
                                                                  ValueStep="1" Minimum="1" Maximum="10"/>
                                    <TextBlock Text="{lang:Lang NeedleAligner_SearchSpeed}" Style="{StaticResource ParamLabel}"/>
                                    <materialDesign:DecimalUpDown Value="{Binding Parameters.SearchSpeed}"
                                                                  ValueStep="0.5" Minimum="0.1" Maximum="20.0"/>
                                    <TextBlock Text="{lang:Lang NeedleAligner_FineSearchSpeed}" Style="{StaticResource ParamLabel}"/>
                                    <materialDesign:DecimalUpDown Value="{Binding Parameters.FineSearchSpeed}"
                                                                  ValueStep="0.1" Minimum="0.1" Maximum="5.0"/>
                                    <TextBlock Text="{lang:Lang NeedleAligner_SafeHeight}" Style="{StaticResource ParamLabel}"/>
                                    <materialDesign:DecimalUpDown Value="{Binding Parameters.SafeHeight}"
                                                                  ValueStep="1" Minimum="0" Maximum="500"/>
                                    <TextBlock Text="{lang:Lang NeedleAligner_SensorDiX}" Style="{StaticResource ParamLabel}"/>
                                    <materialDesign:DecimalUpDown Value="{Binding SensorDiX}"
                                                                  ValueStep="1" Minimum="0" Maximum="65535"/>
                                    <TextBlock Text="{lang:Lang NeedleAligner_SensorDiY}" Style="{StaticResource ParamLabel}"/>
                                    <materialDesign:DecimalUpDown Value="{Binding SensorDiY}"
                                                                  ValueStep="1" Minimum="0" Maximum="65535"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- 右列：系统切换 + 参考坐标 + 对针位置 + 搜索点 -->
                            <GroupBox Grid.Column="1" Style="{StaticResource GroupBoxRedHeader}">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MapMarker" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{lang:Lang NeedleAligner_PositionSettings}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- 系统切换行 -->
                                    <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="SwapHorizontal" Width="16" Height="16"
                                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{lang:Lang NeedleAligner_SystemSelect}" FontSize="12" FontWeight="Medium"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <RadioButton Content="{lang:Lang NeedleSystem1}"
                                                         Command="{Binding System1Command}"
                                                         IsChecked="{Binding SystemNumber, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                                                         Style="{StaticResource MaterialDesignRadioButton}" Margin="0,0,16,0"/>
                                            <RadioButton Content="{lang:Lang NeedleSystem2}"
                                                         Command="{Binding System2Command}"
                                                         IsChecked="{Binding SystemNumber, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}"
                                                         Style="{StaticResource MaterialDesignRadioButton}"/>
                                            <!-- 运行状态指示灯 -->
                                            <Border Width="8" Height="8" CornerRadius="4" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#BDBDBD"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCalibrating}" Value="True">
                                                                <Setter Property="Background" Value="#FFA000"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- 参考坐标（只读文本） -->
                                    <GroupBox Grid.Row="1" Margin="0,0,0,8" Foreground="#7E57C2" FontWeight="SemiBold" >
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="MapMarker" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{lang:Lang NeedleAligner_ReferenceCoordinates}"/>
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="X" Style="{StaticResource ParamLabel}" Foreground="#E53935" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Parameters.ReferenceXYZ.X, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0">
                                                <TextBlock Text="Y" Style="{StaticResource ParamLabel}" Foreground="#43A047" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Parameters.ReferenceXYZ.Y, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="4,0,0,0">
                                                <TextBlock Text="Z" Style="{StaticResource ParamLabel}" Foreground="#7E57C2" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Parameters.ReferenceXYZ.Z, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}"/>
                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>

                                    <!-- 对针位置（只读文本 + 示教按钮） -->
                                    <GroupBox Grid.Row="2" Margin="0,0,0,8" Foreground="#00838F" FontWeight="SemiBold" >
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Target" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding CurrentAlignPositionTitle}"/>
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                                <TextBlock Text="X" Style="{StaticResource ParamLabel}" Foreground="#E53935" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CurrentAlignX, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="4,0">
                                                <TextBlock Text="Y" Style="{StaticResource ParamLabel}" Foreground="#43A047" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CurrentAlignY, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="4,0">
                                                <TextBlock Text="Z" Style="{StaticResource ParamLabel}" Foreground="#7E57C2" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding CurrentAlignZ, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}"/>
                                            </StackPanel>
                                            <Button Grid.Column="3" VerticalAlignment="Bottom"
                                                    Command="{Binding TeachAlignPositionCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Padding="6,4" Margin="4,0,0,0"
                                                    materialDesign:ButtonAssist.CornerRadius="4"
                                                    ToolTip="{lang:Lang NeedleAligner_TeachAlignPosition}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{lang:Lang NeedleAligner_Teach}" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </GroupBox>

                                    <!-- 搜索点 P1-P4（只读文本 + 示教按钮） -->
                                    <GroupBox Grid.Row="3" Foreground="#F57C00" FontWeight="SemiBold" >
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CrosshairsGps" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{lang:Lang NeedleAligner_SearchPointSettings}"/>
                                            </StackPanel>
                                        </GroupBox.Header>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- P1 -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="P1" Style="{StaticResource ParamLabel}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Parameters.SearchPoint1.X, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" Margin="0,0,4,4"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Parameters.SearchPoint1.Y, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" Margin="0,0,4,4"/>
                                            <Button Grid.Row="0" Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="1"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="4,2" Margin="0,0,0,4" Width="36"
                                                    materialDesign:ButtonAssist.CornerRadius="4" VerticalAlignment="Bottom"
                                                    ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                                <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14"/>
                                            </Button>

                                            <!-- P2 -->
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="P2" Style="{StaticResource ParamLabel}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Parameters.SearchPoint2.X, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" Margin="0,0,4,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Parameters.SearchPoint2.Y, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" Margin="0,0,4,4"/>
                                            <Button Grid.Row="1" Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="2"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="4,2" Margin="0,0,0,4"
                                                    materialDesign:ButtonAssist.CornerRadius="4" VerticalAlignment="Bottom"
                                                    ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                                <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14"/>
                                            </Button>

                                            <!-- P3 -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="P3" Style="{StaticResource ParamLabel}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Parameters.SearchPoint3.X, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" Margin="0,0,4,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Parameters.SearchPoint3.Y, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" Margin="0,0,4,4"/>
                                            <Button Grid.Row="2" Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="3"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="4,2" Margin="0,0,0,4"
                                                    materialDesign:ButtonAssist.CornerRadius="4" VerticalAlignment="Bottom"
                                                    ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                                <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14"/>
                                            </Button>

                                            <!-- P4 -->
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="P4" Style="{StaticResource ParamLabel}" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Parameters.SearchPoint4.X, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" Margin="0,0,4,0"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Parameters.SearchPoint4.Y, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" Margin="0,0,4,0"/>
                                            <Button Grid.Row="3" Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="4"
                                                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="4,2"
                                                    materialDesign:ButtonAssist.CornerRadius="4" VerticalAlignment="Bottom"
                                                    ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                                <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14"/>
                                            </Button>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>

                    <!-- ===== Step 2：校准执行与应用 ===== -->
                    <Grid Visibility="{Binding IsStep2Active, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左列：校准控制 + 测量结果 -->
                            <GroupBox Grid.Column="0" Style="{StaticResource GroupBoxTealHeader}">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlayCircle" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{lang:Lang NeedleAligner_CalibrationControl}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <!-- 操作按钮组 -->
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Command="{Binding StartCalibrationCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}"
                                                Background="#43A047" Foreground="White" Margin="0,0,6,0"
                                                materialDesign:ButtonAssist.CornerRadius="4"
                                                ToolTip="{lang:Lang NeedleAligner_StartCalibration}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Play" Width="14" Height="14" Margin="0,0,4,0"/>
                                                <TextBlock Text="{lang:Lang NeedleAligner_StartCalibration}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding StopCalibrationCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                                BorderBrush="#EF5350" Foreground="#C62828"
                                                materialDesign:ButtonAssist.CornerRadius="4"
                                                ToolTip="{lang:Lang NeedleAligner_StopCalibration}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Stop" Width="14" Height="14" Margin="0,0,4,0"/>
                                                <TextBlock Text="{lang:Lang NeedleAligner_StopCalibration}" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                    </WrapPanel>

                                    <!-- 进度条 -->
                                    <ProgressBar Value="{Binding CalibrationProgress}" Height="4" Minimum="0" Maximum="100"
                                                 Margin="0,0,0,6" Foreground="{DynamicResource SecondaryHueMidBrush}"/>

                                    <!-- 状态文本 -->
                                    <TextBlock Text="{Binding CalibrationStatus}" FontSize="11" Foreground="#5E35B1"
                                               FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <!-- 当前坐标 -->
                                    <TextBlock Text="{lang:Lang NeedleAligner_CurrentXYZ}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#9E9E9E" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,0">
                                            <TextBlock Text="X=" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Parameters.CurrentXYZ.X, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                                            <TextBlock Text="Y=" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Parameters.CurrentXYZ.Y, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                                            <TextBlock Text="Z=" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Parameters.CurrentXYZ.Z, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- TCP总偏移 -->
                                    <TextBlock Text="{lang:Lang NeedleAligner_TcpTotalOffset}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#2E7D32" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,0">
                                            <TextBlock Text="X=" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TcpTotalOffsetX, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                                            <TextBlock Text="Y=" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TcpTotalOffsetY, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                                            <TextBlock Text="Z=" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TcpTotalOffsetZ, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 待应用增量 -->
                                    <TextBlock Text="{lang:Lang NeedleAligner_PendingIncrement}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#F57C00" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,4,0">
                                            <TextBlock Text="X=" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PendingIncrementX, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4,0">
                                            <TextBlock Text="Y=" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PendingIncrementY, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="4,0,0,0">
                                            <TextBlock Text="Z=" FontSize="11" Foreground="#9E9E9E" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PendingIncrementZ, StringFormat=F3}" Style="{StaticResource ReadOnlyValueText}" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </GroupBox>

                            <!-- 右列：补偿管理 + 日志 -->
                            <GroupBox Grid.Column="1" Style="{StaticResource GroupBoxAmberHeader}">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MathCompass" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{lang:Lang NeedleAligner_CompensationDetails}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- X轴补偿行 -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Grid.Column="0" Kind="AxisXArrow" Width="14" Height="14"
                                                                 Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PendingIncrementX, StringFormat=F3}"
                                                 Style="{StaticResource ReadOnlyValueText}" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding CompensationXExpression, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Padding="3,2" Margin="0,0,4,0"
                                                 materialDesign:HintAssist.Hint="Expr"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CalculatedCompX, StringFormat='= {0:F3}'}"
                                                 Style="{StaticResource ReadOnlyValueText}" FontSize="11" Margin="0,0,4,0"/>
                                        <common:GlobalVariableLinkControl Grid.Column="4"
                                            DisplayValue="{Binding CalculatedCompX}" DisplayForeground="#E53935"
                                            IsLinked="{Binding IsCompensationXLinked}"
                                            UnlinkCommand="{Binding UnlinkCompensationXCommand}"
                                            LinkedVariableName="{Binding CompensationXLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                            LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="166"/>
                                    </Grid>

                                    <!-- Y轴补偿行 -->
                                    <Grid Grid.Row="1" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Grid.Column="0" Kind="AxisYArrow" Width="14" Height="14"
                                                                 Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PendingIncrementY, StringFormat=F3}"
                                                 Style="{StaticResource ReadOnlyValueText}" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding CompensationYExpression, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Padding="3,2" Margin="0,0,4,0"
                                                 materialDesign:HintAssist.Hint="Expr"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CalculatedCompY, StringFormat='= {0:F3}'}"
                                                 Style="{StaticResource ReadOnlyValueText}" FontSize="11" Margin="0,0,4,0"/>
                                        <common:GlobalVariableLinkControl Grid.Column="4"
                                            DisplayValue="{Binding CalculatedCompY}" DisplayForeground="#43A047"
                                            IsLinked="{Binding IsCompensationYLinked}"
                                            UnlinkCommand="{Binding UnlinkCompensationYCommand}"
                                            LinkedVariableName="{Binding CompensationYLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                            LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="166"/>
                                    </Grid>

                                    <!-- Z轴补偿行 -->
                                    <Grid Grid.Row="2" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="72"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Grid.Column="0" Kind="AxisZArrow" Width="14" Height="14"
                                                                 Foreground="#1E88E5" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding PendingIncrementZ, StringFormat=F3}"
                                                 Style="{StaticResource ReadOnlyValueText}" FontSize="11" Margin="0,0,4,0"/>
                                        <TextBox Grid.Column="2" Text="{Binding CompensationZExpression, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="11" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Padding="3,2" Margin="0,0,4,0"
                                                 materialDesign:HintAssist.Hint="Expr"/>
                                        <TextBlock Grid.Column="3" Text="{Binding CalculatedCompZ, StringFormat='= {0:F3}'}"
                                                 Style="{StaticResource ReadOnlyValueText}" FontSize="11" Margin="0,0,4,0"/>
                                        <common:GlobalVariableLinkControl Grid.Column="4"
                                            DisplayValue="{Binding CalculatedCompZ}" DisplayForeground="#1E88E5"
                                            IsLinked="{Binding IsCompensationZLinked}"
                                            UnlinkCommand="{Binding UnlinkCompensationZCommand}"
                                            LinkedVariableName="{Binding CompensationZLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                            LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="166"/>
                                    </Grid>

                                    <!-- 补偿操作按钮 + 日志 -->
                                    <Grid Grid.Row="3">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                                            <Button Command="{Binding ApplyCompensationCommand}"
                                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                                    Background="#43A047" Foreground="White" Margin="0,0,6,0"
                                                    materialDesign:ButtonAssist.CornerRadius="4"
                                                    ToolTip="{lang:Lang NeedleAligner_ApplyCompensation}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{lang:Lang NeedleAligner_ApplyCompensation}" FontWeight="SemiBold" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ResetCompensationCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    BorderBrush="#FF9800" Foreground="#E65100" Margin="0,0,6,0"
                                                    materialDesign:ButtonAssist.CornerRadius="4"
                                                    ToolTip="{lang:Lang NeedleAligner_ResetCompensation}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Refresh" Width="12" Height="12" Margin="0,0,3,0"/>
                                                    <TextBlock Text="{lang:Lang NeedleAligner_ResetCompensation}" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding ShowCompensationHistoryCommand}"
                                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                                    materialDesign:ButtonAssist.CornerRadius="4"
                                                    ToolTip="{lang:Lang NeedleAligner_ShowCompensationHistory}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="History" Width="12" Height="12" Margin="0,0,3,0"/>
                                                    <TextBlock Text="{lang:Lang NeedleAligner_ShowCompensationHistory}" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>

                                        <!-- 日志列表 -->
                                        <GroupBox Grid.Row="1" Foreground="#757575" FontWeight="SemiBold" >
                                            <GroupBox.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="TextBox" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{lang:Lang NeedleAligner_CalibrationLog}"/>
                                                </StackPanel>
                                            </GroupBox.Header>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <ListBox Grid.Row="0" ItemsSource="{Binding CalibrationLogs}"
                                                         VirtualizingStackPanel.IsVirtualizing="True"
                                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                         Background="Transparent" BorderBrush="#E0E0E0"
                                                         FontFamily="Consolas" FontSize="10" MinHeight="80">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                                            <Setter Property="Padding" Value="3,1"/>
                                                            <Setter Property="MinHeight" Value="18"/>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                </ListBox>
                                                <Button Grid.Row="1" Command="{Binding ClearLogCommand}"
                                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                                        Padding="6,3" Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="10"
                                                        materialDesign:ButtonAssist.CornerRadius="4"
                                                        ToolTip="{lang:Lang NeedleAligner_ClearLog}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="DeleteSweep" Width="12" Height="12" Margin="0,0,3,0"/>
                                                        <TextBlock Text="{lang:Lang NeedleAligner_ClearLog}"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- ========== 底部操作栏 ========== -->
                <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}" Padding="10,8,14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 当前步骤信息 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Information" Width="14" Height="14"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentStepTitle}" Foreground="{DynamicResource PrimaryHueMidBrush}" FontSize="12"
                                       FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 中央状态文本 -->
                        <TextBlock Grid.Column="1" Text="{Binding CalibrationStatus}" Foreground="#757575" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding IsStep2Active, Converter={StaticResource BoolToVis}}"/>

                        <!-- 文件操作 + 步骤导航 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 文件操作 -->
                            <Border Background="#F5F5F5" CornerRadius="4" Padding="8,4" Margin="0,0,8,0"
                                    Visibility="{Binding CurrentFilePath, Converter={StaticResource NullToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="12" Height="12" Foreground="#9E9E9E"
                                                             VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding CurrentFileName}" Foreground="#7E57C2" FontSize="9"
                                               FontFamily="Consolas" TextTrimming="CharacterEllipsis" MaxWidth="120"
                                               ToolTip="{Binding CurrentFilePath}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button Command="{Binding SaveParametersCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="8,4" Margin="0,0,4,0" materialDesign:ButtonAssist.CornerRadius="4"
                                    ToolTip="{lang:Lang NeedleAligner_SaveParameters}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang NeedleAligner_SaveParameters}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding LoadParametersCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="8,4" Margin="0,0,12,0" materialDesign:ButtonAssist.CornerRadius="4"
                                    ToolTip="{lang:Lang NeedleAligner_LoadParameters}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang NeedleAligner_LoadParameters}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="18" Background="#E0E0E0" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <!-- 步骤导航 -->
                            <Button Command="{Binding GoPrevCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="8,4" materialDesign:ButtonAssist.CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ChevronLeft" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang NeedleAligner_PrevStep}" Margin="3,0,0,0" VerticalAlignment="Center" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding GoNextCommand}" Style="{StaticResource MaterialDesignRaisedButton}"
                                    Padding="8,4" Margin="4,0,0,0" materialDesign:ButtonAssist.CornerRadius="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{lang:Lang NeedleAligner_NextStep}" Margin="0,0,3,0" VerticalAlignment="Center" FontSize="11"/>
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </materialDesign:Card>
    </ScrollViewer>
</UserControl>

