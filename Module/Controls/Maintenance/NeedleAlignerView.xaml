<UserControl x:Class="Module.Views.NeedleAlignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:Module.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1100"
             Background="#EEF2F5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Module;component/Controls/Maintenance/MaintenanceSharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
            <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:BooleanToBrushConverter x:Key="LinkedToBrushConverter"
                                                TrueBrush="#5E35B1" FalseBrush="#BDBDBD" />
            <converters:StepStateToBrushConverter x:Key="StepStateToBrush" />
            <converters:StepStateToTextBrushConverter x:Key="StepStateToTextBrush" />
            <converters:StepStateToConnectorBrushConverter x:Key="StepStateToConnectorBrush" />

            <Style x:Key="CardHeaderStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
            <Style x:Key="SideCardHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline6TextBlock}">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SideActionButtonContentStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatusPill" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Background" Value="#F5F5F5" />
            </Style>
            <Style x:Key="ParamRowStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#616161" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ParamTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="MinWidth" Value="0" />
            </Style>
            <Style x:Key="ResultValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="Foreground" Value="#424242" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ResultLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="#9E9E9E" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== 顶部步骤指示器 ===================== -->
        <Border Grid.Row="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Step 1: 参数设置 -->
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding Step1State, Converter={StaticResource StepStateToBrush}}">
                            <TextBlock Text="1" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{lang:Lang NeedleAligner_Step1_Title}" FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding Step1State, Converter={StaticResource StepStateToTextBrush}}" />
                            <TextBlock Text="{lang:Lang NeedleAligner_Step1_Desc}" FontSize="10" Foreground="#757575" />
                        </StackPanel>
                    </StackPanel>
                    <Border Width="40" Height="3" Margin="10,0" VerticalAlignment="Center"
                            Background="{Binding Step1State, Converter={StaticResource StepStateToConnectorBrush}}" />
                    <!-- Step 2: 示教定位 -->
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding Step2State, Converter={StaticResource StepStateToBrush}}">
                            <TextBlock Text="2" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{lang:Lang NeedleAligner_Step2_Title}" FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding Step2State, Converter={StaticResource StepStateToTextBrush}}" />
                            <TextBlock Text="{lang:Lang NeedleAligner_Step2_Desc}" FontSize="10" Foreground="#757575" />
                        </StackPanel>
                    </StackPanel>
                    <Border Width="40" Height="3" Margin="10,0" VerticalAlignment="Center"
                            Background="{Binding Step2State, Converter={StaticResource StepStateToConnectorBrush}}" />
                    <!-- Step 3: 执行校准 -->
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding Step3State, Converter={StaticResource StepStateToBrush}}">
                            <TextBlock Text="3" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{lang:Lang NeedleAligner_Step3_Title}" FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding Step3State, Converter={StaticResource StepStateToTextBrush}}" />
                            <TextBlock Text="{lang:Lang NeedleAligner_Step3_Desc}" FontSize="10" Foreground="#757575" />
                        </StackPanel>
                    </StackPanel>
                    <Border Width="40" Height="3" Margin="10,0" VerticalAlignment="Center"
                            Background="{Binding Step3State, Converter={StaticResource StepStateToConnectorBrush}}" />
                    <!-- Step 4: 补偿应用 -->
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding Step4State, Converter={StaticResource StepStateToBrush}}">
                            <TextBlock Text="4" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{lang:Lang NeedleAligner_Step4_Title}" FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding Step4State, Converter={StaticResource StepStateToTextBrush}}" />
                            <TextBlock Text="{lang:Lang NeedleAligner_Step4_Desc}" FontSize="10" Foreground="#757575" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧：系统切换 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="{lang:Lang NeedleSystem1}"
                                 Command="{Binding System1Command}"
                                 IsChecked="{Binding SystemNumber, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                                 Style="{StaticResource MaterialDesignRadioButton}" Margin="0,0,12,0" />
                    <RadioButton Content="{lang:Lang NeedleSystem2}"
                                 Command="{Binding System2Command}"
                                 IsChecked="{Binding SystemNumber, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}"
                                 Style="{StaticResource MaterialDesignRadioButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 主内容区 ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" MaxWidth="380" />
                <ColumnDefinition Width="1.5*" MinWidth="380" />
                <ColumnDefinition Width="*" MinWidth="200" MaxWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ==================== STEP 1: 参数设置 ==================== -->
            <Grid Visibility="{Binding IsStep1Active, Converter={StaticResource BoolToVis}}"
                  Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" MaxWidth="380" />
                    <ColumnDefinition Width="1.5*" MinWidth="380" />
                    <ColumnDefinition Width="*" MinWidth="200" MaxWidth="320" />
                </Grid.ColumnDefinitions>
                <!-- 左列：运动参数 -->
                <ScrollViewer Grid.Column="0" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Margin="0,0,6,0">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <!-- 运动参数卡片 -->
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Tune" Width="18" Height="18"
                                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                             Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_MotionParameters}"
                                               Style="{StaticResource SideCardHeaderTextStyle}"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="Radius" Width="16" Height="16" Foreground="#9E9E9E" VerticalAlignment="Top" Margin="0,2,4,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{lang:Lang NeedleAligner_SearchRange}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_SearchRangeTip}" />
                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Parameters.SearchRange, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="Repeat" Width="16" Height="16" Foreground="#9E9E9E" VerticalAlignment="Top" Margin="0,2,4,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{lang:Lang NeedleAligner_ZSearchCount}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_ZSearchCountTip}" />
                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Parameters.ZSearchCount}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="Speedometer" Width="16" Height="16" Foreground="#9E9E9E" VerticalAlignment="Top" Margin="0,2,4,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{lang:Lang NeedleAligner_SearchSpeed}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_SearchSpeedTip}" />
                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Parameters.SearchSpeed, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="SpeedometerSlow" Width="16" Height="16" Foreground="#9E9E9E" VerticalAlignment="Top" Margin="0,2,4,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{lang:Lang NeedleAligner_FineSearchSpeed}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_FineSearchSpeedTip}" />
                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Parameters.FineSearchSpeed, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="ArrowUpBold" Width="16" Height="16" Foreground="#9E9E9E" VerticalAlignment="Top" Margin="0,2,4,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{lang:Lang NeedleAligner_SafeHeight}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_SafeHeightTip}" />
                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Parameters.SafeHeight, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="ElectricSwitch" Width="16" Height="16" Foreground="#9E9E9E" VerticalAlignment="Top" Margin="0,2,4,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{lang:Lang NeedleAligner_SensorDiX}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_SensorDiXTip}" />
                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SensorDiX, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="ElectricSwitch" Width="16" Height="16" Foreground="#9E9E9E" VerticalAlignment="Top" Margin="0,2,4,0" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{lang:Lang NeedleAligner_SensorDiY}" Style="{StaticResource ParamLabelStyle}" ToolTip="{lang:Lang NeedleAligner_SensorDiYTip}" />
                                    <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding SensorDiY, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
                <!-- 中列：参考坐标 + 搜索点 -->
                <ScrollViewer Grid.Column="1" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Margin="0,0,6,0">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <!-- 参考坐标卡片 -->
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="MapMarker" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_ReferenceCoordinates}" ToolTip="{lang:Lang NeedleAligner_ReferenceCoordinatesTip}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisXArrow" Width="16" Height="16" Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.ReferenceXYZ.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisYArrow" Width="16" Height="16" Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.ReferenceXYZ.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisZArrow" Width="16" Height="16" Foreground="#7E57C2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.ReferenceXYZ.Z, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                        <!-- 搜索点设置卡片 -->
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="CrosshairsGps" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_SearchPointSettings}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="P1" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint1.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint1.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="1" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" Margin="4,0,0,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="P2" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint2.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint2.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="2" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" Margin="4,0,0,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="P3" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint3.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint3.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="3" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" Margin="4,0,0,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="P4" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint4.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint4.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="4" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" Margin="4,0,0,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
                <!-- 右列：参数操作 -->
                <ScrollViewer Grid.Column="2" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_ParameterOperations}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Grid>
                                <Button Command="{Binding SaveParametersCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,0,0,4" ToolTip="{lang:Lang NeedleAligner_SaveParameters}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,6,0" />
                                        <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_SaveParameters}" Style="{StaticResource SideActionButtonContentStyle}" />
                                    </Grid>
                                </Button>
                                <Button Command="{Binding LoadParametersCommand}" Style="{StaticResource MaterialDesignRaisedButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,5" ToolTip="{lang:Lang NeedleAligner_LoadParameters}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,6,0" />
                                        <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_LoadParameters}" Style="{StaticResource SideActionButtonContentStyle}" />
                                    </Grid>
                                </Button>
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="8,5" Margin="0,8,0,0" Visibility="{Binding CurrentFilePath, Converter={StaticResource NullToVis}}">
                                    <StackPanel>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14" Foreground="#9E9E9E" Margin="0,2,6,0" VerticalAlignment="Top" />
                                            <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_CurrentFile}" Foreground="#9E9E9E" FontSize="10" FontWeight="Medium" TextWrapping="Wrap" />
                                        </Grid>
                                        <TextBlock Text="{Binding CurrentFilePath}" Foreground="#7E57C2" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" ToolTip="{Binding CurrentFilePath}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== STEP 2: 示教定位 ==================== -->
            <Grid Visibility="{Binding IsStep2Active, Converter={StaticResource BoolToVis}}"
                  Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" MaxWidth="380" />
                    <ColumnDefinition Width="1.5*" MinWidth="380" />
                    <ColumnDefinition Width="*" MinWidth="200" MaxWidth="320" />
                </Grid.ColumnDefinitions>
                <!-- 左列：搜索点 -->
                <ScrollViewer Grid.Column="0" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Margin="0,0,6,0"
                              IsEnabled="{Binding IsCalibrating, Converter={StaticResource InverseBooleanConverter}}">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="CrosshairsGps" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_SearchPointSettings}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="P1" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint1.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint1.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="1" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" Margin="4,0,0,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="P2" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint2.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint2.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="2" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" Margin="4,0,0,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="P3" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint3.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint3.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="3" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" Margin="4,0,0,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="P4" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.SearchPoint4.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding Parameters.SearchPoint4.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="3" Command="{Binding TeachSearchPointCommand}" CommandParameter="4" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" Margin="4,0,0,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachSearchPoint}">
                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
                <!-- 中列：对针位置 -->
                <ScrollViewer Grid.Column="1" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Margin="0,0,6,0"
                              IsEnabled="{Binding IsCalibrating, Converter={StaticResource InverseBooleanConverter}}">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Target" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding CurrentAlignPositionTitle}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{lang:Lang NeedleAligner_Axis_X}" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Text="{Binding CurrentAlignX, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{lang:Lang NeedleAligner_Axis_Y}" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" Foreground="#43A047" VerticalAlignment="Center" Margin="4,0,4,0" />
                                    <TextBox Grid.Column="3" Text="{Binding CurrentAlignY, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{lang:Lang NeedleAligner_Axis_Z}" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" Foreground="#7E57C2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Text="{Binding CurrentAlignZ, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ParamTextBoxStyle}" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="2" Command="{Binding TeachAlignPositionCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2" Margin="4,0,0,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_TeachAlignPosition}">
                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                    </Button>
                                </Grid>
                                <!-- 提示说明 -->
                                <Border Background="#E3F2FD" CornerRadius="6" Padding="10,8" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="#1565C0" Margin="0,2,8,0" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_Step2_Guide}" Foreground="#1565C0" FontSize="12" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
                <!-- 右列：参考坐标 -->
                <ScrollViewer Grid.Column="2" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="MapMarker" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_ReferenceCoordinates}" ToolTip="{lang:Lang NeedleAligner_ReferenceCoordinatesTip}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisXArrow" Width="16" Height="16" Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.ReferenceXYZ.X, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisYArrow" Width="16" Height="16" Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.ReferenceXYZ.Y, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisZArrow" Width="16" Height="16" Foreground="#7E57C2" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Column="1" Text="{Binding Parameters.ReferenceXYZ.Z, StringFormat=F3}" Style="{StaticResource ParamTextBoxStyle}" />
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== STEP 3: 执行校准 ==================== -->
            <Grid Visibility="{Binding IsStep3Active, Converter={StaticResource BoolToVis}}"
                  Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" MaxWidth="380" />
                    <ColumnDefinition Width="1.5*" MinWidth="380" />
                    <ColumnDefinition Width="*" MinWidth="200" MaxWidth="320" />
                </Grid.ColumnDefinitions>
                <!-- 左列：运动参数摘要 -->
                <ScrollViewer Grid.Column="0" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Margin="0,0,6,0">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_MotionParameters}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Grid>
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock FontSize="11" Foreground="#616161" Margin="0,0,0,4">
                                            <Run Text="{lang:Lang NeedleAligner_SearchRange}" /><Run Text=": " /><Run Text="{Binding Parameters.SearchRange, StringFormat=F3, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#616161" Margin="0,0,0,4">
                                            <Run Text="{lang:Lang NeedleAligner_ZSearchCount}" /><Run Text=": " /><Run Text="{Binding Parameters.ZSearchCount, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#616161" Margin="0,0,0,4">
                                            <Run Text="{lang:Lang NeedleAligner_SearchSpeed}" /><Run Text=": " /><Run Text="{Binding Parameters.SearchSpeed, StringFormat=F3, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#616161" Margin="0,0,0,4">
                                            <Run Text="{lang:Lang NeedleAligner_FineSearchSpeed}" /><Run Text=": " /><Run Text="{Binding Parameters.FineSearchSpeed, StringFormat=F3, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="#616161">
                                            <Run Text="{lang:Lang NeedleAligner_SafeHeight}" /><Run Text=": " /><Run Text="{Binding Parameters.SafeHeight, StringFormat=F3, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
                <!-- 中列：校准控制 + 结果 -->
                <ScrollViewer Grid.Column="1" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Margin="0,0,6,0">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <!-- 校准控制卡片 -->
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="PlayCircle" Width="18" Height="18" Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{lang:Lang NeedleAligner_CalibrationControl}" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Foreground="{DynamicResource SecondaryHueMidBrush}" />
                                </StackPanel>
                                <WrapPanel Margin="0,0,0,12">
                                    <Button Command="{Binding StartCalibrationCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" Foreground="White" Padding="14,6" Margin="0,0,8,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_StartCalibration}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Play" Width="16" Height="16" Margin="0,0,6,0" />
                                            <TextBlock Text="{lang:Lang NeedleAligner_StartCalibration}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding StopCalibrationCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="14,6" BorderBrush="#EF5350" Foreground="#C62828" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_StopCalibration}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" Margin="0,0,6,0" />
                                            <TextBlock Text="{lang:Lang NeedleAligner_StopCalibration}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <ProgressBar Value="{Binding CalibrationProgress}" Minimum="0" Maximum="100" Height="6" Margin="0,0,0,8" Foreground="{DynamicResource SecondaryHueMidBrush}" />
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Information" Width="16" Height="16" Foreground="#5E35B1" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CalibrationStatus}" FontSize="12" Foreground="#5E35B1" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>
                        <!-- 校准结果卡片 -->
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="ClipboardCheck" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{lang:Lang NeedleAligner_CalibrationResults}" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </StackPanel>
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{lang:Lang NeedleAligner_CurrentXYZ}" FontSize="11" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"><TextBlock Text="X=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding Parameters.CurrentXYZ.X, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#E53935" /></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Y=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding Parameters.CurrentXYZ.Y, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#43A047" /></StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Z=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding Parameters.CurrentXYZ.Z, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#7E57C2" /></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Background="#E8F5E9" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{lang:Lang NeedleAligner_TcpTotalOffset}" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"><TextBlock Text="X=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding TcpTotalOffsetX, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#E53935" /></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Y=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding TcpTotalOffsetY, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#43A047" /></StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Z=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding TcpTotalOffsetZ, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#1E88E5" /></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
                <!-- 右列：校准日志 -->
                <ScrollViewer Grid.Column="2" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="TextBox" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_CalibrationLog}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Grid>
                                <ScrollViewer Style="{StaticResource AlwaysVisibleScrollViewerStyle}" MaxHeight="300" MinHeight="120">
                                    <ListBox ItemsSource="{Binding CalibrationLogs}" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderBrush="#E0E0E0" FontFamily="Consolas" FontSize="11">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                                <Setter Property="Padding" Value="4,2" />
                                                <Setter Property="MinHeight" Value="20" />
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </ScrollViewer>
                                <Button Command="{Binding ClearLogCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Right" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_ClearLog}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DeleteSweep" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang NeedleAligner_ClearLog}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ==================== STEP 4: 补偿应用 ==================== -->
            <Grid Visibility="{Binding IsStep4Active, Converter={StaticResource BoolToVis}}"
                  Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="240" MaxWidth="380" />
                    <ColumnDefinition Width="1.5*" MinWidth="380" />
                    <ColumnDefinition Width="*" MinWidth="200" MaxWidth="320" />
                </Grid.ColumnDefinitions>
                <!-- 左列：校准结果摘要 -->
                <ScrollViewer Grid.Column="0" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Margin="0,0,6,0">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="ClipboardCheck" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_CalibrationResults}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </Grid>
                                <Border Background="#FAFAFA" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{lang:Lang NeedleAligner_CurrentXYZ}" FontSize="11" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"><TextBlock Text="X=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding Parameters.CurrentXYZ.X, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#E53935" /></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Y=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding Parameters.CurrentXYZ.Y, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#43A047" /></StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Z=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding Parameters.CurrentXYZ.Z, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#7E57C2" /></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Background="#E8F5E9" CornerRadius="6" Padding="10,8">
                                    <StackPanel>
                                        <TextBlock Text="{lang:Lang NeedleAligner_TcpTotalOffset}" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"><TextBlock Text="X=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding TcpTotalOffsetX, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#E53935" /></StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"><TextBlock Text="Y=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding TcpTotalOffsetY, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#43A047" /></StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"><TextBlock Text="Z=" Style="{StaticResource ResultLabelStyle}" /><TextBlock Text="{Binding TcpTotalOffsetZ, StringFormat=F3}" Style="{StaticResource ResultValueStyle}" Foreground="#1E88E5" /></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
                <!-- 中列：补偿详情 -->
                <ScrollViewer Grid.Column="1" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Margin="0,0,6,0">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="MathCompass" Width="18" Height="18" Foreground="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{lang:Lang NeedleAligner_CompensationDetails}" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                </StackPanel>
                                <!-- 列标题 -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="" Width="22" />
                                    <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_PendingIncrement}" FontSize="11" Foreground="#9E9E9E" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{lang:Lang NeedleCamera_CompensationExpression}" FontSize="11" Foreground="#9E9E9E" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{lang:Lang NeedleAligner_TcpTotalAfterApply}" FontSize="11" Foreground="#9E9E9E" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="" FontSize="11" />
                                </Grid>
                                <!-- X -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisXArrow" Width="16" Height="16" Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding PendingIncrementX, StringFormat=F3}" FontSize="11" FontWeight="SemiBold" Foreground="#E53935" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding CompensationXExpression, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="0,0,4,0" materialDesign:HintAssist.Hint="{lang:Lang NeedleCamera_CompensationExpression}" />
                                    <TextBlock Grid.Column="3" Text="{Binding CalculatedCompX, StringFormat='= {0:F3}'}" FontSize="11" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="4,0,4,0" />
                                    <common:GlobalVariableLinkControl Grid.Column="4" DisplayValue="{Binding CalculatedCompX}" DisplayForeground="#E53935" IsLinked="{Binding IsCompensationXLinked}" UnlinkCommand="{Binding UnlinkCompensationXCommand}" LinkedVariableName="{Binding CompensationXLinkedVar, UpdateSourceTrigger=PropertyChanged}" LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="120" />
                                </Grid>
                                <!-- Y -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisYArrow" Width="16" Height="16" Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding PendingIncrementY, StringFormat=F3}" FontSize="11" FontWeight="SemiBold" Foreground="#43A047" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding CompensationYExpression, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="0,0,4,0" materialDesign:HintAssist.Hint="{lang:Lang NeedleCamera_CompensationExpression}" />
                                    <TextBlock Grid.Column="3" Text="{Binding CalculatedCompY, StringFormat='= {0:F3}'}" FontSize="11" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="4,0,4,0" />
                                    <common:GlobalVariableLinkControl Grid.Column="4" DisplayValue="{Binding CalculatedCompY}" DisplayForeground="#43A047" IsLinked="{Binding IsCompensationYLinked}" UnlinkCommand="{Binding UnlinkCompensationYCommand}" LinkedVariableName="{Binding CompensationYLinkedVar, UpdateSourceTrigger=PropertyChanged}" LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="120" />
                                </Grid>
                                <!-- Z -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="AxisZArrow" Width="16" Height="16" Foreground="#1E88E5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding PendingIncrementZ, StringFormat=F3}" FontSize="11" FontWeight="SemiBold" Foreground="#1E88E5" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBox Grid.Column="2" Text="{Binding CompensationZExpression, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="0,0,4,0" materialDesign:HintAssist.Hint="{lang:Lang NeedleCamera_CompensationExpression}" />
                                    <TextBlock Grid.Column="3" Text="{Binding CalculatedCompZ, StringFormat='= {0:F3}'}" FontSize="11" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="4,0,4,0" />
                                    <common:GlobalVariableLinkControl Grid.Column="4" DisplayValue="{Binding CalculatedCompZ}" DisplayForeground="#1E88E5" IsLinked="{Binding IsCompensationZLinked}" UnlinkCommand="{Binding UnlinkCompensationZCommand}" LinkedVariableName="{Binding CompensationZLinkedVar, UpdateSourceTrigger=PropertyChanged}" LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="120" />
                                </Grid>
                                <!-- 补偿说明 -->
                                <Border Background="#FFF8E1" CornerRadius="6" Padding="8,6" Margin="0,4,0,0">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16" Foreground="#F9A825" Margin="0,2,8,0" VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_TcpCompensationNote}" Foreground="#795548" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
                <!-- 右列：补偿管理 -->
                <ScrollViewer Grid.Column="2" Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False">
                    <StackPanel Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <materialDesign:Card UniformCornerRadius="8" Padding="12" Margin="0,0,0,6"
                                             Background="{DynamicResource MaterialDesignCardBackground}">
                            <StackPanel IsEnabled="{Binding IsCalibrating, Converter={StaticResource InverseBooleanConverter}}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="MathCompass" Width="18" Height="18" Foreground="{DynamicResource SecondaryHueMidBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_CompensationManagement}" Style="{StaticResource SideCardHeaderTextStyle}" Foreground="{DynamicResource SecondaryHueMidBrush}" />
                                </Grid>
                                <Button Command="{Binding ResetCompensationCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,0,0,4" BorderBrush="#FF9800" Foreground="#E65100" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_ResetCompensation}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,6,0" />
                                        <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_ResetCompensation}" Style="{StaticResource SideActionButtonContentStyle}" />
                                    </Grid>
                                </Button>
                                <Button Command="{Binding ShowCompensationHistoryCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,5" Margin="0,0,0,4" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_ShowCompensationHistory}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="History" Width="14" Height="14" VerticalAlignment="Top" Margin="0,2,6,0" />
                                        <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_ShowCompensationHistory}" Style="{StaticResource SideActionButtonContentStyle}" />
                                    </Grid>
                                </Button>
                                <Button Command="{Binding ApplyCompensationCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Background="#4CAF50" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="8,6" Margin="0,4,0,0" materialDesign:ButtonAssist.CornerRadius="4" ToolTip="{lang:Lang NeedleAligner_ApplyCompensation}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="CheckCircle" Width="16" Height="16" VerticalAlignment="Top" Margin="0,2,6,0" />
                                        <TextBlock Grid.Column="1" Text="{lang:Lang NeedleAligner_ApplyCompensation}" Style="{StaticResource SideActionButtonContentStyle}" FontWeight="SemiBold" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===================== 底部导航栏 ===================== -->
        <Border Grid.Row="2" Background="#37474F" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 左侧：当前步骤标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Information" Width="14" Height="14" Foreground="#80CBC4" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding CurrentStepTitle}" Foreground="#80CBC4" FontSize="12" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 中间：校准状态 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding CalibrationProgress}" Minimum="0" Maximum="100" Width="120" Height="4" Margin="0,0,8,0" Foreground="#80CBC4" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CalibrationStatus}" Foreground="#B0BEC5" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 右侧：上一步 / 下一步 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding GoPrevCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="10,4" Foreground="White" materialDesign:ButtonAssist.CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="{lang:Lang NeedleAligner_PrevStep}" Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Background="#546E7A" Margin="8,0" VerticalAlignment="Center" />
                    <Button Command="{Binding GoNextCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="10,4" Foreground="White" materialDesign:ButtonAssist.CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{lang:Lang NeedleAligner_NextStep}" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="12" />
                            <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
