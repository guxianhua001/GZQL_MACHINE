<UserControl x:Class="Module.Views.SafetyZoneConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:converters="clr-namespace:Module.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="{DynamicResource MaterialDesignPaper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Module;component/Controls/Maintenance/MaintenanceSharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- 安全区域可视化转换器 -->
            <converters:PositionToCanvasConverter x:Key="PositionToCanvasConverter" />
            <converters:DangerZoneRectConverter x:Key="DangerZoneRectConverter" />
            <converters:SafeZoneWidthConverter x:Key="SafeZoneWidthConverter" />
            <converters:SafeZoneHeightConverter x:Key="SafeZoneHeightConverter" />
            <converters:Z1FillWidthConverter x:Key="Z1FillWidthConverter" />
            <converters:SafeLineMarginConverter x:Key="SafeLineMarginConverter" />

            <Style x:Key="GroupBoxBlueHeader" TargetType="GroupBox">
                <Setter Property="Foreground" Value="#1565C0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>
            <Style x:Key="GroupBoxTealHeader" TargetType="GroupBox">
                <Setter Property="Foreground" Value="#00838F"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>

            <Style x:Key="ParamLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#FF607D8B"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <materialDesign:Card UniformCornerRadius="8" Margin="8" MinWidth="700">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ========== 顶部标题栏 ========== -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryHueLightBrush}" Padding="12,8"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Shield" Width="24" Height="24" 
                                                 Foreground="{DynamicResource PrimaryBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{lang:Lang SafetyZone_Title}" FontSize="18" FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryHueDarkBrush}" VerticalAlignment="Center"/>

                        <!-- 启用状态指示灯 -->
                        <Border Width="10" Height="10" CornerRadius="5" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#BDBDBD"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                            <Setter Property="Background" Value="#43A047"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ========== 主内容区：左列参数 + 右列可视化 ========== -->
                <Grid Grid.Row="1" Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== 左列：参数设置 ===== -->
                    <GroupBox Grid.Column="0" Style="{StaticResource GroupBoxBlueHeader}">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang SafetyZone_Parameters}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>

                            <!-- 启用安全互锁复选框 -->
                            <CheckBox Content="{lang:Lang SafetyZone_EnableInterlock}"
                                      IsChecked="{Binding Enabled}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,0,0,8"/>

                            <!-- Dz₁/Dz₂/Dz₃ 安全高度：任一未达则互锁 Dx/Dy -->
                            <TextBlock Text="{lang:Lang SafetyZone_SafeHeightZ1}" Style="{StaticResource ParamLabel}"/>
                            <materialDesign:DecimalUpDown Value="{Binding SafeHeightZ1}"
                                                          ValueStep="1" Minimum="-500" Maximum="500"
                                                          Margin="0,0,0,4"/>
                            <TextBlock Text="{lang:Lang SafetyZone_SafeHeightZ2}" Style="{StaticResource ParamLabel}"/>
                            <materialDesign:DecimalUpDown Value="{Binding SafeHeightZ2}"
                                                          ValueStep="1" Minimum="-500" Maximum="500"
                                                          Margin="0,0,0,4"/>
                            <TextBlock Text="{lang:Lang SafetyZone_SafeHeightZ3}" Style="{StaticResource ParamLabel}"/>
                            <materialDesign:DecimalUpDown Value="{Binding SafeHeightZ3}"
                                                          ValueStep="1" Minimum="-500" Maximum="500"
                                                          Margin="0,0,0,4"/>

                            <!-- Z轴方向反转：Z越往下值越大时勾选 -->
                            <CheckBox Content="{lang:Lang SafetyZone_ZAxisInverted}"
                                      IsChecked="{Binding ZAxisInverted}"
                                      Margin="0,4,0,8"
                                      ToolTip="{lang:Lang SafetyZone_ZAxisInvertedTip}"/>

                            <!-- X 危险区下限/上限 -->
                            <TextBlock Text="{lang:Lang SafetyZone_DangerXMin}" Style="{StaticResource ParamLabel}"/>
                            <materialDesign:DecimalUpDown Value="{Binding DangerZoneXMin}"
                                                          ValueStep="1" Minimum="-1000" Maximum="1000"
                                                          Margin="0,0,0,4"/>
                            <TextBlock Text="{lang:Lang SafetyZone_DangerXMax}" Style="{StaticResource ParamLabel}"/>
                            <materialDesign:DecimalUpDown Value="{Binding DangerZoneXMax}"
                                                          ValueStep="1" Minimum="-1000" Maximum="1000"
                                                          Margin="0,0,0,8"/>

                            <!-- Y 危险区下限/上限 -->
                            <TextBlock Text="{lang:Lang SafetyZone_DangerYMin}" Style="{StaticResource ParamLabel}"/>
                            <materialDesign:DecimalUpDown Value="{Binding DangerZoneYMin}"
                                                          ValueStep="1" Minimum="-1000" Maximum="1000"
                                                          Margin="0,0,0,4"/>
                            <TextBlock Text="{lang:Lang SafetyZone_DangerYMax}" Style="{StaticResource ParamLabel}"/>
                            <materialDesign:DecimalUpDown Value="{Binding DangerZoneYMax}"
                                                          ValueStep="1" Minimum="-1000" Maximum="1000"
                                                          Margin="0,0,0,12"/>

                            <!-- 保存按钮 -->
                            <Button Command="{Binding SaveCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#43A047" Foreground="White"
                                    materialDesign:ButtonAssist.CornerRadius="4"
                                    HorizontalAlignment="Stretch" Padding="0,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang SafetyZone_Save}" FontSize="13" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </GroupBox>

                    <!-- ===== 右列：区域可视化 ===== -->
                    <GroupBox Grid.Column="1" Style="{StaticResource GroupBoxTealHeader}" Margin="8,0,0,0">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Target" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang SafetyZone_Visualization}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>

                            <!-- X-Y 区域画布：行程范围 + 危险区红色矩形 + 当前位置圆点 -->
                            <Border Background="#FAFAFA" CornerRadius="4" Padding="8"
                                    BorderBrush="#E0E0E0" BorderThickness="1" HorizontalAlignment="Left">
                                <Canvas Width="400" Height="300" ClipToBounds="True"
                                        x:Name="SafetyCanvas">

                                    <!-- 行程范围背景（浅灰） -->
                                    <Rectangle Fill="#F5F5F5" Stroke="#BDBDBD" StrokeThickness="1"
                                               Canvas.Left="0" Canvas.Top="0"
                                               Width="400" Height="300"/>

                                    <!-- X轴危险区红色矩形 -->
                                    <Rectangle Fill="#FFCDD2" Stroke="#E53935" StrokeThickness="1.5" Opacity="0.6">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Left">
                                                <Binding Path="DangerZoneXMin"/>
                                                <Binding Path="DangerZoneXMax"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Top">
                                                <Binding Path="DangerZoneYMin"/>
                                                <Binding Path="DangerZoneYMax"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                        <Rectangle.Width>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Width">
                                                <Binding Path="DangerZoneXMin"/>
                                                <Binding Path="DangerZoneXMax"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Rectangle.Width>
                                        <Rectangle.Height>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Height">
                                                <Binding Path="DangerZoneYMin"/>
                                                <Binding Path="DangerZoneYMax"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Rectangle.Height>
                                    </Rectangle>

                                    <!-- 危险区标签 -->
                                    <TextBlock Text="DANGER" FontSize="9" Foreground="#E53935" Opacity="0.6"
                                               FontWeight="Bold" HorizontalAlignment="Center">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Left">
                                                <Binding Path="DangerZoneXMin"/>
                                                <Binding Path="DangerZoneXMax"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Top">
                                                <Binding Path="DangerZoneYMin"/>
                                                <Binding Path="DangerZoneYMax"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                    </TextBlock>

                                    <!-- 坐标轴刻度标签 -->
                                    <TextBlock FontSize="9" Foreground="#9E9E9E" Text="{Binding XRangeMin, StringFormat=F0}">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>278</Canvas.Top>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="#9E9E9E" Text="{Binding XRangeMax, StringFormat=F0}">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>278</Canvas.Top>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="#9E9E9E" Text="{Binding YRangeMin, StringFormat=F0}">
                                        <Canvas.Left>2</Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="#9E9E9E" Text="{Binding YRangeMax, StringFormat=F0}">
                                        <Canvas.Left>2</Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                    </TextBlock>

                                    <!-- 当前位置标记圆点 -->
                                    <Ellipse Width="14" Height="14" StrokeThickness="2"
                                             Stroke="#E65100">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="CurrentX"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="CurrentY"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FF9800"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsXInDanger}" Value="True">
                                                        <Setter Property="Fill" Value="#E53935"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsYInDanger}" Value="True">
                                                        <Setter Property="Fill" Value="#E53935"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- 当前位置坐标文本 -->
                                    <TextBlock FontSize="9" FontFamily="Consolas" Foreground="#424242">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}" ConverterParameter="LabelX">
                                                <Binding Path="CurrentX"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}" ConverterParameter="LabelY">
                                                <Binding Path="CurrentY"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="({0:F1},{1:F1})">
                                                <Binding Path="CurrentX"/>
                                                <Binding Path="CurrentY"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                </Canvas>
                            </Border>

                            <!-- Z₁ 高度状态指示条 -->
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Z₁:" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#7E57C2" VerticalAlignment="Center"/>

                                <!-- Z₁ 高度进度条式显示 -->
                                <Border Grid.Column="1" Height="20" CornerRadius="4"
                                        Background="#E8EAF6" Margin="8,0"
                                        BorderBrush="#B39DDB" BorderThickness="1">
                                    <Grid>
                                        <!-- 已用高度填充（当前高度 / 最大500mm） -->
                                        <Border HorizontalAlignment="Left" CornerRadius="4">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource Z1FillWidthConverter}">
                                                    <Binding Path="CurrentZ1"/>
                                                    <Binding Path="SafeHeightZ1"/>
                                                    <Binding ElementName="Z1Bar" Path="ActualWidth"/>
                                                </MultiBinding>
                                            </Border.Width>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#42A5F5"/>
                                                    <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaneMovementLocked}" Value="True">
                                                    <Setter Property="Background" Value="#EF5350"/>
                                                </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <!-- 安全线标记 -->
                                        <Border HorizontalAlignment="Left" Width="2" Height="20"
                                                Background="#FF9800" Opacity="0.8">
                                            <Border.Margin>
                                                <MultiBinding Converter="{StaticResource SafeLineMarginConverter}">
                                                    <Binding Path="SafeHeightZ1"/>
                                                    <Binding ElementName="Z1Bar" Path="ActualWidth"/>
                                                </MultiBinding>
                                            </Border.Margin>
                                        </Border>

                                        <!-- 数值文本 -->
                                        <TextBlock Text="{Binding CurrentZ1, StringFormat=F1}" FontSize="11"
                                                   Foreground="White" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border x:Name="Z1Bar" Grid.Column="1" Height="20" Visibility="Collapsed"/>

                                <!-- 状态文字 -->
                                <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{lang:Lang SafetyZone_Safe}"/>
                                            <Setter Property="Foreground" Value="#43A047"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaneMovementLocked}" Value="True">
                                                    <Setter Property="Text" Value="{lang:Lang SafetyZone_Danger}"/>
                                                    <Setter Property="Foreground" Value="#E53935"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <!-- X/Y 轴状态行 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AxisXArrow" Width="14" Height="14"
                                                             Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="X: " FontSize="11" Foreground="#757575" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentX, StringFormat=F1}" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#424242"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsXInDanger}" Value="True">
                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AxisYArrow" Width="14" Height="14"
                                                             Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock Text="Y: " FontSize="11" Foreground="#757575" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding CurrentY, StringFormat=F1}" FontSize="11" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#424242"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsYInDanger}" Value="True">
                                                        <Setter Property="Foreground" Value="#E53935"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- 画布行程范围设置 -->
                            <Separator Margin="0,12,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="AspectRatio" Width="16" Height="16"
                                                         Foreground="#00838F" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{lang:Lang SafetyZone_CanvasRange}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="#00838F" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang SafetyZone_XRangeMin}" Style="{StaticResource ParamLabel}" Margin="0,0,4,0"/>
                                <materialDesign:DecimalUpDown Grid.Row="0" Grid.Column="1" Value="{Binding XRangeMin}"
                                                              ValueStep="1" Minimum="-5000" Maximum="5000"
                                                              Margin="0,0,4,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{lang:Lang SafetyZone_XRangeMax}" Style="{StaticResource ParamLabel}" Margin="4,0,4,0"/>
                                <materialDesign:DecimalUpDown Grid.Row="0" Grid.Column="3" Value="{Binding XRangeMax}"
                                                              ValueStep="1" Minimum="-5000" Maximum="5000"
                                                              Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang SafetyZone_YRangeMin}" Style="{StaticResource ParamLabel}" Margin="0,0,4,0"/>
                                <materialDesign:DecimalUpDown Grid.Row="1" Grid.Column="1" Value="{Binding YRangeMin}"
                                                              ValueStep="1" Minimum="-5000" Maximum="5000"
                                                              Margin="0,0,4,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{lang:Lang SafetyZone_YRangeMax}" Style="{StaticResource ParamLabel}" Margin="4,0,4,0"/>
                                <materialDesign:DecimalUpDown Grid.Row="1" Grid.Column="3" Value="{Binding YRangeMax}"
                                                              ValueStep="1" Minimum="-5000" Maximum="5000"
                                                              Margin="0,0,0,4"/>
                            </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>

                <!-- ========== 底部告警栏 ========== -->
                <Border Grid.Row="2" Visibility="{Binding IsAlarmVisible}"
                        Background="#FFEBEE" CornerRadius="0,0,8,8"
                        BorderBrush="#EF9A9A" BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0" Kind="Warning" Width="20" Height="20"
                                                 Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <TextBlock Grid.Column="1" Text="{Binding AlarmMessage}" FontSize="12"
                                   Foreground="#C62828" FontWeight="Medium" VerticalAlignment="Center"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                        <Button Grid.Column="2" Command="{Binding DismissAlarmCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="#EF9A9A" Foreground="#C62828"
                                materialDesign:ButtonAssist.CornerRadius="4"
                                Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang SafetyZone_DismissAlarm}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </materialDesign:Card>
    </ScrollViewer>
</UserControl>
