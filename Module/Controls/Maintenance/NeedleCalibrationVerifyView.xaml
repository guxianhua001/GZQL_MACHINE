<UserControl x:Class="Module.Views.NeedleCalibrationVerifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:Module.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1000"
             Background="#EEF2F5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Module;component/Controls/Maintenance/MaintenanceSharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08" Direction="270" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Needle" Width="24" Height="24"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{lang:Lang NeedleVerify_Title}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#333333"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="4" Padding="8,2" Margin="14,0,0,0">
                        <TextBlock Text="{lang:Lang NeedleVerify_Subtitle}" FontSize="11"
                                   Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                   VerticalAlignment="Center" FontWeight="Medium" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="4" Padding="8,3" Background="#E8F5E9">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding OverallResultColor}"
                                     VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding VerificationStatus}"
                                       FontSize="11" Foreground="#2E7D32" FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT: Two-column layout -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Verification Operations + Results -->
            <ScrollViewer Grid.Column="0"
                          Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                          Margin="0,0,10,0">
                <StackPanel>

                    <!-- Card: System Selection -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="SwapHorizontal" Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang NeedleVerify_SystemSelection}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <RadioButton Content="{lang:Lang NeedleVerify_System1}"
                                             IsChecked="{Binding SelectedSystemNumber, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                                             Command="{Binding System1Command}"
                                             Margin="0,0,20,0"
                                             FontSize="13" />
                                <RadioButton Content="{lang:Lang NeedleVerify_System2}"
                                             IsChecked="{Binding SelectedSystemNumber, Converter={StaticResource IntToBoolConverter}, ConverterParameter=2}"
                                             Command="{Binding System2Command}"
                                             FontSize="13" />
                            </StackPanel>

                            <Border Background="#F5F5F5" CornerRadius="4" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14"
                                                             Foreground="#9E9E9E" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock FontSize="11" Foreground="#757575" VerticalAlignment="Center"
                                               Text="{lang:Lang NeedleVerify_CurrentSystem}" />
                                    <TextBlock Text="{Binding SelectedSystemNumber, StringFormat=': {0}'}"
                                               FontSize="11" Foreground="#424242" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="2,0,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Card: Verification Execution -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang NeedleVerify_Execution}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            </StackPanel>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 执行验证按钮：CanExecute 已绑定 CanVerify(=!IsVerifying)，验证中自动禁用 -->
                                <Button Grid.Column="0"
                                        Command="{Binding ExecuteVerificationCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        HorizontalAlignment="Stretch"
                                        Padding="12,8"
                                        materialDesign:ButtonAssist.CornerRadius="6">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Play" Width="17" Height="17" Margin="0,0,8,0" />
                                        <TextBlock Text="{lang:Lang NeedleVerify_Execute}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>

                                <!-- 取消验证按钮：CanExecute 绑定 IsVerifying，仅验证中可用，工业安全要求可随时中断 -->
                                <Button Grid.Column="2"
                                        Command="{Binding CancelVerificationCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Stretch"
                                        Padding="12,8"
                                        materialDesign:ButtonAssist.CornerRadius="6"
                                        BorderBrush="#F44336" Foreground="#F44336">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Stop" Width="17" Height="17" Margin="0,0,8,0" />
                                        <TextBlock Text="{lang:Lang NeedleVerify_Cancel}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <ProgressBar Value="{Binding VerificationProgress}" Minimum="0" Maximum="100"
                                         Height="6" Margin="0,12,0,6"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}" />

                            <TextBlock Text="{Binding VerificationStatus}"
                                       FontSize="12" Foreground="#757575"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Card: Verification Results -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,0"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="ClipboardCheckOutline" Width="18" Height="18"
                                                         Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang NeedleVerify_Results}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Foreground="{DynamicResource SecondaryHueMidBrush}" />
                            </StackPanel>

                            <Border Background="#E3F2FD" CornerRadius="4" Padding="8,6" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FunctionVariant" Width="14" Height="14"
                                                             Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{lang:Lang NeedleVerify_CompareFormulaTip}"
                                               FontSize="11" Foreground="#1565C0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- 坐标明细：实测 / 已生效TCP / 有效坐标 / 固定基准 -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang NeedleVerify_Axis}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{lang:Lang NeedleVerify_Measured}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{lang:Lang NeedleVerify_ActiveTcp}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{lang:Lang NeedleVerify_Effective}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,4" HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="{lang:Lang NeedleVerify_Reference}"
                                           FontSize="10" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,4" HorizontalAlignment="Center" />

                                <!-- X -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="X" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MeasuredX, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ActiveTcpX, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding EffectiveX, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding ReferenceX, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />

                                <!-- Y -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Y" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding MeasuredY, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ActiveTcpY, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding EffectiveY, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding ReferenceY, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />

                                <!-- Z -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Z" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MeasuredZ, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding ActiveTcpZ, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding EffectiveZ, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding ReferenceZ, StringFormat=F4, Mode=OneWay}"
                                           FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <Rectangle Height="1" Fill="#E0E0E0" Margin="0,0,0,8" />

                            <!-- Axis Deviation Grid -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header Row -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang NeedleVerify_Axis}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{lang:Lang NeedleVerify_Deviation}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{lang:Lang NeedleVerify_Result}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#9E9E9E" Margin="0,0,0,6" HorizontalAlignment="Center" />

                                <!-- X Axis -->
                                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="White" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="X" FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding DeviationX, StringFormat=F4, Mode=OneWay}"
                                                 IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                                                 Background="#FAFAFA" BorderThickness="1" BorderBrush="#E0E0E0"
                                                 Padding="6,4" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="{Binding ResultXColor}" CornerRadius="4"
                                                Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ResultX}" Foreground="White"
                                                       FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Y Axis -->
                                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="White" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Y" FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding DeviationY, StringFormat=F4, Mode=OneWay}"
                                                 IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                                                 Background="#FAFAFA" BorderThickness="1" BorderBrush="#E0E0E0"
                                                 Padding="6,4" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="{Binding ResultYColor}" CornerRadius="4"
                                                Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ResultY}" Foreground="White"
                                                       FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Z Axis -->
                                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Background="White" CornerRadius="4" Padding="6,4" Margin="0,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="Z" FontWeight="Bold" FontSize="14"
                                                   Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding DeviationZ, StringFormat=F4, Mode=OneWay}"
                                                 IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                                                 Background="#FAFAFA" BorderThickness="1" BorderBrush="#E0E0E0"
                                                 Padding="6,4" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Background="{Binding ResultZColor}" CornerRadius="4"
                                                Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ResultZ}" Foreground="White"
                                                       FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Rectangle Height="1" Fill="#E0E0E0" Margin="0,4,0,8" />

                            <!-- Overall Result -->
                            <Border Background="{Binding OverallResultColor}" CornerRadius="6" Padding="12,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="20" Height="20"
                                                             Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding OverallResult}" Foreground="White"
                                               FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT COLUMN: Report + Log -->
            <StackPanel Grid.Column="1">

                <!-- Card: Verification Report -->
                <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                     Background="{DynamicResource MaterialDesignCardBackground}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lang:Lang NeedleVerify_Report}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Foreground="{DynamicResource SecondaryHueMidBrush}" />
                        </StackPanel>

                        <Border Background="#FAFAFA" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <TextBlock Text="{Binding LastReportSummary}"
                                       FontFamily="Consolas" FontSize="11"
                                       Foreground="#424242" TextWrapping="Wrap"
                                       LineHeight="1.6" MaxHeight="180" />
                        </Border>

                        <Button Command="{Binding SaveReportCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch"
                                Padding="10,6" Margin="0,0,0,8"
                                materialDesign:ButtonAssist.CornerRadius="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,6,0" />
                                <TextBlock Text="{lang:Lang NeedleVerify_SaveReport}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding LoadParametersCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Stretch"
                                Padding="10,6" Margin="0,0,0,8"
                                materialDesign:ButtonAssist.CornerRadius="6"
                                ToolTip="{lang:Lang NeedleVerify_LoadParameters}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" Margin="0,0,6,0" />
                                <TextBlock Text="{lang:Lang NeedleVerify_LoadParameters}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <!-- 当前验证记录文件路径 -->
                        <Border Background="#EDE7F6" CornerRadius="6" Padding="10,6"
                                Visibility="{Binding CurrentFilePath, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14"
                                                             Foreground="#5E35B1" Margin="0,0,6,0"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{lang:Lang NeedleVerify_CurrentFile}"
                                               Foreground="#5E35B1" FontSize="10" FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentFilePath}"
                                           Foreground="#7E57C2" FontSize="9" FontFamily="Consolas"
                                           TextWrapping="Wrap" Margin="0,2,0,0"
                                           ToolTip="{Binding CurrentFilePath}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Card: Verification Log -->
                <materialDesign:Card UniformCornerRadius="8" Padding="16"
                                     Background="{DynamicResource MaterialDesignCardBackground}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="TextBoxOutline" Width="18" Height="18"
                                                     Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lang:Lang NeedleVerify_Log}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Foreground="{DynamicResource SecondaryHueMidBrush}" />
                        </StackPanel>

                        <ScrollViewer Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                                      MaxHeight="250"
                                      MinHeight="150">
                            <ListBox ItemsSource="{Binding VerificationLogs}"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent"
                                     BorderBrush="#E0E0E0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="MinHeight" Value="22" />
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#616161"
                                                   FontFamily="Consolas" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>

                        <Button Command="{Binding ClearLogCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                HorizontalAlignment="Right"
                                Padding="8,4" Margin="0,8,0,0"
                                FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" Margin="0,0,4,0" />
                                <TextBlock Text="{lang:Lang NeedleVerify_ClearLog}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
