<UserControl x:Class="Module.UserControls.Grippers.GripperControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             Width="560" Height="540">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ModuleCore;component/Themes/DialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
            <Style x:Key="CompactBtn" TargetType="Button">
                <Setter Property="Height" Value="32"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Padding="14" Background="{DynamicResource DialogCardBrush}" CornerRadius="8">
        <StackPanel>

            <!-- 标题栏 -->
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}"
                        Style="{StaticResource MaterialDesignIconButton}" ToolTip="{lang:Lang Close}"
                        Width="28" Height="28"
                        Foreground="{DynamicResource DialogTextPrimaryBrush}">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="RobotIndustrial" Width="20" Height="20"
                                             Foreground="{DynamicResource DialogAccentBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="{lang:Lang ElectricGripperManualOperation}" FontWeight="Bold" FontSize="15"
                               Foreground="{DynamicResource DialogTextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>

            <!-- 状态栏 -->
            <Border Background="{DynamicResource DialogElevatedBrush}" CornerRadius="4"
                    Padding="10,6" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Width="12" Height="12" Fill="{Binding StatusBrush}"
                            Grid.Column="0" VerticalAlignment="Center" ToolTip="{Binding Status}"/>

                    <TextBlock Text="{Binding StatusMessage}" Grid.Column="1"
                               Foreground="{DynamicResource DialogTextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Medium" FontSize="12"/>

                    <!-- 实时位置显示 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,8,0">
                        <materialDesign:PackIcon Kind="MapMarkerDistance" Width="14" Height="14"
                                                 VerticalAlignment="Center" Foreground="{DynamicResource DialogAccentBrush}" Margin="0,0,4,0"/>
                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DialogAccentBrush}">
                            <Run Text="{Binding CurrentPosition, StringFormat=F1, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource DialogSuccessBrush}" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}"/>
                        <TextBlock Text="{lang:Lang Gripper_Online}" VerticalAlignment="Center" Margin="3,0,0,0" FontSize="11"
                                   Foreground="{DynamicResource DialogTextSecondaryBrush}"
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 位置与寸动（合并区域） -->
            <GroupBox Header="{lang:Lang GripperJogControl}" Margin="0,0,0,8"
                      Foreground="{DynamicResource DialogTextPrimaryBrush}">
                <Grid Margin="4">

                    <!-- 第一行：目标位置 + 移动按钮 -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="{lang:Lang Target}" VerticalAlignment="Center" FontSize="11" Width="36"
                                   Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                        <TextBox Text="{Binding TargetPosition, UpdateSourceTrigger=PropertyChanged}"
                                 Width="70" materialDesign:HintAssist.Hint="{lang:Lang Unit_mm}"
                                 VerticalContentAlignment="Center" FontSize="11"/>
                        <TextBlock Text="{lang:Lang AssemblyStep_SpeedLabel}" VerticalAlignment="Center" FontSize="11" Width="36" Margin="12,0,0,0"
                                   Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                        <Slider Minimum="1" Maximum="100" Value="{Binding Speed}" Width="110"
                                IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Speed, StringFormat={}{0:0}%}"
                                   Foreground="{DynamicResource DialogTextPrimaryBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0" MinWidth="30" FontSize="11"/>
                        <Button Grid.Row="1" Command="{Binding MoveToTargetCommand}" Margin="12,0,0,0"
                                Style="{StaticResource CompactBtn}"
                                Background="{DynamicResource DialogAccentBrush}" Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Target" Width="14" Height="14" Margin="0,0,4,0"/>
                                <TextBlock Text="{lang:Lang Gripper_MoveTo}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 第二行：寸动三按钮 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <Button Command="{Binding JogLeftCommand}" Width="78" Height="32" Margin="3"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowCollapse" Width="16" Height="16" Margin="0,0,3,0"/>
                                <TextBlock Text="{lang:Lang Gripper_ClampJog}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding StopCommand}" Width="78" Height="32" Margin="3"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Background="{DynamicResource DialogErrorBrush}" Foreground="White" Padding="6,2" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" Margin="0,0,3,0"/>
                                <TextBlock Text="{lang:Lang Stop}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding JogRightCommand}" Width="78" Height="32" Margin="3"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArrowExpand" Width="16" Height="16" Margin="0,0,3,0"/>
                                <TextBlock Text="{lang:Lang Gripper_OpenJog}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 第三行：寸动参数 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{lang:Lang AxisOp_JogStep}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                        <TextBox Text="{Binding JogStep, StringFormat={}{0:F1}}" Width="46" Margin="3,0"
                                 VerticalContentAlignment="Center" FontSize="11"/>
                        <TextBlock Text="{lang:Lang Unit_mm}" VerticalAlignment="Center" FontSize="11" Margin="0,10,0,0"
                                   Foreground="{DynamicResource DialogTextPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 力矩 + 系统操作（合并区域） -->
            <GroupBox Header="{lang:Lang TorqueSetting}" Margin="0,0,0,8"
                      Foreground="{DynamicResource DialogTextPrimaryBrush}">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 力矩设定 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock Text="{lang:Lang TorqueLabel}" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource DialogTextSecondaryBrush}"/>
                        <TextBox Text="{Binding TorquePercentage, UpdateSourceTrigger=PropertyChanged}"
                                 Width="48" Margin="3,0" materialDesign:HintAssist.Hint="{lang:Lang Unit_Percent}"
                                 VerticalContentAlignment="Center" FontSize="11">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SetTorqueCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="{lang:Lang Unit_Percent}" VerticalAlignment="Center" FontSize="11" Margin="0,8,0,0"
                                   Foreground="{DynamicResource DialogTextPrimaryBrush}"/>

                        <Button Command="{Binding SetTorqueCommand}" Margin="3,0"
                                Style="{StaticResource CompactBtn}"
                                Background="{DynamicResource DialogAccentBrush}" Foreground="White">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Check" Width="14" Height="14" Margin="0,0,3,0"/>
                                <TextBlock Text="{lang:Lang Set}"/>
                            </StackPanel>
                        </Button>

                        <Border Background="{DynamicResource DialogElevatedBrush}"
                                CornerRadius="4" Padding="8,3" Margin="10,0,0,0">
                            <TextBlock Text="{Binding TorqueDisplay}" FontWeight="Medium" FontSize="12"
                                       Foreground="{DynamicResource DialogAccentOrangeBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- 系统操作 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding HomeCommand}" Margin="3"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="8,3" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Home" Width="14" Height="14" Margin="0,0,3,0"/>
                                <TextBlock Text="{lang:Lang Home}"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ResetCommand}" Margin="3"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="8,3" FontSize="11">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,3,0"/>
                                <TextBlock Text="{lang:Lang ClearAlarm}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <!-- 快速操作：夹紧 / 释放 -->
            <GroupBox Header="{lang:Lang Gripper_QuickActions}" Margin="0,0,0,8"
                      Foreground="{DynamicResource DialogTextPrimaryBrush}">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Command="{Binding ClampCommand}" Margin="4"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource DialogAccentOrangeBrush}" Foreground="White" Height="40"
                            FontSize="13" FontWeight="SemiBold" ToolTip="{lang:Lang Gripper_Tip_ClampAction}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pan" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="{lang:Lang GripClose}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1" Command="{Binding ReleaseCommand}" Margin="4"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{DynamicResource DialogAccentBrush}" Foreground="White" Height="40"
                            FontSize="13" FontWeight="SemiBold" ToolTip="{lang:Lang Gripper_Tip_ReleaseAction}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="OpenInNew" Width="18" Height="18" Margin="0,0,6,0"/>
                            <TextBlock Text="{lang:Lang GripOpen}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </GroupBox>

            <!-- 实时状态 -->
            <GroupBox Header="{lang:Lang Gripper_RealtimeStatus}" Margin="0,0,0,0"
                      Foreground="{DynamicResource DialogTextPrimaryBrush}">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{lang:Lang CurrentPosition}"
                               Foreground="{DynamicResource DialogTextPrimaryBrush}"
                               VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>

                    <Border Grid.Column="1" Background="{DynamicResource DialogElevatedBrush}"
                            CornerRadius="4" Padding="10,5" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentPosition, StringFormat={}{0:F2}}"
                                       FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource DialogAccentBrush}"/>
                            <TextBlock Text="{lang:Lang Unit_mm}" FontSize="11"
                                       Foreground="{DynamicResource DialogTextMutedBrush}"
                                       VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                            <TextBlock Text="{lang:Lang Gripper_UpdateRate}" FontSize="9"
                                       Foreground="{DynamicResource DialogTextMutedBrush}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </GroupBox>

        </StackPanel>
    </Border>
</UserControl>