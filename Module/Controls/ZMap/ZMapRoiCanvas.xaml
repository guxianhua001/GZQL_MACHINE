<UserControl x:Class="Module.Controls.ZMap.ZMapRoiCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#212121">
    <Grid x:Name="RootGrid"
          ClipToBounds="True"
          MouseLeftButtonDown="OnMouseLeftButtonDown"
          MouseLeftButtonUp="OnMouseLeftButtonUp"
          MouseMove="OnMouseMove"
          MouseRightButtonDown="OnMouseRightButtonDown">
        <Image x:Name="HeightMapImage"
               Source="{Binding Source, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Stretch="Uniform"
               IsHitTestVisible="False"/>
        <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False"/>
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="8" Padding="6,3" CornerRadius="2"
                Background="#99000000">
            <TextBlock Text="{Binding HintText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="White" FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
