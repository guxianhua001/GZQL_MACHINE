<UserControl x:Class="Module.Views.NPointCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="750"
             d:DesignWidth="1200"
             Background="#EEF2F5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Module;component/Controls/Maintenance/MaintenanceSharedStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#616161" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <Style x:Key="LeftCardHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignHeadline6TextBlock}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
            </Style>

            <Style x:Key="LeftActionButtonContentStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ReadOnlyTextBoxStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Background" Value="#F5F5F5" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="materialDesign:HintAssist.IsFloating" Value="False" />
                <Setter Property="Margin" Value="0,0,4,0" />
            </Style>

            <Style x:Key="CardHeaderStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="StepLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#9E9E9E" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.6*" MinWidth="500" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================ -->
            <!-- LEFT COLUMN: 轴配置 + 通讯配置 + 自动标定 + 文件操作            -->
            <!-- ============================================================ -->
            <ScrollViewer Grid.Column="0"
                          Style="{StaticResource AlwaysVisibleScrollViewerStyle}"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">
                <StackPanel HorizontalAlignment="Stretch"
                            Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">

                    <!-- 轴配置卡片 -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="AxisArrow" Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{lang:Lang NPointCalib_AxisConfig}"
                                           Style="{StaticResource LeftCardHeaderTextStyle}" />
                            </Grid>

                            <!-- 工站选择 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang NPointCalib_Station}"
                                           Style="{StaticResource ParamLabelStyle}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding StationIdentifiers}"
                                          SelectedItem="{Binding SelectedStationIdentifier}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Padding="4,2" />
                            </Grid>

                            <!-- X轴选择 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{lang:Lang NPointCalib_EnableAxisX}"
                                          IsChecked="{Binding EnableAxisX}"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableAxes}"
                                          SelectedItem="{Binding AxisNameX}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Padding="4,2" />
                                <materialDesign:PackIcon Grid.Column="2" Kind="AxisXArrow" Width="16" Height="16"
                                                         Foreground="#E53935" Margin="6,0,0,0"
                                                         VerticalAlignment="Center" />
                            </Grid>

                            <!-- Y轴选择 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="{lang:Lang NPointCalib_EnableAxisY}"
                                          IsChecked="{Binding EnableAxisY}"
                                          Style="{StaticResource MaterialDesignCheckBox}"
                                          Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableAxes}"
                                          SelectedItem="{Binding AxisNameY}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Padding="4,2" />
                                <materialDesign:PackIcon Grid.Column="2" Kind="AxisYArrow" Width="16" Height="16"
                                                         Foreground="#43A047" Margin="6,0,0,0"
                                                         VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang NPointCalib_PointCount}"
                                           Style="{StaticResource ParamLabelStyle}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding PointCount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="3-99"
                                         Padding="4,2" />
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 通讯配置卡片 -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{lang:Lang NPointCalib_TcpConfig}"
                                           Style="{StaticResource LeftCardHeaderTextStyle}" />
                            </Grid>

                            <CheckBox Content="{lang:Lang NPointCalib_EnableVisionData}"
                                      IsChecked="{Binding EnableVisionData}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,0,0,8" />

                            <!-- TCP连接选择（仅启用视觉数据时可见） -->
                            <Grid Margin="0,0,0,4" Visibility="{Binding EnableVisionData, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang NPointCalib_ConnectionName}"
                                           Style="{StaticResource ParamLabelStyle}"
                                           VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding TcpConnections}"
                                          SelectedItem="{Binding SelectedTcpConnection}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Padding="4,2" />
                            </Grid>

                            <!-- 触发命令（仅启用视觉数据时可见） -->
                            <Grid Visibility="{Binding EnableVisionData, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang NPointCalib_TriggerCommand}"
                                           Style="{StaticResource ParamLabelStyle}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding TriggerCommand, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="4,2" />
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 自动标定卡片 -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{lang:Lang NPointCalib_AutoCalib}"
                                           Style="{StaticResource LeftCardHeaderTextStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang NPointCalib_DelayMs}"
                                           Style="{StaticResource ParamLabelStyle}"
                                           VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding AutoCalibDelayMs, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Padding="4,2" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding StartAutoCalibCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10,6" Margin="0,0,4,0"
                                        materialDesign:ButtonAssist.CornerRadius="6"
                                        ToolTip="{lang:Lang NPointCalib_StartAutoCalib}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Play" Width="16" Height="16"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{lang:Lang NPointCalib_StartAutoCalib}"
                                                   Style="{StaticResource LeftActionButtonContentStyle}" />
                                    </Grid>
                                </Button>

                                <Button Grid.Column="1" Command="{Binding StopAutoCalibCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="10,6" Margin="4,0,0,0"
                                        BorderBrush="#FF9800" Foreground="#E65100"
                                        materialDesign:ButtonAssist.CornerRadius="6"
                                        ToolTip="{lang:Lang NPointCalib_StopAutoCalib}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="Stop" Width="16" Height="16"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{lang:Lang NPointCalib_StopAutoCalib}"
                                                   Style="{StaticResource LeftActionButtonContentStyle}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 文件操作卡片 -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,0"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{lang:Lang NPointCalib_FileOperation}"
                                           Style="{StaticResource LeftCardHeaderTextStyle}" />
                            </Grid>

                            <!-- 保存 + 另存为 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding SaveConfigCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="8,5" Margin="0,0,4,0"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="15" Height="15"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang NPointCalib_Save}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding SaveAsConfigCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="8,5" Margin="4,0,0,0"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSaveAll" Width="15" Height="15"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang NPointCalib_SaveAs}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 导入 + 导出 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding ImportConfigCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="8,5" Margin="0,0,4,0"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="15" Height="15"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang NPointCalib_Import}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding ExportConfigCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        Padding="8,5" Margin="4,0,0,0"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Export" Width="15" Height="15"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang NPointCalib_Export}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 当前文件名 -->
                            <Border Background="#E3F2FD" CornerRadius="6" Padding="10,6"
                                    Visibility="{Binding CurrentFileName, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14"
                                                                 Foreground="#1565C0" Margin="0,2,6,0"
                                                                 VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{lang:Lang NPointCalib_CurrentFile}"
                                                   Foreground="#1565C0" FontSize="10" FontWeight="Medium"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="{Binding CurrentFileName}"
                                               Foreground="#1976D2" FontSize="11" FontFamily="Consolas"
                                               TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </ScrollViewer>

            <!-- ============================================================ -->
            <!-- GRID SPLITTER                                                 -->
            <!-- ============================================================ -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="#E0E0E0" />

            <!-- ============================================================ -->
            <!-- RIGHT COLUMN: 标定数据表格 + 标定结果                          -->
            <!-- ============================================================ -->
            <ScrollViewer Grid.Column="2" Style="{StaticResource AlwaysVisibleScrollViewerStyle}">
                <StackPanel>

                    <!-- 标定数据卡片 -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeaderStyle}">
                                <materialDesign:PackIcon Kind="TableLarge" Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang NPointCalib_CalibData}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            </StackPanel>

                            <!-- 操作按钮行 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Command="{Binding AddPointCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="6,4" Margin="0,0,6,0"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang NPointCalib_AddPoint}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ComputeCalibrationCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Padding="6,4" Margin="0,0,6,0"
                                        materialDesign:ButtonAssist.CornerRadius="4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Calculator" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang NPointCalib_Compute}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- 标定数据表格 -->
                            <DataGrid ItemsSource="{Binding Points}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      materialDesign:DataGridAssist.CellPadding="4"
                                      HeadersVisibility="Column"
                                      FontSize="12"
                                      MaxHeight="400">
                                <!-- 列头居中样式 -->
                                <DataGrid.Resources>
                                    <Style x:Key="CenterHeaderStyle" TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                    <Style x:Key="CenterCellTextStyle" TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <!-- 序号 -->
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"
                                                         IsReadOnly="True"
                                                         HeaderStyle="{StaticResource CenterHeaderStyle}"
                                                         ElementStyle="{StaticResource CenterCellTextStyle}" />
                                    <!-- 名称 -->
                                    <DataGridTextColumn Header="{lang:Lang NPointCalib_PointName}"
                                                         Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="60"
                                                         HeaderStyle="{StaticResource CenterHeaderStyle}"
                                                         ElementStyle="{StaticResource CenterCellTextStyle}" />
                                    <!-- 机械X -->
                                    <DataGridTextColumn Header="{lang:Lang NPointCalib_MachineX}"
                                                         Binding="{Binding MachineX, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="88"
                                                         HeaderStyle="{StaticResource CenterHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#E53935" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- 机械Y -->
                                    <DataGridTextColumn Header="{lang:Lang NPointCalib_MachineY}"
                                                         Binding="{Binding MachineY, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="88"
                                                         HeaderStyle="{StaticResource CenterHeaderStyle}">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#43A047" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!-- 视觉X -->
                                    <DataGridTextColumn Header="{lang:Lang NPointCalib_VisionX}"
                                                         Binding="{Binding VisionX, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="88"
                                                         HeaderStyle="{StaticResource CenterHeaderStyle}"
                                                         ElementStyle="{StaticResource CenterCellTextStyle}" />
                                    <!-- 视觉Y -->
                                    <DataGridTextColumn Header="{lang:Lang NPointCalib_VisionY}"
                                                         Binding="{Binding VisionY, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="88"
                                                         HeaderStyle="{StaticResource CenterHeaderStyle}"
                                                         ElementStyle="{StaticResource CenterCellTextStyle}" />
                                    <!-- 状态 -->
                                    <DataGridTemplateColumn Header="{lang:Lang NPointCalib_Status}" Width="50"
                                                             HeaderStyle="{StaticResource CenterHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="10" Height="10"
                                                         Fill="{Binding StatusColor}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- 操作列 -->
                                    <DataGridTemplateColumn Header="{lang:Lang NPointCalib_Operation}" Width="*" MinWidth="160"
                                                             HeaderStyle="{StaticResource CenterHeaderStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button ToolTip="{lang:Lang NPointCalib_Teach}"
                                                            Command="{Binding DataContext.TeachPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="4,2" Margin="0,0,2,0">
                                                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="14" Height="14" />
                                                    </Button>
                                                    <Button ToolTip="{lang:Lang NPointCalib_Move}"
                                                            Command="{Binding DataContext.MoveToPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="4,2" Margin="2,0,2,0">
                                                        <materialDesign:PackIcon Kind="ArrowRight" Width="14" Height="14" />
                                                    </Button>
                                                    <Button ToolTip="{lang:Lang NPointCalib_DeletePoint}"
                                                            Command="{Binding DataContext.DeletePointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignFlatButton}"
                                                            Padding="4,2" Margin="2,0,0,0">
                                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14"
                                                                                 Foreground="#E53935" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 标定结果卡片 -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,0"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource CardHeaderStyle}">
                                <materialDesign:PackIcon Kind="ChartLine" Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang NPointCalib_CalibResult}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            </StackPanel>

                            <!-- 仿射参数 -->
                            <TextBlock Text="Affine Parameters" Style="{StaticResource StepLabelStyle}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="A" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding CalibrationResult.A, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="B" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CalibrationResult.B, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Tx" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CalibrationResult.Tx, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="C" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding CalibrationResult.C, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />

                                <TextBlock Grid.Row="0" Grid.Column="1" Text="D" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CalibrationResult.D, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />

                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Ty" Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding CalibrationResult.Ty, StringFormat=F6, FallbackValue=0}"
                                         Style="{StaticResource ReadOnlyTextBoxStyle}" />
                            </Grid>

                            <Rectangle Height="1" Fill="#E0E0E0" Margin="0,4,0,8" />

                            <!-- 统计信息 -->
                            <TextBlock Text="{lang:Lang NPointCalib_QualityRating}" Style="{StaticResource StepLabelStyle}" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang NPointCalib_RmsError}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding CalibrationResult.RmsError, StringFormat=F6, FallbackValue=-}"
                                           FontWeight="Bold" FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang NPointCalib_RotationAngle}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding CalibrationResult.EquivalentRotationDeg, StringFormat=F4, FallbackValue=-}"
                                           FontWeight="Bold" FontSize="12" Foreground="#424242"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{lang:Lang NPointCalib_ScaleFactor}"
                                           Style="{StaticResource ParamLabelStyle}" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="X:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding CalibrationResult.EquivalentScaleX, StringFormat=F6, FallbackValue=-}"
                                               FontWeight="Bold" FontSize="12" Foreground="#424242"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="Y:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding CalibrationResult.EquivalentScaleY, StringFormat=F6, FallbackValue=-}"
                                               FontWeight="Bold" FontSize="12" Foreground="#424242"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================ -->
        <!-- BOTTOM: 状态栏                                                -->
        <!-- ============================================================ -->
        <Border Grid.Row="1" Background="{Binding StatusColor}"
                Padding="16,10" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="18" Height="18"
                                         Foreground="#333333" Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                <TextBlock Text="{Binding StatusText}"
                           Foreground="#333333" FontWeight="SemiBold"
                           FontSize="13" VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
