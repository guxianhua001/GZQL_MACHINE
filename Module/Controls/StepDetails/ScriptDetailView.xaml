<UserControl x:Class="Module.Views.ScriptDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             Width="960"
             MaxHeight="720">

    <Border Background="{DynamicResource MaterialDesignCardBackground}"
            CornerRadius="6"
            ClipToBounds="True">
        <Border.Resources>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </Border.Resources>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ 顶部标题栏 ═══ -->
            <Border Grid.Row="0"
                    Padding="12,6"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2D3748" Offset="0" />
                        <GradientStop Color="#3A475A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Command="{Binding CloseCommand}"
                            ToolTip="{lang:Lang Close}"
                            Width="24" Height="24"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Foreground="White">
                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CodeTags"
                                                 Width="18" Height="18"
                                                 Foreground="#81C784"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,6,0" />
                        <TextBlock Text="SCRIPT"
                                   Foreground="White"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Border Background="#2D3748"
                                CornerRadius="3"
                                Padding="5,1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Foreground="#A5D6A7"
                                       FontSize="11"
                                       Text="{lang:Lang ScriptDetail_CSharpScript}" />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ 主体：左侧代码编辑 + 右侧变量引用面板 ═══ -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：代码编辑区 -->
                <Grid Grid.Column="0" Margin="12,12,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 脚本说明 -->
                    <TextBox Grid.Row="0"
                             Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="{lang:Lang ScriptDetail_ScriptDescHint}"
                             Margin="0,0,0,8" />

                    <!-- 代码编辑器 -->
                    <TextBox Grid.Row="1"
                             x:Name="ScriptCodeEditor"
                             Text="{Binding ScriptCode, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="13"
                             Foreground="#212121"
                             Background="#FAFAFA"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource MaterialDesignDivider}"
                             Padding="8"
                             materialDesign:HintAssist.Hint="{lang:Lang ScriptDetail_WriteScriptHint}" />

                    <!-- 编译/执行结果 -->
                    <Border Grid.Row="2"
                            Margin="0,8,0,0"
                            CornerRadius="4"
                            Padding="8,6"
                            MinHeight="28"
                            MaxHeight="120"
                            Background="{DynamicResource MaterialDesignToolBarBackground}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding CompileResult}"
                                       FontSize="12"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#9E9E9E" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCompileSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="#2E7D32" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsCompileSuccess}" Value="False">
                                                <Setter Property="Foreground" Value="#C62828" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 分隔线 -->
                <Border Grid.Column="1"
                        Width="1"
                        Background="{DynamicResource MaterialDesignDivider}"
                        Margin="8,12,8,12" />

                <!-- 右侧：变量引用面板 -->
                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,12,12,12">
                    <StackPanel>
                        <!-- 全局变量 -->
                        <Expander IsExpanded="True"
                                  Header="{lang:Lang ScriptDetail_GlobalVariables}"
                                  Margin="0,0,0,8">
                            <ListBox ItemsSource="{Binding GlobalVariables}"
                                     MaxHeight="200"
                                     BorderThickness="0"
                                     MouseDoubleClick="OnGlobalVariableDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <materialDesign:PackIcon Kind="Variable"
                                                                     Width="14" Height="14"
                                                                     Foreground="#42A5F5"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Medium"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding Value}"
                                                       FontSize="11"
                                                       Foreground="#9E9E9E"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="100"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <!-- 步骤输出参数 -->
                        <Expander IsExpanded="True"
                                  Header="{lang:Lang ScriptDetail_StepOutputParams}"
                                  Margin="0,0,0,8">
                            <ListBox ItemsSource="{Binding StepOutputParameters}"
                                     MaxHeight="150"
                                     BorderThickness="0"
                                     MouseDoubleClick="OnStepOutputDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <materialDesign:PackIcon Kind="Export"
                                                                     Width="14" Height="14"
                                                                     Foreground="#FFB74D"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="Medium"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <!-- 执行结果 -->
                        <Expander IsExpanded="True"
                                  Header="{lang:Lang ScriptDetail_ExecuteResult}"
                                  Margin="0,0,0,8">
                            <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                    CornerRadius="4"
                                    Padding="8"
                                    MinHeight="40">
                                <TextBlock Text="{Binding ExecuteResult}"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           TextWrapping="Wrap"
                                           Foreground="#2E7D32" />
                            </Border>
                        </Expander>

                        <!-- 提示 -->
                        <Border Background="#1A237E08"
                                CornerRadius="4"
                                Padding="8,6"
                                Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{lang:Lang ScriptDetail_DoubleClickInsert}"
                                           FontSize="11"
                                           Foreground="#78909C"
                                           Margin="0,0,0,4" />
                                <TextBlock FontSize="10"
                                           Foreground="#B0BEC5"
                                           TextWrapping="Wrap"
                                           LineHeight="16">
                                    <Run Text="{lang:Lang ScriptDetail_Hint_ReadVar}" /> <Run Text=" ctx.GetDouble(&quot;name&quot;)" FontFamily="Consolas" /><LineBreak />
                                    <Run Text="{lang:Lang ScriptDetail_Hint_ReadOutput}" /> <Run Text=" ctx.GetOutputDouble(&quot;name&quot;)" FontFamily="Consolas" /><LineBreak />
                                    <Run Text="{lang:Lang ScriptDetail_Hint_WriteVar}" /> <Run Text=" ctx.Set(&quot;name&quot;, val)" FontFamily="Consolas" /><LineBreak />
                                    <Run Text="{lang:Lang ScriptDetail_Hint_ReturnVal}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ 底部操作栏 ═══ -->
            <Border Grid.Row="2"
                    Padding="16,10"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Button Command="{Binding CompileCommand}"
                                ToolTip="{lang:Lang ScriptDetail_ToolTipCompile}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="34"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                materialDesign:ButtonAssist.CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Build" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang ScriptDetail_Compile}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExecuteCommand}"
                                ToolTip="{lang:Lang ScriptDetail_ToolTipExecute}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="34"
                                Padding="12,0"
                                materialDesign:ButtonAssist.CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang Execute}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="{Binding IsExecuting}"
                                     Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Width="60" Height="4"
                                     VerticalAlignment="Center"
                                     Margin="8,0,0,0"
                                     Foreground="#42A5F5" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding CloseCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="34"
                                Padding="12,0"
                                Margin="0,0,8,0"
                                materialDesign:ButtonAssist.CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang Cancel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="34"
                                Padding="20,0"
                                materialDesign:ButtonAssist.CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang ScriptDetail_ConfirmContinue}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
