<UserControl x:Class="Module.Views.CheckDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:Module.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <converters:BoolToPassFailColorConverter x:Key="BoolToPassFailColor"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource MaterialDesignCardBackground}"
            CornerRadius="4"
            Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- ═══ 顶部标题栏 ═══ -->
                <Border Padding="12,6"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        Margin="0,0,0,12">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#2D3748" Offset="0" />
                            <GradientStop Color="#3A475A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CancelCommand}"
                                ToolTip="{lang:Lang Close}"
                                Width="24" Height="24"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Foreground="White">
                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                        </Button>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CheckCircleOutline"
                                                     Width="18" Height="18"
                                                     Foreground="#64B5F6"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,6,0" />
                            <TextBlock Text="{lang:Lang CheckDetail_Title}"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 1. 判断表格 -->
                <DataGrid ItemsSource="{Binding CheckItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          materialDesign:DataGridAssist.CellPadding="4"
                          materialDesign:DataGridAssist.ColumnHeaderPadding="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{lang:Lang CheckDetail_Column_Index}" Binding="{Binding Index}" Width="50" IsReadOnly="True"/>
                        <DataGridCheckBoxColumn Header="{lang:Lang CheckDetail_Column_Check}" Binding="{Binding IsChecked}" Width="60"/>
                        <DataGridTextColumn Header="{lang:Lang CheckDetail_Column_DataLink}" Binding="{Binding DataLink}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{lang:Lang CheckDetail_Column_Value}" Binding="{Binding Value, StringFormat=N3}" Width="100"/>
                        <DataGridCheckBoxColumn Header="{lang:Lang CheckDetail_Column_Status}" Binding="{Binding Status}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="{lang:Lang CheckDetail_Column_LowerLimit}" Binding="{Binding LowerLimit, StringFormat=N3}" Width="100"/>
                        <DataGridTextColumn Header="{lang:Lang CheckDetail_Column_UpperLimit}" Binding="{Binding UpperLimit, StringFormat=N3}" Width="100"/>
                        <DataGridTextColumn Header="{lang:Lang CheckDetail_Column_LowerTol}" Binding="{Binding LowerTolerance, StringFormat=N3}" Width="100"/>
                        <DataGridTextColumn Header="{lang:Lang CheckDetail_Column_UpperTol}" Binding="{Binding UpperTolerance, StringFormat=N3}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 整体判定结果 -->
                <Border Background="{DynamicResource MaterialDesignPaper}"
                        CornerRadius="4"
                        Margin="0,16,0,0"
                        Padding="8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{lang:Lang CheckDetail_OverallResult}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding OverallResult}" 
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="{Binding OverallResult, Converter={StaticResource BoolToPassFailColor}}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>

                <Separator Margin="0,0,0,12"/>

                <!-- 2. ON PASS -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{lang:Lang CheckDetail_OnPass}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel VerticalAlignment="Center">
                        <RadioButton Content="{lang:Lang CheckDetail_Continue}"
                                     IsChecked="{Binding SelectedPassAction, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Continue}"
                                     GroupName="PassAction" Margin="0,0,8,0"/>
                        <TextBlock Text="{lang:Lang CheckDetail_SkipToStep}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox ItemsSource="{Binding AllSteps}" DisplayMemberPath="Seq"
                                  SelectedValue="{Binding PassJumpStepSeq}" Width="60"
                                  IsEnabled="{Binding SelectedPassAction, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=SkipTo}"/>
                        <TextBlock Text="{lang:Lang CheckDetail_NoteDispense}" FontStyle="Italic"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </WrapPanel>
                </StackPanel>

                <!-- 3. ON FAIL -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="{lang:Lang CheckDetail_OnFail}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel Margin="16,0,0,8">
                        <WrapPanel VerticalAlignment="Center" Margin="0,0,0,8">
                            <RadioButton Content="{lang:Lang CheckDetail_Retry}"
                                         IsChecked="{Binding SelectedFailAction, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Retry}"
                                         GroupName="FailAction" Margin="0,0,8,0"/>
                            <TextBlock Text="{lang:Lang CheckDetail_JumpToStep}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding AllSteps}" DisplayMemberPath="Seq"
                                      SelectedValue="{Binding FailJumpStepSeq}" Width="60"
                                      IsEnabled="{Binding SelectedFailAction, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=SkipTo}"/>
                            <TextBlock Text="{lang:Lang CheckDetail_NotePinAdj}" FontStyle="Italic"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </WrapPanel>
                        <WrapPanel VerticalAlignment="Center">
                            <RadioButton Content="{lang:Lang CheckDetail_StopGoHome}"
                                         IsChecked="{Binding SelectedFailAction, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Stop}"
                                         GroupName="FailAction" Margin="0,0,8,0"/>
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Margin="24,8,0,0">
                        <WrapPanel>
                            <TextBlock Text="{lang:Lang CheckDetail_MaxRetries}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <materialDesign:NumericUpDown Value="{Binding MaxRetries}" Minimum="1" Maximum="10" Width="60"/>
                            <TextBlock Text="{lang:Lang CheckDetail_OnMaxExceeded}" VerticalAlignment="Center" Margin="16,0,8,0"/>
                            <ComboBox ItemsSource="{Binding MaxExceededActions}"
                                      SelectedItem="{Binding SelectedMaxExceededAction}" Width="100"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 按钮栏 -->
                <Separator Margin="0,8,0,8"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="{lang:Lang Cancel}" Command="{Binding CancelCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,8,0"/>
                    <Button Content="{lang:Lang Save}" Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
