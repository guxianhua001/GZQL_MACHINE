<UserControl x:Class="Module.Views.VisionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:converters="clr-namespace:Module.Converters"
             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             Width="960"
             MaxHeight="720">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ModuleCore;component/Themes/DialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:StringEmptyToCollapsedConverter x:Key="StringEmptyToCollapsedConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource DialogCardBrush}"
            CornerRadius="6"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ 主体：左侧编辑+右侧配置面板 ═══ -->
            <Grid Grid.Row="0" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- ═══ 左侧：解析脚本 + 结果输出 + 变量映射 ═══ -->
                <Grid Grid.Column="0" Margin="12,12,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 解析脚本标题 -->
                    <Border Grid.Row="0" Background="{DynamicResource DialogElevatedBrush}"
                            CornerRadius="4,4,0,0" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CodeBraces" Width="16" Height="16" 
                                                     Foreground="{DynamicResource DialogSuccessDarkBrush}"
                                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{lang:Lang VisionDetail_DataParseScript}" FontWeight="SemiBold" FontSize="12"
                                       VerticalAlignment="Center" 
                                       Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- 脚本编辑器 -->
                    <TextBox Grid.Row="1"
                             Text="{Binding ParseScript, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="13"
                             Foreground="{DynamicResource DialogTextPrimaryBrush}"
                             Background="{DynamicResource DialogElevatedBrush}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource DialogBorderBrush}"
                             Padding="8"
                             materialDesign:HintAssist.Hint="{lang:Lang VisionDetail_WriteScriptHint}"
                             materialDesign:HintAssist.Foreground="{DynamicResource DialogTextMutedBrush}" />

                    <!-- 脚本操作按钮行 -->
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <Button DockPanel.Dock="Right"
                                Command="{Binding InsertDefaultScriptCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="8,4" Height="30" FontSize="11"
                                materialDesign:ButtonAssist.CornerRadius="4"
                                Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang VisionDetail_DefaultTemplate}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right"
                                Command="{Binding CompileScriptCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="8,4" Height="30" FontSize="11"
                                materialDesign:ButtonAssist.CornerRadius="4"
                                Margin="8,0,0,0"
                                Foreground="{DynamicResource DialogSuccessDarkBrush}" 
                                BorderBrush="{DynamicResource DialogSuccessDarkBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PlayCircleOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang VisionDetail_Compile}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{lang:Lang VisionDetail_InputScriptVision}" VerticalAlignment="Center"
                                   FontSize="11" 
                                   Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                    </DockPanel>

                    <!-- 结果输出（三态颜色） -->
                    <Border Grid.Row="3"
                            CornerRadius="4" Padding="10,6" MinHeight="28" MaxHeight="120"
                            Background="{DynamicResource DialogElevatedBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ExecuteResult}"
                                       FontSize="12" FontFamily="Consolas" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource DialogTextSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExecuteSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource DialogSuccessDarkBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExecuteSuccess}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource DialogErrorDarkBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- 分隔线 -->
                <Border Grid.Column="1"
                        Width="1"
                        Background="{DynamicResource DialogBorderBrush}"
                        Margin="8,12,8,12" />

                <!-- ═══ 右侧：通讯配置 + 执行测试 + 提示 ═══ -->
                <ScrollViewer Grid.Column="2"
                              VerticalScrollBarVisibility="Auto"
                              Margin="0,12,12,12">
                    <StackPanel>

                        <!-- 通讯配置 Expander -->
                        <Expander IsExpanded="True" Header="{lang:Lang VisionDetail_CommConfig}" Margin="0,0,0,8">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang VisionDetail_Method}" VerticalAlignment="Center" FontSize="11"
                                                  Foreground="{DynamicResource DialogTextPrimaryBrush}"/>
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding CommunicationTypes}"
                                          SelectedItem="{Binding SelectedCommunicationType}" FontSize="11"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang VisionDetail_TcpConnection}" VerticalAlignment="Center" FontSize="11"
                                           Visibility="{Binding IsTcpSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                           Foreground="{DynamicResource DialogTextPrimaryBrush}" Margin="0,6,0,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding TcpConnections}"
                                          SelectedItem="{Binding SelectedConnectionName}"
                                          IsEditable="True" FontSize="11" Margin="0,6,0,0"
                                          Visibility="{Binding IsTcpSelected, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang VisionDetail_TriggerCommand}" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource DialogTextPrimaryBrush}" Margin="0,6,0,0"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                         Text="{Binding TriggerCommand, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11" Margin="0,6,0,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{lang:Lang TimeoutMs}" VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource DialogTextPrimaryBrush}" Margin="0,6,0,0"/>
                                <materialDesign:NumericUpDown Grid.Row="3" Grid.Column="1"
                                                              Value="{Binding ResponseTimeout}"
                                                              Minimum="100" Maximum="60000" FontSize="11" Margin="0,6,0,0"/>
                            </Grid>
                        </Expander>

                        <!-- 变量映射 Expander -->
                        <Expander IsExpanded="True" Header="{lang:Lang VisionDetail_VariableMapping}" Margin="0,0,0,8">
                            <StackPanel Margin="4">
                                <DataGrid ItemsSource="{Binding MappingRows}"
                                          SelectedItem="{Binding SelectedMapping}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False" CanUserDeleteRows="False"
                                          materialDesign:DataGridAssist.CellPadding="3"
                                          MaxHeight="160" FontSize="11">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{lang:Lang VisionDetail_Column_KeyName}" Width="Auto">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate><TextBlock Text="{Binding SourceKey}" VerticalAlignment="Center" FontSize="11"/></DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate><TextBox Text="{Binding SourceKey, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/></DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="{lang:Lang VisionDetail_Column_GlobalVar}" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <common:GlobalVariableLinkControl
                                                        DisplayValue="{Binding DisplayValue, Mode=OneWay}"
                                                        DisplayForeground="{DynamicResource DialogSuccessDarkBrush}"
                                                        IsLinked="{Binding IsLinked, Mode=OneWay}"
                                                        UnlinkCommand="{Binding DataContext.UnlinkMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        LinkedVariableName="{Binding GlobalVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                        LinkableGlobalVariables="{Binding DataContext.LinkableGlobalVariables, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ComboBoxWidth="120" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <common:GlobalVariableLinkControl
                                                        DisplayValue="{Binding DisplayValue, Mode=OneWay}"
                                                        DisplayForeground="{DynamicResource DialogSuccessDarkBrush}"
                                                        IsLinked="{Binding IsLinked, Mode=OneWay}"
                                                        UnlinkCommand="{Binding DataContext.UnlinkMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        LinkedVariableName="{Binding GlobalVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                        LinkableGlobalVariables="{Binding DataContext.LinkableGlobalVariables, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ComboBoxWidth="120" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Command="{Binding AddMappingCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="28" Padding="8,0" FontSize="11"
                                            materialDesign:ButtonAssist.CornerRadius="4" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang Add}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DeleteMappingCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="28" Padding="8,0" FontSize="11"
                                            materialDesign:ButtonAssist.CornerRadius="4"
                                            Foreground="{DynamicResource DialogErrorDarkBrush}" 
                                            BorderBrush="{DynamicResource DialogErrorDarkBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang Delete}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <!-- 执行测试 Expander -->
                        <Expander IsExpanded="True" Header="{lang:Lang VisionDetail_ExecuteTest}" Margin="0,0,0,8">
                            <StackPanel Margin="4">

                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right"
                                            Command="{Binding FillSampleDataCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Padding="6,2" Height="26" FontSize="10"
                                            materialDesign:ButtonAssist.CornerRadius="4" Margin="6,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="DatabaseImportOutline" Width="12" Height="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang VisionDetail_Sample}" Margin="3,0,0,0" VerticalAlignment="Center" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="{lang:Lang VisionDetail_TestData}" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                                </DockPanel>
                                <TextBox Text="{Binding SampleData, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="{lang:Lang VisionDetail_WriteScriptHint}"
                                         Margin="0,0,0,6" FontSize="12"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Command="{Binding ExecuteTestCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Height="28" Padding="10,0" FontSize="10"
                                            materialDesign:ButtonAssist.CornerRadius="4" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Send" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang VisionDetail_TriggerExecute}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ExecuteWithSampleDataCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Height="28" Padding="10,0" FontSize="10"
                                            materialDesign:ButtonAssist.CornerRadius="4">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="{lang:Lang VisionDetail_SampleExecute}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <ProgressBar IsIndeterminate="{Binding IsExecuting}"
                                                 Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Width="50" Height="3" VerticalAlignment="Center" Margin="6,0,0,0"
                                                 Foreground="{DynamicResource DialogInfoBrush}" />
                                </StackPanel>

                                <Border Background="{DynamicResource DialogElevatedBrush}"
                                        CornerRadius="4" Padding="6,4" MinHeight="36" MaxHeight="120">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding ExecuteResult}" TextWrapping="Wrap"
                                                   FontFamily="Consolas" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource DialogTextSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExecuteSuccess}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DialogSuccessDarkBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsExecuteSuccess}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DialogErrorDarkBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- 提示 -->
                        <Border Background="{DynamicResource DialogElevatedBrush}" CornerRadius="4" Padding="8,6" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="{lang:Lang VisionDetail_VarMappingNote}" FontSize="11"
                                           Foreground="{DynamicResource DialogTextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock FontSize="10" Foreground="{DynamicResource DialogTextMutedBrush}" TextWrapping="Wrap" LineHeight="15">
                                    <Run Text="{lang:Lang VisionDetail_Tip_Flow}" /><LineBreak/>
                                    <Run Text="{lang:Lang VisionDetail_Tip_SampleMode}" /><LineBreak/>
                                    <Run Text="{lang:Lang VisionDetail_Tip_Reexecute}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ 底部操作栏 ═══ -->
            <Border Grid.Row="1"
                    Padding="16,10"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DialogBorderBrush}">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <ProgressBar IsIndeterminate="{Binding IsExecuting}"
                                     Visibility="{Binding IsExecuting, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Width="60" Height="4" VerticalAlignment="Center" Margin="0,0,0,0"
                                     Foreground="{DynamicResource DialogInfoBrush}" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding CloseCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="34" Padding="12,0" Margin="0,0,8,0"
                                materialDesign:ButtonAssist.CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang Cancel}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="34" Padding="20,0"
                                materialDesign:ButtonAssist.CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang VisionDetail_SaveConfig}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
