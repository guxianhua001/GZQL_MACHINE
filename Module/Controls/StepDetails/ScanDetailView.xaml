<UserControl x:Class="Module.Views.ScanDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             Width="960" MaxHeight="800">

    <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" ClipToBounds="True">
        <Border.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </Border.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ ROW 0: 标题栏 (与VisionDetailView一致) ═══ -->
            <Border Grid.Row="0" Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2D3748" Offset="0" />
                        <GradientStop Color="#3A475A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" ToolTip="{lang:Lang Close}"
                            Width="24" Height="24" Style="{StaticResource MaterialDesignIconButton}" Foreground="White">
                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Camera" Width="18" Height="18" Foreground="#FFB74D" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <Binding Path="StepDescription" StringFormat="SCAN 3D相机配置 - {0}" />
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ ROW 1: 主内容区（左右分栏）═══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>

                <!-- ═══ 左侧：配置 + 脚本编辑区 ═══ -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,8,0">
                    <StackPanel>

                        <!-- 1. 运动配置 (保持原有内部布局不变) -->
                        <GroupBox Header="{lang:Lang ScanDetail_MotionConfig}" Margin="0,0,0,10">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Row 0: Z轴ID, X轴ID, 运动速度 -->
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{lang:Lang ScanDetail_ZAxisId}" VerticalAlignment="Center" />
                                <materialDesign:NumericUpDown Grid.Row="0" Grid.Column="1"
                                                              Value="{Binding ZAxisId}"
                                                              Minimum="0"
                                                              Maximum="255"
                                                              Width="120"
                                                              HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{lang:Lang ScanDetail_XAxisId}" VerticalAlignment="Center" />
                                <materialDesign:NumericUpDown Grid.Row="0" Grid.Column="3"
                                                              Value="{Binding XAxisId}"
                                                              Minimum="0"
                                                              Maximum="255"
                                                              Width="120"
                                                              HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="0" Grid.Column="4"
                                           Text="{lang:Lang ScanDetail_MoveSpeed}" VerticalAlignment="Center" />
                                <materialDesign:NumericUpDown Grid.Row="0" Grid.Column="5"
                                                              Value="{Binding MoveSpeed}"
                                                              Minimum="10"
                                                              Maximum="60"
                                                              Width="120"
                                                              HorizontalAlignment="Left" />

                                <!-- Row 1: Z初始位置, X起始位置 -->
                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{lang:Lang ScanDetail_ZInitPos}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding ZPositions}"
                                          Text="{Binding ZInitPosition, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          Margin="0,8,0,0" />

                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Text="{lang:Lang ScanDetail_XStartPos}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <ComboBox Grid.Row="1" Grid.Column="3"
                                          ItemsSource="{Binding XPositions}"
                                          Text="{Binding XStartPosition, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          Margin="0,8,0,0" />

                                <!-- Row 2: Z拍照位置, X结束位置 -->
                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{lang:Lang ScanDetail_ZPhotoPos}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          ItemsSource="{Binding ZPositions}"
                                          Text="{Binding ZPhotoPosition, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          Margin="0,8,0,0" />

                                <TextBlock Grid.Row="2" Grid.Column="2"
                                           Text="{lang:Lang ScanDetail_XEndPos}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <ComboBox Grid.Row="2" Grid.Column="3"
                                          ItemsSource="{Binding XPositions}"
                                          Text="{Binding XEndPosition, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          Margin="0,8,0,0" />

                                <!-- Row 3: Z安全位置, X待机位置 -->
                                <TextBlock Grid.Row="3" Grid.Column="0"
                                           Text="{lang:Lang ScanDetail_ZSafePos}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <ComboBox Grid.Row="3" Grid.Column="1"
                                          ItemsSource="{Binding ZPositions}"
                                          Text="{Binding ZSafePosition, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          Margin="0,8,0,0" />

                                <TextBlock Grid.Row="3" Grid.Column="2"
                                           Text="{lang:Lang ScanDetail_XStandbyPos}" VerticalAlignment="Center" Margin="0,8,0,0" />
                                <ComboBox Grid.Row="3" Grid.Column="3"
                                          ItemsSource="{Binding XPositions}"
                                          Text="{Binding XStandbyPosition, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="True"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          Margin="0,8,0,0" />
                            </Grid>
                        </GroupBox>

                        <!-- 2. IO配置 (保持原有) -->
                        <GroupBox Header="{lang:Lang ScanDetail_IOConfig}" Margin="0,0,0,10">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{lang:Lang ScanDetail_TriggerIOPort}" VerticalAlignment="Center" />
                                <materialDesign:NumericUpDown Grid.Row="0" Grid.Column="1"
                                                              Value="{Binding TriggerIoPort}"
                                                              Minimum="0"
                                                              Maximum="65535"
                                                              Width="200"
                                                              HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="{lang:Lang ScanDetail_IOResetDelay}" VerticalAlignment="Center" />
                                <materialDesign:NumericUpDown Grid.Row="0" Grid.Column="3"
                                                              Value="{Binding IoResetDelayMs}"
                                                              Minimum="0"
                                                              Maximum="60000"
                                                              Width="200"
                                                              HorizontalAlignment="Left" />
                            </Grid>
                        </GroupBox>

                        <!-- 3. 通讯配置 (保持原有) -->
                        <GroupBox Header="{lang:Lang ScanDetail_CommConfig}" Margin="0,0,0,10">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{lang:Lang ScanDetail_CommType}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding CommunicationTypes}"
                                          SelectedItem="{Binding SelectedCommunicationType}"
                                          Width="200"
                                          HorizontalAlignment="Left" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{lang:Lang ScanDetail_TcpConnection}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsTcpSelected, Converter={StaticResource BoolToVis}}" />
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding TcpConnections}"
                                          SelectedItem="{Binding SelectedConnectionName}"
                                          Width="200"
                                          HorizontalAlignment="Left"
                                          IsEditable="True"
                                          Visibility="{Binding IsTcpSelected, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{lang:Lang TimeoutMs}" VerticalAlignment="Center" />
                                <materialDesign:NumericUpDown Grid.Row="2" Grid.Column="1"
                                                              Value="{Binding ResponseTimeout}"
                                                              Minimum="100"
                                                              Maximum="60000"
                                                              Width="200"
                                                              HorizontalAlignment="Left" />
                            </Grid>
                        </GroupBox>

                        <!-- 4. 数据解析：脚本编辑器 + 变量映射 -->
                        <GroupBox Header="{lang:Lang ScanDetail_DataParsing}" Margin="0,0,0,0">
                            <StackPanel Margin="8">
                                <!-- 点数量 + 默认模板按钮 -->
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="{lang:Lang ScanDetail_PointCount}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               Margin="0,0,8,0" />
                                    <materialDesign:NumericUpDown Value="{Binding TabCount}"
                                                                  Minimum="1"
                                                                  Maximum="100"
                                                                  Width="120"
                                                                  HorizontalAlignment="Left" />
                                </DockPanel>

                                <!-- 解析脚本 -->
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right"
                                            Content="{lang:Lang ScanDetail_DefaultTemplate}"
                                            Command="{Binding InsertDefaultScriptCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="8,0,0,0"
                                            Padding="8,4" />
                                    <TextBlock Text="{lang:Lang ScanDetail_InputScript3D}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                </DockPanel>
                                <TextBox Text="{Binding ParseScript, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         MinHeight="150"
                                         MaxHeight="300"
                                         materialDesign:HintAssist.Hint="{lang:Lang ScanDetail_WriteScriptHint}"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         Margin="0,0,0,8" />

                                <!-- 变量映射 -->
                                <TextBlock Text="{lang:Lang ScanDetail_MapKeyToGlobalVar}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding VariableMappings}"
                                          SelectedItem="{Binding SelectedMapping}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          materialDesign:DataGridAssist.CellPadding="4"
                                          MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{lang:Lang ScanDetail_Column_SourceKey}" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SourceKey}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SourceKey, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="{lang:Lang ScanDetail_Column_GlobalVarMeasured}" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding GlobalVariableName}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.GlobalVariableNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding GlobalVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEditable="True" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="{lang:Lang ScanDetail_Column_CompensatedVar}" Width="200">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CompensatedGlobalVariableName}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.GlobalVariableNames, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding CompensatedGlobalVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                              IsEditable="True" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 映射操作按钮 -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0">
                                    <Button Content="{lang:Lang ScanDetail_AddMapping}"
                                            Margin="0,0,4,0"
                                            Command="{Binding AddMappingCommand}" />
                                    <Button Content="{lang:Lang ScanDetail_DeleteMapping}"
                                            Margin="0,0,4,0"
                                            Command="{Binding DeleteMappingCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <!-- 分隔线 -->
                <Border Grid.Column="1" Width="1" Background="{DynamicResource MaterialDesignDivider}" Margin="0,0,0,0" />

                <!-- ═══ 右侧：数据面板 + 执行测试 + 提示 ═══ -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,0,0,0">
                    <StackPanel>

                        <!-- 5. 数据解析面板 (结果DataGrid) -->
                        <GroupBox Margin="0,0,0,10">
                            <GroupBox.Header>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{lang:Lang ScanDetail_DataParsingPanel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding LastReceivedTime, StringFormat=最后解析：{0}}" Foreground="#2196F3" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LastReceivedData}" Foreground="AliceBlue" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </GroupBox.Header>
                            <DataGrid ItemsSource="{Binding ScanResults}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeRows="False" materialDesign:DataGridAssist.CellPadding="4" MaxHeight="260">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_Seq}" Binding="{Binding Index}" Width="45" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_Name}" Binding="{Binding Name}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_BaseZ}" Binding="{Binding BaseZValue, StringFormat=N3}" Width="95"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_UpperLimit}" Binding="{Binding UpperLimit, StringFormat=N3}" Width="75"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_LowerLimit}" Binding="{Binding LowerLimit, StringFormat=N3}" Width="75"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_Measured}" Binding="{Binding MeasuredValue, StringFormat=N3}" Width="90" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_Deviation}" Binding="{Binding Deviation, StringFormat=N3}" Width="75" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_FixedComp}" Binding="{Binding FixedCompensation, StringFormat=N3}" Width="100"/>
                                    <DataGridTemplateColumn Header="{lang:Lang ScanDetail_Column_Status}" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_Compensated}" Binding="{Binding CompensatedValue, StringFormat=N3}" Width="90" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="{lang:Lang ScanDetail_Column_WriteGlobalVar}" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TargetGlobalVariable}"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                           FontSize="11"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- 6. 执行测试 (Expander) -->
                        <Expander IsExpanded="True" Header="{lang:Lang ScanDetail_ExecuteTest}" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <!-- 示例数据输入 -->
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right"
                                            Content="{lang:Lang ScanDetail_FillSample}"
                                            Command="{Binding FillSampleDataCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="8,0,0,0"
                                            Padding="8,4"
                                            ToolTip="{lang:Lang ScanDetail_FillSampleToolTip}" />
                                    <TextBlock Text="{lang:Lang ScanDetail_TestData}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               Margin="0,0,8,0" />
                                </DockPanel>
                                <TextBox Text="{Binding SampleData, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="{lang:Lang ScanDetail_InputSimData}"
                                         Margin="0,0,0,8" />

                                <!-- 执行按钮组 -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,8">
                                    <Button Content="{lang:Lang ScanDetail_SendTriggerExecute}"
                                            Command="{Binding ExecuteTestCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Margin="0,0,8,0"
                                            Padding="12,6"
                                            ToolTip="{lang:Lang ScanDetail_SendTriggerToolTip}" />
                                    <Button Content="{lang:Lang ScanDetail_UseSampleExecute}"
                                            Command="{Binding ExecuteWithSampleDataCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,8,0"
                                            Padding="12,6"
                                            ToolTip="{lang:Lang ScanDetail_UseSampleToolTip}" />
                                </StackPanel>

                                <!-- 进度条 -->
                                <ProgressBar IsIndeterminate="{Binding IsExecuting}"
                                             Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}"
                                             Margin="0,0,0,8"
                                             Height="4" />

                                <!-- 结果展示 -->
                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                        CornerRadius="4"
                                        Padding="12"
                                        MinHeight="60"
                                        MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding ExecuteResult}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- 7. 提示信息 -->
                        <Border Background="#1A237E08" CornerRadius="4" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="{lang:Lang VisionDetail_VarMappingNote}" FontSize="11" Foreground="#78909C" Margin="0,0,0,4"/>
                                <TextBlock FontSize="10" Foreground="#B0BEC5" TextWrapping="Wrap" LineHeight="15">
                                    <Run Text="▸ TCP发送 → 接收响应 → C#脚本解析 → 映射全局变量" /><LineBreak/>
                                    <Run Text="▸ 示例执行跳过TCP，直接用测试数据解析" /><LineBreak/>
                                    <Run Text="▸ 修改映射后需重新执行以生效" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ ROW 2: 底部操作栏 ═══ -->
            <Border Grid.Row="2" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Button Command="{Binding ExecuteTestCommand}" ToolTip="{lang:Lang Test}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang Test}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding CloseCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Padding="12,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang Cancel}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Height="34" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang Save}" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
