<UserControl x:Class="Module.Views.ScanDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             Width="960" MaxHeight="800">

    <Border Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="6" ClipToBounds="True">
        <Border.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </Border.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ ROW 0: 标题栏 ═══ -->
            <Border Grid.Row="0" Padding="12,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource MaterialDesignDivider}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2D3748" Offset="0" />
                        <GradientStop Color="#3A475A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Command="{Binding CloseCommand}" ToolTip="{lang:Lang Close}"
                            Width="24" Height="24" Style="{StaticResource MaterialDesignIconButton}" Foreground="White">
                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Camera" Width="18" Height="18" Foreground="#FFB74D" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{lang:Lang ScanDetail_Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text=" - " Foreground="#90A4AE" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StepDescription}" Foreground="#B0BEC5" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ ROW 1: 主内容区（双列布局）═══ -->
            <Grid Grid.Row="1" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ─── 左列：通讯配置 + 数据解析 ─── -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- 1. 通讯配置 -->
                        <GroupBox Header="{lang:Lang ScanDetail_CommConfig}" Margin="0,0,0,10">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{lang:Lang ScanDetail_CommType}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          ItemsSource="{Binding CommunicationTypes}"
                                          SelectedItem="{Binding SelectedCommunicationType}"
                                          HorizontalAlignment="Stretch" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="{lang:Lang ScanDetail_TcpConnection}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsTcpSelected, Converter={StaticResource BoolToVis}}" />
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding TcpConnections}"
                                          SelectedItem="{Binding SelectedConnectionName}"
                                          HorizontalAlignment="Stretch"
                                          IsEditable="True"
                                          Visibility="{Binding IsTcpSelected, Converter={StaticResource BoolToVis}}" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="{lang:Lang TimeoutMs}" VerticalAlignment="Center" />
                                <materialDesign:NumericUpDown Grid.Row="2" Grid.Column="1"
                                                              Value="{Binding ResponseTimeout}"
                                                              Minimum="100"
                                                              Maximum="60000"
                                                              HorizontalAlignment="Stretch" />
                            </Grid>
                        </GroupBox>

                        <!-- 2. 数据解析：脚本编辑器 + 变量映射 -->
                        <GroupBox Header="{lang:Lang ScanDetail_DataParsing}" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <!-- 点数量 + 默认模板按钮 -->
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right"
                                            Content="{lang:Lang ScanDetail_DefaultTemplate}"
                                            Command="{Binding InsertDefaultScriptCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="8,0,0,0"
                                            Padding="8,4" />
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{lang:Lang ScanDetail_PointCount}"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <materialDesign:NumericUpDown Value="{Binding TabCount}"
                                                                      Minimum="1" Maximum="100"
                                                                      Width="100" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- 解析脚本（用Grid约束宽度，使TextBox横向滚动条生效） -->
                                <TextBlock Text="{lang:Lang ScanDetail_InputScript3D}" Margin="0,0,0,4"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                <Grid>
                                    <TextBox Text="{Binding ParseScript, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             AcceptsTab="True"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             MinHeight="150"
                                             MaxHeight="300"
                                             materialDesign:HintAssist.Hint="{lang:Lang ScanDetail_WriteScriptHint}"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             Margin="0,0,0,8" />
                                </Grid>

                                <!-- 变量映射 -->
                                <TextBlock Text="{lang:Lang ScanDetail_MapKeyToGlobalVar}"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Margin="0,0,0,8" />
                                <DataGrid ItemsSource="{Binding VariableMappings}"
                                          SelectedItem="{Binding SelectedMapping}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          materialDesign:DataGridAssist.CellPadding="4"
                                          MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{lang:Lang ScanDetail_Column_SourceKey}" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SourceKey}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding SourceKey, UpdateSourceTrigger=PropertyChanged}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="{lang:Lang ScanDetail_Column_GlobalVarMeasured}" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <common:GlobalVariableLinkControl
                                                        DisplayValue="{Binding DisplayValue, Mode=OneWay}"
                                                        DisplayForeground="#81C784"
                                                        IsLinked="{Binding IsLinked, Mode=OneWay}"
                                                        UnlinkCommand="{Binding DataContext.UnlinkMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        LinkedVariableName="{Binding GlobalVariableName, UpdateSourceTrigger=PropertyChanged}"
                                                        LinkableGlobalVariables="{Binding DataContext.LinkableGlobalVariables, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        ComboBoxWidth="120" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>


                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- 映射操作按钮 -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0">
                                    <Button Content="{lang:Lang ScanDetail_AddMapping}"
                                            Margin="0,0,4,0"
                                            Command="{Binding AddMappingCommand}" />
                                    <Button Content="{lang:Lang ScanDetail_DeleteMapping}"
                                            Margin="0,0,4,0"
                                            Command="{Binding DeleteMappingCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── 右列：数据解析面板 + 执行测试 + 提示信息 ─── -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- 3. 数据解析面板 (结果DataGrid) -->
                        <GroupBox Margin="0,0,0,10">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{lang:Lang ScanDetail_DataParsingPanel}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Text="  " VerticalAlignment="Center" />
                                    <TextBlock Text="{lang:Lang ScanDetail_LastParsed}" Foreground="#2196F3" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text=": " Foreground="#2196F3" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LastReceivedTime}" Foreground="#2196F3" FontSize="11" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LastReceivedData}" Foreground="AliceBlue" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </GroupBox.Header>
                            <!-- DataGrid Width 约束 + 列 MinWidth 自适应列名，总宽超出时显示横向滚动条 -->
                            <DataGrid ItemsSource="{Binding ScanResults}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserSortColumns="False" CanUserResizeRows="False" materialDesign:DataGridAssist.CellPadding="4" MaxHeight="260" Width="440" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_Seq}" Binding="{Binding Index}" Width="40" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_Name}" Binding="{Binding Name}" Width="*" MinWidth="85" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_BaseZ}" Binding="{Binding BaseZValue, StringFormat=N3}" Width="*" MinWidth="65"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_UpperLimit}" Binding="{Binding UpperLimit, StringFormat=N3}" Width="*" MinWidth="65"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_LowerLimit}" Binding="{Binding LowerLimit, StringFormat=N3}" Width="*" MinWidth="65"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_Measured}" Binding="{Binding MeasuredValue, StringFormat=N3}" Width="*" MinWidth="75" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{lang:Lang ScanDetail_Column_Deviation}" Binding="{Binding Deviation, StringFormat=N3}" Width="*" MinWidth="75" IsReadOnly="True"/>

                                    <DataGridTemplateColumn Header="{lang:Lang ScanDetail_Column_Status}" MinWidth="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pass">
                                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Fail">
                                                                    <Setter Property="Foreground" Value="#D32F2F"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                            <Setter Property="Foreground" Value="#9E9E9E"/>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{lang:Lang ScanDetail_Column_WriteGlobalVar}" Width="*" MinWidth="190">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <common:GlobalVariableLinkControl
                                                    DisplayValue="{Binding Deviation, Mode=OneWay}"
                                                    DisplayForeground="#81C784"
                                                    IsLinked="{Binding IsDeviationLinked, Mode=OneWay}"
                                                    LinkedVariableName="{Binding TargetGlobalVariable, UpdateSourceTrigger=PropertyChanged}"
                                                    LinkableGlobalVariables="{Binding DataContext.LinkableGlobalVariables, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ComboBoxWidth="100" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>

                        <!-- 4. 执行测试 -->
                        <Expander IsExpanded="True" Header="{lang:Lang ScanDetail_ExecuteTest}" Margin="0,0,0,10">
                            <StackPanel Margin="8">
                                <!-- 示例数据输入 -->
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right"
                                            Content="{lang:Lang ScanDetail_FillSample}"
                                            Command="{Binding FillSampleDataCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="8,0,0,0"
                                            Padding="8,4"
                                            ToolTip="{lang:Lang ScanDetail_FillSampleToolTip}" />
                                    <TextBlock Text="{lang:Lang ScanDetail_TestData}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               Margin="0,0,8,0" />
                                </DockPanel>
                                <TextBox Text="{Binding SampleData, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="{lang:Lang ScanDetail_InputSimData}"
                                         Margin="0,0,0,8" />

                                <!-- 执行按钮组 -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,8">
                                    <Button Content="{lang:Lang ScanDetail_SendTriggerExecute}"
                                            Command="{Binding ExecuteTestCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Margin="0,0,8,0"
                                            Padding="12,6"
                                            ToolTip="{lang:Lang ScanDetail_SendTriggerToolTip}" />
                                    <Button Content="{lang:Lang ScanDetail_UseSampleExecute}"
                                            Command="{Binding ExecuteWithSampleDataCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Margin="0,0,8,0"
                                            Padding="12,6"
                                            ToolTip="{lang:Lang ScanDetail_UseSampleToolTip}" />
                                </StackPanel>

                                <!-- 进度条 -->
                                <ProgressBar IsIndeterminate="{Binding IsExecuting}"
                                             Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}"
                                             Margin="0,0,0,8"
                                             Height="4" />

                                <!-- 结果展示 -->
                                <Border Background="{DynamicResource MaterialDesignToolBarBackground}"
                                        CornerRadius="4"
                                        Padding="12"
                                        MinHeight="60"
                                        MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding ExecuteResult}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="Consolas"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MaterialDesign.Brush.ValidationError}" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Expander>

                        <!-- 5. 提示信息 -->
                        <Border Background="#1A237E08" CornerRadius="4" Padding="8,6">
                            <StackPanel>
                                <TextBlock Text="{lang:Lang VisionDetail_VarMappingNote}" FontSize="11" Foreground="#78909C" Margin="0,0,0,4"/>
                                <TextBlock FontSize="10" Foreground="#B0BEC5" TextWrapping="Wrap" LineHeight="15">
                                    <Run Text="{lang:Lang ScanDetail_Hint_TcpFlow}" /><LineBreak/>
                                    <Run Text="{lang:Lang ScanDetail_Hint_SampleSkip}" /><LineBreak/>
                                    <Run Text="{lang:Lang ScanDetail_Hint_Remapping}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ ROW 2: 底部操作栏 ═══ -->
            <Border Grid.Row="2" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource MaterialDesignDivider}">
                <Grid>
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Button Command="{Binding ExecuteWithSampleDataCommand}" ToolTip="{lang:Lang ScanDetail_UseSampleToolTip}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Padding="12,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang Test}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button Command="{Binding CloseCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Height="34" Padding="12,0" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang Cancel}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource MaterialDesignRaisedButton}" Height="34" Padding="20,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang Save}" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="Medium"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
