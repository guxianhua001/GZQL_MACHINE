<UserControl x:Class="Module.Views.GotoDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:converters="clr-namespace:Module.Common.Converters"
             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             Width="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ModuleCore;component/Themes/DialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Padding="16"
            Background="{DynamicResource DialogCardBrush}"
            CornerRadius="4">
        <StackPanel>

            <!-- 模式切换：回零 / 绝对定位 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                <TextBlock Text="{lang:Lang GotoDetail_ModeLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <RadioButton IsChecked="{Binding IsAbsoluteMode, Mode=TwoWay}"
                             Content="{lang:Lang GotoDetail_AbsoluteMode}"
                             VerticalAlignment="Center"
                             Margin="0,0,16,0"/>
                <RadioButton IsChecked="{Binding IsHomeMode, Mode=TwoWay}"
                             Content="{lang:Lang GotoDetail_HomeMode}"
                             VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 方案A：Ofs 链接与 VISION 映射同一全局变量，运行时显示视觉写入值 -->
            <TextBlock Text="{lang:Lang GotoDetail_SchemeA_Hint}"
                       TextWrapping="Wrap"
                       FontSize="10"
                       Foreground="{DynamicResource DialogTextSecondaryBrush}"
                       Margin="0,0,0,6"
                       Visibility="{Binding IsAbsoluteMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <!-- 绝对定位模式表格 -->
            <DataGrid ItemsSource="{Binding SubMoveRows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HorizontalAlignment="Stretch"
                      materialDesign:DataGridAssist.CellPadding="4"
                      MaxHeight="300"
                      SelectedItem="{Binding SelectedSubMoveRow}"
                      Visibility="{Binding IsAbsoluteMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sub" Binding="{Binding SubSeq}" Width="Auto" />
                    <DataGridTemplateColumn Header="Station" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StationId}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.StationItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding StationId, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="StationId"
                                          DisplayMemberPath="DisplayName"
                                          IsEditable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Axis" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}.{1}">
                                            <Binding Path="StationId" />
                                            <Binding Path="Axis" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableAxes}"
                                          SelectedItem="{Binding Axis, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Position" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PositionName}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailablePositions}"
                                          SelectedItem="{Binding PositionName, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Ofs(mm)" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <common:GlobalVariableLinkControl
                                    DisplayValue="{Binding OffsetDisplayValue, Mode=OneWay}"
                                    DisplayForeground="{DynamicResource DialogSuccessDarkBrush}"
                                    IsLinked="{Binding IsOffsetLinked, Mode=OneWay}"
                                    UnlinkCommand="{Binding DataContext.UnlinkOffsetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    LinkedVariableName="{Binding OffsetVariableName, UpdateSourceTrigger=PropertyChanged}"
                                    LinkableGlobalVariables="{Binding DataContext.LinkableOffsetVariables, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ComboBoxWidth="140" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Spd" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 回零模式表格 -->
            <DataGrid ItemsSource="{Binding SubMoveRows}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HorizontalAlignment="Stretch"
                      materialDesign:DataGridAssist.CellPadding="4"
                      MaxHeight="300"
                      SelectedItem="{Binding SelectedSubMoveRow}"
                      Visibility="{Binding IsHomeMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Sub" Binding="{Binding SubSeq}" Width="Auto" />
                    <DataGridTemplateColumn Header="Station" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StationId}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.StationItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedValue="{Binding StationId, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="StationId"
                                          DisplayMemberPath="DisplayName"
                                          IsEditable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Axis" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}.{1}">
                                            <Binding Path="StationId" />
                                            <Binding Path="Axis" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding AvailableAxes}"
                                          SelectedItem="{Binding Axis, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <!-- 回零类型：卡内配置 / 自定义参数 -->
                    <DataGridTemplateColumn Header="Type" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding HomeType}" VerticalAlignment="Center" Padding="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding HomeTypeOptions}"
                                          SelectedItem="{Binding HomeType, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <!-- 回零模式值：仅自定义模式下可编辑 -->
                    <DataGridTemplateColumn Header="HomeMode" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HomeMode, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsHomeParamsEditable}"
                                         materialDesign:HintAssist.Hint="1/2/3..."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="MinVel" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HomeMinVel, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="mm/s"
                                         IsEnabled="{Binding IsHomeParamsEditable}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="MaxVel" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding HomeMaxVel, UpdateSourceTrigger=PropertyChanged}"
                                         materialDesign:HintAssist.Hint="mm/s"
                                         IsEnabled="{Binding IsHomeParamsEditable}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 操作按钮 -->
            <DockPanel Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{lang:Lang Close}"
                            Command="{Binding CloseCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0" />
                    <Button Content="{lang:Lang Save}"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="{lang:Lang GotoDetail_Add}"
                            Margin="0,0,4,0"
                            Command="{Binding AddSubMoveCommand}" />
                    <Button Content="{lang:Lang GotoDetail_Delete}"
                            Margin="4,0,4,0"
                            Command="{Binding DeleteSubMoveCommand}" />
                    <Button Content="↑"
                            Margin="4,0,4,0"
                            Command="{Binding MoveUpCommand}" />
                    <Button Content="↓"
                            Margin="4,0,0,0"
                            Command="{Binding MoveDownCommand}" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
