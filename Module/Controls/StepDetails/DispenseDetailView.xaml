<UserControl x:Class="Module.Views.DispenseDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             Width="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ModuleCore;component/Themes/DialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource DialogAccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Padding="16"
            Background="{DynamicResource DialogCardBrush}"
            CornerRadius="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Dispense Mode Section -->
                <materialDesign:Card Padding="10" Margin="0,0,0,8">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="4" Background="{DynamicResource DialogAccentBrush}" CornerRadius="2,0,0,2" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="{lang:Lang DispenseDetail_DispenseMode}" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource DialogAccentBrush}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <RadioButton Content="{lang:Lang DispenseDetail_DotMode}"
                                             IsChecked="{Binding IsDotMode}"
                                             GroupName="DispenseModeGroup"
                                             Margin="0,0,16,0" Foreground="{DynamicResource DialogTextPrimaryBrush}"/>
                                <RadioButton Content="{lang:Lang DispenseDetail_ArcMode}"
                                             IsChecked="{Binding IsArcMode}"
                                             GroupName="DispenseModeGroup" Foreground="{DynamicResource DialogTextPrimaryBrush}"/>
                            </StackPanel>
                            <!-- 当前执行针头（只读，在 Step3 设置） -->
                            <materialDesign:Card Padding="8,6" Margin="0,8,0,0" Background="{DynamicResource DialogElevatedBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Needle" Width="16" Height="16" VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource DialogAccentBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{lang:Lang DispenseDetail_ActiveNeedleLabel}" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding ActiveNeedleDisplayText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DialogAccentBrush}" FontWeight="Bold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActiveNeedleStatusHint}" FontSize="10"
                                               Foreground="{DynamicResource DialogTextMutedBrush}" Margin="24,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </materialDesign:Card>
                            <!-- ============ 第一组：校准组 ============ -->
                            <Border Margin="0,8,0,6" Padding="10,8"
                                    Background="{DynamicResource DialogElevatedBrush}"
                                    BorderBrush="{DynamicResource DialogBorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="4" Background="{DynamicResource DialogAccentBrush}"
                                            CornerRadius="2,0,0,2" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <CheckBox DockPanel.Dock="Left" Content="{lang:Lang DispenseDetail_EnableZCalibration}"
                                                      IsChecked="{Binding EnableZCalibration}"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource DialogAccentBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" FontSize="10"
                                                       Foreground="{DynamicResource DialogTextMutedBrush}"
                                                       Text="{lang:Lang DispenseDetail_Group_Calibration}"/>
                                        </DockPanel>
                                        <Grid Visibility="{Binding EnableZCalibration, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{lang:Lang DispenseDetail_XCompCalibrator}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <common:GlobalVariableLinkControl Grid.Column="1"
                                                    DisplayValue="{Binding XCompensationCalibratorDisplayValue, Mode=OneWay}"
                                                    DisplayForeground="{DynamicResource DialogAccentBrush}"
                                                    IsLinked="{Binding IsXCompensationCalibratorLinked, Mode=OneWay}"
                                                    LinkedVariableName="{Binding XCompensationCalibratorLinkedVar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    LinkableGlobalVariables="{Binding AvailableGlobalVariables}"
                                                    UnlinkCommand="{Binding UnlinkXCompensationCalibratorCommand}"
                                                    ComboBoxWidth="180" />
                                            </Grid>
                                            <Grid Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{lang:Lang DispenseDetail_YCompCalibrator}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <common:GlobalVariableLinkControl Grid.Column="1"
                                                    DisplayValue="{Binding YCompensationCalibratorDisplayValue, Mode=OneWay}"
                                                    DisplayForeground="{DynamicResource DialogAccentBrush}"
                                                    IsLinked="{Binding IsYCompensationCalibratorLinked, Mode=OneWay}"
                                                    LinkedVariableName="{Binding YCompensationCalibratorLinkedVar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    LinkableGlobalVariables="{Binding AvailableGlobalVariables}"
                                                    UnlinkCommand="{Binding UnlinkYCompensationCalibratorCommand}"
                                                    ComboBoxWidth="180" />
                                            </Grid>
                                            <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{lang:Lang DispenseDetail_ZCompensationCalibrator}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <common:GlobalVariableLinkControl Grid.Column="1"
                                                    DisplayValue="{Binding ZCompensationCalibratorDisplayValue, Mode=OneWay}"
                                                    DisplayForeground="{DynamicResource DialogAccentBrush}"
                                                    IsLinked="{Binding IsZCompensationCalibratorLinked, Mode=OneWay}"
                                                    LinkedVariableName="{Binding ZCompensationCalibratorLinkedVar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    LinkableGlobalVariables="{Binding AvailableGlobalVariables}"
                                                    UnlinkCommand="{Binding UnlinkZCompensationCalibratorCommand}"
                                                    ComboBoxWidth="180" />
                                            </Grid>
                                            <Grid Grid.Row="1" Grid.Column="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{lang:Lang DispenseDetail_ZCompensation3D}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <common:GlobalVariableLinkControl Grid.Column="1"
                                                    DisplayValue="{Binding ZCompensation3DDisplayValue, Mode=OneWay}"
                                                    DisplayForeground="{DynamicResource DialogAccentBrush}"
                                                    IsLinked="{Binding IsZCompensation3DLinked, Mode=OneWay}"
                                                    LinkedVariableName="{Binding ZCompensation3DLinkedVar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    LinkableGlobalVariables="{Binding AvailableGlobalVariables}"
                                                    UnlinkCommand="{Binding UnlinkZCompensation3DCommand}"
                                                    ComboBoxWidth="180" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- ============ 第二组：运动方向补偿组 ============ -->
                            <Border Margin="0,0,0,6" Padding="10,8"
                                    Background="{DynamicResource DialogElevatedBrush}"
                                    BorderBrush="{DynamicResource DialogBorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="4" Background="{DynamicResource DialogAccentOrangeBrush}"
                                            CornerRadius="2,0,0,2" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <CheckBox DockPanel.Dock="Left" Content="{lang:Lang DispenseDetail_EnableComp}"
                                                      IsChecked="{Binding EnableComp}"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource DialogAccentOrangeBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" FontSize="10"
                                                       Foreground="{DynamicResource DialogTextMutedBrush}"
                                                       Text="{lang:Lang DispenseDetail_Group_MotionComp}"/>
                                        </DockPanel>
                                        <StackPanel Visibility="{Binding EnableComp, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Margin="0,0,8,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{lang:Lang DispenseDetail_XCompensation}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <common:GlobalVariableLinkControl Grid.Column="1"
                                                        DisplayValue="{Binding XCompensationDisplayValue, Mode=OneWay}"
                                                        DisplayForeground="{DynamicResource DialogAccentBrush}"
                                                        IsLinked="{Binding IsXCompensationLinked, Mode=OneWay}"
                                                        LinkedVariableName="{Binding XCompensationLinkedVar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        LinkableGlobalVariables="{Binding AvailableGlobalVariables}"
                                                        UnlinkCommand="{Binding UnlinkXCompensationCommand}"
                                                        ComboBoxWidth="180" />
                                                </Grid>
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{lang:Lang DispenseDetail_YCompensation}"
                                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <common:GlobalVariableLinkControl Grid.Column="1"
                                                        DisplayValue="{Binding YCompensationDisplayValue, Mode=OneWay}"
                                                        DisplayForeground="{DynamicResource DialogAccentBrush}"
                                                        IsLinked="{Binding IsYCompensationLinked, Mode=OneWay}"
                                                        LinkedVariableName="{Binding YCompensationLinkedVar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        LinkableGlobalVariables="{Binding AvailableGlobalVariables}"
                                                        UnlinkCommand="{Binding UnlinkYCompensationCommand}"
                                                        ComboBoxWidth="180" />
                                                </Grid>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- ============ 第三组：旋转补偿组 ============ -->
                            <Border Margin="0,0,0,0" Padding="10,8"
                                    Background="{DynamicResource DialogElevatedBrush}"
                                    BorderBrush="{DynamicResource DialogBorderBrush}"
                                    BorderThickness="1" CornerRadius="4">
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="4" Background="{DynamicResource DialogInfoBrush}"
                                            CornerRadius="2,0,0,2" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <CheckBox DockPanel.Dock="Left" Content="{lang:Lang DispenseDetail_EnableRotationComp}"
                                                      IsChecked="{Binding EnableRotationComp}"
                                                      FontWeight="SemiBold"
                                                      Foreground="{DynamicResource DialogInfoBrush}"/>
                                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" FontSize="10"
                                                       Foreground="{DynamicResource DialogTextMutedBrush}"
                                                       Text="{lang:Lang DispenseDetail_Group_RotationComp}"/>
                                        </DockPanel>
                                        <StackPanel Visibility="{Binding EnableRotationComp, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{lang:Lang DispenseDetail_RotationAngle}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <common:GlobalVariableLinkControl Grid.Column="1"
                                                    DisplayValue="{Binding RotationAngleDisplayValue, Mode=OneWay}"
                                                    DisplayForeground="{DynamicResource DialogAccentBrush}"
                                                    IsLinked="{Binding IsRotationAngleLinked, Mode=OneWay}"
                                                    LinkedVariableName="{Binding RotationAngleLinkedVar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    LinkableGlobalVariables="{Binding AvailableGlobalVariables}"
                                                    UnlinkCommand="{Binding UnlinkRotationAngleCommand}"
                                                    ComboBoxWidth="180" />
                                                <!-- 查看旋转后坐标弹窗按钮 -->
                                                <Button Grid.Column="2" Command="{Binding ViewRotatedCoordsCommand}"
                                                        Style="{StaticResource MaterialDesignFlatButton}"
                                                        Padding="8,2" Margin="8,0,0,0" FontSize="11"
                                                        ToolTip="{lang:Lang DispenseDetail_ViewRotatedCoords}"
                                                        IsEnabled="{Binding IsTransformAvailable}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="MapMarkerDistance" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{lang:Lang DispenseDetail_ViewRotatedCoords}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <!-- Coord Transform 状态提示 -->
                                            <TextBlock FontSize="10" Foreground="{DynamicResource DialogTextMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                <Run Text="{lang:Lang DispenseDetail_CoordTransformHint}"/>
                                                <Run Text=" "/>
                                                <Run Text="{Binding IsTransformAvailable, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Segment Import Section -->
                <materialDesign:Card Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding SegmentImportTitle}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>

                        <!-- Toolbar：按点胶模式显示对应导入按钮 -->
                        <WrapPanel Margin="0,0,0,6">
                            <Button Command="{Binding ImportLinesCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="10,4" Margin="0,0,4,0" FontSize="13"
                                    Visibility="{Binding ShowImportLines, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileImport" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang DispenseDetail_ImportLines}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImportArcsCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="10,4" Margin="0,0,4,0"
                                    Visibility="{Binding ShowImportArcs, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileImport" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang DispenseDetail_ImportArcs}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveSelectedCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="10,4" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Delete" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang DispenseDetail_RemoveSelected}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="10,4" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CheckAll" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang DispenseDetail_SelectAll}"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding InvertSelectionCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="10,4" Margin="0,0,4,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="SwapHorizontal" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang DispenseDetail_InvertSelection}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- DataGrid -->
                        <DataGrid ItemsSource="{Binding SegmentRefs}"
                                  SelectedItem="{Binding SelectedSegmentRef}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  materialDesign:DataGridAssist.CellPadding="4"
                                  MaxHeight="120">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="{lang:Lang Step3_Header_Enabled}" Width="Auto" MinWidth="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                      HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="{lang:Lang DispenseDetail_Header_ID}"
                                                    Binding="{Binding SourceSegmentId}" Width="*"/>

                                <DataGridTextColumn Header="{lang:Lang DispenseDetail_Header_Type}"
                                                    Binding="{Binding SourceEntityType}" Width="*"/>

                                <DataGridTextColumn Header="{lang:Lang DispenseDetail_Header_Layer}"
                                                    Binding="{Binding SourceLayerName}" Width="*"/>

                                <DataGridTextColumn Header="{lang:Lang DispenseDetail_Header_Length}"
                                                    Binding="{Binding SourceLength, StringFormat=F2}" Width="*"/>

                                <DataGridTextColumn Header="{lang:Lang DispenseDetail_Header_PointCount}"
                                                    Binding="{Binding SourcePointCount}" Width="*"/>

                                <!-- 段级 Z Comp（3D Camera）链接列：仅线段导入（点模式）显示 -->
                                <DataGridTemplateColumn Header="{lang:Lang DispenseDetail_Header_SegmentZComp3D}"
                                                        Width="220" MinWidth="200"
                                                        Visibility="{Binding DataContext.ShowImportLines, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <common:GlobalVariableLinkControl
                                                DisplayValue="{Binding ZCompensation3DDisplayValue, Mode=OneWay}"
                                                DisplayForeground="{DynamicResource DialogAccentBrush}"
                                                IsLinked="{Binding IsZCompensation3DLinked, Mode=OneWay}"
                                                LinkedVariableName="{Binding ZCompensation3DLinkedVar, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                LinkableGlobalVariables="{Binding DataContext.AvailableGlobalVariables, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ComboBoxWidth="110" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Process Parameters Section -->
                <materialDesign:Card Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding ProcessParamsTitle}" FontWeight="Bold" FontSize="13" Margin="0,0,0,6"/>

                        <!-- Default Params — Three-column color-grouped layout -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Group 1: Motion Params (Blue) -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource DialogAccentBrush}"
                                           Text="{lang:Lang DispenseDetail_Group_MotionParams}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_MoveSpeed}" Margin="0,2,8,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveMoveSpeed, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm/s"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_InterpSpeed}" Margin="0,2,8,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveInterpSpeed, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm/s"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_SafeHeight}" Margin="0,2,8,0"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveSafeHeight, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_ApproachHeight}" Margin="0,2,8,0"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveApproachHeight, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_CornerDecel}" Margin="0,2,8,0"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveCornerDecel, StringFormat=F2, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Column="1" Width="1" Background="{DynamicResource DialogBorderBrush}" Margin="0,4"/>
                            <StackPanel Grid.Column="2" Margin="12,0,12,0">
                                <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource DialogAccentOrangeBrush}"
                                           Text="{lang:Lang DispenseDetail_Group_DispenseControl}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_DispenseTime}" Margin="0,2,8,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveDispenseTime, StringFormat=F0, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="ms"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_PreDelay}" Margin="0,2,8,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectivePreDelay, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="ms"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_EarlyCloseGlueDelay}" Margin="0,2,8,0"
                                               ToolTip="{lang:Lang DispenseDetail_Tip_EarlyCloseGlueDelay}"
                                               Visibility="{Binding IsArcMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveEarlyCloseGlueDelayMs, StringFormat=F0, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"
                                             Visibility="{Binding IsArcMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="ms"
                                               Visibility="{Binding IsArcMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_PostDelay}" Margin="0,2,8,0"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectivePostDelay, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="ms"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_GlueTriggerOffset}" Margin="0,2,8,0"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveGlueTriggerOffsetMm, StringFormat=F2, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>
                                </Grid>
                            </StackPanel>

                            <Border Grid.Column="3" Width="1" Background="{DynamicResource DialogBorderBrush}" Margin="0,4"/>

                            <!-- Group 3: Height Params (Cyan) -->
                            <StackPanel Grid.Column="4" Margin="12,0,0,0">
                                <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="{DynamicResource DialogInfoBrush}"
                                           Text="{lang:Lang DispenseDetail_Group_HeightParams}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_TeachHeight}" Margin="0,2,8,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveTeachHeight, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang DispenseDetail_HeightCompensation}" Margin="0,2,8,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveHeightCompensation, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>
                                </Grid>

                                <!-- 人工补偿（XY Offset，位于高度参数组下方） -->
                                <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,10,0,6" Foreground="{DynamicResource DialogInfoBrush}"
                                           Text="{lang:Lang DispenseDetail_Group_ManualCompensation}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamLabel}"
                                               Text="{lang:Lang DispenseDetail_XyCompensationX}" Margin="0,2,8,0"
                                               ToolTip="{lang:Lang DispenseDetail_Tip_XyCompensation}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveXyCompensationX, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamLabel}"
                                               Text="{lang:Lang DispenseDetail_XyCompensationY}" Margin="0,2,8,0"
                                               ToolTip="{lang:Lang DispenseDetail_Tip_XyCompensation}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             Text="{Binding EffectiveXyCompensationY, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </materialDesign:Card>

                <!-- Execution Control Section -->
                <materialDesign:Card Padding="10" Margin="0,0,0,8">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="4" Background="{DynamicResource DialogAccentOrangeBrush}" CornerRadius="2,0,0,2" Margin="0,0,10,0"/>
                        <StackPanel>
                            <TextBlock Text="{lang:Lang DispenseDetail_ExecutionControl}" FontWeight="Bold" FontSize="13"
                                       Foreground="{DynamicResource DialogAccentOrangeBrush}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <CheckBox Content="{lang:Lang DispenseDetail_DryRunMode}"
                                          IsChecked="{Binding IsDryRunMode}"
                                          Margin="0,0,20,0" Foreground="{DynamicResource DialogTextPrimaryBrush}"/>
                                <CheckBox Content="{lang:Lang DispenseDetail_RealDispenseMode}"
                                          IsChecked="{Binding IsRealDispenseMode}"
                                          Foreground="{DynamicResource DialogTextPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:Card>

                <!-- Footer -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="{lang:Lang Close}" Command="{Binding CloseCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                    <Button Content="{lang:Lang Save}" Command="{Binding SaveCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
