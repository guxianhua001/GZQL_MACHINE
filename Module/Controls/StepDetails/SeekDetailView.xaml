<UserControl x:Class="Module.Views.SeekDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             Width="1010"
             MaxHeight="680">

    <Border Background="{DynamicResource MaterialDesignCardBackground}"
            CornerRadius="6">
        <Border.Resources>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </Border.Resources>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ 顶部标题栏 ═══ -->
            <Border Grid.Row="0"
                        Padding="12,6"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource MaterialDesignDivider}">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2D3748" Offset="0" />
                        <GradientStop Color="#3A475A" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                                Command="{Binding CloseCommand}"
                                ToolTip="{lang:Lang Close}"
                                Width="24" Height="24"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Foreground="White">
                        <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                    </Button>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="CrosshairsGps"
                                                                   Width="18" Height="18"
                                                                   Foreground="#FFB74D"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,6,0" />
                        <TextBlock Text="SEEK"
                                           Foreground="White"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                        <Border Background="#2D3748"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Foreground="#90CAF9"
                                               FontSize="11">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{lang:Lang SeekDetail_Offline}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRefreshing}" Value="True">
                                                <Setter Property="Text" Value="{lang:Lang SeekDetail_RealTimeCollecting}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ═══ 主体：通道表格 ═══ -->
            <Grid Grid.Row="1" Margin="16,12,16,8">
                <DataGrid ItemsSource="{Binding ChannelRows}"
                          SelectedItem="{Binding SelectedChannelRow}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          materialDesign:DataGridAssist.CellPadding="6,4"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowHeight="36"
                          MaxHeight="380">
                    <DataGrid.Columns>
                        <!-- Sub 序号 -->
                        <DataGridTextColumn Header="Sub"
                                            Binding="{Binding Sub}"
                                            Width="48" IsReadOnly="True"
                                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />

                        <!-- 链接通道 -->
                        <DataGridTemplateColumn Header="{lang:Lang SeekDetail_Column_LinkedChannel}" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LinkedChannel}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource PrimaryHueMidBrush}"
                                               FontWeight="Medium" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <materialDesign:NumericUpDown Value="{Binding LinkedChannel, UpdateSourceTrigger=PropertyChanged}"
                                                                  Minimum="0" Maximum="255" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- 通道名称（来自 hwcfg.xml 配置，只读） -->
                        <DataGridTemplateColumn Header="{lang:Lang SeekDetail_Column_ChannelName}" Width="90" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ChannelName}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#78909C" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Target 目标力值 -->
                        <DataGridTemplateColumn Header="Target(N)" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TargetForce, StringFormat={}{0:F2}N}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontWeight="Medium" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <materialDesign:NumericUpDown Value="{Binding TargetForce, UpdateSourceTrigger=PropertyChanged}"
                                                                  Minimum="-100" Maximum="100" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- Force 实时力值（核心列，带颜色指示条 + 单位显示） -->
                        <DataGridTemplateColumn Header="Force" Width="130" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Height="6"
                                                CornerRadius="3"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E0E0E0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsForceInRange}" Value="True">
                                                            <Setter Property="Background" Value="#66BB6A" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsForceInRange}" Value="False">
                                                            <Setter Property="Background" Value="#EF5350" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding CurrentForce, StringFormat={}{0:F2}}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#9E9E9E" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsForceInRange}" Value="True">
                                                            <Setter Property="Foreground" Value="#2E7D32" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsForceInRange}" Value="False">
                                                            <Setter Property="Foreground" Value="#C62828" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 单位显示（来自 hwcfg.xml AD 通道配置） -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ChannelUnit}"
                                                   FontSize="11"
                                                   Foreground="#9E9E9E"
                                                   VerticalAlignment="Center"
                                                   Margin="3,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- force_min -->
                        <DataGridTemplateColumn Header="Min" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ForceMin, StringFormat={}{0:F1}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#78909C" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <materialDesign:NumericUpDown Value="{Binding ForceMin, UpdateSourceTrigger=PropertyChanged}"
                                                                  Minimum="-1000" Maximum="1000" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- force_max -->
                        <DataGridTemplateColumn Header="Max" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ForceMax, StringFormat={}{0:F1}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#78909C" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <materialDesign:NumericUpDown Value="{Binding ForceMax, UpdateSourceTrigger=PropertyChanged}"
                                                                  Minimum="-1000" Maximum="1000" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <!-- 全局变量（统一使用 GlobalVariableLinkControl） -->
                        <DataGridTemplateColumn Header="{lang:Lang SeekDetail_Column_GlobalVar}" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <common:GlobalVariableLinkControl
                                        DisplayValue="{Binding CurrentForce, Mode=OneWay}"
                                        DisplayForeground="#42A5F5"
                                        IsLinked="{Binding IsLinked, Mode=OneWay}"
                                        UnlinkCommand="{Binding DataContext.UnlinkVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        LinkedVariableName="{Binding LinkedVariableName, UpdateSourceTrigger=PropertyChanged}"
                                        LinkableGlobalVariables="{Binding DataContext.LinkableGlobalVariables, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ComboBoxWidth="100" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Description -->
                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"
                                            ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ═══ 底部操作栏 ═══ -->
            <Border Grid.Row="2"
                    Padding="16,10"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource MaterialDesignDivider}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：通道操作 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding AddChannelRowCommand}"
                                ToolTip="{lang:Lang SeekDetail_AddChannelToolTip}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="6,0" Margin="0,0,4,0"
                                Height="30">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang SeekDetail_AddChannel}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteChannelRowCommand}"
                                ToolTip="{lang:Lang SeekDetail_DeleteChannelToolTip}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="6,0" Margin="0,0,4,0"
                                Height="30">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Minus" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang SeekDetail_DeleteChannel}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 中左：刷新控制 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button Command="{Binding StartRefreshCommand}"
                                ToolTip="{lang:Lang SeekDetail_RefreshToolTip}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Padding="6,0" Margin="0,0,4,0"
                                Height="30">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Play" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang SeekDetail_Refresh}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding StopRefreshCommand}"
                                ToolTip="{lang:Lang SeekDetail_StopToolTip}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="6,0" Margin="0,0,4,0"
                                Height="30">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang SeekDetail_Stop}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ProgressBar IsIndeterminate="{Binding IsRefreshing}"
                                     Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}"
                                     Width="60" Height="4"
                                     VerticalAlignment="Center"
                                     Margin="4,0,0,0"
                                     Foreground="#42A5F5" />
                    </StackPanel>

                    <!-- 中右：导入导出 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,0,12,0">
                        <Button Command="{Binding ImportCommand}"
                                ToolTip="{lang:Lang SeekDetail_ImportToolTip}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="6,0" Margin="0,0,4,0"
                                Height="30">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Import" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang SeekDetail_Import}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportCommand}"
                                ToolTip="{lang:Lang SeekDetail_ExportToolTip}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="6,0"
                                Height="30">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Export" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang SeekDetail_Export}" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 右侧：确认继续 -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Height="34"
                                Padding="20,0"
                                materialDesign:ButtonAssist.CornerRadius="4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang SeekDetail_ConfirmContinue}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
