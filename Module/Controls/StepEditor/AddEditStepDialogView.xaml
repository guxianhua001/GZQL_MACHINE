<UserControl x:Class="Module.Views.AddEditStepDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="500">
    <StackPanel Margin="16">
        <TextBlock Text="{lang:Lang PSE_AddEditStepTitle}"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- 步骤类型 -->
        <ComboBox materialDesign:HintAssist.Hint="{lang:Lang PSE_StepTypeHint}"
                  ItemsSource="{Binding StepTypeValues}"
                  SelectedItem="{Binding Step.Step}"
                  Margin="0,8" />

        <!-- 组件特征 -->
        <ComboBox materialDesign:HintAssist.Hint="{lang:Lang PSE_ColumnCompFeature}"
                  ItemsSource="{Binding ComponentFeatures}"
                  SelectedItem="{Binding Step.CompFeature}"
                  Margin="0,8" />

        <!-- 站点特征 -->
        <ComboBox materialDesign:HintAssist.Hint="{lang:Lang PSE_ColumnSiteFeature}"
                  ItemsSource="{Binding SiteFeatures}"
                  SelectedItem="{Binding Step.SiteFeature}"
                  Margin="0,8" />

        <!-- 相机 -->
        <ComboBox materialDesign:HintAssist.Hint="{lang:Lang PSE_ColumnCamera}"
                  ItemsSource="{Binding CameraOptions}"
                  SelectedItem="{Binding Step.Camera}"
                  Margin="0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{lang:Lang Dialog_Cancel}"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    Command="{Binding CancelCommand}"
                    Margin="8,0" />
            <Button Content="{lang:Lang Dialog_OK}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Command="{Binding OkCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
