<Window x:Class="Module.Editor.SvgPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="坐标对齐原理示意图"
        Width="940" Height="520"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAFAFA">
    <Viewbox Margin="12">
        <Canvas Width="900" Height="480">
            <!-- 左：CAD图纸 -->
            <Rectangle Canvas.Left="20" Canvas.Top="20" Width="400" Height="420"
                       Fill="#FFF" Stroke="#999" StrokeThickness="1" RadiusX="6" RadiusY="6"/>
            <TextBlock Canvas.Left="150" Canvas.Top="32" FontSize="14" FontWeight="Bold" Foreground="#333"
                       FontFamily="微软雅黑" Text="CAD 图纸端"/>

            <!-- 圆弧轨迹 -->
            <Path Data="M 60,220 Q 180,100 300,220" Stroke="#2196F3" StrokeThickness="3" Fill="Transparent"/>

            <!-- 真实基准A（在轨迹上） -->
            <Ellipse Canvas.Left="52" Canvas.Top="212" Width="16" Height="16" Fill="#f44336"/>
            <TextBlock Canvas.Left="72" Canvas.Top="205" FontSize="13" Foreground="#333"
                       FontFamily="微软雅黑" Text="真实基准A"/>

            <!-- 虚拟方向点B -->
            <Ellipse Canvas.Left="152" Canvas.Top="212" Width="14" Height="14" Fill="#4caf50"/>
            <TextBlock Canvas.Left="172" Canvas.Top="200" FontSize="12" Foreground="#888"
                       FontFamily="微软雅黑" Text="虚拟方向点B"/>
            <TextBlock Canvas.Left="172" Canvas.Top="218" FontSize="12" Foreground="#888"
                       FontFamily="微软雅黑" Text="(无实物)"/>

            <!-- 图纸X轴虚线 -->
            <Line X1="60" Y1="220" X2="280" Y2="220" Stroke="#CCC" StrokeThickness="1.5" StrokeDashArray="4,2"/>
            <TextBlock Canvas.Left="100" Canvas.Top="230" FontSize="12" Foreground="#888"
                       FontFamily="微软雅黑" Text="沿图纸X轴固定偏移生成"/>

            <!-- 中间映射箭头 -->
            <Line X1="420" Y1="220" X2="470" Y2="220" Stroke="#ff5722" StrokeThickness="2"/>
            <Polygon Points="470,215 480,220 470,225" Fill="#ff5722"/>

            <!-- 右：机械工作台（带旋转） -->
            <Rectangle Canvas.Left="490" Canvas.Top="20" Width="390" Height="420"
                       Fill="#FFF" Stroke="#999" StrokeThickness="1" RadiusX="6" RadiusY="6"/>
            <TextBlock Canvas.Left="600" Canvas.Top="32" FontSize="14" FontWeight="Bold" Foreground="#333"
                       FontFamily="微软雅黑" Text="机械工作台端"/>

            <!-- 旋转后圆弧 -->
            <Path Data="M 540,260 Q 660,160 760,280" Stroke="#2196F3" StrokeThickness="3" Fill="Transparent"
                  RenderTransformOrigin="0.512,0.796" HorizontalAlignment="Center" Canvas.Top="149.34" VerticalAlignment="Top" Canvas.Left="-72.214">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.99999999999999989" ScaleY="0.99999999999999989"/>
                        <SkewTransform/>
                        <RotateTransform Angle="7.493"/>
                        <TranslateTransform X="79.832" Y="-190.362"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>

            <!-- 机械真实A（现场示教唯一真实点） -->
            <Ellipse Canvas.Left="532" Canvas.Top="252" Width="16" Height="16" Fill="#f44336"/>
            <TextBlock Canvas.Left="552" Canvas.Top="245" FontSize="13" Foreground="#333"
                       FontFamily="微软雅黑" Text="机械真实A（唯一需要示教）"/>

            <!-- 机械虚拟B -->
            <Ellipse Canvas.Left="627" Canvas.Top="227" Width="14" Height="14" Fill="#4caf50"/>
            <TextBlock Canvas.Left="647" Canvas.Top="215" FontSize="12" Foreground="#888"
                       FontFamily="微软雅黑" Text="机械虚拟B"/>
            <TextBlock Canvas.Left="647" Canvas.Top="233" FontSize="12" Foreground="#888"
                       FontFamily="微软雅黑" Text="(自动计算，无需示教)"/>

            <!-- 机械倾斜X轴 -->
            <Line X1="540" Y1="260" X2="720" Y2="210" Stroke="#E65100" StrokeThickness="1.5"/>
            <TextBlock Canvas.Left="590" Canvas.Top="185" FontSize="12" Foreground="#888"
                       FontFamily="微软雅黑" Text="沿机械X轴同距离自动生成"/>

            <!-- 底部总结 -->
            <TextBlock Canvas.Left="30" Canvas.Top="455" FontSize="12" Foreground="#888"
                       FontFamily="微软雅黑" Text="关键：只示教1个真实基准A，B点全部软件虚拟生成，不用现场找第二个点"/>
        </Canvas>
    </Viewbox>
</Window>
