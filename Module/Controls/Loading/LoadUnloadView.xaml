<UserControl x:Class="Module.Views.LoadUnloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/" xmlns:converters="clr-namespace:Module.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100"
             MinWidth="1100"
             MinHeight="700"
             Background="#EEF2F5">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />
            <converters:ColorToLightBrushConverter x:Key="ColorToLightBrushConverter" />
            <converters:BooleanToFontWeightConverter x:Key="BooleanToFontWeightConverter" />
            <converters:BooleanToCheckmarkConverter x:Key="BooleanToCheckmarkConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

            <!-- 状态指示Pill样式 -->
            <Style x:Key="StatusPill" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="8,3" />
                <Setter Property="Background" Value="#F5F5F5" />
            </Style>

            <!-- 轴状态项样式 -->
            <Style x:Key="AxisStatusItem" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ==================== HEADER ==================== -->
        <Border Grid.Row="0" Background="White" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.08" Direction="270" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧标题区 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="SwapHorizontalBold" Width="24" Height="24"
                                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                                             VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{lang:Lang LoadUnload_Title}"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#333333"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource PrimaryHueLightBrush}" CornerRadius="4" Padding="8,2" Margin="14,0,0,0">
                        <TextBlock Text="{lang:Lang LoadUnload_Subtitle}" FontSize="11"
                                   Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                   VerticalAlignment="Center" FontWeight="Medium" />
                    </Border>
                </StackPanel>

                <!-- 右侧状态 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusPill}"
                            Background="{Binding VacuumStatusColor, Converter={StaticResource ColorToLightBrushConverter}, FallbackValue=#E8F5E9}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{Binding VacuumStatusColor, FallbackValue=#4CAF50}"
                                     VerticalAlignment="Center" Margin="0,0,5,0" />
                            <TextBlock Text="{Binding ProcessStatus}"
                                       FontSize="11" Foreground="#2E7D32" FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT: 三栏布局 ==================== -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="240" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="300" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <!-- ============================================================ -->
            <!-- LEFT PANEL: 设备状态监控                                        -->
            <!-- ============================================================ -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">

                <!-- 设备状态卡片 -->
                <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                     Background="{DynamicResource MaterialDesignCardBackground}">
                    <StackPanel>
                        <TextBlock Text="{lang:Lang Device_Status_Title}"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"
                                   Margin="0,0,0,12" />

                        <!-- 轴状态列表 -->
                        <TextBlock Text="{lang:Lang Axis_Status_Label}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#9E9E9E" Margin="0,0,0,8" />

                        <!-- Rx 轴 -->
                        <Border Style="{StaticResource AxisStatusItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rx"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Grid.Column="1" Width="9" Height="9"
                                         Fill="{Binding RxAxisReady, Converter={StaticResource BooleanToBrushConverter}}"
                                         Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RxAxisReady, Converter={StaticResource BooleanToCheckmarkConverter}}"
                                           Foreground="#757575" FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Rz 轴 -->
                        <Border Style="{StaticResource AxisStatusItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rz"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Grid.Column="1" Width="9" Height="9"
                                         Fill="{Binding RzAxisReady, Converter={StaticResource BooleanToBrushConverter}}"
                                         Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RzAxisReady, Converter={StaticResource BooleanToCheckmarkConverter}}"
                                           Foreground="#757575" FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Y 轴 -->
                        <Border Style="{StaticResource AxisStatusItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Y"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Grid.Column="1" Width="9" Height="9"
                                         Fill="{Binding YAxisReady, Converter={StaticResource BooleanToBrushConverter}}"
                                         Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding YAxisReady, Converter={StaticResource BooleanToCheckmarkConverter}}"
                                           Foreground="#757575" FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Ry 轴 -->
                        <Border Style="{StaticResource AxisStatusItem}" Margin="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Ry"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                                           FontWeight="Bold" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Grid.Column="1" Width="9" Height="9"
                                         Fill="{Binding RyAxisReady, Converter={StaticResource BooleanToBrushConverter}}"
                                         Margin="8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding RyAxisReady, Converter={StaticResource BooleanToCheckmarkConverter}}"
                                           Foreground="#757575" FontSize="11"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 实时位置卡片 -->
                <materialDesign:Card UniformCornerRadius="8" Padding="16"
                                     Background="{DynamicResource MaterialDesignCardBackground}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <materialDesign:PackIcon Kind="CrosshairsGps" Width="18" Height="18"
                                                     Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lang:Lang RealTimePosition}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Foreground="{DynamicResource SecondaryHueMidBrush}" />
                        </StackPanel>

                        <Border Background="#FAFAFA" CornerRadius="6" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{Binding RealTimePositions}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="#424242" TextWrapping="Wrap"
                                           LineHeight="1.7" />
                                <Rectangle Height="1" Fill="#E0E0E0" Margin="0,8" />
                                <TextBlock Text="{lang:Lang RealTimePosition}"
                                           FontSize="10" Foreground="#BDBDBD" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>

            <!-- ============================================================ -->
            <!-- CENTER PANEL: 主操作控制区                                      -->
            <!-- ============================================================ -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0"
                          IsEnabled="{Binding IsMoving, Converter={StaticResource InverseBooleanConverter}}">
                <StackPanel>

                    <!-- ========== A. VACUUM CONTROL ========== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="Vacuum" Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang Vacuum_Control_Title}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            </StackPanel>

                            <WrapPanel>
                                <!-- 载台真空：状态 -->
                                <TextBlock Text="{lang:Lang Vacuum_Chuck}"
                                           VerticalAlignment="Center" Foreground="#616161"
                                           FontSize="13" Margin="0,0,8,0" />

                                <!-- 真空状态指示 -->
                                <Border Style="{StaticResource StatusPill}"
                                        Background="#E8F5E9" Margin="0,0,20,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding VacuumStatusColor, FallbackValue=#4CAF50}"
                                                 VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding VacuumStatusText}"
                                                   Foreground="#2E7D32" FontWeight="SemiBold"
                                                   FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- 操作按钮 -->
                                <Button Command="{Binding VacuumOnCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="10,4" Margin="0,0,6,0"
                                        BorderBrush="#4CAF50" Foreground="#2E7D32"
                                        ToolTip="{lang:Lang LoadUnload_Vacuum_On}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Power" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang LoadUnload_Vacuum_On}" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding VacuumOffCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="10,4" Margin="0,0,6,0"
                                        BorderBrush="#EF5350" Foreground="#C62828"
                                        ToolTip="{lang:Lang LoadUnload_Vacuum_Off}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PowerOff" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang LoadUnload_Vacuum_Off}" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding VacuumCheckCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="10,4"
                                        ToolTip="{lang:Lang LoadUnload_Vacuum_Check}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircle" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang LoadUnload_Vacuum_Check}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ========== B. POSITIONING CONTROL ========== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="ArrowDecision" Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang Positioning_Control_Title}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            </StackPanel>

                            <!-- 快速定位按钮 -->
                            <TextBlock Text="{lang:Lang Quick_Move_Label}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#9E9E9E" Margin="0,0,0,8" />

                            <WrapPanel Margin="0,0,0,14">
                                <Button Command="{Binding GoToPickCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="10,4" Margin="0,0,6,6"
                                        ToolTip="{lang:Lang Position_Pickup}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowRightTop" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang Position_Pickup}" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding GoToScanCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="10,4" Margin="0,0,6,6"
                                        ToolTip="{lang:Lang Position_Scan}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Camera" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang Position_Scan}" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding GoToUnloadCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="10,4" Margin="0,0,6,6"
                                        ToolTip="{lang:Lang Position_Discharge}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowDown" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang Position_Discharge}" />
                                    </StackPanel>
                                </Button>

                                <!-- Home All (警告色) -->
                                <Button Command="{Binding HomeAllCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#FFA000" Foreground="White"
                                        Padding="10,4" Margin="0,0,0,6"
                                        materialDesign:ButtonAssist.CornerRadius="4"
                                        ToolTip="{lang:Lang LoadUnload_Button_HomeAll}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Home" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang LoadUnload_Button_HomeAll}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- 装配位选择 -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{lang:Lang LoadUnload_SelectAssemblyPositionLabel}"
                                           VerticalAlignment="Center" Foreground="#616161"
                                           FontSize="13" Margin="0,0,8,0" />

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AssySites}"
                                          SelectedItem="{Binding SelectedSite}"
                                          materialDesign:HintAssist.Hint="{lang:Lang LoadUnload_SelectAssemblyPositionLabel}"
                                          FontSize="12" />

                                <Button Grid.Column="2"
                                        Command="{Binding MoveToSelectedSiteCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="8,0,6,0" Padding="14,4"
                                        ToolTip="{lang:Lang LoadUnload_Button_ExecutePositioning}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MapMarker" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang LoadUnload_Button_ExecutePositioning}" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="3"
                                        Command="{Binding EditSitePositionCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="10,4"
                                        ToolTip="{lang:Lang LoadUnload_Button_Edit}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang LoadUnload_Button_Edit}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ========== C. GRIPPER CONTROL ========== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,0"
                                         Background="{DynamicResource MaterialDesignCardBackground}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="HandBackRight" Width="18" Height="18"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang Gripper_Control_Title}"
                                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                           Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            </StackPanel>

                            <!-- 夹爪真空控制行 -->
                            <WrapPanel Margin="0,0,0,12">
                                <TextBlock Text="{lang:Lang Gripper_Vacuum}"
                                           VerticalAlignment="Center" Foreground="#616161"
                                           FontSize="13" Margin="0,0,8,0" />

                                <Border Style="{StaticResource StatusPill}" Background="#E8F5E9"
                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8"
                                                 Fill="{Binding GripperVacuumStatusColor, FallbackValue=#4CAF50}"
                                                 VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <TextBlock Text="{Binding GripperVacuumStatusText}"
                                                   Foreground="#2E7D32" FontWeight="SemiBold"
                                                   FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <Button Command="{Binding GripperVacuumOnCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="8,4" Margin="0,0,6,0"
                                        BorderBrush="#4CAF50" Foreground="#2E7D32"
                                        ToolTip="{lang:Lang LoadUnload_Vacuum_On}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Power" Width="13" Height="13" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang LoadUnload_Vacuum_On}" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding GripperVacuumOffCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="8,4" Margin="0,0,6,0"
                                        BorderBrush="#EF5350" Foreground="#C62828"
                                        ToolTip="{lang:Lang LoadUnload_Vacuum_Off}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PowerOff" Width="13" Height="13" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang LoadUnload_Vacuum_Off}" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding GripperVacuumCheckCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="8,4"
                                        ToolTip="{lang:Lang LoadUnload_Vacuum_Check}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CheckCircle" Width="13" Height="13" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang LoadUnload_Vacuum_Check}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- 夹爪状态信息 -->
                            <Border Background="#FFF8E1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="InformationOutline" Width="16" Height="16"
                                                             Foreground="#F9A825" Margin="0,0,8,0"
                                                             VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding GripperStatus}"
                                               Foreground="#795548" FontSize="12"
                                               FontStyle="Italic" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- 夹爪操作按钮组 -->
                            <WrapPanel>
                                <Button Command="{Binding GripperOperationCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="10,4" Margin="0,0,6,6"
                                        ToolTip="{lang:Lang GripperOperation}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Hand" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang GripperOperation}" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding GoToGripAngleCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="10,4" Margin="0,0,6,6"
                                        ToolTip="{lang:Lang GoToGripAngle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="RotateRight" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang GoToGripAngle}" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ClampCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#EF5350" Foreground="White"
                                        Padding="10,4" Margin="0,0,6,6"
                                        materialDesign:ButtonAssist.CornerRadius="4"
                                        ToolTip="{lang:Lang GripClose}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CloseThick" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang GripClose}" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ReleaseCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#66BB6A" Foreground="White"
                                        Padding="10,4" Margin="0,0,6,6"
                                        materialDesign:ButtonAssist.CornerRadius="4"
                                        ToolTip="{lang:Lang GripOpen}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="OpenInApp" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang GripOpen}" />
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding EditGripperParameterCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Padding="10,4" Margin="0,0,0,6"
                                        ToolTip="{lang:Lang Param_Edit}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Pencil" Width="14" Height="14" Margin="0,0,5,0" />
                                        <TextBlock Text="{lang:Lang Param_Edit}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </materialDesign:Card>

                </StackPanel>
            </ScrollViewer>

            <!-- ============================================================ -->
            <!-- RIGHT PANEL: 流程控制与状态监控                                  -->
            <!-- ============================================================ -->
            <StackPanel Grid.Column="2">

                <!-- 自动流程卡片 -->
                <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10"
                                     Background="{DynamicResource MaterialDesignCardBackground}">
                    <StackPanel IsEnabled="{Binding IsMoving, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <materialDesign:PackIcon Kind="RobotIndustrial" Width="18" Height="18"
                                                     Foreground="{DynamicResource SecondaryHueMidBrush}"
                                                     Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{lang:Lang Auto_Process_Title}"
                                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                       Foreground="{DynamicResource SecondaryHueMidBrush}" />
                        </StackPanel>

                        <!-- 流程状态显示 -->
                        <Border Background="#E3F2FD" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Information" Width="18" Height="18"
                                                         Foreground="#1565C0" Margin="0,0,8,0"
                                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ProcessStatus}"
                                           Foreground="#1565C0" FontWeight="SemiBold"
                                           FontSize="13" VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 全宽流程按钮 -->
                        <Button Command="{Binding AutoPickUpCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Padding="12,8" materialDesign:ButtonAssist.CornerRadius="6"
                                ToolTip="{lang:Lang Position_Pickup}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ArrowRightBold" Width="17" Height="17" Margin="0,0,8,0" />
                                <TextBlock Text="{lang:Lang Auto_PickUp_Label}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenStageAlignCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Padding="12,8" materialDesign:ButtonAssist.CornerRadius="6"
                                ToolTip="{lang:Lang Alignment_Title}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="AxisArrow" Width="17" Height="17" Margin="0,0,8,0" />
                                <TextBlock Text="{lang:Lang Stage_Alignment_Label}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AutoScanCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Padding="12,8" materialDesign:ButtonAssist.CornerRadius="6"
                                ToolTip="{lang:Lang Position_Scan}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Camera" Width="17" Height="17" Margin="0,0,8,0" />
                                <TextBlock Text="{lang:Lang Auto_Scan_Label}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding View3DScanDataCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Padding="12,8" materialDesign:ButtonAssist.CornerRadius="6"
                                ToolTip="{lang:Lang LoadUnload_3DLineScan}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="Eye" Width="17" Height="17" Margin="0,0,8,0" />
                                <TextBlock Text="{lang:Lang View_3DScan_Data_Label}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding AutoUnloadCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch" Padding="12,8"
                                materialDesign:ButtonAssist.CornerRadius="6"
                                ToolTip="{lang:Lang Position_Discharge}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="ArrowDownBold" Width="17" Height="17" Margin="0,0,8,0" />
                                <TextBlock Text="{lang:Lang Auto_Unload_Label}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding EmergencyStopCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="#D32F2F" Foreground="White"
                                HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                Padding="12,8" materialDesign:ButtonAssist.CornerRadius="6"
                                ToolTip="{lang:Lang LoadUnload_EmergencyStop}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="AlertOctagon" Width="17" Height="17" Margin="0,0,8,0" />
                                <TextBlock Text="{lang:Lang LoadUnload_EmergencyStop}" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 流程步骤状态列表 -->
                <GroupBox Header="{lang:Lang Status_FlowState}"
                          Margin="0,0,0,0"
                          Style="{DynamicResource MaterialDesignCardGroupBox}"
                          Foreground="#616161">
                    <ListBox x:Name="StatusListBox"
                             ItemsSource="{Binding StepStatusList}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MaxHeight="230"
                             MinHeight="230"
                             Background="Transparent"
                             BorderBrush="#E0E0E0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="MinHeight" Value="26" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{Binding IsCompleted, Converter={StaticResource BooleanToBrushConverter}}"
                                             Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11" Foreground="#757575"
                                               FontWeight="{Binding IsCurrent, Converter={StaticResource BooleanToFontWeightConverter}}"
                                               TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
