<UserControl x:Class="Module.Views.ProductCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             xmlns:converters="clr-namespace:Module.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             MinHeight="500"
             MinWidth="600">
    <UserControl.Resources>
        <converters:BooleanToBrushConverter x:Key="BoolToBrushConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="8">
            <!-- 标题 -->
            <TextBlock Text="{lang:Lang ProductCalib_Title}"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                       Foreground="{DynamicResource PrimaryHueMidBrush}" />

            <!-- ===== 区域1：运动控制（基准位 + 拍照位1 + 拍照位2）===== -->
            <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10">
                <StackPanel>
                    <!-- 区域标题 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="AxisArrow" Width="20" Height="20"
                                                 Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                 Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{lang:Lang ProductCalib_MotionControl}"
                                   FontWeight="Bold" FontSize="15"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}" />
                    </Grid>

                    <!-- Step 1: 基准位 -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource PrimaryHueMidBrush}"
                                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="{lang:Lang ProductCalib_ReferencePosition}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Rx" VerticalAlignment="Center" FontSize="12" />
                                <TextBox Grid.Column="1" Text="{Binding RefRx, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="4,0,8,0" />
                                <TextBlock Grid.Column="2" Text="Rz" VerticalAlignment="Center" FontSize="12" />
                                <TextBox Grid.Column="3" Text="{Binding RefRz, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="4,0,8,0" />
                                <Button Grid.Column="4" Command="{Binding TeachReferenceCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,2" Margin="0,0,4,0"
                                        ToolTip="{lang:Lang ProductCalib_Teach}">
                                    <materialDesign:PackIcon Kind="Crosshairs" Width="16" Height="16" />
                                </Button>
                                <Button Grid.Column="5" Command="{Binding MoveToReferenceCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Padding="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowRight" Width="14" Height="14" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang ProductCalib_Move}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,8,0,8" Background="{DynamicResource MaterialDesignDivider}" />

                    <!-- Step 2: 拍照位1 -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" CornerRadius="12" Background="#1565C0"
                                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang ProductCalib_PhotoPosition1}" FontWeight="SemiBold" FontSize="13" />
                                <Ellipse Grid.Column="2" Width="10" Height="10" Margin="6,0,0,0"
                                         Fill="{Binding Photo1Captured, Converter={StaticResource BoolToBrushConverter}}"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dx" VerticalAlignment="Center" FontSize="11" Foreground="#E53935" />
                                <TextBox Grid.Column="1" Text="{Binding Photo1Dx, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                <TextBlock Grid.Column="2" Text="Dy" VerticalAlignment="Center" FontSize="11" Foreground="#43A047" />
                                <TextBox Grid.Column="3" Text="{Binding Photo1Dy, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                <TextBlock Grid.Column="4" Text="Dz" VerticalAlignment="Center" FontSize="11" Foreground="#1E88E5" />
                                <TextBox Grid.Column="5" Text="{Binding Photo1Dz, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                <Button Grid.Column="6" Command="{Binding TeachPhoto1Command}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2"
                                        ToolTip="{lang:Lang ProductCalib_Teach}">
                                    <materialDesign:PackIcon Kind="Crosshairs" Width="14" Height="14" />
                                </Button>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang ProductCalib_VisionResult}" VerticalAlignment="Center"
                                           FontSize="11" Foreground="Gray" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11">
                                    <Run Text="X:" /><Run Text="{Binding Photo1VisionX, StringFormat=F3}" Foreground="#E53935" />
                                </TextBlock>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11">
                                    <Run Text="Y:" /><Run Text="{Binding Photo1VisionY, StringFormat=F3}" Foreground="#43A047" />
                                </TextBlock>
                                <Button Grid.Column="5" Command="{Binding MoveToPhoto1Command}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowRight" Width="13" Height="13" Margin="0,0,3,0" />
                                        <TextBlock Text="{lang:Lang ProductCalib_Move}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="6" Command="{Binding Capture1Command}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Camera" Width="13" Height="13" Margin="0,0,3,0" />
                                        <TextBlock Text="{lang:Lang ProductCalib_Capture}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,8,0,8" Background="{DynamicResource MaterialDesignDivider}" />

                    <!-- Step 3: 拍照位2 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="24" Height="24" CornerRadius="12" Background="#6A1B9A"
                                VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,2,0,0">
                            <TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang ProductCalib_PhotoPosition2}" FontWeight="SemiBold" FontSize="13" />
                                <Ellipse Grid.Column="2" Width="10" Height="10" Margin="6,0,0,0"
                                         Fill="{Binding Photo2Captured, Converter={StaticResource BoolToBrushConverter}}"
                                         VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Dx" VerticalAlignment="Center" FontSize="11" Foreground="#E53935" />
                                <TextBox Grid.Column="1" Text="{Binding Photo2Dx, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                <TextBlock Grid.Column="2" Text="Dy" VerticalAlignment="Center" FontSize="11" Foreground="#43A047" />
                                <TextBox Grid.Column="3" Text="{Binding Photo2Dy, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                <TextBlock Grid.Column="4" Text="Dz" VerticalAlignment="Center" FontSize="11" Foreground="#1E88E5" />
                                <TextBox Grid.Column="5" Text="{Binding Photo2Dz, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                <Button Grid.Column="6" Command="{Binding TeachPhoto2Command}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2"
                                        ToolTip="{lang:Lang ProductCalib_Teach}">
                                    <materialDesign:PackIcon Kind="Crosshairs" Width="14" Height="14" />
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang ProductCalib_VisionResult}" VerticalAlignment="Center"
                                           FontSize="11" Foreground="Gray" Margin="0,0,4,0" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11">
                                    <Run Text="X:" /><Run Text="{Binding Photo2VisionX, StringFormat=F3}" Foreground="#E53935" />
                                </TextBlock>
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11">
                                    <Run Text="Y:" /><Run Text="{Binding Photo2VisionY, StringFormat=F3}" Foreground="#43A047" />
                                </TextBlock>
                                <Button Grid.Column="5" Command="{Binding MoveToPhoto2Command}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowRight" Width="13" Height="13" Margin="0,0,3,0" />
                                        <TextBlock Text="{lang:Lang ProductCalib_Move}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="6" Command="{Binding Capture2Command}"
                                        Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Camera" Width="13" Height="13" Margin="0,0,3,0" />
                                        <TextBlock Text="{lang:Lang ProductCalib_Capture}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </materialDesign:Card>

            <!-- ===== 区域2：结果与校正（偏差 + 全局变量 + 旋转）===== -->
            <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 偏差结果 -->
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Delta" Width="18" Height="18"
                                                     Foreground="#FF6F00" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{lang:Lang ProductCalib_DeviationResult}"
                                       FontWeight="Bold" FontSize="14" Foreground="#FF6F00" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ΔX:" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                       Foreground="#E53935" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding DeltaX, StringFormat=F3}"
                                       VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#E53935" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ΔY:" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                       Foreground="#43A047" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding DeltaY, StringFormat=F3}"
                                       VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#43A047" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ΔAngle:" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                       Foreground="#6A1B9A" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding DeltaAngle, StringFormat=F3}"
                                       VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#6A1B9A" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lang:Lang ProductCalib_OffsetXY}" VerticalAlignment="Center"
                                       FontSize="11" Foreground="Gray" Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11">
                                <Run Text="X:" /><Run Text="{Binding OffsetX, StringFormat=F3}" Foreground="#E53935" />
                                <Run Text=" Y:" /><Run Text="{Binding OffsetY, StringFormat=F3}" Foreground="#43A047" />
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <Separator Grid.Column="1" Margin="0,0,0,0" Background="{DynamicResource MaterialDesignDivider}" />

                    <!-- 全局变量链接 -->
                    <StackPanel Grid.Column="2">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="LinkVariant" Width="18" Height="18"
                                                     Foreground="#1565C0" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{lang:Lang ProductCalib_GlobalVariableLink}"
                                       FontWeight="Bold" FontSize="14" Foreground="#1565C0" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ΔX" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#E53935" />
                            <common:GlobalVariableLinkControl Grid.Column="1"
                                DisplayValue="{Binding DeltaX}" DisplayForeground="#E53935"
                                IsLinked="{Binding IsDeltaXLinked}" UnlinkCommand="{Binding UnlinkDeltaXCommand}"
                                LinkedVariableName="{Binding DeltaXLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="110" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ΔY" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#43A047" />
                            <common:GlobalVariableLinkControl Grid.Column="1"
                                DisplayValue="{Binding DeltaY}" DisplayForeground="#43A047"
                                IsLinked="{Binding IsDeltaYLinked}" UnlinkCommand="{Binding UnlinkDeltaYCommand}"
                                LinkedVariableName="{Binding DeltaYLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="110" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ΔA" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="#6A1B9A" />
                            <common:GlobalVariableLinkControl Grid.Column="1"
                                DisplayValue="{Binding DeltaAngle}" DisplayForeground="#6A1B9A"
                                IsLinked="{Binding IsDeltaAngleLinked}" UnlinkCommand="{Binding UnlinkDeltaAngleCommand}"
                                LinkedVariableName="{Binding DeltaAngleLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="110" />
                        </Grid>
                    </StackPanel>

                    <Separator Grid.Column="3" Margin="0,0,0,0" Background="{DynamicResource MaterialDesignDivider}" />

                    <!-- 旋转校正 -->
                    <StackPanel Grid.Column="4" Margin="10,0,0,10">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="RotateRight" Width="18" Height="18"
                                                     Foreground="#FF6F00" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{lang:Lang ProductCalib_RotateCorrection}"
                                       FontWeight="Bold" FontSize="14" Foreground="#FF6F00" />
                        </Grid>
                        <TextBlock Text="{lang:Lang ProductCalib_RotateDescription}"
                                   FontSize="11" Foreground="Gray" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <Button Command="{Binding RotateCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,6"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="RotateRight" Width="16" Height="16" Margin="0,0,6,0" />
                                <TextBlock Text="{lang:Lang ProductCalib_Rotate}" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- ===== 区域3：配置（TCP + 文件操作）===== -->
            <materialDesign:Card UniformCornerRadius="8" Padding="16" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- TCP配置 -->
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="LanConnect" Width="18" Height="18"
                                                     Foreground="#1565C0" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{lang:Lang ProductCalib_TcpConfig}"
                                       FontWeight="Bold" FontSize="14" Foreground="#1565C0" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lang:Lang ProductCalib_Connection}" VerticalAlignment="Center"
                                       FontSize="12" Margin="0,0,8,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding TcpConnections}"
                                      SelectedItem="{Binding SelectedTcpConnection}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="4,2" />
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lang:Lang ProductCalib_TriggerCmd}" VerticalAlignment="Center"
                                       FontSize="12" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding TriggerCommand, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{lang:Lang ProductCalib_Timeout}" VerticalAlignment="Center"
                                       FontSize="12" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Text="{Binding CaptureTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" />
                        </Grid>
                    </StackPanel>

                    <Separator Grid.Column="1" Margin="0,0,0,0" Background="{DynamicResource MaterialDesignDivider}" />

                    <!-- 文件操作 -->
                    <StackPanel Grid.Column="2" Margin="10,0,0,10">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="FileDocumentOutline" Width="18" Height="18"
                                                     Foreground="#1565C0" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{lang:Lang ProductCalib_FileOperation}"
                                       FontWeight="Bold" FontSize="14" Foreground="#1565C0" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Command="{Binding SaveConfigCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,4,0" />
                                    <TextBlock Text="{lang:Lang ProductCalib_Save}" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding LoadConfigCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" Margin="0,0,4,0" />
                                    <TextBlock Text="{lang:Lang ProductCalib_Load}" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ImportConfigCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Import" Width="14" Height="14" Margin="0,0,4,0" />
                                    <TextBlock Text="{lang:Lang ProductCalib_Import}" FontSize="12" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportConfigCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Export" Width="14" Height="14" Margin="0,0,4,0" />
                                    <TextBlock Text="{lang:Lang ProductCalib_Export}" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Background="#E3F2FD" CornerRadius="4" Padding="8,4"
                                Visibility="{Binding CurrentFileName, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding CurrentFileName}" FontSize="11" Foreground="#1565C0"
                                       FontFamily="Consolas" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>

            <!-- 底部状态栏 -->
            <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="10,6" Margin="0,4,0,0">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="White" FontWeight="Medium" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
