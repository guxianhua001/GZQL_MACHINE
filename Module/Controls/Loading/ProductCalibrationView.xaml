<UserControl x:Class="Module.Views.ProductCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             xmlns:converters="clr-namespace:Module.Converters"
             MinHeight="600"
             MinWidth="1100"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

            <!-- 拍照完成状态指示圆点样式（跟随主题） -->
            <Style x:Key="StatusDotStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="10" />
                <Setter Property="Height" Value="10" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Fill" Value="{DynamicResource DialogTextMutedBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                        <Setter Property="Fill" Value="{DynamicResource DialogSuccessBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 参数标签样式 -->
            <Style x:Key="ParamLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource DialogTextSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,6,0" />
            </Style>

            <!-- 卡片标题样式 -->
            <Style x:Key="CardHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource DialogAccentBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 步骤圆点样式 -->
            <Style x:Key="StepBadgeStyle" TargetType="Border">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="Background" Value="{DynamicResource DialogAccentBrush}" />
            </Style>

            <!-- 步骤圆点内文字 -->
            <Style x:Key="StepBadgeTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 轴标签样式（统一色） -->
            <Style x:Key="AxisLabelStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource DialogTextSecondaryBrush}" />
            </Style>

            <!-- 关键数值样式 -->
            <Style x:Key="HighlightValueStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource DialogAccentBrush}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 主内容区：左栏(运动控制+TCP+文件) | 分隔 | 右栏(计算+基准+偏差+链接+旋转) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1.5*" MinWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- 左栏：运动控制 + TCP通讯 + 文件操作                          -->
            <!-- ======================================================== -->
            <ScrollViewer Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,8,4,8">

                    <!-- ===== 运动控制卡片 ===== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="14" Margin="0,0,0,10"
                                         Background="{DynamicResource DialogCardBrush}">
                        <StackPanel>
                            <!-- 卡片标题 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="AxisArrow" Width="20" Height="20"
                                                         Foreground="{DynamicResource DialogAccentBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang ProductCalib_MotionControl}"
                                           Style="{StaticResource CardHeaderTextStyle}" />
                            </StackPanel>

                            <!-- Step 1: 基准位（Rx/Rz） -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadgeStyle}">
                                    <TextBlock Text="1" Style="{StaticResource StepBadgeTextStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{lang:Lang ProductCalib_ReferencePosition}" FontWeight="SemiBold" FontSize="13"
                                               Margin="0,0,0,6" Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Rx" Style="{StaticResource AxisLabelStyle}" />
                                        <TextBox Grid.Column="1" Text="{Binding RefRx, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="4,0,8,0" />
                                        <TextBlock Grid.Column="2" Text="Rz" Style="{StaticResource AxisLabelStyle}" />
                                        <TextBox Grid.Column="3" Text="{Binding RefRz, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="4,0,8,0" />
                                        <Button Grid.Column="4" Command="{Binding TeachReferenceCommand}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2" Margin="0,0,4,0"
                                                ToolTip="{lang:Lang ProductCalib_Teach}">
                                            <materialDesign:PackIcon Kind="Crosshairs" Width="14" Height="14" />
                                        </Button>
                                        <Button Grid.Column="5" Command="{Binding MoveToReferenceCommand}"
                                                Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ArrowRight" Width="13" Height="13" Margin="0,0,3,0" />
                                                <TextBlock Text="{lang:Lang ProductCalib_Move}" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,4,0,8" Background="{DynamicResource DialogBorderBrush}" />

                            <!-- Step 2: 拍照位1（Dx/Dy/Dz） -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadgeStyle}">
                                    <TextBlock Text="2" Style="{StaticResource StepBadgeTextStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{lang:Lang ProductCalib_PhotoPosition1}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                                        <Ellipse Grid.Column="2" Style="{StaticResource StatusDotStyle}" Margin="6,0,0,0"
                                                 Tag="{Binding Photo1Captured}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dx" Style="{StaticResource AxisLabelStyle}" FontSize="11" />
                                        <TextBox Grid.Column="1" Text="{Binding Photo1Dx, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                        <TextBlock Grid.Column="2" Text="Dy" Style="{StaticResource AxisLabelStyle}" FontSize="11" />
                                        <TextBox Grid.Column="3" Text="{Binding Photo1Dy, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                        <TextBlock Grid.Column="4" Text="Dz" Style="{StaticResource AxisLabelStyle}" FontSize="11" />
                                        <TextBox Grid.Column="5" Text="{Binding Photo1Dz, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                        <Button Grid.Column="6" Command="{Binding TeachPhoto1Command}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2"
                                                ToolTip="{lang:Lang ProductCalib_Teach}">
                                            <materialDesign:PackIcon Kind="Crosshairs" Width="14" Height="14" />
                                        </Button>
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{lang:Lang ProductCalib_VisionResult}" VerticalAlignment="Center"
                                                   FontSize="11" Foreground="{DynamicResource DialogTextMutedBrush}" Margin="0,0,4,0" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource DialogTextSecondaryBrush}">
                                            <Run Text="X:" /><Run Text="{Binding Photo1VisionX, StringFormat=F3}" />
                                            <Run Text=" Y:" /><Run Text="{Binding Photo1VisionY, StringFormat=F3}" />
                                        </TextBlock>
                                        <Button Grid.Column="3" Command="{Binding MoveToPhoto1Command}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2" Margin="4,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ArrowRight" Width="13" Height="13" Margin="0,0,3,0" />
                                                <TextBlock Text="{lang:Lang ProductCalib_Move}" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="4" Command="{Binding Capture1Command}"
                                                Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2"
                                                IsEnabled="{Binding IsCameraActive}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Camera" Width="13" Height="13" Margin="0,0,3,0" />
                                                <TextBlock Text="{lang:Lang ProductCalib_Capture}" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,4,0,8" Background="{DynamicResource DialogBorderBrush}" />

                            <!-- Step 3: 拍照位2（Dx/Dy/Dz） -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource StepBadgeStyle}">
                                    <TextBlock Text="3" Style="{StaticResource StepBadgeTextStyle}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{lang:Lang ProductCalib_PhotoPosition2}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                                        <Ellipse Grid.Column="2" Style="{StaticResource StatusDotStyle}" Margin="6,0,0,0"
                                                 Tag="{Binding Photo2Captured}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Dx" Style="{StaticResource AxisLabelStyle}" FontSize="11" />
                                        <TextBox Grid.Column="1" Text="{Binding Photo2Dx, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                        <TextBlock Grid.Column="2" Text="Dy" Style="{StaticResource AxisLabelStyle}" FontSize="11" />
                                        <TextBox Grid.Column="3" Text="{Binding Photo2Dy, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                        <TextBlock Grid.Column="4" Text="Dz" Style="{StaticResource AxisLabelStyle}" FontSize="11" />
                                        <TextBox Grid.Column="5" Text="{Binding Photo2Dz, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Margin="2,0,4,0" />
                                        <Button Grid.Column="6" Command="{Binding TeachPhoto2Command}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2"
                                                ToolTip="{lang:Lang ProductCalib_Teach}">
                                            <materialDesign:PackIcon Kind="Crosshairs" Width="14" Height="14" />
                                        </Button>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{lang:Lang ProductCalib_VisionResult}" VerticalAlignment="Center"
                                                   FontSize="11" Foreground="{DynamicResource DialogTextMutedBrush}" Margin="0,0,4,0" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource DialogTextSecondaryBrush}">
                                            <Run Text="X:" /><Run Text="{Binding Photo2VisionX, StringFormat=F3}" />
                                            <Run Text=" Y:" /><Run Text="{Binding Photo2VisionY, StringFormat=F3}" />
                                        </TextBlock>
                                        <Button Grid.Column="3" Command="{Binding MoveToPhoto2Command}"
                                                Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2" Margin="4,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ArrowRight" Width="13" Height="13" Margin="0,0,3,0" />
                                                <TextBlock Text="{lang:Lang ProductCalib_Move}" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="4" Command="{Binding Capture2Command}"
                                                Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2"
                                                IsEnabled="{Binding IsCameraActive}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Camera" Width="13" Height="13" Margin="0,0,3,0" />
                                                <TextBlock Text="{lang:Lang ProductCalib_Capture}" FontSize="11" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ===== TCP通讯 + 相机屏蔽 + 数据接收模式 ===== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="14" Margin="0,0,0,10"
                                         Background="{DynamicResource DialogCardBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="LanConnect" Width="20" Height="20"
                                                         Foreground="{DynamicResource DialogAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang ProductCalib_TcpConfig}" Style="{StaticResource CardHeaderTextStyle}" />
                            </StackPanel>

                            <!-- TCP连接选择 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang ProductCalib_Connection}" Style="{StaticResource ParamLabelStyle}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding TcpConnections}"
                                          SelectedItem="{Binding SelectedTcpConnection}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" Padding="4,2" />
                            </Grid>

                            <!-- 触发命令 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang ProductCalib_TriggerCmd}" Style="{StaticResource ParamLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding TriggerCommand, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" />
                            </Grid>

                            <!-- 超时 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang ProductCalib_Timeout}" Style="{StaticResource ParamLabelStyle}" />
                                <TextBox Grid.Column="1" Text="{Binding CaptureTimeoutMs, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" />
                            </Grid>

                            <Separator Margin="0,0,0,8" Background="{DynamicResource DialogBorderBrush}" />

                            <!-- 相机屏蔽开关 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="CameraOff" Width="16" Height="16"
                                                         Foreground="{DynamicResource DialogTextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{lang:Lang ProductCalib_CameraShielded}"
                                           FontSize="12" VerticalAlignment="Center" />
                                <ToggleButton Grid.Column="2" IsChecked="{Binding CameraShielded}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            </Grid>

                            <!-- 数据接收模式切换 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="DownloadNetwork" Width="16" Height="16"
                                                         Foreground="{DynamicResource DialogTextSecondaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{lang:Lang ProductCalib_DataReceiveMode}" FontSize="12" />
                                    <TextBlock Text="{Binding DataReceiveMode}"
                                               FontSize="10" Foreground="{DynamicResource DialogTextMutedBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding ToggleDataReceiveModeCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2"
                                        IsEnabled="{Binding IsCameraActive}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="SwapHorizontal" Width="13" Height="13" Margin="0,0,3,0" />
                                        <TextBlock Text="{lang:Lang ProductCalib_ManualTrigger}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ===== 文件操作卡片 ===== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="14" Margin="0,0,0,10"
                                         Background="{DynamicResource DialogCardBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Width="20" Height="20"
                                                         Foreground="{DynamicResource DialogAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang ProductCalib_FileOperation}" Style="{StaticResource CardHeaderTextStyle}" />
                            </StackPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Command="{Binding SaveConfigCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang ProductCalib_Save}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding LoadConfigCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang ProductCalib_Load}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ImportConfigCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Import" Width="14" Height="14" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang ProductCalib_Import}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExportConfigCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,4" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Export" Width="14" Height="14" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang ProductCalib_Export}" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <Border Background="{DynamicResource DialogElevatedBrush}" CornerRadius="4" Padding="8,4"
                                    Visibility="{Binding CurrentFileName, Converter={StaticResource NullToVisibilityConverter}}">
                                <TextBlock Text="{Binding CurrentFileName}" FontSize="11"
                                           Foreground="{DynamicResource DialogAccentBrush}"
                                           FontFamily="Consolas" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- 列分隔线 -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource DialogBorderBrush}" />

            <!-- ======================================================== -->
            <!-- 右栏：Halcon计算结果 + 基准特征点 + 偏差结果(带取反) + 全局变量链接 + 旋转校正 -->
            <!-- ======================================================== -->
            <ScrollViewer Grid.Column="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,8,8,8">

                    <!-- ===== Halcon特征点计算结果卡片 ===== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="14" Margin="0,0,0,10"
                                         Background="{DynamicResource DialogCardBrush}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="CalculatorVariant" Width="20" Height="20"
                                                         Foreground="{DynamicResource DialogAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{lang:Lang ProductCalib_FeatureResult}"
                                           Style="{StaticResource CardHeaderTextStyle}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Command="{Binding CalculateCommand}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Padding="6,2" Margin="0,0,4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Refresh" Width="13" Height="13" Margin="0,0,3,0" />
                                            <TextBlock Text="{lang:Lang ProductCalib_Recalculate}" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SetAsReferenceCommand}"
                                            Style="{StaticResource MaterialDesignRaisedButton}" Padding="6,2">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="BookmarkCheck" Width="13" Height="13" Margin="0,0,3,0" />
                                            <TextBlock Text="{lang:Lang ProductCalib_SetAsReference}" FontSize="11" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 中心点 / 角度 / 距离 三列展示 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 中心点 -->
                                <StackPanel>
                                    <TextBlock Text="{lang:Lang ProductCalib_CenterPoint}" FontSize="11"
                                               Foreground="{DynamicResource DialogTextMutedBrush}" Margin="0,0,0,4" />
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="X:" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource DialogTextSecondaryBrush}" Margin="0,0,4,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding CenterX, StringFormat=F3}"
                                                   Style="{StaticResource HighlightValueStyle}" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Y:" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource DialogTextSecondaryBrush}" Margin="0,0,4,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding CenterY, StringFormat=F3}"
                                                   Style="{StaticResource HighlightValueStyle}" />
                                    </Grid>
                                </StackPanel>

                                <Separator Grid.Column="1" Background="{DynamicResource DialogBorderBrush}" Margin="8,0" />

                                <!-- 角度 -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{lang:Lang ProductCalib_Angle}" FontSize="11"
                                               Foreground="{DynamicResource DialogTextMutedBrush}" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ResultAngle, StringFormat=F3}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource DialogAccentBrush}" />
                                        <TextBlock Text="°" FontSize="11" Foreground="{DynamicResource DialogTextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <Separator Grid.Column="3" Background="{DynamicResource DialogBorderBrush}" Margin="8,0" />

                                <!-- 距离 -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{lang:Lang ProductCalib_Distance}" FontSize="11"
                                               Foreground="{DynamicResource DialogTextMutedBrush}" Margin="0,0,0,4" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding PointDistance, StringFormat=F3}" FontSize="20" FontWeight="Bold"
                                                   Foreground="{DynamicResource DialogAccentBrush}" />
                                        <TextBlock Text="mm" FontSize="11" Foreground="{DynamicResource DialogTextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ===== 基准特征点 + 偏差结果（合并卡片） ===== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="14" Margin="0,0,0,10"
                                         Background="{DynamicResource DialogCardBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="Target" Width="20" Height="20"
                                                         Foreground="{DynamicResource DialogAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang ProductCalib_ReferenceFeature}"
                                           Style="{StaticResource CardHeaderTextStyle}" />
                            </StackPanel>

                            <!-- 基准特征点输入 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{lang:Lang ProductCalib_ReferenceCenter}" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource DialogTextMutedBrush}" Margin="0,0,6,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="X:" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource DialogTextSecondaryBrush}" Margin="0,0,3,0" />
                                    <TextBox Text="{Binding ReferenceCenterX, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Width="70" Margin="0,0,8,0" />
                                    <TextBlock Text="Y:" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource DialogTextSecondaryBrush}" Margin="0,0,3,0" />
                                    <TextBox Text="{Binding ReferenceCenterY, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Width="70" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{lang:Lang ProductCalib_ReferenceAngle}" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource DialogTextMutedBrush}" Margin="8,0,6,0" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <TextBox Text="{Binding ReferenceAngle, StringFormat=F3, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="4,2" Width="70" />
                                    <TextBlock Text="°" VerticalAlignment="Center" FontSize="11"
                                               Foreground="{DynamicResource DialogTextMutedBrush}" Margin="3,0,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="4" Text="{lang:Lang ProductCalib_ManualInput}" VerticalAlignment="Center"
                                           FontSize="10" Foreground="{DynamicResource DialogTextMutedBrush}" Margin="8,0,0,0"
                                           ToolTip="{lang:Lang ProductCalib_ManualInput}" />
                            </Grid>

                            <Separator Margin="0,0,0,10" Background="{DynamicResource DialogBorderBrush}" />

                            <!-- 偏差结果标题 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="Delta" Width="18" Height="18"
                                                         Foreground="{DynamicResource DialogAccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang ProductCalib_DeviationResult}"
                                           FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource DialogTextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- ΔX 行 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ΔX" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DeltaX, StringFormat=F3}"
                                           Style="{StaticResource HighlightValueStyle}" />
                                <TextBlock Grid.Column="2" Text="{lang:Lang ProductCalib_Invert}"
                                           VerticalAlignment="Center" FontSize="10"
                                           Foreground="{DynamicResource DialogTextMutedBrush}" Margin="0,0,4,0" />
                                <ToggleButton Grid.Column="3" IsChecked="{Binding InvertDeltaX}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            </Grid>

                            <!-- ΔY 行 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ΔY" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding DeltaY, StringFormat=F3}"
                                           Style="{StaticResource HighlightValueStyle}" />
                                <TextBlock Grid.Column="2" Text="{lang:Lang ProductCalib_Invert}"
                                           VerticalAlignment="Center" FontSize="10"
                                           Foreground="{DynamicResource DialogTextMutedBrush}" Margin="0,0,4,0" />
                                <ToggleButton Grid.Column="3" IsChecked="{Binding InvertDeltaY}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            </Grid>

                            <!-- ΔAngle 行 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ΔA" VerticalAlignment="Center" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"
                                           Foreground="{DynamicResource DialogAccentBrush}">
                                    <Run Text="{Binding DeltaAngle, StringFormat=F3}" /><Run Text="°" FontSize="11" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{lang:Lang ProductCalib_Invert}"
                                           VerticalAlignment="Center" FontSize="10"
                                           Foreground="{DynamicResource DialogTextMutedBrush}" Margin="0,0,4,0" />
                                <ToggleButton Grid.Column="3" IsChecked="{Binding InvertDeltaAngle}"
                                              Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ===== 全局变量链接卡片 ===== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="14" Margin="0,0,0,10"
                                         Background="{DynamicResource DialogCardBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="LinkVariant" Width="20" Height="20"
                                                         Foreground="{DynamicResource DialogAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang ProductCalib_GlobalVariableLink}"
                                           Style="{StaticResource CardHeaderTextStyle}" />
                            </StackPanel>

                            <!-- ΔX 链接 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ΔX" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                                <common:GlobalVariableLinkControl Grid.Column="1"
                                    DisplayValue="{Binding DeltaX}"
                                    IsLinked="{Binding IsDeltaXLinked}" UnlinkCommand="{Binding UnlinkDeltaXCommand}"
                                    LinkedVariableName="{Binding DeltaXLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                    LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="140" />
                            </Grid>

                            <!-- ΔY 链接 -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ΔY" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                                <common:GlobalVariableLinkControl Grid.Column="1"
                                    DisplayValue="{Binding DeltaY}"
                                    IsLinked="{Binding IsDeltaYLinked}" UnlinkCommand="{Binding UnlinkDeltaYCommand}"
                                    LinkedVariableName="{Binding DeltaYLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                    LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="140" />
                            </Grid>

                            <!-- ΔAngle 链接 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ΔA" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource DialogTextPrimaryBrush}" />
                                <common:GlobalVariableLinkControl Grid.Column="1"
                                    DisplayValue="{Binding DeltaAngle}"
                                    IsLinked="{Binding IsDeltaAngleLinked}" UnlinkCommand="{Binding UnlinkDeltaAngleCommand}"
                                    LinkedVariableName="{Binding DeltaAngleLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                    LinkableGlobalVariables="{Binding LinkableGlobalVariables}" ComboBoxWidth="140" />
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- ===== 旋转校正卡片 ===== -->
                    <materialDesign:Card UniformCornerRadius="8" Padding="14" Margin="0,0,0,10"
                                         Background="{DynamicResource DialogCardBrush}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <materialDesign:PackIcon Kind="RotateRight" Width="20" Height="20"
                                                         Foreground="{DynamicResource DialogAccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{lang:Lang ProductCalib_RotateCorrection}"
                                           Style="{StaticResource CardHeaderTextStyle}" />
                            </StackPanel>
                            <TextBlock Text="{lang:Lang ProductCalib_RotateDescription}"
                                       FontSize="11" Foreground="{DynamicResource DialogTextMutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <Button Command="{Binding RotateCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,6"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="RotateRight" Width="16" Height="16" Margin="0,0,6,0" />
                                    <TextBlock Text="{lang:Lang ProductCalib_Rotate}" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部状态栏 + 关闭按钮 -->
        <Grid Grid.Row="1" Margin="8,4,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="10,6">
                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="White" FontWeight="Medium" />
            </Border>
            <Button Grid.Column="1" Command="{Binding CloseCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}" Padding="12,6" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Margin="0,0,4,0" />
                    <TextBlock Text="{lang:Lang ProductCalib_Close}" FontSize="12" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
