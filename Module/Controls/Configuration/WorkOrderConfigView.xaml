<UserControl x:Class="Module.Views.WorkOrderConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:models="clr-namespace:Module.ViewModels"
             xmlns:views="clr-namespace:Module.Views"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             materialDesign:TransitionAssist.DisableTransitions="True"
             materialDesign:RippleAssist.IsDisabled="True"
             MinHeight="600">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,16">
            <!-- 第一行：标题和基本操作 -->
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Work Order Config"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0" />
                <!-- 显示当前配方池 -->
                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                             CornerRadius="4"
                             Padding="8,4"
                             VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DatabaseOutline"
                                     Width="14"
                                     Height="14"
                                     VerticalAlignment="Center"
                                     Margin="0,0,4,0" />
                        <TextBlock Text="{Binding CurrentPoolName}"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </WrapPanel>
            <!-- 第二行：配置管理 -->
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="{lang:Lang LoadParameters}"
                        Command="{Binding LoadDataCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0,0,8,0" />
                <Button Content="{lang:Lang SaveParameters}"
                        Command="{Binding SaveDataCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0" />
            </WrapPanel>
        </StackPanel>

        <!-- 主要内容区域：TabControl -->
        <TabControl Grid.Row="1">
            <!-- Tab 1: 部件特征 -->
            <TabItem Header="Component Features">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 部件选择与操作栏 -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Component:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Components}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedComponent}"
                                  Width="150"
                                  Margin="0,0,8,0" />
                        <Button Content="Add Component"
                                Command="{Binding AddComponentCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Edit Component"
                                Command="{Binding EditComponentCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Delete Component"
                                Command="{Binding DeleteComponentCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </WrapPanel>

                    <!-- 部件特征表格 -->
                    <GroupBox Grid.Row="1" Header="Component Features">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding SelectedComponent.Features}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      SelectedItem="{Binding SelectedComponentFeature}"
                                      materialDesign:DataGridAssist.CellPadding="4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="{lang:Lang Description}" Binding="{Binding Description}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,0,0">
                                <Button Content="Add Feature"
                                        Command="{Binding AddComponentFeatureCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,0" />
                                <Button Content="Edit Feature"
                                        Command="{Binding EditComponentFeatureCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,0" />
                                <Button Content="Delete Feature"
                                        Command="{Binding DeleteComponentFeatureCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Tab 2: 工位特征 -->
            <TabItem Header="Site Features">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Groups 选择与操作栏 -->
                    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Group:" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Sites}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedSite}"
                                  Width="150"
                                  Margin="0,0,8,0" />
                        <Button Content="Add Group"
                                Command="{Binding AddGroupCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Edit Group"
                                Command="{Binding EditGroupCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Delete Group"
                                Command="{Binding DeleteGroupCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                    </WrapPanel>

                    <!-- Site Features 表格 -->
                    <GroupBox Grid.Row="1" Header="Site Features">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid Grid.Row="0"
                                      ItemsSource="{Binding CurrentGroupSiteFeatures}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      SelectedItem="{Binding SelectedSiteFeature}"
                                      materialDesign:DataGridAssist.CellPadding="4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="Auto" />
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Group" Binding="{Binding DataContext.SelectedSite.Name, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="Auto" />
                                    <DataGridTemplateColumn Header="{lang:Lang Type}" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Type}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.SiteFeatureTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{lang:Lang Description}" Binding="{Binding Description}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,0,0">
                                <Button Content="Add Site Feature"
                                        Command="{Binding AddSiteFeatureCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,0" />
                                <Button Content="Edit Site Feature"
                                        Command="{Binding EditSiteFeatureCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Margin="0,0,8,0" />
                                <Button Content="Delete Site Feature"
                                        Command="{Binding DeleteSiteFeatureCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Tab 3: 示教位置（多工站位置编辑器） --><!--
            <TabItem Header="Taught Positions">
                --><!--<views:MultiStationPositionEditorView />--><!--
            </TabItem>

            --><!-- Tab 4: 全局变量 --><!--
            <TabItem Header="Global Variables">
                --><!--<views:GlobalVariablesView />--><!--
            </TabItem>-->

            <!-- Tab 5: 设备常量 -->
            <TabItem Header="Machine Constants">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <!-- Camera 列表（可编辑） -->
                        <TextBlock Text="Cameras" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <DataGrid ItemsSource="{Binding Cameras}"
                                  AutoGenerateColumns="False" 
                                  SelectedItem="{Binding SelectedCamera}"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"       
                                  CanUserSortColumns="False"
                                  materialDesign:DataGridAssist.CellPadding="4" MaxHeight="150">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{lang:Lang Description}" Binding="{Binding Description}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,8">
                            <Button Content="Add Camera" Command="{Binding AddCameraCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                            <Button Content="Delete Camera" Command="{Binding DeleteCameraCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>

                        <!-- Purpose 列表（可编辑） -->
                        <TextBlock Text="Purposes" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <DataGrid ItemsSource="{Binding Purposes}" 
                                  AutoGenerateColumns="False"
                                  SelectedItem="{Binding SelectedPurpose}"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"       
                                  CanUserSortColumns="False"
                                  materialDesign:DataGridAssist.CellPadding="4" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{lang:Lang Description}" Binding="{Binding Description}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,16">
                            <Button Content="Add Purpose" Command="{Binding AddPurposeCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                            <Button Content="Delete Purpose" Command="{Binding DeletePurposeCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>

                        <!-- Axis Inventory 列表（可编辑） -->
                        <TextBlock Text="Axis Inventory" FontWeight="SemiBold" Margin="0,16,0,4" />
                        <DataGrid ItemsSource="{Binding Axes}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" 
                                  CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"       
                                  CanUserSortColumns="False"
                                  SelectedItem="{Binding SelectedAxis}"
                                  materialDesign:DataGridAssist.CellPadding="4" MaxHeight="250">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="*" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{lang:Lang Description}" Binding="{Binding Description}" Width="2*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Content="Add Axis" Command="{Binding AddAxisCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                            <Button Content="Edit Axis" Command="{Binding EditAxisCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" />
                            <Button Content="Delete Axis" Command="{Binding DeleteAxisCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                        
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
        </TabControl>
    </Grid>
</UserControl>