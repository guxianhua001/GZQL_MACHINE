<UserControl x:Class="Module.Views.Camera2DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             MaxHeight="500">
    <Border Padding="16"
            Background="{DynamicResource MaterialDesignCardBackground}"
            CornerRadius="4">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <StackPanel MinWidth="900">

                <!-- 标题栏 + 关闭按钮 -->
                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Button DockPanel.Dock="Right"
                                Content="✖"
                                Width="30"
                                Height="30"
                                Command="{Binding CloseCommand}"
                                ToolTip="{lang:Lang Close}"
                                Style="{StaticResource MaterialDesignIconButton}" />
                        <TextBlock FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   Text="{Binding StepDescription, StringFormat=DETAIL: Step {0} — 2D CAMERA}" />
                    </DockPanel>

                    <!-- 工站选择（可选） -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <TextBlock Text="Station:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Stations}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedStation}"
                                  Width="150" />
                    </StackPanel>
                </Grid>

                <!-- 相机和部件选择 -->
                <GroupBox Header="Camera &amp; Part Selection" Margin="0,0,0,16">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{lang:Lang Camera}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding CameraList}"
                                  SelectedItem="{Binding SelectedCamera}"
                                  Width="150"/>
                        <TextBlock Grid.Column="2" Text="Component" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="3"
                                  ItemsSource="{Binding SlotList}"
                                  SelectedItem="{Binding SelectedSlot}"
                                  Width="150"/>
                    </Grid>
                </GroupBox>

                <!-- 数据表格（参照图片样式） -->
                <GroupBox Header="Camera Data" Margin="0,0,0,16">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding DataRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  materialDesign:DataGridAssist.CellPadding="4"
                                  MaxHeight="300"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <!-- 固定列：Type -->
                                <DataGridTextColumn Header="{lang:Lang Type}" Binding="{Binding Type}" Width="100" IsReadOnly="True"/>
                                <!-- X, Y, U, Distance -->
                                <DataGridTextColumn Header="Slot OfsX (mm)" Binding="{Binding X, StringFormat=F3}" Width="80"/>
                                <DataGridTextColumn Header="Slot Ofs Y (mm)" Binding="{Binding Y, StringFormat=F3}" Width="80"/>
                                <DataGridTextColumn Header="Slot Ofs U (°)" Binding="{Binding U, StringFormat=F3}" Width="80"/>
                                <DataGridTextColumn Header="Height (mm)" Binding="{Binding Distance, StringFormat=F3}" Width="100"/>
                                <!-- X2, Y2, U2, Distance2 -->
                                <DataGridTextColumn Header="Assy Ofs X (mm)" Binding="{Binding X2, StringFormat=F3}" Width="80"/>
                                <DataGridTextColumn Header="Assy Ofs Y (mm)" Binding="{Binding Y2, StringFormat=F3}" Width="80"/>
                                <DataGridTextColumn Header="Assy Ofs U (°)" Binding="{Binding U2, StringFormat=F3}" Width="80"/>
                                <!--<DataGridTextColumn Header="Height (mm)" Binding="{Binding Distance2, StringFormat=F3}" Width="100"/>-->
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 操作按钮栏 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="📸 Capture" Margin="4" Command="{Binding CaptureCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}" Background="#007bff" Foreground="White"/>
                            <Button Content="{lang:Lang ExportCSV}" Margin="4" Command="{Binding ExportCsvCommand}"/>
                            <Button Content="{lang:Lang Close}" Margin="4" Command="{Binding CloseCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="* Click 'Capture' to acquire live data from the 2D camera. The table shows Reference, Deviation, and Compensation values."
                           FontSize="11"
                           Foreground="Gray"
                           Margin="0,4,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>