<UserControl x:Class="Module.Views.SetupCalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:Converter="clr-namespace:Module.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             MinHeight="200">
    <UserControl.Resources>
        <Converter:StringToBoolConverter x:Key="StringToBoolConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <materialDesign:Card UniformCornerRadius="12"
                                 Padding="16,12"
                                 Margin="0,0,0,16">
                <StackPanel>

                    <!-- Dispensing Check -->
                    <TextBlock Text="{lang:Lang Dispensing_DispensingCheck_Title}"
                               Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                               Foreground="{DynamicResource SecondaryHueMidBrush}"
                               Margin="0,0,0,8" />

                    <WrapPanel Margin="0,0,0,8">
                        <RadioButton Content="{lang:Lang Dispensing_Head1_Radio}"
                                     GroupName="HeadSelection"
                                     Margin="0,0,12,0" 
                                     IsChecked="{Binding SelectedHead, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Head 1}"/>
                        <RadioButton Content="{lang:Lang Dispensing_Head2_Radio}"
                                     GroupName="HeadSelection"
                                     Margin="0,0,24,0" 
                                     IsChecked="{Binding SelectedHead, Converter={StaticResource StringToBoolConverter}, ConverterParameter=Head 2}"/>
                    </WrapPanel>

                    <WrapPanel Margin="0,0,0,12">
                        <TextBlock Text="{lang:Lang Dispensing_PressureLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding DispensePressure, UpdateSourceTrigger=PropertyChanged}"
                                 Width="70"
                                 Margin="0,0,4,0" />
                        <TextBlock Text="MPa" VerticalAlignment="Center" Margin="0,0,24,0" />
                        <TextBlock Text="{lang:Lang Dispensing_DispenseSpeedLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding DispenseSpeed, UpdateSourceTrigger=PropertyChanged}"
                                 Width="70"
                                 Margin="0,0,4,0" />
                        <TextBlock Text="mm/s" VerticalAlignment="Center" />
                    </WrapPanel>

                    <!-- Recipe Settings -->
                    <TextBlock Text="{lang:Lang Dispensing_ParameterSettings_Title}"
                               Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                               Foreground="{DynamicResource SecondaryHueMidBrush}"
                               Margin="0,4,0,4" />

                    <WrapPanel>
                        <Button Command="{Binding SaveRecipeCommand}" Padding="12,4">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,4,0" />
                                <TextBlock Text="{lang:Lang Param_Save}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </materialDesign:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>