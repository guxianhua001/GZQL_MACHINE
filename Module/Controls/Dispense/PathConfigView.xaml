<UserControl x:Class="Module.Views.PathConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="500">

    <materialDesign:Card UniformCornerRadius="12"
                         Padding="16,12,16,16"
                         Margin="0,0,0,16">
        <StackPanel>
            <!--<TextBlock Text="PATH CONFIG &amp; SAFETY LOGIC"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                       Margin="0,0,0,12" />-->

            <!-- Nozzle Configuration -->
            <TextBlock Text="{lang:Lang Dispensing_NozzleConfig_Title}"
                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                       Foreground="{DynamicResource SecondaryHueMidBrush}"
                       Margin="0,8,0,4" />
            <Grid Margin="24,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Dispensing_ValveNumberLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" Width="160" SelectedIndex="0" HorizontalAlignment="Left">
                    <ComboBoxItem Content="{lang:Lang Dispensing_Valve1}" />
                    <ComboBoxItem Content="{lang:Lang Dispensing_Valve2}" />
                    <ComboBoxItem Content="{lang:Lang Dispensing_Valve3}" />
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Dispensing_Head1ActiveLabel}" VerticalAlignment="Center" Margin="0,4,0,4" />
                <ComboBox Grid.Row="1" Grid.Column="1" Width="160" SelectedIndex="0" HorizontalAlignment="Left" Margin="0,4,0,4">
                    <ComboBoxItem Content="{lang:Lang Dispensing_NozzleOption_A}" />
                    <ComboBoxItem Content="{lang:Lang Dispensing_NozzleOption_B}" />
                    <ComboBoxItem Content="{lang:Lang Dispensing_NozzleOption_C}" />
                </ComboBox>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang Dispensing_Head2ActiveLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" Width="160" SelectedIndex="1" HorizontalAlignment="Left">
                    <ComboBoxItem Content="{lang:Lang Dispensing_NozzleOption_A}" />
                    <ComboBoxItem Content="{lang:Lang Dispensing_NozzleOption_B}" />
                    <ComboBoxItem Content="{lang:Lang Dispensing_NozzleOption_C}" />
                </ComboBox>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{lang:Lang Dispensing_NozzleDiameterLabel}" VerticalAlignment="Center" Margin="0,4,0,4" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                    <TextBox Width="80" Text="0.2" VerticalAlignment="Center" />
                    <TextBlock Text="mm" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- General Parameters -->
            <TextBlock Text="{lang:Lang Dispensing_GeneralParams_Title}"
                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                       Foreground="{DynamicResource SecondaryHueMidBrush}"
                       Margin="0,8,0,4" />
            <Grid Margin="24,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Dispensing_ZGapHeightLabel}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="80" Text="0.5" VerticalAlignment="Center" />
                    <TextBlock Text="mm" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Dispensing_TargetLineWidthLabel}" VerticalAlignment="Center" Margin="0,4,0,4" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                    <TextBox Width="80" Text="1.0" VerticalAlignment="Center" />
                    <TextBlock Text="mm" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang Dispensing_DispenseTimePointLabel}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="80" Text="200" VerticalAlignment="Center" />
                    <TextBlock Text="ms" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{lang:Lang Dispensing_DispenseSpeedLabel}" VerticalAlignment="Center" Margin="0,4,0,4" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                    <TextBox Width="80" Text="20" VerticalAlignment="Center" />
                    <TextBlock Text="mm/s" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Motion & Safety Logic -->
            <TextBlock Text="{lang:Lang Dispensing_MotionSafety_Title}"
                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                       Foreground="{DynamicResource SecondaryHueMidBrush}"
                       Margin="0,8,0,4" />
            <Grid Margin="24,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Dispensing_GlobalSafetyHeightLabel}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="80" Text="50.0" VerticalAlignment="Center" />
                    <TextBlock Text="mm" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Dispensing_ApproachHeightLabel}" VerticalAlignment="Center" Margin="0,4,0,4" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                    <TextBox Width="80" Text="5.0" VerticalAlignment="Center" />
                    <TextBlock Text="mm" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang Dispensing_LocalPathHeightLabel}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="80" Text="1.0" VerticalAlignment="Center" />
                    <TextBlock Text="mm" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="{lang:Lang Dispensing_IntermediatePathPointsLabel}" VerticalAlignment="Center" Margin="0,4,0,4" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                    <Button Style="{StaticResource MaterialDesignOutlinedButton}" Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pencil" Width="16" Height="16" Margin="0,0,4,0" />
                            <TextBlock Text="{lang:Lang Dispensing_Button_EditPathPoints}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Start Logic -->
            <TextBlock Text="{lang:Lang Dispensing_StartLogic_Title}"
                       Style="{StaticResource MaterialDesignBodyMediumTextBlock}"
                       Foreground="{DynamicResource SecondaryHueMidBrush}"
                       Margin="0,8,0,4" />
            <Grid Margin="24,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Dispensing_ApproachSpeedLabel}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="80" Text="10" VerticalAlignment="Center" />
                    <TextBlock Text="mm/s" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Dispensing_ApproachDistanceLabel}" VerticalAlignment="Center" Margin="0,4,0,4" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,4">
                    <TextBox Width="80" Text="5.0" VerticalAlignment="Center" />
                    <TextBlock Text="mm" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang Dispensing_PreDispenseDelayLabel}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Width="80" Text="50" VerticalAlignment="Center" />
                    <TextBlock Text="ms" Margin="4,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- Apply Configuration Button -->
            <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Padding="16,6">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Text="{lang:Lang Param_Save}" />
                    </StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>
    </materialDesign:Card>
</UserControl>