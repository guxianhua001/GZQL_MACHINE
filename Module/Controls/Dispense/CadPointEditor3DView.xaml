<UserControl x:Class="Module.Views.CadPointEditor3DView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             MinHeight="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- 1. File Input -->
            <TextBlock Text="{lang:Lang Dispensing_FileInput_Title}"
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
            <TextBlock Text="{lang:Lang Dispensing_FileInput_Description}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="Gray"
                       FontSize="12"/>
            <WrapPanel Margin="0,0,0,8">
                <Button Content="{lang:Lang Dispensing_Button_SelectFile}"
                        Command="{Binding ImportDxfCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="12,4"
                        Margin="0,0,8,0" />
                <TextBox Text="{Binding SelectedFilePath, Mode=OneWay}"
                         materialDesign:HintAssist.Hint="{lang:Lang Dispensing_FileInput_NoFileSelected}"
                         MinWidth="320"
                         IsReadOnly="True"
                         VerticalAlignment="Center" />
                <ComboBox Width="100"
                          SelectedIndex="0"
                          Margin="8,0,0,0"
                          materialDesign:HintAssist.Hint="{lang:Lang Dispensing_FileInput_FileTypeHint}">
                    <ComboBoxItem Content="{lang:Lang Dispensing_FileInput_FileType_DXF}"
                                  IsSelected="True" />
                </ComboBox>
            </WrapPanel>
            <TextBlock Text="{lang:Lang Dispensing_FileInput_SupportedFormats}"
                       FontSize="11"
                       Margin="0,0,0,24"
                       Foreground="Gray" />

            <!-- 2. Visualization -->
            <TextBlock Text="{lang:Lang Dispensing_Visualization_Title}"
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
            <TextBlock Text="{lang:Lang Dispensing_Visualization_Description}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="Gray"
                       FontSize="12" />
            <Border BorderBrush="LightGray"
                    BorderThickness="1"
                    Background="WhiteSmoke"
                    Height="300">
                <!-- 固定高度，ScrollViewer 会自动填充 -->
                <ScrollViewer x:Name="DrawingScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Canvas x:Name="DrawingCanvas" Background="White" />
                </ScrollViewer>
            </Border>
            <WrapPanel Margin="0,12,0,24">
                <Button Content="Zoom In" Command="{Binding ZoomInCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,0"/>
                <Button Content="Zoom Out" Command="{Binding ZoomOutCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,0"/>
                <Button Content="Reset View" Command="{Binding ResetViewCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="8,0"/>
            </WrapPanel>

            <!-- 3. Path Editing -->
            <TextBlock Text="{lang:Lang Dispensing_PathEditing_Title}"
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
            <TextBlock Text="{lang:Lang Dispensing_PathEditing_Description}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Foreground="Gray"
                       FontSize="12" />
            <DataGrid ItemsSource="{Binding Points}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectedItem="{Binding SelectedPoint}"
                      materialDesign:DataGridAssist.CellPadding="4"
                      MaxHeight="200"
                      Margin="0,0,0,12">
                <DataGrid.Columns>
                    <!-- ID 列 -->
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="100"
                                        IsReadOnly="True" />
                    <DataGridTextColumn Header="{lang:Lang Dispensing_DataGrid_Column_X}"
                                        Binding="{Binding X, UpdateSourceTrigger=LostFocus}"
                                        Width="160" />
                    <DataGridTextColumn Header="{lang:Lang Dispensing_DataGrid_Column_Y}"
                                        Binding="{Binding Y, UpdateSourceTrigger=LostFocus}"
                                        Width="160" />
                    <DataGridTextColumn Header="{lang:Lang Dispensing_DataGrid_Column_Z}"
                                        Binding="{Binding Z, UpdateSourceTrigger=LostFocus}"
                                        Width="160" />
                    <!-- AssySite 下拉框列 -->
                    <DataGridTemplateColumn Header="Assy Site" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AssySite}" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.AssySites, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding AssySite, UpdateSourceTrigger=PropertyChanged}"
                                          IsEditable="False" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Margin="0,0,0,24">
                <Button Content="{lang:Lang Dispensing_Button_AddRow}"
                        Command="{Binding AddPointCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="12,4"
                        Margin="0,0,8,0" />
                <Button Content="{lang:Lang Dispensing_Button_DeleteSelected}"
                        Command="{Binding DeletePointCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="12,4"
                        Margin="0,0,8,0" />
                <Button Content="{lang:Lang Dispensing_Button_SavePath}"
                        Command="{Binding SavePointsCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="12,4" />
            </WrapPanel>

            <!-- 5. Align & Execute -->
            <TextBlock Text="Align"
           FontWeight="Bold"
           FontSize="16"
           Margin="0,16,0,4"
           Foreground="{DynamicResource PrimaryHueMidBrush}" />

            <!-- 两列：Map Fiducial 和 Dispensing Fiducial -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Map基准点 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Map Fiducial" FontWeight="SemiBold" Margin="0,0,0,4" />
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0">
                    <TextBox Text="{Binding MapFiducial.X, StringFormat=F1}" Width="50" Margin="0,0,4,0" materialDesign:HintAssist.Hint="{lang:Lang Dispensing_Hint_X}" />
                    <TextBox Text="{Binding MapFiducial.Y, StringFormat=F1}" Width="50" Margin="0,0,4,0" materialDesign:HintAssist.Hint="{lang:Lang Dispensing_Hint_Y}" />
                    <TextBox Text="{Binding MapFiducial.Z, StringFormat=F1}" Width="50" Margin="0,0,4,0" materialDesign:HintAssist.Hint="{lang:Lang Dispensing_Hint_Z}" />
                    <TextBox Text="{Binding MapFiducial.Rx, StringFormat=F1}" Width="50" Margin="0,0,4,0" materialDesign:HintAssist.Hint="Rx" />
                    <TextBox Text="{Binding MapFiducial.Rz, StringFormat=F1}" Width="50" Margin="0,0,4,0" materialDesign:HintAssist.Hint="Rz" />
                    <Button Content="{lang:Lang AssemblyStep_Button_Teach}" Command="{Binding TeachMapFiducialCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,2" />
                </StackPanel>

                <!-- Dispensing基准点 -->
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Dispensing Fiducial" FontWeight="SemiBold" Margin="0,0,0,4" />
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox Text="{Binding DispensingFiducial.X, StringFormat=F1}" Width="50" Margin="0,0,4,0" materialDesign:HintAssist.Hint="{lang:Lang Dispensing_Hint_X}" />
                    <TextBox Text="{Binding DispensingFiducial.Y, StringFormat=F1}" Width="50" Margin="0,0,4,0" materialDesign:HintAssist.Hint="{lang:Lang Dispensing_Hint_Y}" />
                    <TextBox Text="{Binding DispensingFiducial.Z, StringFormat=F1}" Width="50" Margin="0,0,4,0" materialDesign:HintAssist.Hint="{lang:Lang Dispensing_Hint_Z}" />
                    <TextBox Text="{Binding DispensingFiducial.Rx, StringFormat=F1}" Width="50" Margin="0,0,4,0" materialDesign:HintAssist.Hint="Rx" />
                    <TextBox Text="{Binding DispensingFiducial.Rz, StringFormat=F1}" Width="50" Margin="0,0,4,0" materialDesign:HintAssist.Hint="Rz" />
                    <Button Content="{lang:Lang AssemblyStep_Button_Teach}" Command="{Binding TeachDispensingFiducialCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="8,2" />
                </StackPanel>
            </Grid>

            <!-- Calibration File 单独一行 -->
            <TextBlock Text="Calibration File"
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
            <WrapPanel Margin="0,0,0,12">
                <Button Content="Import Calibration File"
                        Command="{Binding ImportCalibrationCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="12,6"/>
                <TextBlock Text="{Binding CalibrationFilePath, StringFormat='File: {0}'}"
                           materialDesign:HintAssist.Hint="{lang:Lang Dispensing_FileInput_NoFileSelected}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Foreground="Gray"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="300"/>
            </WrapPanel>
            <TextBlock Text="Supported: JSON"
                       FontSize="11"
                       Margin="0,0,0,12"
                       Foreground="Gray"/>

            <TextBlock Text="{lang:Lang Execute}"
                       FontWeight="Bold"
                       FontSize="16"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource PrimaryHueMidBrush}" />
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Site Select:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Width="120" SelectedIndex="0" Margin="0,0,8,0">
                    <ComboBoxItem Content="ASSY_001" />
                    <ComboBoxItem Content="ASSY_002" />
                    <ComboBoxItem Content="ASSY_003" />
                    <ComboBoxItem Content="ASSY_004" />
                    <ComboBoxItem Content="ASSY_005" />
                    <ComboBoxItem Content="ASSY_006" />
                </ComboBox>
                <TextBlock Text="Z correction:" VerticalAlignment="Center" Margin="8,0,8,0" />
                <TextBlock Text="✅ Applied (from Z-Scan)"
                           VerticalAlignment="Center"
                           Foreground="Green"/>
                <!--Visibility="{Binding ZCorrectionApplied, Converter={StaticResource BooleanToVisibilityConverter}}"-->
                <TextBlock Text="❌ Not Applied"
                           VerticalAlignment="Center"
                           Foreground="Red"/>
                <!--Visibility="{Binding ZCorrectionApplied, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}"/>-->
            </WrapPanel>

            <WrapPanel Margin="0,0,0,12">
                <Button Content="Dry Run — Trace Without Dispensing"
                        Command="{Binding DryRunCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0"
                        Padding="16,6"/>
                <Button Content="{lang:Lang Dispensing_Button_Execute3D}"
                        Command="{Binding ExecutePathCommand}"
                        Padding="16,6"/>
                <TextBlock Text="Status: Ready"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           Foreground="Green"/>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>