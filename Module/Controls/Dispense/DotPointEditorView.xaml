<UserControl x:Class="Module.Views.DotPointEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:Module.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             mc:Ignorable="d"
             prism:ViewModelLocator.AutoWireViewModel="True"
             d:DesignHeight="700" d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StepStateToBrushConverter x:Key="StepStateToBrush" />
        <converters:StepStateToTextBrushConverter x:Key="StepStateToTextBrush" />
        <converters:StepStateToConnectorBrushConverter x:Key="StepStateToConnectorBrush" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />

        <SolidColorBrush x:Key="PrimaryBlue" Color="#FF1565C0" />
        <SolidColorBrush x:Key="SuccessGreen" Color="#FF2E7D32" />
        <SolidColorBrush x:Key="DangerRed" Color="#FFD32F2F" />
        <SolidColorBrush x:Key="WarningAmber" Color="#FFF57C00" />
        <SolidColorBrush x:Key="TealColor" Color="#FF00838F" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FF263238" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF607D8B" />
        <SolidColorBrush x:Key="DividerColor" Color="#FFE0E4E8" />
        <SolidColorBrush x:Key="StatusBarBg" Color="#FF37474F" />
        <SolidColorBrush x:Key="ExecutingBg" Color="#FFFFF8E1" />
        <SolidColorBrush x:Key="ExecutingBorder" Color="#FFFFA000" />

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="CompactOutlinedButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelCard" TargetType="materialDesign:Card"
               BasedOn="{StaticResource {x:Type materialDesign:Card}}">
            <Setter Property="UniformCornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="#FFF5F7FA" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========== 顶部步骤指示器（仿CadPointEditorView） ========== -->
        <Border Grid.Row="0" Background="#FFFAFAFA" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- Step 1 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding Step1State, Converter={StaticResource StepStateToBrush}}"
                                BorderThickness="2">
                            <TextBlock Text="1" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{lang:Lang Dispensing_Dot_Section_ProcessParams}" FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding Step1State, Converter={StaticResource StepStateToTextBrush}}" />
                            <TextBlock Text="{lang:Lang Dispensing_Dot_Desc_ProcessParams}" FontSize="10" Foreground="#FF757575" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 连接线 -->
                    <Border Width="50" Height="3" Margin="10,0" VerticalAlignment="Center"
                            Background="{Binding Step1State, Converter={StaticResource StepStateToConnectorBrush}}" />

                    <!-- Step 2 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding Step2State, Converter={StaticResource StepStateToBrush}}"
                                BorderThickness="2">
                            <TextBlock Text="2" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{lang:Lang Dispensing_Dot_Section_PointEdit}" FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding Step2State, Converter={StaticResource StepStateToTextBrush}}" />
                            <TextBlock Text="{lang:Lang Dispensing_Dot_Desc_PointEdit}" FontSize="10" Foreground="#FF757575" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 连接线 -->
                    <Border Width="50" Height="3" Margin="10,0" VerticalAlignment="Center"
                            Background="{Binding Step2State, Converter={StaticResource StepStateToConnectorBrush}}" />

                    <!-- Step 3 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding Step3State, Converter={StaticResource StepStateToBrush}}"
                                BorderThickness="2">
                            <TextBlock Text="3" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{lang:Lang Dispensing_Dot_Section_ExecControl}" FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding Step3State, Converter={StaticResource StepStateToTextBrush}}" />
                            <TextBlock Text="{lang:Lang Dispensing_Dot_Desc_ExecControl}" FontSize="10" Foreground="#FF757575" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧状态消息 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFF3E0" CornerRadius="4" Padding="8,4"
                            Visibility="{Binding Status, Converter={StaticResource StringToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"
                                                     Foreground="#FFE65100" />
                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#FFE65100"
                                       VerticalAlignment="Center" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource ExecutingBg}" BorderBrush="{StaticResource ExecutingBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="6,0,0,0"
                            Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Loading" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"
                                                     Foreground="#FFF57C00">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform x:Name="LoadingRotate" CenterX="7" CenterY="7" />
                                </materialDesign:PackIcon.RenderTransform>
                                <materialDesign:PackIcon.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="LoadingRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </materialDesign:PackIcon.Triggers>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{lang:Lang Dispensing_Dot_Executing}" FontSize="11" Foreground="#FFF57C00"
                                       VerticalAlignment="Center" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 主内容区：Visibility切换 ========== -->
        <Grid Grid.Row="1">

            <!-- ═══ Step 1: 工艺参数配置 ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsStep1Active, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="12,10">
                    <materialDesign:Card Style="{StaticResource PanelCard}">
                        <StackPanel Margin="12,10">
                            <Border Style="{StaticResource SectionHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TuneVertical" Width="16" Height="16"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"
                                                             Foreground="{StaticResource PrimaryBlue}" />
                                    <TextBlock Text="{lang:Lang Dispensing_Dot_PanelTitle_Params}" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 运动参数 -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="{lang:Lang Dispensing_Dot_JumpSpeed}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"
                                               Foreground="{StaticResource PrimaryBlue}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_JumpSpeed}" Margin="0,0,8,0"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_JumpSpeed}"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.MoveSpeed, UpdateSourceTrigger=LostFocus, StringFormat=F1}"
                                                 Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_JumpSpeed}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm/s"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_SafeHeight}" Margin="0,0,8,0"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_SafeHeight}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.SafeHeight, UpdateSourceTrigger=LostFocus, StringFormat=F1}"
                                                 Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_SafeHeight}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_ApproachHeight}" Margin="0,0,8,0"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_ApproachHeight}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.ApproachHeight, UpdateSourceTrigger=LostFocus, StringFormat=F1}"
                                                 Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_ApproachHeight}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_DecelFactor}" Margin="0,0,8,0"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_DecelFactor}"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.CornerDecel, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                 Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_DecelFactor}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ParamLabel}" Text=" "/>
                                    </Grid>
                                </StackPanel>

                                <Border Grid.Column="1" Width="1" Background="{StaticResource DividerColor}" Margin="0,4"/>

                                <!-- 出胶参数 -->
                                <StackPanel Grid.Column="2" Margin="12,0,12,0">
                                    <TextBlock Text="{lang:Lang Dispensing_Dot_DispenseTime}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"
                                               Foreground="{StaticResource WarningAmber}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_DispenseTime}" Margin="0,0,8,0" FontWeight="Medium" Foreground="{StaticResource WarningAmber}"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_DispenseTime}"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.DispenseTime, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                                                 BorderBrush="#FFCC80" Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_DispenseTime}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="ms" Foreground="{StaticResource WarningAmber}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_PreDispenseDelay}" Margin="0,0,8,0"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_PreDispenseDelay}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.PreDispenseDelay, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                                                 Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_PreDispenseDelay}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="ms"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_PostDelay}" Margin="0,0,8,0"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_PostDelay}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.PostDelay, UpdateSourceTrigger=LostFocus, StringFormat=F0}"
                                                 Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_PostDelay}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="ms"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_StartDistance}" Margin="0,0,8,0" FontWeight="Medium" Foreground="{StaticResource WarningAmber}"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_StartDistance}"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.DotGlueTriggerOffsetMm, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                 BorderBrush="#FFCC80" Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_StartDistance}"/>
                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm" Foreground="{StaticResource WarningAmber}"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_Pressure}" Margin="0,0,8,0"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_Pressure}"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.DispensingPressure, UpdateSourceTrigger=LostFocus, StringFormat=F2}"
                                                 Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_Pressure}"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="MPa"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_SuctionTime}" Margin="0,0,8,0"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_SuctionTime}"/>
                                        <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.SuckBackTime, UpdateSourceTrigger=LostFocus, StringFormat=F1}"
                                                 Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_SuctionTime}"/>
                                        <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="ms"/>
                                    </Grid>
                                </StackPanel>

                                <Border Grid.Column="3" Width="1" Background="{StaticResource DividerColor}" Margin="0,4"/>

                                <!-- 高度参数 -->
                                <StackPanel Grid.Column="4" Margin="12,0,0,0">
                                    <TextBlock Text="{lang:Lang Dispensing_Dot_TeachHeight}" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"
                                               Foreground="{StaticResource TealColor}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_TeachHeight}" Margin="0,0,8,0"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_TeachHeight}"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.TeachHeight, UpdateSourceTrigger=LostFocus, StringFormat=F3}"
                                                 Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_TeachHeight}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_HeightCompensation}" Margin="0,0,8,0"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_HeightCompensation}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.HeightCompensation, UpdateSourceTrigger=LostFocus, StringFormat=F3}"
                                                 Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_HeightCompensation}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ParamLabel}" Text="{lang:Lang Dispensing_Dot_EffectiveHeight}" Margin="0,0,8,0" Foreground="#9E9E9E"
                                                   ToolTip="{lang:Lang Dispensing_Dot_Tip_EffectiveHeight}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 Text="{Binding ProcessParams.EffectiveZHeight, Mode=OneWay, StringFormat=F3}"
                                                 IsReadOnly="True" Background="#F5F5F5" Foreground="#424242" FontWeight="Medium"
                                                 Padding="4,2" FontSize="11" ToolTip="{lang:Lang Dispensing_Dot_Tip_EffectiveHeight}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ParamLabel}" Text="mm"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- 操作按钮行 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <Button Command="{Binding SaveDataCommand}"
                                        Style="{StaticResource CompactOutlinedButton}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang Dispensing_Dot_Btn_SaveParams}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding LoadDataCommand}"
                                        Style="{StaticResource CompactOutlinedButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang Dispensing_Dot_Btn_LoadParams}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ Step 2: 点位数据编辑 ═══ -->
            <Grid Visibility="{Binding IsStep2Active, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 工具栏 -->
                <materialDesign:Card Grid.Row="0" Padding="8,6" Margin="12,10,12,0" UniformCornerRadius="6">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="{lang:Lang Dispensing_Dot_GroupFilter_Label}" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" Foreground="{StaticResource TextSecondary}"/>
                            <ComboBox Width="100" ItemsSource="{Binding GroupFilters}" SelectedItem="{Binding SelectedGroupFilter}"
                                      FontSize="11" Margin="0,0,12,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding AddPointCommand}"
                                    Style="{StaticResource CompactButton}" Margin="0,0,4,0"
                                    Background="{StaticResource TealColor}" Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14"
                                                             VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{lang:Lang Dispensing_Dot_Btn_AddPoint}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DeleteSelectedCommand}"
                                    Style="{StaticResource CompactOutlinedButton}" Margin="0,0,4,0"
                                    Foreground="{StaticResource DangerRed}" BorderBrush="{StaticResource DangerRed}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Delete" Width="14" Height="14"
                                                             VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{lang:Lang Dispensing_Dot_Btn_DeleteSelected}" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource CompactOutlinedButton}" Margin="0,0,2,0" FontSize="11"
                                    Content="{lang:Lang Dispensing_Dot_CheckBox_SelectAll}" Padding="6,4"/>
                            <Button Command="{Binding DeselectAllCommand}"
                                    Style="{StaticResource CompactOutlinedButton}" FontSize="11"
                                    Content="{lang:Lang Dispensing_Dot_CheckBox_InvertSelect}" Padding="6,4"/>
                            <Border Width="1" Background="{StaticResource DividerColor}" Margin="6,2,0,2"
                                    SnapsToDevicePixels="True"/>
                            <TextBlock Text="{lang:Lang Dispensing_Dot_Target_Label}" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"
                                       Foreground="{StaticResource TextSecondary}"/>
                            <ComboBox Width="50" ItemsSource="{Binding ApplyTargetOptions}" SelectedItem="{Binding ApplyTargetZ}"
                                      FontSize="10" Margin="0,0,4,0">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='Dz{0}'}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Command="{Binding ApplyProcessParamsCommand}"
                                    Style="{StaticResource CompactButton}" Margin="0,0,0,0"
                                    Background="{StaticResource PrimaryBlue}" Foreground="White"
                                    ToolTip="{lang:Lang Dispensing_Dot_Tip_ApplyParams}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowDownBold" Width="14" Height="14"
                                                             VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{lang:Lang Dispensing_Dot_Btn_ApplyParams}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </materialDesign:Card>

                <!-- DataGrid -->
                <DataGrid Grid.Row="1" Margin="12,6,12,10"
                          ItemsSource="{Binding FilteredPoints}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          materialDesign:DataGridAssist.CellPadding="4"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          BorderBrush="{StaticResource DividerColor}" BorderThickness="1"
                          RowBackground="White" AlternatingRowBackground="#F8F9FA"
                          FontSize="11">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="☑" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="38"/>

                        <DataGridTemplateColumn Header="Group" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Group}" VerticalAlignment="Center" Foreground="{StaticResource TealColor}" FontWeight="Medium" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding Group, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="ID" Binding="{Binding PointId}" Width="68" IsReadOnly="True"
                                            Foreground="#757575"/>
                        <DataGridTextColumn Header="Dx" Binding="{Binding Dx, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Width="62"/>
                        <DataGridTextColumn Header="Dy" Binding="{Binding Dy, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Width="62"/>
                        <DataGridTextColumn Header="Dz₂" Binding="{Binding Dz2, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Width="62"/>
                        <DataGridTextColumn Header="Dz₃" Binding="{Binding Dz3, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Width="62"/>
                        <DataGridTextColumn Header="Rx" Binding="{Binding Rx, StringFormat=F2, UpdateSourceTrigger=LostFocus}" Width="52"/>
                        <DataGridTextColumn Header="Ry" Binding="{Binding Ry, StringFormat=F2, UpdateSourceTrigger=LostFocus}" Width="52"/>
                        <DataGridTextColumn Header="{lang:Lang Dispensing_Dot_Column_Dz2Comp}" Binding="{Binding Dz2Compensation, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Width="62"/>
                        <DataGridTextColumn Header="{lang:Lang Dispensing_Dot_Column_Dz3Comp}" Binding="{Binding Dz3Compensation, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Width="62"/>

                        <DataGridTemplateColumn Header="{lang:Lang Dispensing_Dot_Column_Teach}" Width="58">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{lang:Lang Dispensing_Dot_Column_Teach}"
                                            Command="{Binding DataContext.TeachPointCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Padding="4,1" FontSize="10"
                                            Foreground="{StaticResource TealColor}" BorderBrush="{StaticResource TealColor}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ═══ Step 3: 执行控制 ═══ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsStep3Active, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="12,10">
                    <materialDesign:Card Style="{StaticResource PanelCard}">
                        <StackPanel Margin="12,10">
                            <Border Style="{StaticResource SectionHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlayCircleOutline" Width="16" Height="16"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"
                                                             Foreground="{StaticResource WarningAmber}" />
                                    <TextBlock Text="{lang:Lang Dispensing_Dot_PanelTitle_Exec}" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="{lang:Lang Dispensing_Dot_PanelDesc_Exec}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center" Margin="10,0,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- 执行按钮组 -->
                            <WrapPanel Margin="0,0,0,10">
                                <Button Command="{Binding DryRunCommand}"
                                        Style="{StaticResource CompactOutlinedButton}" Margin="0,0,8,4"
                                        BorderBrush="{StaticResource PrimaryBlue}" Foreground="{StaticResource PrimaryBlue}"
                                        ToolTip="{lang:Lang Dispensing_Dot_Tip_DryRun}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlayOutline" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang Dispensing_Dot_Btn_DryRun}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ExecuteDotDispenseCommand}"
                                        Style="{StaticResource CompactButton}" Margin="0,0,8,4"
                                        Background="{StaticResource WarningAmber}" Foreground="White"
                                        ToolTip="{lang:Lang Dispensing_Dot_Tip_RealDispense}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Needle" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang Dispensing_Dot_Btn_RealDispense}" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding StopExecutionCommand}"
                                        Style="{StaticResource CompactButton}" Margin="0,0,0,4"
                                        Background="{StaticResource DangerRed}" Foreground="White"
                                        ToolTip="{lang:Lang Dispensing_Dot_Tip_Stop}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Stop" Width="14" Height="14"
                                                                 VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <TextBlock Text="{lang:Lang Dispensing_Dot_Btn_Stop}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>

                            <!-- 进度与状态 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ProgressBar Grid.Column="0" Value="{Binding ProgressCurrent}" Maximum="{Binding ProgressTotal}"
                                             Height="18" Margin="0,0,12,0"
                                             Foreground="{StaticResource WarningAmber}" Background="#FFE0B2"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border CornerRadius="4" Padding="10,4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#C8E6C9"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Background" Value="#FFCDD2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Medium" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Status, Mode=OneWay}"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerRed}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Running">
                                                            <Setter Property="Foreground" Value="{StaticResource WarningAmber}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ========== 底部状态栏 ========== -->
        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBg}">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Foreground="#FFB0BEC5" FontSize="11"
                           Text="{Binding Points.Count, StringFormat={}{0}}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Foreground="#FFB0BEC5" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value=""/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedGroupFilter}" Value="">
                                    <Setter Property="Text" Value="{lang:Lang Dispensing_Dot_Filter_All}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{lang:Lang Dispensing_Dot_Btn_PrevStep}" Command="{Binding GoPrevCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Padding="8,2" FontSize="11" />
                    <TextBlock Text="{Binding CurrentStepTitle, FallbackValue='Step 1'}" Foreground="#FF80CBC4"
                               VerticalAlignment="Center" Margin="8,0" FontSize="11" FontWeight="Medium" />
                    <Button Content="{lang:Lang Dispensing_Dot_Btn_NextStep}" Command="{Binding GoNextCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Padding="8,2" FontSize="11" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>