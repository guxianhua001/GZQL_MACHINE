<UserControl x:Class="Module.Views.VisionCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Module.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:vm="clr-namespace:Module.ViewModels"
             xmlns:converters="clr-namespace:Module.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:helpers="clr-namespace:Framework.Helpers;assembly=Framework"
             xmlns:interactivity="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:common="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BooleanToBrushConverter x:Key="LinkedToBrushConverter"
                                            TrueBrush="#1565C0" FalseBrush="#BDBDBD" />
        <ObjectDataProvider x:Key="RunModeValues"
                            MethodName="GetValues"
                            ObjectType="{x:Type vm:RunMode}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:RunMode" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <converters:StepStateToBrushConverter x:Key="StepStateToBrush" />
        <converters:StepStateToIconConverter x:Key="StepStateToIcon" />
        <converters:StepStateToForegroundConverter x:Key="StepStateToForeground" />
        <converters:StepStateToTextBrushConverter x:Key="StepStateToTextBrush" />
        <converters:StepStateToConnectorBrushConverter x:Key="StepStateToConnectorBrush" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringToVis" />

        <SolidColorBrush x:Key="SectionHeaderBg" Color="#FFF5F7FA" />
        <SolidColorBrush x:Key="StepCardBg" Color="#FFFAFBFC" />
        <SolidColorBrush x:Key="ResultHighlightBg" Color="#FFE3F2FD" />
        <SolidColorBrush x:Key="ResultHighlightBorder" Color="#FF1565C0" />
        <SolidColorBrush x:Key="ExecutingBg" Color="#FFFFF8E1" />
        <SolidColorBrush x:Key="ExecutingBorder" Color="#FFFFA000" />
        <SolidColorBrush x:Key="PrimaryBlue" Color="#FF1565C0" />
        <SolidColorBrush x:Key="SuccessGreen" Color="#FF2E7D32" />
        <SolidColorBrush x:Key="DangerRed" Color="#FFD32F2F" />
        <SolidColorBrush x:Key="WarningAmber" Color="#FFF57C00" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FF263238" />
        <SolidColorBrush x:Key="TextSecondary" Color="#FF607D8B" />
        <SolidColorBrush x:Key="DividerColor" Color="#FFE0E4E8" />
        <SolidColorBrush x:Key="StatusBarBg" Color="#FF37474F" />
        <SolidColorBrush x:Key="StepActiveBg" Color="#FF1565C0" />
        <SolidColorBrush x:Key="StepDoneBg" Color="#FF2E7D32" />
        <SolidColorBrush x:Key="StepPendingBg" Color="#FFBDBDBD" />
        <SolidColorBrush x:Key="ConnectorDoneBg" Color="#FF2E7D32" />
        <SolidColorBrush x:Key="ConnectorPendingBg" Color="#FFE0E0E0" />

        <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="CompactOutlinedButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="4" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SectionHeaderBg}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="CoordCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource StepCardBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>

        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PanelCard" TargetType="materialDesign:Card"
               BasedOn="{StaticResource {x:Type materialDesign:Card}}">
            <Setter Property="UniformCornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========== 顶部步骤指示器（仿CadPointEditorView） ========== -->
        <Border Grid.Row="0" Background="#FFFAFAFA" BorderBrush="#FFE0E0E0" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- Step 1 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding Step1State, Converter={StaticResource StepStateToBrush}}"
                                BorderThickness="2">
                            <TextBlock Text="1" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{lang:Lang VisionCapture_Step1Title}" FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding Step1State, Converter={StaticResource StepStateToTextBrush}}" />
                            <TextBlock Text="{lang:Lang VisionCapture_Step1Desc}" FontSize="10" Foreground="#FF757575" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 连接线 -->
                    <Border Width="60" Height="3" Margin="12,0" VerticalAlignment="Center"
                            Background="{Binding Step1State, Converter={StaticResource StepStateToConnectorBrush}}" />

                    <!-- Step 2 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0">
                        <Border Width="32" Height="32" CornerRadius="16"
                                Background="{Binding Step2State, Converter={StaticResource StepStateToBrush}}"
                                BorderThickness="2">
                            <TextBlock Text="2" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{lang:Lang VisionCapture_Step2Title}" FontSize="12" FontWeight="Medium"
                                       Foreground="{Binding Step2State, Converter={StaticResource StepStateToTextBrush}}" />
                            <TextBlock Text="{lang:Lang VisionCapture_Step2Desc}" FontSize="10" Foreground="#FF757575" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧状态消息 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFF3E0" CornerRadius="4" Padding="8,4"
                            Visibility="{Binding StatusMessage, Converter={StaticResource StringToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"
                                                     Foreground="#FFE65100" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="#FFE65100"
                                       VerticalAlignment="Center" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource ExecutingBg}" BorderBrush="{StaticResource ExecutingBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="6,0,0,0"
                            Visibility="{Binding IsExecuting, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Loading" Width="14" Height="14"
                                                     VerticalAlignment="Center" Margin="0,0,4,0"
                                                     Foreground="#FFF57C00">
                                <materialDesign:PackIcon.RenderTransform>
                                    <RotateTransform x:Name="LoadingRotate" CenterX="7" CenterY="7" />
                                </materialDesign:PackIcon.RenderTransform>
                                <materialDesign:PackIcon.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="LoadingRotate"
                                                                 Storyboard.TargetProperty="Angle"
                                                                 From="0" To="360" Duration="0:0:1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </materialDesign:PackIcon.Triggers>
                            </materialDesign:PackIcon>
                            <TextBlock Text="{lang:Lang VisionCapture_Executing}" FontSize="11" Foreground="#FFF57C00"
                                       VerticalAlignment="Center" FontWeight="Medium" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 主内容区：Visibility切换 ========== -->
        <Grid Grid.Row="1">
            <!-- Step1: 配置 & 拍照 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsStep1Active, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="12,10">
                    <!-- 运动参数配置 -->
                    <materialDesign:Card Style="{StaticResource PanelCard}" Margin="0,0,0,0">
                        <StackPanel Margin="12,10">
                            <Border Style="{StaticResource SectionHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Robot" Width="16" Height="16"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"
                                                             Foreground="{StaticResource PrimaryBlue}" />
                                    <TextBlock Text="{lang:Lang VisionCapture_MotionParams}" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                <TextBlock Text="{lang:Lang VisionCapture_SafePosition}" Style="{StaticResource ParamLabel}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SafePositionName}" FontSize="11" FontWeight="Medium"
                                           Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding AxisPositionItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource CoordCard}" Margin="0,0,6,4" MinWidth="120">
                                            <StackPanel>
                                                <TextBlock Text="{Binding AxisName}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{lang:Lang VisionCapture_RealtimePos}" FontSize="10"
                                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,2,0" />
                                                    <TextBlock Text="{Binding RealtimePosition, StringFormat=F3}" FontSize="10"
                                                               Foreground="{StaticResource PrimaryBlue}" FontWeight="Medium" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{lang:Lang VisionCapture_SafePosValue}" FontSize="10"
                                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,2,0" />
                                                    <TextBlock Text="{Binding SafePosition, StringFormat=F3}" FontSize="10"
                                                               Foreground="{StaticResource SuccessGreen}" FontWeight="Medium" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 配置工站 -->
                    <materialDesign:Card Style="{StaticResource PanelCard}">
                        <StackPanel Margin="12,10">
                            <Border Style="{StaticResource SectionHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FormatListGroup" Width="16" Height="16"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"
                                                             Foreground="{StaticResource PrimaryBlue}" />
                                    <TextBlock Text="{lang:Lang VisionCapture_ConfigStation}" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ComboBox Width="160"
                                          ItemsSource="{Binding Groups}"
                                          SelectedItem="{Binding SelectedGroup}"
                                          materialDesign:HintAssist.Hint="{lang:Lang VisionCapture_SelectGroup}"
                                          FontSize="12" Margin="0,0,8,0" />
                                <Button Command="{Binding AddGroupCommand}"
                                        Style="{StaticResource CompactOutlinedButton}"
                                        Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                        ToolTip="{lang:Lang VisionCapture_Btn_AddGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderPlus" Width="12" Height="12"
                                                                 VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="{lang:Lang VisionCapture_Btn_AddGroup}" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteGroupCommand}"
                                        Style="{StaticResource CompactOutlinedButton}"
                                        Padding="6,2" FontSize="10" Margin="0,0,8,0"
                                        ToolTip="{lang:Lang VisionCapture_Btn_DeleteGroup}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderRemove" Width="12" Height="12"
                                                                 VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="{lang:Lang VisionCapture_Btn_DeleteGroup}" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddPhotoPositionCommand}"
                                        Style="{StaticResource CompactButton}"
                                        Background="{StaticResource PrimaryBlue}" Foreground="White"
                                        Padding="6,2" FontSize="10" Margin="0,0,4,0"
                                        ToolTip="{lang:Lang VisionCapture_Btn_AddPhotoPosition}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="12" Height="12"
                                                                 VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="{lang:Lang VisionCapture_Btn_AddPhotoPosition}" FontSize="10" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeletePhotoPositionCommand}"
                                        CommandParameter="{Binding SelectedRow}"
                                        Style="{StaticResource CompactOutlinedButton}"
                                        Padding="6,2" FontSize="10"
                                        ToolTip="{lang:Lang VisionCapture_Btn_DeletePhotoPosition}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Minus" Width="12" Height="12"
                                                                 VerticalAlignment="Center" Margin="0,0,3,0" />
                                        <TextBlock Text="{lang:Lang VisionCapture_Btn_DeletePhotoPosition}" FontSize="10" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <!-- 无效位置警告条：选中行的拍照位在位置编辑器中不存在时显示 -->
                            <Border Background="#FFFBEE" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="4"
                                    Padding="8,4" Margin="0,4,0,4"
                                    Visibility="{Binding SelectedRow.IsPositionInvalid, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircle" Width="16" Height="16"
                                                             Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{lang:Lang VisionCapture_Warn_InvalidPosition}" FontSize="11"
                                               Foreground="#E65100" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <DataGrid ItemsSource="{Binding PhotoPositionRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      SelectionMode="Single"
                                      SelectedItem="{Binding SelectedRow}"
                                      materialDesign:DataGridAssist.CellPadding="2,1"
                                      FontSize="11"
                                      BorderThickness="1" BorderBrush="{StaticResource DividerColor}"
                                      HeadersVisibility="Column"
                                      MaxHeight="220">
                                <DataGrid.Columns>
                                    <!-- 无效位置警告图标列（位置名不存在于位置编辑器时显示红色警示） -->
                                    <DataGridTemplateColumn Width="28" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <materialDesign:PackIcon Kind="AlertCircle" Width="14" Height="14"
                                                                         Foreground="#E65100" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                         Visibility="{Binding IsPositionInvalid, Converter={StaticResource BoolToVis}}"
                                                                         ToolTip="{lang:Lang VisionCapture_Warn_InvalidPosition}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- 拍照位名称（手动输入，输入后自动从位置编辑器解析各轴坐标） -->
                                    <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_PhotoName}" Binding="{Binding PositionName, UpdateSourceTrigger=LostFocus}" Width="120" FontSize="11" />
                                    <!-- 只读解析坐标列（由 ViewModel 按 PositionName 从位置编辑器填充） -->
                                    <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_Dx}" Binding="{Binding Dx, StringFormat=F3, Mode=OneWay}" Width="72" FontSize="11" IsReadOnly="True" />
                                    <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_Dy}" Binding="{Binding Dy, StringFormat=F3, Mode=OneWay}" Width="72" FontSize="11" IsReadOnly="True" />
                                    <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_Dz1}" Binding="{Binding Dz1, StringFormat=F3, Mode=OneWay}" Width="72" FontSize="11" IsReadOnly="True" />
                                    <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_Y}" Binding="{Binding Y, StringFormat=F3, Mode=OneWay}" Width="72" FontSize="11" IsReadOnly="True" />
                                    <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_Rx}" Binding="{Binding Rx, StringFormat=F3, Mode=OneWay}" Width="62" FontSize="11" IsReadOnly="True" />
                                    <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_Rz}" Binding="{Binding Rz, StringFormat=F3, Mode=OneWay}" Width="62" FontSize="11" IsReadOnly="True" />
                                    <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_Spd}" Binding="{Binding Speed}" Width="75" FontSize="11" />
                                    <DataGridTemplateColumn Header="{lang:Lang VisionCapture_ColumnMove}" Width="65">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.MoveToTeachPositionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactButton}"
                                                        Background="{StaticResource WarningAmber}" Foreground="White"
                                                        Padding="4,2" FontSize="10"
                                                        ToolTip="{lang:Lang VisionCapture_MoveTooltip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Navigation" Width="12" Height="12"
                                                                                 VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{lang:Lang VisionCapture_ColumnTrigger}" Binding="{Binding TriggerCommand}" Width="72" FontSize="11" />
                                    <DataGridTemplateColumn Header="{lang:Lang VisionCapture_ColumnConnection}" Width="102">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ConnectionName}" VerticalAlignment="Center" Margin="2,0" FontSize="11" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableConnections, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedItem="{Binding ConnectionName, UpdateSourceTrigger=PropertyChanged}" FontSize="11" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{lang:Lang VisionCapture_ColumnType}" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TrajectoryOverride}" VerticalAlignment="Center" Margin="2,0" FontSize="11" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding DataContext.AvailableTrajectoryTypes, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedItem="{Binding TrajectoryOverride, UpdateSourceTrigger=PropertyChanged}" FontSize="11" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{lang:Lang VisionCapture_ColumnCapture}" Width="78">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.ExecuteCaptureCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CompactButton}"
                                                        Background="{StaticResource PrimaryBlue}" Foreground="White"
                                                        Padding="4,2" FontSize="10" >
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Camera" Width="12" Height="12"
                                                                                 VerticalAlignment="Center" Margin="0,0,2,0" />
                                                        <TextBlock Text="{lang:Lang AssemblyStep_Button_Capture}" FontSize="10" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{lang:Lang VisionCapture_ReturnToSafe}" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding ReturnToSafeAfterCapture, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- 视觉数据 -->
                    <materialDesign:Card Style="{StaticResource PanelCard}">
                        <StackPanel Margin="12,10">
                            <Border Style="{StaticResource SectionHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Eye" Width="16" Height="16"
                                                             VerticalAlignment="Center" Margin="0,0,6,0"
                                                             Foreground="{StaticResource PrimaryBlue}" />
                                    <TextBlock Text="{lang:Lang VisionCapture_VisionData}" FontWeight="SemiBold" FontSize="13"
                                               VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{lang:Lang VisionCapture_RawResponse}" FontWeight="SemiBold" FontSize="11"
                                           Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding RawResponse, Mode=OneWay}"
                                         IsReadOnly="True" TextWrapping="Wrap"
                                         MaxHeight="80" FontSize="11"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>



                </StackPanel>
            </ScrollViewer>

            <!-- Step2: 预览 & 点胶 -->
            <Grid Visibility="{Binding IsStep2Active, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="500" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：坐标转换详情 + 目标点表 -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,10,6,10">
                        <!-- 坐标转换详情 -->
                        <materialDesign:Card Style="{StaticResource PanelCard}">
                            <StackPanel Margin="12,10">
                                <Border Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Calculator" Width="16" Height="16"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Foreground="{StaticResource PrimaryBlue}" />
                                        <TextBlock Text="{lang:Lang VisionCapture_CoordTransformDetail}" FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{lang:Lang VisionCapture_FinalCoordinateFormula}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           TextWrapping="Wrap"
                                           Margin="6,6,6,0" />

                                <!-- 统一坐标转换面板：轨迹类型（用户指定）+ 目标点 + 偏移叠加 -->
                                <StackPanel Margin="4,8">
                                    <!-- 轨迹类型：仅用户指定，取消自动检测 -->
                                    <Border Style="{StaticResource CoordCard}" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{lang:Lang VisionCapture_TrajectoryType}"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <ComboBox Grid.Column="1" Width="120" FontSize="11" HorizontalAlignment="Left"
                                                      ItemsSource="{Binding AvailableTrajectoryTypes}"
                                                      SelectedItem="{Binding SelectedRow.TrajectoryOverride, UpdateSourceTrigger=PropertyChanged}" />
                                        </Grid>
                                    </Border>

                                    <!-- 目标点表：相机坐标 + 叠加后机械坐标 -->
                                    <TextBlock Text="{lang:Lang VisionCapture_TargetPoints}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4" />
                                    <DataGrid ItemsSource="{Binding CapturedTargetPoints}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              MaxHeight="140"
                                              FontSize="11"
                                              materialDesign:DataGridAssist.CellPadding="2,1"
                                              BorderThickness="1" BorderBrush="{StaticResource DividerColor}"
                                              HeadersVisibility="Column"
                                              Margin="0,0,0,8">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="36" IsReadOnly="True" />
                                            <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_PointX}" Binding="{Binding PointX, StringFormat=F3}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_PointY}" Binding="{Binding PointY, StringFormat=F3}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_MechX}" Binding="{Binding MechX, StringFormat=F3}" Width="*" IsReadOnly="True" />
                                            <DataGridTextColumn Header="{lang:Lang VisionCapture_Header_MechY}" Binding="{Binding MechY, StringFormat=F3}" Width="*" IsReadOnly="True" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- 统一偏移：相机针头距离 / 校针偏差（XY 补偿已移至工艺参数面板，与 Step3 对齐） -->
                                    <UniformGrid Columns="2" Margin="0,0,0,4">
                                        <Border Style="{StaticResource CoordCard}" Margin="0,0,4,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource PrimaryBlue}" Margin="0,0,4,0">
                                                        <TextBlock Text="1" Foreground="White" FontSize="9" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{lang:Lang VisionCapture_CameraNeedleDistance}" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource TextPrimary}" />
                                                </StackPanel>
                                                <Grid Margin="6,0,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="AxisXArrow" Width="12" Height="12"
                                                                             Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,4,1" />
                                                    <common:GlobalVariableLinkControl Grid.Row="0" Grid.Column="1"
                                                        DisplayValue="{Binding CameraNeedleDistanceX}"
                                                        DisplayForeground="#E53935"
                                                        IsLinked="{Binding IsCameraNeedleDistanceXLinked}"
                                                        UnlinkCommand="{Binding UnlinkNeedleDistanceXCommand}"
                                                        LinkedVariableName="{Binding CameraNeedleDistanceXLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                                        LinkableGlobalVariables="{Binding LinkableGlobalVariables}"
                                                        ComboBoxWidth="200" />
                                                    <materialDesign:PackIcon Grid.Row="1" Grid.Column="0" Kind="AxisYArrow" Width="12" Height="12"
                                                                             Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <common:GlobalVariableLinkControl Grid.Row="1" Grid.Column="1"
                                                        DisplayValue="{Binding CameraNeedleDistanceY}"
                                                        DisplayForeground="#43A047"
                                                        IsLinked="{Binding IsCameraNeedleDistanceYLinked}"
                                                        UnlinkCommand="{Binding UnlinkNeedleDistanceYCommand}"
                                                        LinkedVariableName="{Binding CameraNeedleDistanceYLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                                        LinkableGlobalVariables="{Binding LinkableGlobalVariables}"
                                                        ComboBoxWidth="200" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource CoordCard}" Margin="2,0,2,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                    <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource PrimaryBlue}" Margin="0,0,4,0">
                                                        <TextBlock Text="2" Foreground="White" FontSize="9" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{lang:Lang VisionCapture_NeedleOffset}" FontWeight="SemiBold" FontSize="10" Foreground="{StaticResource TextPrimary}" />
                                                </StackPanel>
                                                <Grid Margin="6,0,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Grid.Row="0" Grid.Column="0" Kind="AxisXArrow" Width="12" Height="12"
                                                                             Foreground="#E53935" VerticalAlignment="Center" Margin="0,0,4,1" />
                                                    <common:GlobalVariableLinkControl Grid.Row="0" Grid.Column="1"
                                                        DisplayValue="{Binding NeedleOffsetX}"
                                                        DisplayForeground="#E53935"
                                                        IsLinked="{Binding IsNeedleOffsetXLinked}"
                                                        UnlinkCommand="{Binding UnlinkNeedleOffsetXCommand}"
                                                        LinkedVariableName="{Binding NeedleOffsetXLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                                        LinkableGlobalVariables="{Binding LinkableGlobalVariables}"
                                                        ComboBoxWidth="200" />
                                                    <materialDesign:PackIcon Grid.Row="1" Grid.Column="0" Kind="AxisYArrow" Width="12" Height="12"
                                                                             Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <common:GlobalVariableLinkControl Grid.Row="1" Grid.Column="1"
                                                        DisplayValue="{Binding NeedleOffsetY}"
                                                        DisplayForeground="#43A047"
                                                        IsLinked="{Binding IsNeedleOffsetYLinked}"
                                                        UnlinkCommand="{Binding UnlinkNeedleOffsetYCommand}"
                                                        LinkedVariableName="{Binding NeedleOffsetYLinkedVar, UpdateSourceTrigger=PropertyChanged}"
                                                        LinkableGlobalVariables="{Binding LinkableGlobalVariables}"
                                                        ComboBoxWidth="200" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Dot 模式最终点胶坐标 -->
                                    <Border Background="{StaticResource ResultHighlightBg}"
                                            BorderBrush="{StaticResource ResultHighlightBorder}"
                                            BorderThickness="2" CornerRadius="6" Padding="10,8" Margin="0,2,0,0"
                                            Visibility="{Binding IsDotMode, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <materialDesign:PackIcon Kind="MapMarker" Width="16" Height="16"
                                                                         VerticalAlignment="Center" Margin="0,0,6,0"
                                                                         Foreground="{StaticResource ResultHighlightBorder}" />
                                                <TextBlock Text="{lang:Lang VisionCapture_FinalDispensePos}" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" FontSize="13" />
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="22,0,0,0">
                                                    <TextBlock Text="X = " FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}">
                                                        <Run Text="{Binding FinalX, StringFormat=F3}" />
                                                    </TextBlock>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <TextBlock Text="Y = " FontSize="12" Foreground="{StaticResource TextPrimary}" />
                                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}">
                                                        <Run Text="{Binding FinalY, StringFormat=F3}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 弧线可视化 -->
                        <materialDesign:Card Style="{StaticResource PanelCard}" Margin="0,0,0,0"
                                             Visibility="{Binding IsArcMode, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="12,10">
                                <Border Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="VectorCurve" Width="16" Height="16"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Foreground="{StaticResource PrimaryBlue}" />
                                        <TextBlock Text="{lang:Lang VisionCapture_ArcPreview}" FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>
                                <Canvas x:Name="ArcPreviewCanvas"
                                        Height="220"
                                        Background="#FFF8F9FA"
                                        ClipToBounds="True">
                                    <Canvas.Resources>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="StrokeThickness" Value="1" />
                                        </Style>
                                    </Canvas.Resources>

                                    <ItemsControl ItemsSource="{Binding ArcPathGeometry}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas IsItemsHost="True" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Canvas>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- 分割条 -->
                <GridSplitter Grid.Column="1" Width="3" Background="{StaticResource DividerColor}"
                              ResizeBehavior="PreviousAndNext" />

                <!-- 右侧：点胶操作面板 -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="6,10,12,10">
                        <!-- 点胶操作 -->
                        <materialDesign:Card Style="{StaticResource PanelCard}">
                            <StackPanel Margin="12,10">
                                <Border Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="VectorCurve" Width="16" Height="16"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Foreground="{StaticResource PrimaryBlue}" />
                                        <TextBlock Text="{lang:Lang DispensingOperation}" FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding SiteFeatureNames}"
                                              SelectedItem="{Binding SelectedSiteFeatureName}"
                                              materialDesign:HintAssist.Hint="{lang:Lang VisionCapture_Hint_SiteFeature}" FontSize="12" Margin="0,0,6,0" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Source={StaticResource RunModeValues}}"
                                              SelectedItem="{Binding CurrentRunMode}"
                                              materialDesign:HintAssist.Hint="{lang:Lang VisionCapture_Hint_RunMode}" FontSize="12" />
                                </Grid>

                                <CheckBox Content="{lang:Lang VisionCapture_NeedleDescend}"
                                          IsChecked="{Binding NeedleDescend}"
                                          Margin="0,0,0,8" FontSize="12"
                                          ToolTip="{lang:Lang VisionCapture_NeedleDescendTooltip}" />

                                <WrapPanel Margin="0,0,0,4">
                                    <Button Command="{Binding PreviewMachinePointsCommand}"
                                            Style="{StaticResource CompactOutlinedButton}" Margin="0,0,6,4"
                                            ToolTip="{lang:Lang VisionCapture_PreviewTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="MapMarkerPath" Width="14" Height="14"
                                                                     VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{lang:Lang VisionCapture_Preview}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ExecuteDispenseCommand}"
                                            Style="{StaticResource CompactButton}" Margin="0,0,6,4"
                                            Background="{StaticResource PrimaryBlue}" Foreground="White"
                                            ToolTip="{lang:Lang VisionCapture_ExecuteTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Play" Width="14" Height="14"
                                                                     VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{lang:Lang Execute}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding PauseCommand}"
                                            Style="{StaticResource CompactButton}" Margin="0,0,6,4"
                                            Background="{StaticResource WarningAmber}" Foreground="White"
                                            Visibility="{Binding IsArcMode, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{lang:Lang VisionCapture_PauseTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Pause" Width="14" Height="14"
                                                                     VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{lang:Lang Flow_Pause}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ResumeCommand}"
                                            Style="{StaticResource CompactButton}" Margin="0,0,6,4"
                                            Background="{StaticResource SuccessGreen}" Foreground="White"
                                            Visibility="{Binding IsArcMode, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{lang:Lang VisionCapture_ResumeTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Play" Width="14" Height="14"
                                                                     VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{lang:Lang Continue}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding StopCommand}"
                                            Style="{StaticResource CompactButton}" Margin="0,0,0,4"
                                            Background="{StaticResource DangerRed}" Foreground="White"
                                            ToolTip="{lang:Lang VisionCapture_StopTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Stop" Width="14" Height="14"
                                                                     VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBlock Text="{lang:Lang Stop}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- 点胶工艺参数（与 Step3EditParamsPanel 对齐：三列彩色分组） -->
                        <materialDesign:Card Style="{StaticResource PanelCard}" Margin="0,0,0,0"
                                             Visibility="{Binding HasSelectedRow, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="12,10">
                                <Border Style="{StaticResource SectionHeader}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Tune" Width="16" Height="16"
                                                                 VerticalAlignment="Center" Margin="0,0,6,0"
                                                                 Foreground="{StaticResource PrimaryBlue}" />
                                        <TextBlock Text="{lang:Lang VisionCapture_ProcessParams}" FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                </Border>

                                <!-- 双针头选择器（与 Step3EditParamsPanel 对齐） -->
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <TextBlock Text="{lang:Lang VisionCapture_NeedleSelect}" VerticalAlignment="Center"
                                               FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource TextSecondary}" />
                                    <RadioButton Content="{lang:Lang VisionCapture_Needle1}" IsChecked="{Binding IsNeedle1Selected}"
                                                 GroupName="VisionCaptureNeedleSelector" FontSize="12" Margin="0,0,16,0" />
                                    <RadioButton Content="{lang:Lang VisionCapture_Needle2}" IsChecked="{Binding IsNeedle2Selected}"
                                                 GroupName="VisionCaptureNeedleSelector" FontSize="12" />
                                </StackPanel>

                                <!-- Dot(单点)模式工艺参数：绑定 CurrentDotParams（按当前针头） -->
                                <Grid Visibility="{Binding IsDotMode, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 第一组：运动参数（蓝色） -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#1565C0"
                                                   Text="{lang:Lang Step3_Group_MotionParams}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Step3_Label_MoveSpeed}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.MoveSpeed, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="mm/s" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Step3_Label_SafeHeight}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.SafeHeight, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang Step3_Label_ApproachHeight}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.ApproachHeight, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{lang:Lang Step3_Label_DecelFactor}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.CornerDecel, StringFormat=F2, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Grid.Column="1" Width="1" Background="#FFE0E4E8" Margin="0,4"/>

                                    <!-- 第二组：出胶控制（琥珀色） -->
                                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                        <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#F57C00"
                                                   Text="{lang:Lang Step3_Group_DispenseControl}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Step3_Label_DispenseTime}" FontSize="11" Foreground="#F57C00" FontWeight="Medium" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.DispenseTime, StringFormat=F0, UpdateSourceTrigger=LostFocus}" BorderBrush="#FFCC80" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="ms" FontSize="11" Foreground="#F57C00" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Step3_Label_GlueTriggerOffset}" FontSize="11" Foreground="#F57C00" FontWeight="Medium" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.DotGlueTriggerOffsetMm, StringFormat=F2, UpdateSourceTrigger=LostFocus}" BorderBrush="#FFCC80" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" FontSize="11" Foreground="#F57C00" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang Step3_Label_PreDispenseDelay}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.PreDispenseDelay, StringFormat=F0, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="ms" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{lang:Lang Step3_Label_PostDelay}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.PostDelay, StringFormat=F0, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="ms" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Grid.Column="3" Width="1" Background="#FFE0E4E8" Margin="0,4"/>

                                    <!-- 第三组：高度参数（青色） -->
                                    <StackPanel Grid.Column="4" Margin="8,0,0,0">
                                        <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#00838F"
                                                   Text="{lang:Lang Step3_Group_HeightParams}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Step3_Label_TeachHeight}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.TeachHeight, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11" MinHeight="24"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Step3_Label_HeightCompensation}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.HeightCompensation, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11" MinHeight="24"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang Step3_Label_EffectiveHeight}" FontSize="11" Foreground="#757575" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentDotParams.EffectiveZHeight, StringFormat=F3}" VerticalAlignment="Center" Foreground="#424242" FontWeight="Medium" FontSize="11"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" FontSize="11" Foreground="#757575" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{lang:Lang Step3_Label_XyCompensationX}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"
                                                       ToolTip="{lang:Lang VisionCapture_Tip_XyOffset}"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.XyCompensationX, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11" MinHeight="24"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{lang:Lang Step3_Label_XyCompensationY}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"
                                                       ToolTip="{lang:Lang VisionCapture_Tip_XyOffset}"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentDotParams.XyCompensationY, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11" MinHeight="24"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <!-- 路径(连续插补)模式工艺参数：绑定 CurrentArcParams（按当前针头） -->
                                <Grid Visibility="{Binding IsArcMode, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 第一组：运动参数（蓝色） -->
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#1565C0"
                                                   Text="{lang:Lang Step3_Group_MotionParams}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Step3_Label_MoveSpeed}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.MoveSpeed, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="mm/s" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Step3_Label_SafeHeight}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.SafeHeight, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang Step3_Label_ApproachHeight}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.ApproachHeight, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{lang:Lang Step3_Label_DecelFactor}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.CornerDecel, StringFormat=F2, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{lang:Lang Step3_Label_InterpolationSpeed}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.InterpSpeed, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="mm/s" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Grid.Column="1" Width="1" Background="#FFE0E4E8" Margin="0,4"/>

                                    <!-- 第二组：出胶控制（琥珀色） -->
                                    <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                        <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#F57C00"
                                                   Text="{lang:Lang Step3_Group_DispenseControl}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Step3_Label_GlueTriggerOffset}" FontSize="11" Foreground="#F57C00" FontWeight="Medium" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.GlueTriggerOffsetMm, StringFormat=F1, UpdateSourceTrigger=LostFocus}" BorderBrush="#FFCC80" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" FontSize="11" Foreground="#F57C00" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Step3_Label_PreDelay}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.PreDelay, StringFormat=F1, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang Step3_Label_EarlyCloseGlueDelay}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.EarlyCloseGlueDelayMs, StringFormat=F0, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="ms" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{lang:Lang Step3_Label_PostDelay}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.PostDelay, StringFormat=F0, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="ms" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Grid.Column="3" Width="1" Background="#FFE0E4E8" Margin="0,4"/>

                                    <!-- 第三组：高度参数（青色） -->
                                    <StackPanel Grid.Column="4" Margin="8,0,0,0">
                                        <TextBlock FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" Foreground="#00838F"
                                                   Text="{lang:Lang Step3_Group_HeightParams}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang Step3_Label_TeachHeight}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.TeachHeight, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11" MinHeight="24"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang Step3_Label_HeightCompensation}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.HeightCompensation, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11" MinHeight="24"/>
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{lang:Lang Step3_Label_EffectiveHeight}" FontSize="11" Foreground="#757575" VerticalAlignment="Center" Margin="0,2,8,0"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CurrentArcParams.EffectiveZHeight, StringFormat=F3}" VerticalAlignment="Center" Foreground="#424242" FontWeight="Medium" FontSize="11"/>
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="mm" FontSize="11" Foreground="#757575" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="{lang:Lang Step3_Label_XyCompensationX}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"
                                                       ToolTip="{lang:Lang VisionCapture_Tip_XyOffset}"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.XyCompensationX, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11" MinHeight="24"/>
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="{lang:Lang Step3_Label_XyCompensationY}" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center" Margin="0,2,8,0"
                                                       ToolTip="{lang:Lang VisionCapture_Tip_XyOffset}"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                     Text="{Binding CurrentArcParams.XyCompensationY, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Padding="4,2" FontSize="11" MinHeight="24"/>
                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="mm" FontSize="11" Foreground="#FF607D8B" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ========== 底部状态栏 ========== -->
        <StatusBar Grid.Row="2" Background="{StaticResource StatusBarBg}">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="11" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Foreground="#FFB0BEC5" FontSize="11" Text="{Binding GroupDisplay}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Foreground="#FFB0BEC5" FontSize="11" Text="{Binding ModeDisplay}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Foreground="#FFB0BEC5" FontSize="11" Text="{Binding PointsDisplay}" />
            </StatusBarItem>
            <!-- 文件管理：当前文件 + 加载/保存（移至底部工具栏） -->
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="FileDocumentOutline" Width="14" Height="14"
                                             Foreground="#FFB0BEC5" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding CurrentFileName, Mode=OneWay}" Foreground="#FFE0E0E0" FontSize="11"
                               VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" Margin="0,0,6,0" />
                    <Button Command="{Binding LoadConfigCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Padding="6,2" FontSize="10"
                            ToolTip="{lang:Lang VisionCapture_LoadFile}">
                        <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" />
                    </Button>
                    <Button Command="{Binding SaveConfigCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Padding="6,2" FontSize="10"
                            ToolTip="{lang:Lang VisionCapture_SaveFile}">
                        <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" />
                    </Button>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{lang:Lang VisionCapture_PrevStep}" Command="{Binding GoPrevCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Padding="8,2" FontSize="11" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <TextBlock Text="{lang:Lang VisionCapture_Label_CurrentStep}" Foreground="#FFB0BEC5" FontSize="11"/>
                        <TextBlock Text="{Binding CurrentStepTitle}" Foreground="#FF80CBC4"
                                   Margin="4,0,0,0" FontSize="11" FontWeight="Medium"/>
                    </StackPanel>
                    <Button Content="{lang:Lang NextStep}" Command="{Binding GoNextCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Padding="8,2" FontSize="11" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
