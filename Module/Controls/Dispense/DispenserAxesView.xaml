<UserControl x:Class="Module.Views.DispenserAxesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             MinHeight="260">
    <materialDesign:Card UniformCornerRadius="12"
                         Margin="0,0,0,16"
                         Background="#F8F9FA">
        <!-- 浅灰背景与周围卡片区分 -->
        <StackPanel>
            <!-- 标题行 -->
            <!--<TextBlock Text="JOG &amp; HOMING (Dispenser Axes)"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                       Padding="16,12,16,0" />-->
            <!-- 内容区域 -->
            <StackPanel Margin="16,0,16,16">

                <!-- 表格头 -->
                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Axis" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Position" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Speed" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="Step Size" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Control" FontWeight="Bold" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- 数据行（ItemsControl） -->
                <ItemsControl ItemsSource="{Binding Axes}" Margin="0,4,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding AxisName}" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center">
                                    <Run Text="{Binding Position, StringFormat=F3}" /><Run Text=" " /><Run Text="{Binding Unit}" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Center">
                                    <Run Text="{Binding Speed, StringFormat=F1}" /><Run Text=" " /><Run Text="{Binding SpeedUnit}" />
                                </TextBlock>
                                <TextBlock Grid.Column="3" HorizontalAlignment="Center">
                                    <Run Text="{Binding StepSize, StringFormat=F2}" /><Run Text=" " /><Run Text="{Binding Unit}" />
                                </TextBlock>
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="-" Width="30" Margin="2,0" Padding="0"
                                            Command="{Binding MoveNegativeCommand}" />
                                    <Button Content="+" Width="30" Margin="2,0" Padding="0"
                                            Command="{Binding MovePositiveCommand}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 按钮行 -->
                <WrapPanel Margin="0,8,0,0">
                    <Button Command="{Binding HomeCommand}"
                            Padding="16,6"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Home" Width="16" Height="16" Margin="0,0,4,0" />
                            <TextBlock Text="{lang:Lang Home}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding EmergencyStopCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Background="#FFD32F2F"
                            Foreground="White"
                            Padding="16,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertOctagon" Width="16" Height="16" Margin="0,0,4,0" />
                            <TextBlock Text="{lang:Lang Emergency}" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</UserControl>