<UserControl x:Class="Module.Views.AssemblyAxesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             MinHeight="450">
    <materialDesign:Card UniformCornerRadius="12"
                         Margin="0,0,0,16"
                         Background="#F8F9FA">
        <StackPanel>
            <TextBlock Text="JOG &amp; HOMING (Assembly Axes)"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                       Padding="16,12,16,0" />

            <StackPanel Margin="16,0,16,16">
                <!-- 全局速度设置 -->
                <WrapPanel Margin="0,0,0,12">
                    <TextBlock Text="Global Speed:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider Width="200"
                            Value="{Binding GlobalSpeed}"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0" />
                    <TextBox Text="{Binding GlobalSpeed, UpdateSourceTrigger=LostFocus}"
                             Width="50"
                             VerticalAlignment="Center"
                             Margin="0,0,4,0" />
                    <TextBlock Text="mm/s" VerticalAlignment="Center" />
                </WrapPanel>

                <!-- 轴表格 -->
                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Axis" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{lang:Lang Position}" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{lang:Lang AxisOp_JogSpeed}" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{lang:Lang AxisOp_JogStep}" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="Control" FontWeight="Bold" HorizontalAlignment="Center" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Axes}" Margin="0,4,0,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding AxisName}" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center">
                                    <Run Text="{Binding Position, StringFormat=F3}" /><Run Text=" mm" />
                                </TextBlock>
                                <TextBlock Grid.Column="2" HorizontalAlignment="Center">
                                    <Run Text="{Binding Speed, StringFormat=F1}" /><Run Text=" mm/s" />
                                </TextBlock>
                                <ComboBox Grid.Column="3"
                                          Width="80"
                                          ItemsSource="{Binding StepSizeOptions}"
                                          SelectedItem="{Binding StepSize}"
                                          HorizontalAlignment="Center" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="-"
                                            Width="30"
                                            Margin="2,0"
                                            Padding="0"
                                            Command="{Binding MoveNegativeCommand}" />
                                    <Button Content="+"
                                            Width="30"
                                            Margin="2,0"
                                            Padding="0"
                                            Command="{Binding MovePositiveCommand}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 操作按钮 -->
                <WrapPanel HorizontalAlignment="Left" Margin="0,8,0,0">
                    <Button Command="{Binding HomeAllCommand}"
                            Padding="16,6"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Home" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{lang:Lang AssemblyStep_Button_HomeAll}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding EmergencyStopCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Background="#FFD32F2F"
                            Foreground="DarkRed"
                            Padding="16,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertOctagon" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="{lang:Lang AxisOp_EmergencyStopAll}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </materialDesign:Card>
</UserControl>