<UserControl x:Class="Module.Views.ZScanDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:Module.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:uc="clr-namespace:ModuleCore.UserControls;assembly=ModuleCore"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="1150" VerticalAlignment="Top">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Pass">
                    <Setter Property="Foreground" Value="#2E7D32"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Fail">
                    <Setter Property="Foreground" Value="#D32F2F"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Pending">
                    <Setter Property="Foreground" Value="#9E9E9E"/>
                </DataTrigger>
            </Style.Triggers>
            <Setter Property="Foreground" Value="#9E9E9E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: 运动控制按钮组 + 针头选择 + 通讯方式 ═══ -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8" Orientation="Horizontal">
            <!-- 3D扫描按钮（主色调） -->
            <Button Command="{Binding Start3DScanCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Padding="16,6"
                    ToolTip="{lang:Lang ZScanDetail_Start3DScan}"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlayArrow" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{lang:Lang ZScanDetail_3DScan}" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <!-- 停止按钮（警告色） -->
            <Button Command="{Binding StopCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Background="#D32F2F"
                    BorderBrush="#B71C1C"
                    Padding="16,6"
                    ToolTip="{lang:Lang ZScanDetail_EmergencyStop}"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{lang:Lang ZScanDetail_Stop}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Button>

            <!-- 回待机位按钮（轴运动图标） -->
            <Button Command="{Binding ReturnToStandbyCommand}"
                    Padding="16,6"
                    ToolTip="{lang:Lang ZScanDetail_ReturnStandby}"
                    Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AxisArrow" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{lang:Lang ZScanDetail_ReturnStandbyBtn}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Separator Width="1" Margin="4,0" VerticalAlignment="Stretch" />

            <!-- 针头选择 -->
            <StackPanel Orientation="Horizontal" Margin="12,0">
                <TextBlock Text="{lang:Lang ZScanDetail_NeedleSelector}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBodyLight}" FontWeight="Medium" FontSize="12" />
                <RadioButton Content="Dz1" GroupName="NeedleSelector"
                     IsChecked="{Binding CurrentNeedleIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=0}"
                     Margin="0,0,8,0" FontSize="12" />
                <RadioButton Content="Dz2" GroupName="NeedleSelector"
                     IsChecked="{Binding CurrentNeedleIndex, Converter={StaticResource IntToBoolConverter}, ConverterParameter=1}"
                     FontSize="12" />
            </StackPanel>

            <Separator Width="1" Margin="4,0" VerticalAlignment="Stretch" />

            <!-- 通讯方式 -->
            <TextBlock Text="{lang:Lang ZScanDetail_CommMethod}" VerticalAlignment="Center" Margin="16,0,8,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
            <ComboBox ItemsSource="{Binding CommunicationTypes}"
                      SelectedItem="{Binding SelectedCommunicationType}"
                      Width="120"
                      VerticalAlignment="Center"
                      materialDesign:HintAssist.Hint="{lang:Lang ZScanDetail_SelectCommMethod}"
                      Margin="0,0,12,0" />

            <!-- TCP连接名称（仅 TCPIP 时显示） -->
            <ComboBox ItemsSource="{Binding TcpConnections}"
                      SelectedItem="{Binding SelectedConnectionName}"
                      Width="160"
                      VerticalAlignment="Center"
                      materialDesign:HintAssist.Hint="{lang:Lang ZScanDetail_TcpConnName}"
                      IsEditable="True"
                      Visibility="{Binding IsTcpSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <!-- ═══ Row 1: 扫描速度设置 ═══ -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal">
            <!-- 扫描速度（Dx轴运动速度，范围10-60mm/s） -->
            <TextBlock Text="{lang:Lang ZScanDetail_ScanSpeed}" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" FontWeight="Medium" />
            <materialDesign:DecimalUpDown Value="{Binding ScanSpeed, Mode=TwoWay}"
                                  Minimum="10" Maximum="60" ValueStep="1"
                                  Width="90" VerticalAlignment="Center" FontSize="12"
                                  materialDesign:HintAssist.Hint="{lang:Lang ZScanDetail_ScanSpeedHint}" />
            <TextBlock Text="{Binding ScanSpeedDisplay}" VerticalAlignment="Center" Margin="6,0,0,0" FontSize="11" Foreground="#1565C0" FontWeight="SemiBold" />
        </StackPanel>

        <!-- ═══ Row 2: 表格管理工具栏 ═══ -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="4" BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1" Padding="10,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{lang:Lang ZScanDetail_Table}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <ComboBox ItemsSource="{Binding Tables}"
                          SelectedItem="{Binding SelectedTable}"
                          DisplayMemberPath="TableName"
                          Width="150"
                          VerticalAlignment="Center"
                          materialDesign:HintAssist.Hint="{lang:Lang ZScanDetail_SelectTable}"
                          Margin="0,0,6,0" />
                <Button Command="{Binding AddTableCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Width="28" Height="28"
                        ToolTip="{lang:Lang ZScanDetail_NewTable}"
                        VerticalAlignment="Center" Margin="0,0,4,0">
                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" />
                </Button>
                <Button Command="{Binding DeleteTableCommand}"
                        Style="{StaticResource MaterialDesignIconButton}"
                        Width="28" Height="28"
                        ToolTip="{lang:Lang ZScanDetail_DeleteTable}"
                        VerticalAlignment="Center" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" />
                </Button>

                <Separator Width="1" Margin="4,0" VerticalAlignment="Stretch" />

                <Button Command="{Binding SaveConfigCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="8,4"
                        ToolTip="{lang:Lang ZScanDetail_SaveConfig}"
                        VerticalAlignment="Center" Margin="8,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{lang:Lang ZScanDetail_SaveConfigBtn}" VerticalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding LoadConfigCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="8,4"
                        ToolTip="{lang:Lang ZScanDetail_LoadConfig}"
                        VerticalAlignment="Center" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpenOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock Text="{lang:Lang ZScanDetail_LoadConfigBtn}" VerticalAlignment="Center" FontSize="11" />
                    </StackPanel>
                </Button>
                <Separator Width="1" Margin="8,0" VerticalAlignment="Stretch" />
                <materialDesign:PackIcon Kind="FileOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="4,0,4,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="{Binding CurrentFilePath}" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- ═══ Row 3: 标定区域（独立） ═══ -->
        <GroupBox Grid.Row="3" Header="{lang:Lang ZScanDetail_CalibrationSection}"
                  Margin="0,0,0,8">
            <GroupBox.HeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CrosshairsGps" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="Medium" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </GroupBox.HeaderTemplate>
            <StackPanel>
                <WrapPanel Margin="0,0,0,6">
                    <materialDesign:PackIcon Kind="Numeric1Circle" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#1565C0" />
                    <TextBlock Text="{lang:Lang ZScanDetail_Step1_BaseZ}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" FontSize="12" />
                    <TextBox Text="{Binding BaseZInput, StringFormat=F3, UpdateSourceTrigger=LostFocus}" Width="80" VerticalAlignment="Center" FontSize="12"
                             materialDesign:HintAssist.Hint="{lang:Lang ZScanDetail_3DCameraHeight}" Margin="0,0,8,0" />
                </WrapPanel>

                <WrapPanel Margin="0,0,0,6">
                    <materialDesign:PackIcon Kind="Numeric2Circle" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#2E7D32" />
                    <TextBlock Text="{lang:Lang ZScanDetail_Step2_MoveNeedle}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" FontSize="12" />
                    <!--<Button Command="{Binding MoveNeedleToBaseZCommand}"
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Padding="8,4" FontSize="11"
                            Content="{lang:Lang ZScanDetail_MoveNeedleBtn}" />-->
                </WrapPanel>

                <WrapPanel Margin="0,0,0,6">
                    <materialDesign:PackIcon Kind="Numeric3Circle" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#E65100" />
                    <TextBlock Text="{lang:Lang ZScanDetail_Step3_TeachMZ}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" FontSize="12" />
                    <TextBlock Text="{lang:Lang ZScanDetail_MZ}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <Border Background="#E8F5E9" CornerRadius="3" Padding="6,2" Margin="0,0,12,0">
                        <TextBlock Text="{Binding MeasuredMZ, StringFormat=F3}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="#2E7D32" />
                    </Border>
                    <Button Command="{Binding TeachNeedleMZCommand}"
                            Padding="8,4" FontSize="11"
                            ToolTip="{lang:Lang ZScanDetail_TeachNeedleHeight}"
                            Content="{lang:Lang ZScanDetail_TeachMZBtn}" Margin="0,0,8,0" />
                </WrapPanel>

                <WrapPanel Margin="0,0,0,6">
                    <materialDesign:PackIcon Kind="Numeric4Circle" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#6A1B9A" />
                    <TextBlock Text="{lang:Lang ZScanDetail_Step4_CurrentZ}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Medium" FontSize="12" />
                    <TextBlock Text="{lang:Lang ZScanDetail_CurrentZHeight}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBox Text="{Binding CurrentZHeightInput, StringFormat=F3}" Width="80" VerticalAlignment="Center" FontSize="12"
                             materialDesign:HintAssist.Hint="{lang:Lang ZScanDetail_3DCameraHeight}" Margin="0,0,8,0" />
                    <TextBlock Text="{lang:Lang ZScanDetail_NeedleComp}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                    <TextBox Text="{Binding NeedleCompensationValue, StringFormat=F3}" Width="65" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
                    <Button Command="{Binding CalculateDispenseHeightCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Padding="8,4" FontSize="11" MinWidth="65"
                            Content="{lang:Lang ZScanDetail_CalcBtn}" Margin="0,0,8,0" />
                    <TextBlock Text="{lang:Lang ZScanDetail_ZHeightDiff}" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="#E65100" FontWeight="Medium" />
                    <Border Background="#FFF3E0" CornerRadius="3" Padding="6,2" Margin="0,0,12,0" MinWidth="50">
                        <TextBlock Text="{Binding ZHeightDifference, StringFormat=+0.000;-0.000;0.000}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="#E65100" />
                    </Border>
                    <TextBlock Text="{lang:Lang ZScanDetail_DispenseHeight}" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#1565C0" FontWeight="Medium" />
                    <Border Background="#E3F2FD" CornerRadius="3" Padding="8,3" MinWidth="50">
                        <TextBlock Text="{Binding CalculatedDispenseHeight, StringFormat=F3}" VerticalAlignment="Center" FontWeight="Bold" FontSize="13" Foreground="#0D47A1" />
                    </Border>
                </WrapPanel>

                <WrapPanel>
                    <Button Command="{Binding ResetCalibrationCommand}"
                            Padding="8,4" MinWidth="65"
                            ToolTip="{lang:Lang ZScanDetail_ResetCalibration}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="{lang:Lang ZScanDetail_ResetCalibrationBtn}" VerticalAlignment="Center" FontSize="11" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <!-- ═══ Row 4: 统计信息栏 ═══ -->
        <Border Grid.Row="4"
                Background="{DynamicResource MaterialDesignCardBackground}"
                CornerRadius="4"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                Padding="12,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="ChartBar" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="{lang:Lang ZScanDetail_TotalPoints}" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                <TextBlock Text="{Binding TotalPoints}" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center" FontSize="12" />

                <Separator Width="1" Margin="0,2,0,2" VerticalAlignment="Stretch" />

                <TextBlock Text="{lang:Lang ZScanDetail_ZNominalRange}" Margin="12,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                <TextBlock Text="{Binding ZNominalRange}" Margin="0,0,20,0" VerticalAlignment="Center" FontSize="12" />

                <Separator Width="1" Margin="0,2,0,2" VerticalAlignment="Stretch" />

                <TextBlock Text="{lang:Lang ZScanDetail_ZMaxDelta}" Margin="12,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" />
                <TextBlock Text="{Binding ZMaxDelta, StringFormat=+0.000;-0.000;0.000}" FontWeight="Bold" Foreground="{Binding StatusColor}" Margin="0,0,12,0" VerticalAlignment="Center" FontSize="12" />

                <Border Background="{Binding StatusColor}" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Foreground="White" FontSize="11" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══ Row 5: 数据表格 ═══ -->
        <DataGrid x:Name="PointsDataGrid" Grid.Row="5"
                  ItemsSource="{Binding PointDetails}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False" CanUserSortColumns="True"
                  SelectionMode="Single"
                  SelectedItem="{Binding SelectedPointDetail}"
                  materialDesign:DataGridAssist.CellPadding="4"
                  Margin="0,0,0,8"
                  RowHeaderWidth="30"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pt #" Binding="{Binding PointNumber}" Width="55" IsReadOnly="True" />
                <DataGridTextColumn Header="X (pcs)" Binding="{Binding X, StringFormat=F3}" Width="80" />
                <DataGridTextColumn Header="Y (pcs)" Binding="{Binding Y, StringFormat=F3}" Width="80" />
                <DataGridTemplateColumn Header="Z_actual" Width="90" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ZMeasured, StringFormat=F3}" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="Link" Width="12" Height="12"
                                    Foreground="#1565C0" VerticalAlignment="Center" Margin="2,0,0,0"
                                    Visibility="{Binding IsZActualLinked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ΔZ" Width="90" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DeltaZ, StringFormat=+0.000;-0.000;0.000}" VerticalAlignment="Center"/>
                                <materialDesign:PackIcon Kind="Link" Width="12" Height="12"
                                    Foreground="#1565C0" VerticalAlignment="Center" Margin="2,0,0,0"
                                    Visibility="{Binding IsGlobalVarLinked, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Description" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Description}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Nominal" Binding="{Binding Nominal, StringFormat=F3}" Width="80" />
                <DataGridTextColumn Header="Range" Binding="{Binding Range, StringFormat=F3}" Width="75" />

                <DataGridTemplateColumn Header="Type" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.DataFormatOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding PointType, UpdateSourceTrigger=PropertyChanged}"
                                      FontSize="11" Padding="2,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="GV Link" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <uc:GlobalVariableLinkControl
                                DisplayValue="{Binding DeltaZ}"
                                DisplayForeground="#1565C0"
                                IsLinked="{Binding IsGlobalVarLinked, Mode=OneWay}"
                                LinkedVariableName="{Binding LinkedGlobalVarName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                LinkableGlobalVariables="{Binding DataContext.AvailableGlobalVariables, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                UnlinkCommand="{Binding DataContext.UnlinkRowGlobalVariableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ComboBoxWidth="160" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Status" Width="75">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusTextStyle}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ═══ Row 6: 底部操作按钮区 ═══ -->
        <WrapPanel Grid.Row="6" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Command="{Binding AddRowCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    ToolTip="{lang:Lang ZScanDetail_AddRow}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{lang:Lang ZScanDetail_AddRowBtn}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Command="{Binding DeleteSelectedRowCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    ToolTip="{lang:Lang ZScanDetail_DeleteSelected}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="DeleteOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{lang:Lang ZScanDetail_DeleteSelectedBtn}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Command="{Binding ImportCSVCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    ToolTip="{lang:Lang ZScanDetail_ImportCSV}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileUploadOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{lang:Lang ZScanDetail_ImportCSVBtn}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Command="{Binding ExportCSVCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Padding="12,4"
                    Margin="0,0,8,0"
                    ToolTip="{lang:Lang ZScanDetail_ExportCSV}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FileDownloadOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{lang:Lang ZScanDetail_ExportCSVBtn}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

        </WrapPanel>
    </Grid>
</UserControl>