<UserControl x:Class="Framework.Views.ControlPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Framework"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:enums="clr-namespace:Interfaces.SharedInterfaces;assembly=Interfaces"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1000">
    <!-- 添加滚动视图支持 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- 系统选择器 -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0 0 0 16">
            <TextBlock Text="选择系统:"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0 0 8 0" />

            <ComboBox ItemsSource="{Binding SystemOptions}"
                      SelectedItem="{Binding SelectedSystem}"
                      DisplayMemberPath="Name"
                      Width="120"
                      Margin="0 0 16 0" />
            <TextBlock Text="当前系统状态:"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="16 0 8 0" />

            <Ellipse Width="12"
                     Height="12"
                     Fill="{Binding StatusColor}"
                     Stroke="DarkGray"
                     StrokeThickness="1"
                     VerticalAlignment="Center"
                     ToolTip="系统状态指示灯" />

            <TextBlock Text="{Binding StatusText}"
                       Margin="8 0 0 0"
                       VerticalAlignment="Center"
                       FontWeight="Medium" />
        </StackPanel>
        
        <!-- 标题栏 -->
        <TextBlock Grid.Row="1"
                   Text="龙门同步控制面板"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0 0 0 16" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 目标位置设置 -->
                <materialDesign:Card Margin="8"
                                     Padding="16"
                                     Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="目标位置设置"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0 0 0 8" />

                        <Separator Margin="0 8" />

                        <StackPanel Orientation="Horizontal"
                                    Margin="0 8">
                            <TextBlock Text="选择目标："
                                       Width="80"
                                       VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding GantryTypes}"
                                      SelectedItem="{Binding SelectedGantryType}"
                                      materialDesign:HintAssist.Hint="选择龙门"
                                      Width="160" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0 16">
                            <TextBlock Text="目标X："
                                       Width="80"
                                       VerticalAlignment="Center" />
                            <TextBox materialDesign:HintAssist.Hint="X坐标 (mm)"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Width="200"
                                     Text="{Binding TargetX}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0 16">
                            <TextBlock Text="目标Y："
                                       Width="80"
                                       VerticalAlignment="Center" />
                            <TextBox materialDesign:HintAssist.Hint="Y坐标 (mm)"
                                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                                     Width="200"
                                     Text="{Binding TargetY}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0 16">
                            <TextBlock Text="移动速度："
                                       Width="80"
                                       VerticalAlignment="Center" />
                            <Slider Minimum="1"
                                    Maximum="100"
                                    Value="{Binding MoveSpeed}"
                                    Width="200"
                                    Margin="0 16"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="5" />
                            <TextBlock Text="{Binding MoveSpeed, StringFormat={}{0:0} mm/s}"
                                       Margin="16 0 0 0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryHueDarkBrush}" />
                        </StackPanel>

                        <Button Content="移动到目标"
                                Command="{Binding MoveToTargetCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0 24 0 0"
                                materialDesign:ButtonAssist.CornerRadius="4"
                                Height="40" />

                        <TextBlock Text="龙门手动操作"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0 10 0 8" />
                        <Separator Margin="0 8"
                                   Grid.Row="0" />
                        <!-- Jog操作区 -->
                        <Grid Grid.Row="1"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 向上按钮 -->
                            <Button Grid.Row="0"
                                    Grid.Column="1"
                                    local:JogButtonHelper.IsJogControl="True"
                                    local:JogButtonHelper.JogDirectionEnum="{x:Static enums:JogDirection.Up}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="向上移动">
                                <materialDesign:PackIcon Kind="ArrowUpBold"
                                                         Width="34"
                                                         Height="34" />
                            </Button>

                            <!-- 向左按钮 -->
                            <Button Grid.Row="1"
                                    Grid.Column="0"
                                    local:JogButtonHelper.IsJogControl="True"
                                    local:JogButtonHelper.JogDirectionEnum="{x:Static enums:JogDirection.Left}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="向左移动">
                                <materialDesign:PackIcon Kind="ArrowLeftBold"
                                                         Width="34"
                                                         Height="34" />
                            </Button>

                            <!-- 停止按钮 -->
                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Command="{Binding StopJogCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    Background="{DynamicResource PrimaryHueMidBrush}"
                                    ToolTip="停止移动">
                                <materialDesign:PackIcon Kind="Stop"
                                                         Foreground="White"
                                                         Width="34"
                                                         Height="34" />
                            </Button>

                            <!-- 向右按钮 -->
                            <Button Grid.Row="1"
                                    Grid.Column="2"
                                    local:JogButtonHelper.IsJogControl="True"
                                    local:JogButtonHelper.JogDirectionEnum="{x:Static enums:JogDirection.Right}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="向右移动">
                                <materialDesign:PackIcon Kind="ArrowRightBold"
                                                         Width="34"
                                                         Height="34" />
                            </Button>

                            <!-- 向下按钮 -->
                            <Button Grid.Row="2"
                                    Grid.Column="1"
                                    local:JogButtonHelper.IsJogControl="True"
                                    local:JogButtonHelper.JogDirectionEnum="{x:Static enums:JogDirection.Down}"
                                    Style="{StaticResource MaterialDesignIconButton}"
                                    ToolTip="向下移动">
                                <materialDesign:PackIcon Kind="ArrowDownBold"
                                                         Width="34"
                                                         Height="34" />
                            </Button>
                        </Grid>

                        <!-- 位置显示 -->
                        <StackPanel Grid.Row="2"
                                    Orientation="Vertical"
                                    Margin="0 16 0 0">
                            <TextBlock Text="当前位置"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />

                            <Grid Margin="0 8"
                                  HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="上龙门:"
                                           Margin="0 0 8 0" />
                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding UpperPositionDisplay, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Width="120" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="下龙门:"
                                           Margin="0 8 8 0" />
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding LowerPositionDisplay, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Margin="0 8 0 0"
                                         Width="120" />
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0 16 0 0">
                                <TextBlock Text="Jog速度:"
                                           VerticalAlignment="Center"
                                           Margin="0 0 8 0" />
                                <Slider Minimum="1"
                                        Maximum="100"
                                        Value="{Binding JogSpeed}"
                                        Width="200"
                                        Margin="0 8"
                                        IsSnapToTickEnabled="True"
                                        TickFrequency="5" />
                                <TextBlock Text="{Binding JogSpeed, StringFormat={}{0:0}%}"
                                           Margin="8 0 0 0"
                                           VerticalAlignment="Center"
                                           MinWidth="40" />
                            </StackPanel>
                        </StackPanel>


                    </StackPanel>
                </materialDesign:Card>

                <!-- 同步控制 -->
                <materialDesign:Card Grid.Column="1"
                                     Margin="8"
                                     Padding="16">
                    <StackPanel>
                        <TextBlock Text="龙门同步控制"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0 0 0 8" />
                        <Separator Margin="0 8" />
                        <!-- 同步开关 -->
                        <StackPanel Orientation="Vertical"
                                    Margin="0 16"
                                    HorizontalAlignment="Center">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          Margin="0"
                                          IsChecked="{Binding IsSynchronizing}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SynchronizationStatus}"
                                               FontWeight="Bold"
                                               Margin="8 0 0 0" />
                                </StackPanel>
                            </ToggleButton>
                            <TextBlock Text="点击切换同步状态"
                                       HorizontalAlignment="Center"
                                       Opacity="0.7"
                                       Margin="0 4 0 0" />
                        </StackPanel>
                        <!-- 基准位置管理 -->
                        <Grid Margin="0 24 0 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal"
                                        Grid.Row="0"
                                        HorizontalAlignment="Center"
                                        Margin="0 0 0 8">
                                <TextBlock Text="基准位置管理"
                                           FontWeight="Bold"
                                           FontSize="14" />
                            </StackPanel>

                            <Grid Grid.Row="1"
                                  Margin="0 8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 上龙门基准位置 -->
                                <StackPanel Grid.Column="0"
                                            Margin="0 0 12 0">
                                    <TextBlock Text="上龙门基准:"
                                               Margin="0 0 0 4"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding UpperBasePosition}"
                                               FontWeight="Bold"
                                               MinWidth="120"
                                               Padding="4"
                                               Background="{DynamicResource PrimaryHueLightBrush}" />
                                </StackPanel>

                                <!-- 下龙门基准位置 -->
                                <StackPanel Grid.Column="1"
                                            Margin="12 0 0 0">
                                    <TextBlock Text="下龙门基准:"
                                               Margin="0 0 0 4"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding LowerBasePosition}"
                                               FontWeight="Bold"
                                               MinWidth="120"
                                               Padding="4"
                                               Background="{DynamicResource PrimaryHueLightBrush}" />
                                </StackPanel>

                                <!-- 记录基准按钮 -->
                                <Button Command="{Binding RecordBaseCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        materialDesign:ButtonAssist.CornerRadius="2"
                                        Grid.Column="2"
                                        Background="{DynamicResource PrimaryHueMidBrush}"
                                        Foreground="White"
                                        Margin="16 0 0 0"
                                        VerticalAlignment="Bottom"
                                        Width="120"
                                        Height="32">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BackupRestore"
                                                                 Height="20"
                                                                 Width="20"
                                                                 Margin="0 0 6 0"
                                                                 Foreground="White" />
                                        <TextBlock Text="记录基准" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- 高级操作 -->
                            <StackPanel Orientation="Horizontal"
                                        Grid.Row="2"
                                        HorizontalAlignment="Center"
                                        Margin="0 16 0 0">

                                <!-- 对齐操作 -->
                                <Button Content="基准对齐"
                                        Command="{Binding AlignGantryCommand}"
                                        ToolTip="执行基准位置对齐操作"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Width="120"
                                        Margin="0 0 16 0" />

                                <!-- 停止所有 -->
                                <Button Content="停止所有"
                                        Command="{Binding StopAllCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Width="120"
                                        Margin="0 0 16 0" />

                                <!-- 系统复位 -->
                                <Button Content="系统复位"
                                        Command="{Binding ResetSystemCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Width="120" />
                            </StackPanel>
                        </Grid>

                        <!-- 同步误差 -->
                        <StackPanel Margin="0 16 0 0"
                                    HorizontalAlignment="Center">
                            <TextBlock Text="当前同步误差"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding SyncError, StringFormat={}{0:F3} mm}"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryAccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </materialDesign:Card>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
