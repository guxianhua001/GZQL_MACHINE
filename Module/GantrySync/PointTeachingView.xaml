<UserControl x:Class="Framework.Views.PointTeachingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Framework.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:dv="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
             xmlns:vm="clr-namespace:Framework.ViewModels"
             xmlns:converters="clr-namespace:Framework.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="800">

    <UserControl.Resources>
        <!-- 添加转换器实例 -->
        <converters:BooleanInverseConverter x:Key="BooleanInverseConverter" />
        <converters:NullToBooleanConverter x:Key="NullToBooleanConverter" />
        <!-- 自定义按钮样式 -->
        <Style x:Key="CustomFlatButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Background"
                    Value="{DynamicResource MaterialDesign.Brush.Primary.Dark}" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="Padding"
                    Value="8 4" />
            <Setter Property="Margin"
                    Value="2" />
            <Setter Property="FontSize"
                    Value="14" />

            <!-- 覆盖悬停效果 -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Border x:Name="HoverOverlay"
                                    Background="Transparent"
                                    CornerRadius="2"
                                    SnapsToDevicePixels="True" />
                            <ContentPresenter x:Name="contentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="{TemplateBinding Padding}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 鼠标悬停时轻微加深颜色，而不是变透明 -->
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="HoverOverlay"
                                        Property="Background"
                                        Value="#20000000" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="HoverOverlay"
                                        Property="Background"
                                        Value="#40000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 删除按钮专用样式 -->
        <Style x:Key="DeleteButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CustomFlatButtonStyle}">
            <Setter Property="Background"
                    Value="{DynamicResource MaterialDesign.Brush.ValidationError}" />
        </Style>

        <Style TargetType="TextBox"
               BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="Margin"
                    Value="0 0 0 4" />
            <Setter Property="Width"
                    Value="110" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
        </Style>

        <Style TargetType="DataGridCell"
               BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="Padding"
                    Value="4" />
            <Setter Property="FontSize"
                    Value="14" />
        </Style>
    </UserControl.Resources>

    <!-- 使用 DockPanel 替代 Grid 提供更好的布局控制 -->
    <DockPanel LastChildFill="True">
        <!-- 顶部工具栏 -->
        <materialDesign:Card DockPanel.Dock="Top"
                             Margin="8"
                             Padding="8"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <TextBlock Text="当前系统: "
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0 0 8 0" />
                <ComboBox ItemsSource="{Binding AvailableSystems}"
                          SelectedItem="{Binding SelectedSystem}"
                          Width="120"
                          FontSize="16"
                          materialDesign:HintAssist.Hint="选择系统" />

                <Separator VerticalAlignment="Top"
                           Height="24"
                           Margin="16 0"
                           Style="{StaticResource MaterialDesignLightSeparator}" />

                <!-- 时间间隔设置 -->
                <TextBlock Text="测试间隔 (ms): "
                           FontSize="16"
                           VerticalAlignment="Center"
                           Margin="0 0 8 0" />
                <TextBox Text="{Binding TestInterval, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         Style="{StaticResource MaterialDesignTextBox}"
                         Width="100" />

                <Button Content="开始测试"
                        Margin  ="8"
                        Command="{Binding StartTestCommand}"
                        Style="{StaticResource CustomFlatButtonStyle}"
                        Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                        Foreground="White"
                        IsEnabled="{Binding IsTesting, Converter={StaticResource BooleanInverseConverter}}" />

                <Button Content="停止测试"
                        Command="{Binding CancelTestCommand}"
                        Style="{StaticResource CustomFlatButtonStyle}"
                        Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                        Foreground="White"
                        IsEnabled="{Binding IsTesting}" />
            </StackPanel>
        </materialDesign:Card>

        <!-- 底部按钮工具栏 -->
        <materialDesign:Card DockPanel.Dock="Top"
                             Margin="8"
                             Padding="8"
                             UniformCornerRadius="4"
                             materialDesign:ElevationAssist.Elevation="Dp2">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">
                <Button Content="增加点位"
                        Margin="5"
                        Command="{Binding AddPointCommand}"
                        Style="{StaticResource CustomFlatButtonStyle}"
                        Width="90"
                        Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                        Foreground="White">
                    <Button.ToolTip>
                        <ToolTip>添加一个新的点位记录</ToolTip>
                    </Button.ToolTip>
                </Button>

                <Button Content="删除"
                        Margin="5"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource DeleteButtonStyle}"
                        Width="70"
                        Background="{DynamicResource MaterialDesign.Brush.ValidationError}"
                        Foreground="White"
                        IsEnabled="{Binding SelectedPoint, Converter={StaticResource NullToBooleanConverter}}">
                    <Button.ToolTip>
                        <ToolTip>删除选中的点位记录</ToolTip>
                    </Button.ToolTip>
                </Button>

                <Button Content="保存"
                        Margin="5"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource CustomFlatButtonStyle}"
                        Width="70"
                        Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                        Foreground="White">
                    <Button.ToolTip>
                        <ToolTip>保存当前点位到文件</ToolTip>
                    </Button.ToolTip>
                </Button>

                <Button Content="导入"
                        Margin="5"
                        Command="{Binding ImportCommand}"
                        Style="{StaticResource CustomFlatButtonStyle}"
                        Width="70">
                    <Button.ToolTip>
                        <ToolTip>从文件导入点位</ToolTip>
                    </Button.ToolTip>
                </Button>

                <Button Content="导出"
                        Command="{Binding ExportCommand}"
                        Style="{StaticResource CustomFlatButtonStyle}"
                        Width="70">
                    <Button.ToolTip>
                        <ToolTip>导出点位到文件</ToolTip>
                    </Button.ToolTip>
                </Button>
                <StackPanel Orientation="Horizontal"
                            Margin="8 5">
                    <TextBlock Text="移动速度："
                               Width="80"
                               VerticalAlignment="Center" />
                    <Slider Minimum="1"
                            Maximum="100"
                            Value="{Binding MoveSpeed}"
                            Width="200"
                            Margin="0 8"
                            IsSnapToTickEnabled="True"
                            TickFrequency="5" />
                    <TextBlock Text="{Binding MoveSpeed, StringFormat={}{0:0} mm/s}"
                               Margin="16 0 0 0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PrimaryHueDarkBrush}" />
                </StackPanel>
            </StackPanel>
        </materialDesign:Card>

        <!-- 中间数据表格（带滚动） -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <DataGrid Margin="8"
                      Width="Auto"
                      ItemsSource="{Binding PointList}"
                      SelectedItem="{Binding SelectedPoint}"
                      CanUserResizeRows="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                      HeadersVisibility="All"
                      materialDesign:DataGridAssist.CellPadding="4 0"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="40"
                      VerticalGridLinesBrush="{DynamicResource MaterialDivider}"
                      HorizontalGridLinesBrush="{DynamicResource MaterialDivider}"
                      MinHeight="400">
                <DataGrid.Columns>
                    <!-- 名称列 -->
                    <DataGridTemplateColumn Header="名称"
                                            Width="150"
                                            MinWidth="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- 上龙门X -->
                    <DataGridTemplateColumn Header="上龙门X"
                                            Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UpperX, StringFormat={}{0:F2}}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding UpperX, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- 上龙门Y -->
                    <DataGridTemplateColumn Header="上龙门Y"
                                            Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UpperY, StringFormat={}{0:F2}}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding UpperY, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- 下龙门X -->
                    <DataGridTemplateColumn Header="下龙门X"
                                            Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LowerX, StringFormat={}{0:F2}}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding LowerX, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- 下龙门Y -->
                    <DataGridTemplateColumn Header="下龙门Y"
                                            Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LowerY, StringFormat={}{0:F2}}"
                                           VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding LowerY, UpdateSourceTrigger=PropertyChanged}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- 操作列 -->
                    <DataGridTemplateColumn Header="操作"
                                            Width="180"
                                            IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Content="示教"
                                            Command="{Binding DataContext.TeachCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            Style="{StaticResource CustomFlatButtonStyle}"
                                            Width="60"
                                            IsEnabled="{Binding DataContext.SelectedPoint, 
                                                RelativeSource={RelativeSource AncestorType={x:Type DataGrid}},
                                                Converter={StaticResource NullToBooleanConverter}}">
                                        <Button.ToolTip>
                                            <ToolTip>记录当前位置到当前行</ToolTip>
                                        </Button.ToolTip>
                                    </Button>

                                    <Button Content="移动"
                                            Command="{Binding DataContext.MoveToCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                            Style="{StaticResource CustomFlatButtonStyle}"
                                            Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                                            Foreground="White"
                                            Width="60"
                                            Margin="6 0 0 0"
                                            IsEnabled="{Binding DataContext.SelectedPoint, 
                                                RelativeSource={RelativeSource AncestorType={x:Type DataGrid}},
                                                Converter={StaticResource NullToBooleanConverter}}">
                                        <Button.ToolTip>
                                            <ToolTip>移动到当前行坐标</ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
        
    </DockPanel>
    
</UserControl>