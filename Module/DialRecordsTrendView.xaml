<UserControl x:Class="Framework.Views.DialRecordsTrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Framework.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:Framework.ViewModels"
             xmlns:local1="clr-namespace:ModuleCore.Views;assembly=ModuleCore"
             d:DataContext="{d:DesignInstance Type=viewmodels:OverViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource MaterialDesignPaper}"
          Margin="5">
        <TextBlock Text="实时力矩曲线"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,0,0,5"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="Black" />
        <!-- 图表区域 -->
        <Grid Grid.Row="1"
              Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- 图表1 -->
            <Border Grid.Row="0"
                    MinHeight="200"
                    MaxHeight="400"
                    Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 数值显示 -->
                    <StackPanel Grid.Row="0">
                        <!--<TextBlock Text="{Binding Encoder1Value}"
                        Style="{StaticResource MaterialDesignBody1TextBlock}" />-->
                        <ItemsControl ItemsSource="{Binding Analog1Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0:F3} N}"
                                               Margin="0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 图表显示 -->
                    <local:RealTimeChart Grid.Row="1"
                                         DataContext="{Binding TorqueChart1}" />
                </Grid>
            </Border>
            <!-- 图表2 -->
            <Border Grid.Row="2"
                    MinHeight="200"
                    Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 数值显示 -->
                    <StackPanel Grid.Row="0">
                        <!--<TextBlock Text="{Binding Encoder2Value}"
                        Style="{StaticResource MaterialDesignBody1TextBlock}" />-->
                        <ItemsControl ItemsSource="{Binding Analog2Inputs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat={}{0:F3} N}"
                                               Margin="0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 图表显示 -->
                    <local:RealTimeChart Grid.Row="1"
                                         DataContext="{Binding TorqueChart2}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
