<UserControl x:Class="Framework.Views.HistoricalTrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Framework.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:Framework.ViewModels"
             xmlns:local1="clr-namespace:ModuleCore.Views;assembly=ModuleCore"
             d:DataContext="{d:DesignInstance Type=viewmodels:OverViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid  Background="{StaticResource MaterialDesignPaper}"
           Margin="5">
        <TextBlock Text="力矩与位移曲线"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,0,0,5"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="Black" />
        <local:PlotView HorizontalAlignment="Stretch"
                        VerticalAlignment ="Stretch"
                        Height="auto"
                        Width="auto"
                        Margin="5,20,5,5"/>
    </Grid>
    
</UserControl>
