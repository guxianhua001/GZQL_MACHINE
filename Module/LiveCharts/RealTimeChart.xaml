<UserControl x:Class="Framework.Views.RealTimeChart"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Framework"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="GridLineBrush"
                             Color="#3F4F5F"
                             Opacity="0.3" />
            <Style TargetType="lvc:Separator">
                <Setter Property="IsEnabled"
                        Value="True" />
                <Setter Property="Stroke"
                        Value="#555555" />
                <Setter Property="StrokeThickness"
                        Value="0.5" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <lvc:CartesianChart Series="{Binding Series}"
                            LegendLocation="Right"
                            DisableAnimations="True">
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="时间 (秒)"
                          LabelFormatter="{Binding XFormatter}">
                    <!-- 添加X轴网格线 -->
                    <lvc:Axis.Separator>
                        <lvc:Separator Stroke="{DynamicResource GridLineBrush}"
                                       StrokeThickness="0.5"
                                       StrokeDashArray="2 2" />
                    </lvc:Axis.Separator>
                </lvc:Axis>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="力矩 (N)"
                          MinValue="{Binding AxisMin}"
                          MaxValue="{Binding AxisMax}"
                          LabelFormatter="{Binding YFormatter}">
                    <!-- 添加Y轴网格线 -->
                    <lvc:Axis.Separator>
                        <lvc:Separator Stroke="#335577"
                                       StrokeThickness="0.5" />
                    </lvc:Axis.Separator>
                </lvc:Axis>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>

    </Grid>
</UserControl>
