<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:vm="clr-namespace:Framework.ViewModels"
                    xmlns:views="clr-namespace:Framework.Views"
                    xmlns:conv="clr-namespace:Framework.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/LiveCharts.Wpf;component/Resources.xaml" />
        <materialDesign:BundledTheme BaseTheme="Light"
