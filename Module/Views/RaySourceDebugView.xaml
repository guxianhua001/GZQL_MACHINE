<UserControl x:Class="Framework.Views.RaySourceDebugView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Framework.Views"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <Style TargetType="ToggleButton"
               BasedOn="{StaticResource MaterialDesignFlatToggleButton}" />
        <Style TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Margin"
                    Value="5" />
            <Setter Property="Padding"
                    Value="10,5" />
            <Setter Property="MinWidth"
                    Value="120" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin"
                    Value="5" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin"
                    Value="5" />
            <Setter Property="materialDesign:HintAssist.Hint"
                    Value="请输入值" />
            <Setter Property="MinWidth"
                    Value="100" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin"
                    Value="5" />
            <Setter Property="MinWidth"
                    Value="100" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,15">
            <materialDesign:PackIcon Kind="Monitor"
                                     Width="30"
                                     Height="30"
                                     Margin="0,0,10,0"
                                     VerticalAlignment="Center" />
            <TextBlock Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                       Text="微焦射线源调试工具"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- 连接状态和操作 -->
        <Border Grid.Row="1"
                Style="{StaticResource MaterialDesignToolBarMainPanelBorderStyle}"
                CornerRadius="4"
                Padding="10"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           Text="通信设置"
                           Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="串口选择:" />
                    <ComboBox Grid.Row="0"
                              Grid.Column="1"
                              ItemsSource="{Binding AvailablePorts}"
                              SelectedItem="{Binding CommunicationService.PortName, Mode=TwoWay}"
                              materialDesign:HintAssist.Hint="选择串口" />

                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Content="连接"
                            Command="{Binding ConnectCommand}"
                            Margin="10,0" />

                    <Button Grid.Row="0"
                            Grid.Column="3"
                            HorizontalAlignment="Left"
                            Content="断开连接"
                            Command="{Binding DisconnectCommand}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="状态:" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Grid.ColumnSpan="3"
                               Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource MaterialDesignBody}"
                               FontWeight="Bold" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 通信控制和状态显示 -->
        <Grid Grid.Row="2"
              Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：通信命令区域 -->
            <Border Grid.Column="0"
                    Style="{StaticResource MaterialDesignToolBarMainPanelBorderStyle}"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.ColumnSpan="3"
                               Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                               Text="命令发送"
                               Margin="0,0,0,10" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="指令:" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="输入指令" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="参数:" />
                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Text="{Binding ParameterText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="输入参数" />

                    <Button Grid.Row="2"
                            Grid.Column="2"
                            Content="发送"
                            Command="{Binding SendCommand}"
                            Margin="5" />

                    <Separator Grid.Row="3"
                               Grid.ColumnSpan="3"
                               Margin="0,15,0,15"
                               Style="{StaticResource MaterialDesignLightSeparator}" />

                    <!-- 快速操作标题 -->
                    <TextBlock Grid.Row="4"
                               Grid.ColumnSpan="3"
                               Text="快速操作"
                               Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                               Margin="0,0,0,5" />

                    <!-- 第一排按钮 -->
                    <StackPanel Grid.Row="5"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Margin="0,20,0,5">
                        <!-- 添加底部间距 -->

                        <Button Content="开启射线 (XON)"
                                Command="{Binding TurnOnCommand}"
                                Margin="0,0,5,0" />

                        <Button Content="关闭射线 (XOF)"
                                Command="{Binding TurnOffCommand}"
                                Margin="0,0,5,0" />

                        <!-- 为电压添加输入框 -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="5,0,0,0">
                            <TextBlock Text="电压(kV):"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />
                            <TextBox Text="{Binding VoltageValue}"
                                     Width="60"
                                     Margin="0,0,5,0" />
                            <Button Content="设置 (HIV)"
                                    Command="{Binding SetVoltageCommand}"
                                    Margin="0,0,5,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 第二排按钮 -->
                    <StackPanel Grid.Row="6"
                                Grid.ColumnSpan="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Margin="0,60,0,0">
                        <!-- 添加上部间距 -->

                        <Button Content="自测 (TSF)"
                                Command="{Binding RunSelfTestCommand}"
                                Margin="0,0,5,0" />

                        <Button Content="复位保护 (RST)"
                                Command="{Binding ResetProtectionCommand}"
                                Margin="0,0,5,0" />

                        <!-- 为电流添加输入框 -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="5,0,0,0">
                            <TextBlock Text="电流(μA):"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0" />
                            <TextBox Text="{Binding CurrentValue}"
                                     Width="60"
                                     Margin="0,0,5,0" />
                            <Button Content="设置 (CUR)"
                                    Command="{Binding SetCurrentCommand}"
                                    Margin="0,0,5,0" />
                        </StackPanel>

                        <!-- 查询状态按钮 -->
                        <Button Content="查询状态 (STS)"
                                Command="{Binding QueryStatusCommand}"
                                Margin="5,0,0,0" />
                        <!-- 添加左侧间距 -->
                    </StackPanel>

                </Grid>
            </Border>

            <!-- 分隔线 -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch" />

            <!-- 右侧：通信日志区域 -->
            <Border Grid.Column="2"
                    Style="{StaticResource MaterialDesignToolBarMainPanelBorderStyle}"
                    CornerRadius="4"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Text="通信日志"
                                   VerticalAlignment="Center" />

                        <Button Grid.Column="1"
                                Content="清除日志"
                                Command="{Binding ClearLogCommand}"
                                HorizontalAlignment="Right"
                                Margin="10,0,0,0" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding CommunicationLog}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Padding="5"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2"
                               Text="微焦通讯协议与指令 V1.1 爱克斯瑞真空技术(苏州)有限公司"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0" />
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3"
                   Background="{DynamicResource MaterialDesignSecondaryHeader}">
            <ItemsControl ItemsSource="{Binding StatusBarItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StatusBarItem>
                            <StackPanel Orientation="Horizontal"
                                        Margin="5,0">
                                <ContentControl Content="{Binding}" />
                            </StackPanel>
                        </StatusBarItem>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StatusBar>
    </Grid>
</UserControl>

