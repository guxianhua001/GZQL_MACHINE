<UserControl x:Class="Module.Views.OverView"
	             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	             xmlns:prism="http://prismlibrary.com/"
	             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
	             xmlns:langView="clr-namespace:Language.Views;assembly=Language"
	             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MaterialDesignPaper}"
                 MinHeight="300"
                 MinWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- ============================================== -->
        <!-- 1. 顶部快捷操作栏 -->
        <!-- ============================================== -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesignCardBackground}" Padding="15,10" Margin="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.1" Direction="270"/>
            </Border.Effect>
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Border Background="#E8F5E9" CornerRadius="4" Padding="10,5" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding DoorColor}" Margin="0,0,5,0"/>
                            <TextBlock Text="{lang:Lang OverView_Door_Locked}" Foreground="#2E7D32" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#FFF3E0" CornerRadius="4" Padding="10,5" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding TrioLightColor}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding TrioLightText}" Foreground="#E65100" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#E3F2FD" CornerRadius="4" Padding="10,5" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Speedometer" Width="16" Height="16" Foreground="#1565C0" VerticalAlignment="Center" Margin="0,0,5,0"
                                                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"/>
                            <TextBlock Text="{Binding SpeedDisplayText}" Foreground="#1565C0" FontWeight="Medium" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Margin="0,0,10,0" Padding="15,8" Foreground="White" FontWeight="Medium" FontSize="14"
                            ToolTip="{lang:Lang OverView_Btn_WorkLight}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#757575" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#616161"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Lightbulb" Width="18" Height="18" Foreground="White" VerticalAlignment="Center"
                                                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Margin="0,0,6,0"/>
                            <TextBlock Text="{lang:Lang OverView_Btn_WorkLight}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="0,0,10,0" Padding="15,8" Foreground="White" FontWeight="Medium" FontSize="14"
                            ToolTip="{lang:Lang OverView_Btn_AirBlow}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#757575" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#616161"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="WeatherWindy" Width="18" Height="18" Foreground="White" VerticalAlignment="Center"
                                                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Margin="0,0,6,0"/>
                            <TextBlock Text="{lang:Lang OverView_Btn_AirBlow}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShowLogViewerCommand}" Margin="0,0,10,0" Padding="15,8" Foreground="White" FontWeight="Medium" FontSize="14"
                            ToolTip="{lang:Lang OverView_Btn_Log}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#546E7A" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#455A64"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocument" Width="18" Height="18" Foreground="White" VerticalAlignment="Center"
                                                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Margin="0,0,6,0"/>
                            <TextBlock Text="{lang:Lang OverView_Btn_Log}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <langView:LanguageSelectorView Margin="0,0,15,0" />
                    <TextBlock Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12"
                               Text="{Binding SystemTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ============================================== -->
        <!-- 2. 中部核心区域 -->
        <!-- ============================================== -->
        <Grid Grid.Row="1" Margin="10,10,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="8" Margin="0,0,5,0" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <ContentControl prism:RegionManager.RegionName="OverviewDeviceRegion" />
                    <TextBlock Text="{lang:Lang OverView_Placeholder_MainVisual}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" Foreground="{DynamicResource MaterialDesignBodyLight}" FontWeight="Bold" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource MaterialDesignBackground}" CornerRadius="8" Margin="5,0,0,0" Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1" Direction="270"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ContentControl Grid.Row="0" prism:RegionManager.RegionName="OverviewTaskMonitorRegion" />
                    <ContentControl Grid.Row="1" prism:RegionManager.RegionName="OverviewSpeedControlRegion" Margin="0,8,0,0"/>
                </Grid>
            </Border>
        </Grid>
        <!-- ============================================== -->
        <!-- 3. 底部流程控制栏 -->
        <!-- ============================================== -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignToolBarBackground}" Margin="0,10,0,0" Padding="20,15" CornerRadius="0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Command="{Binding ToggleSingleStepCommand}" Margin="0,0,10,0"
	                            Padding="20,10" Foreground="White" FontWeight="Bold" FontSize="14" Height="42"
                            Content="{Binding SingleStepButtonText}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#546E7A" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#455A64"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSingleStepMode}" Value="True">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" Background="#00897B" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#00796B"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{lang:Lang OverView_Btn_NextStep}" Command="{Binding StepNextCommand}" Margin="0,0,15,0"
	                            Padding="20,10" Foreground="White" FontWeight="Bold" FontSize="14" Height="42">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#00897B" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#00796B"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="bd" Property="Background" Value="#455A64"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <!-- 急停按钮已迁移至 MainWindow 右侧工具栏，保持统一布局 -->
            </Grid>
        </Border>
    </Grid>
</UserControl>
