<!-- NG穴位控件模板 NGPointControl.xaml -->
<UserControl x:Class="Framework.Views.NGPointControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Framework.Converters"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:CountToColorConverter x:Key="CountToColor" />
        <Style TargetType="Border"
               x:Key="FlashingBorder">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFlashing}"
                             Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <ColorAnimation From="Red"
                                                To="DarkRed"
                                                Duration="0:0:0.5"
                                                Storyboard.TargetProperty="Background.Color" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="5">
        <Border Style="{StaticResource FlashingBorder}"
            Background="{Binding IsActive, Converter={StaticResource CountToColor}}">
            <StackPanel>
                <TextBlock Text="{Binding QRCode}"
                       Width="40"
                       Height="20" />
                <TextBlock Text="{Binding Count}"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

