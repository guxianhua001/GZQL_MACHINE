<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off"
      internalLogFile="">

  <targets>
    <!-- Error 级别日志，单文件最大20MB -->
    <target xsi:type="File"
            name="fileError"
            fileName="${basedir}/Logs/${shortdate}/Error.log"
            archiveAboveSize="20971520"
            archiveFileName="${basedir}/Logs/${shortdate}/Error_{#}.log"
            archiveNumbering="Sequence"
            maxArchiveFiles="30"
            layout="${longdate} | ${level:padding=-5} | ${logger} | ${message} ${exception:format=tostring}"
            encoding="utf-8" />

    <!-- Warn 级别日志，单文件最大20MB -->
    <target xsi:type="File"
            name="fileWarn"
            fileName="${basedir}/Logs/${shortdate}/Warn.log"
            archiveAboveSize="20971520"
            archiveFileName="${basedir}/Logs/${shortdate}/Warn_{#}.log"
            archiveNumbering="Sequence"
            maxArchiveFiles="30"
            layout="${longdate} | ${level:padding=-5} | ${logger} | ${message} ${exception:format=tostring}"
            encoding="utf-8" />

    <!-- Info 级别日志（同时包含 Warn 和 Error），单文件最大20MB -->
    <target xsi:type="File"
            name="fileInfo"
            fileName="${basedir}/Logs/${shortdate}/Info.log"
            archiveAboveSize="20971520"
            archiveFileName="${basedir}/Logs/${shortdate}/Info_{#}.log"
            archiveNumbering="Sequence"
            maxArchiveFiles="30"
            layout="${longdate} | ${level:padding=-5} | ${logger} | ${message} ${exception:format=tostring}"
            encoding="utf-8" />

    <!-- Debug 级别日志，单文件最大20MB -->
    <target xsi:type="File"
            name="fileDebug"
            fileName="${basedir}/Logs/${shortdate}/Debug.log"
            archiveAboveSize="20971520"
            archiveFileName="${basedir}/Logs/${shortdate}/Debug_{#}.log"
            archiveNumbering="Sequence"
            maxArchiveFiles="30"
            layout="${longdate} | ${level:padding=-5} | ${logger} | ${message} ${exception:format=tostring}"
            encoding="utf-8" />

    <!-- Trace 级别日志，单文件最大20MB -->
    <target xsi:type="File"
            name="fileTrace"
            fileName="${basedir}/Logs/${shortdate}/Trace.log"
            archiveAboveSize="20971520"
            archiveFileName="${basedir}/Logs/${shortdate}/Trace_{#}.log"
            archiveNumbering="Sequence"
            maxArchiveFiles="30"
            layout="${longdate} | ${level:padding=-5} | ${logger} | ${message} ${exception:format=tostring}"
            encoding="utf-8" />

    <target xsi:type="Null" name="blackhole" />
  </targets>

  <rules>
    <logger name="Microsoft.*" minlevel="Trace" writeTo="blackhole" final="true" />
    <logger name="System.*" minlevel="Trace" writeTo="blackhole" final="true" />

    <!-- Error 独立文件 -->
    <logger name="*" level="Error" writeTo="fileError" />

    <!-- Warn 独立文件 -->
    <logger name="*" level="Warn" writeTo="fileWarn" />

    <!-- Info 文件包含 Info + Warn + Error -->
    <logger name="*" minlevel="Info" writeTo="fileInfo" />

    <!-- Debug 独立文件 -->
    <logger name="*" level="Debug" writeTo="fileDebug" />

    <!-- Trace 独立文件 -->
    <logger name="*" level="Trace" writeTo="fileTrace" />
  </rules>
</nlog>
