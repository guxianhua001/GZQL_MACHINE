<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      internalLogFile="nlog-internal.log"
      internalLogLevel="Info"
      throwExceptions="true">
	<extensions>
		<add assembly="NLogViewer" />
		<!-- 注意程序集名称大小写 -->
	</extensions>

	<targets>
		<!-- NLogViewer 目标 -->
		<target xsi:type="NlogViewer" name="ctrl" />

		<!-- 控制台输出 -->
		<target name="console" xsi:type="ColoredConsole"
                layout="${date:format=HH\:mm\:ss}> ${message}"/>

		<!-- 调试器输出 -->
		<target name="debugger" xsi:type="Debugger"
                layout="${date:format=HH\:mm\:ss} | ${level:padding=-5} | ${message}" />

		<!-- 文件目标（修正后的布局） -->
		<target name="error_file" xsi:type="File" maxArchiveFiles="30"
                fileName="${basedir}/Logs/Error/${shortdate}/error.txt"
                layout="${longdate} | ${level:uppercase=false:padding=-5} | ${message} ${onexception:inner=${exception:format=tostring}${newline}${stacktrace}${newline}}" />

		<target name="info_file" xsi:type="File" maxArchiveFiles="30"
                fileName="${basedir}/Logs/Info/${shortdate}/info.txt"
                layout="${longdate} | ${level:uppercase=false:padding=-5} | ${message} ${onexception:inner=${exception:format=tostring}${newline}${stacktrace}${newline}}" />

		<target name="warn_file" xsi:type="File" maxArchiveFiles="30"
                fileName="${basedir}/Logs/Warn/${shortdate}/warn.txt"
                layout="${longdate} | ${level:uppercase=false:padding=-5} | ${message} ${onexception:inner=${exception:format=tostring}${newline}${stacktrace}${newline}}" />

		<target name="trace_file" xsi:type="File" maxArchiveFiles="30"
                fileName="${basedir}/Logs/Trace/${shortdate}/trace.txt"
                layout="${longdate} | ${level:uppercase=false:padding=-5} | ${message} ${onexception:inner=${exception:format=tostring}${newline}${stacktrace}${newline}}" />

		<target name="debug_file" xsi:type="File" maxArchiveFiles="30"
                fileName="${basedir}/Logs/Debug/${shortdate}/debug.txt"
                layout="${longdate} | ${level:uppercase=false:padding=-5} | ${message} ${onexception:inner=${exception:format=tostring}${newline}${stacktrace}${newline}}" />
	</targets>

	<rules>
		<!-- 规则调整 -->
		<!-- 1. 所有级别的日志首先记录到各自文件 -->
		<logger name="*" minlevel="Error" writeTo="error_file" />
		<logger name="*" minlevel="Warn" maxlevel="Warn" writeTo="warn_file" />
		<logger name="*" minlevel="Info" maxlevel="Info" writeTo="info_file" />
		<logger name="*" minlevel="Trace" maxlevel="Trace" writeTo="trace_file" />
		<logger name="*" minlevel="Debug" maxlevel="Debug" writeTo="debug_file" />

		<!-- 2. 额外的规则：将 Warn 和 Error 级别日志也写入 info 文件 -->
		<logger name="*" minlevel="Warn" writeTo="info_file" />

		<!-- 3. 最后处理带 final 的规则 -->
		<logger name="*" minlevel="Trace" writeTo="ctrl" final="true" />
	</rules>
</nlog>
