<!-- NeedleCalibrationView.xaml -->
<UserControl x:Class="Stations.Views.NeedleAlignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:Stations.ViewModels"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Height="600"
             Width="800">
    <!--<UserControl.DataContext>
        <vm:NeedleCalibrationViewModel />
    </UserControl.DataContext>-->

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,16">
            <materialDesign:PackIcon Kind="Needle"
                                     Width="24"
                                     Height="24"
                                     Margin="0,0,8,0" />
            <TextBlock Text="针头校准"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：参数设置 -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="搜索点设置"
                              Style="{DynamicResource MaterialDesignGroupBox}"
                              Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="四个搜索点坐标 (mm)"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="点1:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Text="{Binding Parameters.SearchPoint1.X, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="X"
                                         Margin="0,0,4,8" />
                                <TextBox Grid.Row="0"
                                         Grid.Column="2"
                                         Text="{Binding Parameters.SearchPoint1.Y, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="Y"
                                         Margin="4,0,0,8" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="点2:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Text="{Binding Parameters.SearchPoint2.X, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="X"
                                         Margin="0,0,4,8" />
                                <TextBox Grid.Row="1"
                                         Grid.Column="2"
                                         Text="{Binding Parameters.SearchPoint2.Y, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="Y"
                                         Margin="4,0,0,8" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Text="点3:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Text="{Binding Parameters.SearchPoint3.X, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="X"
                                         Margin="0,0,4,8" />
                                <TextBox Grid.Row="2"
                                         Grid.Column="2"
                                         Text="{Binding Parameters.SearchPoint3.Y, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="Y"
                                         Margin="4,0,0,8" />

                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Text="点4:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Grid.Row="3"
                                         Grid.Column="1"
                                         Text="{Binding Parameters.SearchPoint4.X, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="X"
                                         Margin="0,0,4,0" />
                                <TextBox Grid.Row="3"
                                         Grid.Column="2"
                                         Text="{Binding Parameters.SearchPoint4.Y, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="Y"
                                         Margin="4,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="基准坐标"
                              Style="{DynamicResource MaterialDesignGroupBox}"
                              Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal"
                                    Margin="8">
                            <!-- X基准 -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,16,0">
                                <TextBlock Text="X基准:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           FontWeight="SemiBold"
                                           MinWidth="40" />
                                <TextBox Width="80"
                                         Text="{Binding Parameters.ReferenceXYZ.X, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="X坐标" />
                            </StackPanel>

                            <!-- Y基准 -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,16,0">
                                <TextBlock Text="Y基准:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           FontWeight="SemiBold"
                                           MinWidth="40" />
                                <TextBox Width="80"
                                         Text="{Binding Parameters.ReferenceXYZ.Y, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="Y坐标" />
                            </StackPanel>

                            <!-- Z基准 -->
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Z基准:"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           FontWeight="SemiBold"
                                           MinWidth="40" />
                                <TextBox Width="80"
                                         Text="{Binding Parameters.ReferenceXYZ.Z, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="Z坐标" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="运动参数"
                              Style="{DynamicResource MaterialDesignGroupBox}"
                              Margin="0,0,0,16">
                        <StackPanel>
                            <!-- 搜索范围 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MapSearch"
                                                             Width="20"
                                                             Height="20"
                                                             Margin="0,0,5,0" />
                                    <TextBlock Text="搜索范围 (mm):"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Parameters.SearchRange, StringFormat=F2}"
                                         materialDesign:HintAssist.Hint="0.01-5.00"
                                         Style="{StaticResource MaterialDesignFilledTextBox}" />
                            </Grid>

                            <!-- Z方向搜索次数 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AxisZArrow"
                                                             Width="20"
                                                             Height="20"
                                                             Margin="0,0,5,0" />
                                    <TextBlock Text="Z方向搜索次数:"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Parameters.ZSearchCount}"
                                         materialDesign:HintAssist.Hint="1-10次"
                                         Style="{StaticResource MaterialDesignFilledTextBox}" />
                            </Grid>

                            <!-- 搜索速度 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Speedometer"
                                                             Width="20"
                                                             Height="20"
                                                             Margin="0,0,5,0" />
                                    <TextBlock Text="搜索速度 (mm/s):"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Parameters.SearchSpeed, StringFormat=F1}"
                                         materialDesign:HintAssist.Hint="1.0-20.0 mm/s"
                                         Style="{StaticResource MaterialDesignFilledTextBox}" />
                            </Grid>

                            <!-- 精细搜索速度 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MagnifyScan"
                                                             Width="20"
                                                             Height="20"
                                                             Margin="0,0,5,0" />
                                    <TextBlock Text="精细搜索速度 (mm/s):"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Parameters.FineSearchSpeed, StringFormat=F1}"
                                         materialDesign:HintAssist.Hint="0.1-2.0 mm/s"
                                         Style="{StaticResource MaterialDesignFilledTextBox}" />
                            </Grid>
                            <!-- 针头基准高度 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Needle"
                                         Width="20"
                                         Height="20"
                                         Margin="0,0,5,0" />
                                    <TextBlock Text="针头基准高度 (mm):"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Parameters.NeedleBaseHeight, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="针头零点高度"
                                         Style="{StaticResource MaterialDesignFilledTextBox}" />
                            </Grid>

                            <!-- 3D相机基准高度 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Camera"
                                         Width="20"
                                         Height="20"
                                         Margin="0,0,5,0" />
                                    <TextBlock Text="3D相机基准高度 (mm):"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <TextBox Grid.Column="1"
                                         Text="{Binding Parameters.CameraBaseHeight, StringFormat=F3}"
                                         materialDesign:HintAssist.Hint="相机焦平面高度"
                                         Style="{StaticResource MaterialDesignFilledTextBox}" />
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="校准结果"
                              Style="{DynamicResource MaterialDesignGroupBox}">
                        <StackPanel>
                            <TextBlock Text="当前测量值"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBox Text="{Binding Parameters.CurrentXYZ, Mode=OneWay}"
                                     IsReadOnly="True"
                                     materialDesign:HintAssist.Hint="当前XYZ"
                                     Margin="0,0,0,8" />

                            <TextBlock Text="补偿值"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <TextBox Text="{Binding Parameters.CompensationXYZ, Mode=OneWay}"
                                     IsReadOnly="True"
                                     materialDesign:HintAssist.Hint="补偿XYZ"
                                     Margin="0,0,0,0" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧：状态和控制 -->
            <StackPanel Grid.Column="2">
                <GroupBox Header="校准控制"
                          Style="{DynamicResource MaterialDesignGroupBox}"
                          Margin="0,0,0,16">
                    <StackPanel>
                        <Button Content="开始校准"
                                Command="{Binding StartCalibrationCommand}"
                                Style="{DynamicResource MaterialDesignRaisedButton}"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Margin="0,0,0,8" />
                        <Button Content="停止校准"
                                Command="{Binding StopCalibrationCommand}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Margin="0,0,0,16" />

                        <ProgressBar Value="{Binding CalibrationProgress}"
                                     Maximum="100"
                                     Height="8"
                                     Style="{DynamicResource MaterialDesignLinearProgressBar}"
                                     Margin="0,0,0,8" />
                        <TextBlock Text="{Binding CalibrationStatus}"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="参数操作"
                          Style="{DynamicResource MaterialDesignGroupBox}"
                          Margin="0,0,0,16">
                    <StackPanel>
                        <Button Content="保存参数"
                                Command="{Binding SaveParametersCommand}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Margin="0,0,0,8" />
                        <Button Content="加载参数"
                                Command="{Binding LoadParametersCommand}"
                                Style="{DynamicResource MaterialDesignOutlinedButton}"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Margin="0,0,0,0" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="校准日志"
                          Style="{DynamicResource MaterialDesignGroupBox}"
                          Height="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0"
                                 ItemsSource="{Binding CalibrationLogs}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               FontSize="11" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="1"
                                Content="清空日志"
                                Command="{Binding ClearLogCommand}"
                                HorizontalAlignment="Right"
                                Margin="0,4,0,0"
                                Style="{DynamicResource MaterialDesignFlatButton}"
                                materialDesign:ButtonAssist.CornerRadius="2" />
                    </Grid>
                </GroupBox>
            </StackPanel>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="应用补偿"
                    Command="{Binding ApplyCompensationCommand}"
                    Style="{DynamicResource MaterialDesignRaisedButton}"
                    materialDesign:ButtonAssist.CornerRadius="2"
                    Margin="0,0,8,0" />
            <Button Content="关闭"
                    Command="{Binding CancelCommand}"
                    Style="{DynamicResource MaterialDesignOutlinedButton}"
                    materialDesign:ButtonAssist.CornerRadius="2" />
        </StackPanel>
    </Grid>
</UserControl>
