<UserControl x:Class="Stations.Views.ADValueDisplayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Stations.Views"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <UserControl.Resources>
        <!-- 定义颜色转换器 -->
        <!--<local:ForceValueToColorConverter x:Key="ForceValueToColorConverter" />-->

        <!-- ProgressBar样式 -->
        <Style x:Key="ForceProgressBarStyle"
               TargetType="ProgressBar">
            <Setter Property="Foreground"
                    Value="#4CAF50" />
            <Style.Triggers>
                <!-- 当力值为负时显示红色 -->
                <DataTrigger Binding="{Binding ForceValue}"
                             Value="-50">
                    <Setter Property="Foreground"
                            Value="#F44336" />
                </DataTrigger>
                <!-- 更通用的负值判断 -->
                <DataTrigger Binding="{Binding ForceValue}">
                    <DataTrigger.Value>
                        <sys:Double>0</sys:Double>
                    </DataTrigger.Value>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation To="#4CAF50"
                                                Storyboard.TargetProperty="Foreground.Color"
                                                Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border BorderBrush="Gray"
                BorderThickness="1"
                Padding="10"
                Margin="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="AD值监控"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChannelForces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#f5f5f5"
                                        BorderBrush="#ddd"
                                        BorderThickness="1"
                                        Margin="0,2"
                                        Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding ChannelName}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />

                                        <!-- 方法1：使用样式 -->
                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ForceValue}"
                                                     Minimum="-50"
                                                     Maximum="50"
                                                     Height="20"
                                                     Margin="10,0"
                                                     VerticalAlignment="Center"
                                                     Style="{StaticResource ForceProgressBarStyle}" />

                                        <!-- 方法2：使用转换器（推荐） -->
                                        <!--
                                        <ProgressBar Grid.Column="1"
                                                     Value="{Binding ForceValue}"
                                                     Minimum="-50"
                                                     Maximum="50"
                                                     Height="20"
                                                     Margin="10,0"
                                                     VerticalAlignment="Center"
                                                     Foreground="{Binding ForceValue, Converter={StaticResource ForceValueToColorConverter}}"/>
                                        -->

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DisplayValue}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>