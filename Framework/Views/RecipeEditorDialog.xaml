
    <!-- Framework/Views/RecipeEditorDialog.xaml -->
    <UserControl x:Class="Framework.Views.RecipeEditorDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:prism="http://prismlibrary.com/"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
                 prism:ViewModelLocator.AutoWireViewModel="True"
                 Width="400"
                 Height="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
        
    <Border Background="{DynamicResource MaterialDesignPaper}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="1"
                CornerRadius="4"
                Effect="{DynamicResource MaterialDesignShadowDepth4}">

            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0"
                           Text="{Binding Title}"
                           Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                           Foreground="{DynamicResource PrimaryHueMidBrush}"
                           Margin="0,0,0,16" />

                <!-- 表单 -->
                <StackPanel Grid.Row="1"
                            Margin="0,0,0,16">
                    <TextBox materialDesign:HintAssist.Hint="{lang:Lang RecipeEditor_RecipeName}"
                             Text="{Binding RecipeName,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource MaterialDesignFloatingHintTextBox}"
                             Margin="0,0,0,12"
                             CharacterCasing="Upper" />
                    <TextBox materialDesign:HintAssist.Hint="{lang:Lang RecipeEditor_RecipeDescription}"
                             Text="{Binding Description,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                             Style="{DynamicResource MaterialDesignFloatingHintTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="80"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <!-- 按钮区域 -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Command="{Binding CancelCommand}"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Margin="0,0,8,0"
                            Content="{lang:Lang Cancel}" />

                <!-- 主按钮：根据 Mode 显示“创建”或“保存” -->
                <Button Command="{Binding SaveCommand}"
                        Background="{DynamicResource PrimaryHueMidBrush}"
                        IsDefault="True">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                            <Setter Property="Content"
                                    Value="{lang:Lang Save}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mode}"
                                             Value="Create">
                                    <Setter Property="Content"
                                            Value="{lang:Lang RecipeEditor_Create}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            </Grid>
        </Border>
    </UserControl>