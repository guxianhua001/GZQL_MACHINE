<UserControl x:Class="Framework.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="820">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 通用转换器 -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- 样式定义 -->
            <Style x:Key="SectionHeaderStyle"
                   TargetType="TextBlock">
                <Setter Property="FontSize"
                        Value="16" />
                <Setter Property="FontWeight"
                        Value="SemiBold" />
                <Setter Property="Margin"
                        Value="0,15,0,10" />
                <Setter Property="Foreground"
                        Value="{DynamicResource PrimaryHueMidBrush}" />
            </Style>

            <Style x:Key="GroupBoxStyle"
                   TargetType="GroupBox">
                <Setter Property="Margin"
                        Value="0,5,0,15" />
                <Setter Property="Padding"
                        Value="10" />
                <Setter Property="BorderThickness"
                        Value="1" />
                <Setter Property="BorderBrush"
                        Value="{DynamicResource MaterialDesignDivider}" />
            </Style>

            <Style x:Key="FormLabelStyle"
                   TargetType="TextBlock">
                <Setter Property="VerticalAlignment"
                        Value="Center" />
                <Setter Property="Margin"
                        Value="0,0,10,0" />
                <Setter Property="FontWeight"
                        Value="Medium" />
            </Style>

            <Style x:Key="FormTextBoxStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                <Setter Property="Margin"
                        Value="0,5" />
                <Setter Property="materialDesign:HintAssist.Hint"
                        Value="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" />
            </Style>

            <Style x:Key="FormButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Margin"
                        Value="5,0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 服务器配置 -->
            <GroupBox Header="{lang:Lang Config_ServerConfig}"
                      Style="{StaticResource GroupBoxStyle}"
                      Grid.Row="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="{lang:Lang Config_ServerIP}"
                               Style="{StaticResource FormLabelStyle}" />
                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Text="{Binding ServerIP}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Tag="{lang:Lang Config_ServerIPAddress}" />

                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Text="{lang:Lang Config_Port}"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="20,0,0,0" />
                    <TextBox Grid.Row="0"
                             Grid.Column="3"
                             Text="{Binding ServerPort}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Tag="{lang:Lang Config_PortNumber}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{lang:Lang Config_MaxClients}"
                               Style="{StaticResource FormLabelStyle}" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding MaxClients}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Tag="{lang:Lang Config_MaxClientsCount}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Text="{lang:Lang Config_EncodingMethod}"
                               Style="{StaticResource FormLabelStyle}"
                               Margin="20,0,0,0" />
                    <TextBox Grid.Row="1"
                             Grid.Column="3"
                             Text="{Binding EncodingMethod}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Tag="{lang:Lang Config_EncodingMethod}" />
                </Grid>
            </GroupBox>

            <!-- 客户端配置 -->
            <GroupBox Header="{lang:Lang Config_ClientConfig}"
                      Style="{StaticResource GroupBoxStyle}"
                      Grid.Row="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 左右布局：添加新客户端 | 客户端列表 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：添加新客户端 -->
                        <GroupBox Grid.Column="0"
                                  Header="{lang:Lang Config_AddNewClient}">
                            <Grid Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding NewClient.Name}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Tag="{lang:Lang Config_ClientName}"
                                             Margin="0,0,5,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding NewClient.IP}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Tag="{lang:Lang Config_IPAddress}"
                                             Margin="5,0,5,0" />
                                    <TextBox Grid.Column="2"
                                             Text="{Binding NewClient.Port}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Tag="{lang:Lang Config_ClientPort}"
                                             Margin="5,0,5,0" />
                                    <Button Grid.Column="3"
                                            Content="{lang:Lang Add}"
                                            Command="{Binding AddClientCommand}"
                                            Style="{StaticResource FormButtonStyle}"
                                            Margin="5,0,0,0" />
                                </Grid>

                                <TextBox Grid.Row="1"
                                         Text="{Binding NewClient.Description}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Tag="{lang:Lang Description}"
                                         Margin="0,5,0,0" />
                            </Grid>
                        </GroupBox>

                        <!-- 右侧：客户端列表 -->
                        <GroupBox Grid.Column="2"
                                  Header="{lang:Lang Config_ClientList}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ListBox Grid.Row="0"
                                         ItemsSource="{Binding Clients}"
                                         SelectedItem="{Binding SelectedClient}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Margin="5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="Transparent"
                                                    Margin="2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled}"
                                                              VerticalAlignment="Center"
                                                              Margin="5,0,10,0" />

                                                    <StackPanel Grid.Column="1"
                                                                Orientation="Vertical"
                                                                Margin="5,2">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding IP, StringFormat='IP: {0}'}"
                                                                   FontSize="11"
                                                                   Foreground="Gray" />
                                                        <TextBlock Text="{Binding Port, StringFormat='端口: {0}'}"
                                                                   FontSize="11"
                                                                   Foreground="Gray" />
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="11"
                                                                   Foreground="DarkGray"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <Button Grid.Column="2"
                                                            Content="↑"
                                                            Command="{Binding DataContext.MoveClientUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignToolButton}"
                                                            Margin="2"
                                                            Width="25"
                                                            Height="25" />
                                                    <Button Grid.Column="3"
                                                            Content="↓"
                                                            Command="{Binding DataContext.MoveClientDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource MaterialDesignToolButton}"
                                                            Margin="2"
                                                            Width="25"
                                                            Height="25" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="5">
                                    <Button Content="{lang:Lang Config_DeleteSelected}"
                                            Command="{Binding RemoveClientCommand}"
                                            CommandParameter="{Binding SelectedClient.Name}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            IsEnabled="{Binding SelectedClient, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- 操作按钮 -->
                        <StackPanel Grid.Row="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,20,0,0">
                            <Button Content="{lang:Lang Config_RefreshConfig}"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Margin="10,0,10,0" />
                            <Button Content="{lang:Lang Config_SaveConfig}"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Margin="0,0,20,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 客户端统计信息 -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Clients.Count, StringFormat='总共 {} 个客户端'}"
                               HorizontalAlignment="Right"
                               Margin="5"
                               FontStyle="Italic"
                               Foreground="Gray" />
                </Grid>
            </GroupBox>

        </Grid>
    </ScrollViewer>
</UserControl>