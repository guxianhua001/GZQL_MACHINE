<Window x:Class="Framework.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Style="{StaticResource MaterialDesignWindow}"
        WindowStartupLocation="CenterScreen"
        Width="450"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Background="#FF424242">
    <!-- 深灰色背景 -->

    <Window.Resources>
        <!-- 主资源字典（包含所有资源，确保统一管理） -->
        <ResourceDictionary>
            <!-- 1. 合并外部资源字典 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Secondary/MaterialDesignColor.Lime.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 2. 类型转换器（必须显式定义 Key） -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- 3. 动画按钮样式（显式 Key） -->
            <Style x:Key="AnimatedButtonVisibilityStyle"
                   TargetType="Button">
                <Setter Property="Visibility"
                        Value="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Style.Triggers>
                    <Trigger Property="Visibility"
                             Value="Visible">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0"
                                                     To="1"
                                                     Duration="0:0:0.3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1"
                                                     To="0"
                                                     Duration="0:0:0.3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 4. 其他自定义样式（全部显式 Key） -->
            <SolidColorBrush x:Key="DarkDialogBackground"
                             Color="#FF424242" />
            <SolidColorBrush x:Key="CardBackground"
                             Color="#FF2D2D2D" />

            <Style x:Key="CustomCloseButton"
                   TargetType="Button">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Width="30"
                                  Height="30">
                                <Border Background="Transparent" />
                                <materialDesign:PackIcon Kind="Close"
                                                         Width="16"
                                                         Height="16"
                                                         Foreground="#FFFFFFFF" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CustomTitleBarStyle"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="#FF555555" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="8"
                                          ShadowDepth="1"
                                          Opacity="0.4"
                                          Color="Black" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 5. 隐式样式改为显式 -->
            <Style x:Key="MaterialDesignCardStyle"
                   TargetType="materialDesign:Card"
                   BasedOn="{StaticResource MaterialDesignElevatedCard}">
                <Setter Property="Background"
                        Value="{StaticResource MaterialDesignLightSeparatorBackground}" />
                <Setter Property="materialDesign:ElevationAssist.Elevation"
                        Value="Dp8" />
                <Setter Property="BorderBrush"
                        Value="#FF555555" />
                <Setter Property="BorderThickness"
                        Value="0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>


    <!-- 主布局 -->
    <Grid Background="{StaticResource DarkDialogBackground}">
        <Grid.RowDefinitions>
            <!-- 标题栏设为可拖动区域 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" 
                Height="32" 
                Background="{StaticResource DarkDialogBackground}"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Title}"
                           VerticalAlignment="Center"
                           Margin="16 0 0 0"
                           Foreground="#FFFFFFFF" />
                <!-- 深色主题下使用白色文字 -->
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1"
              Margin="16">
            <materialDesign:Card UniformCornerRadius="4"
                                 Margin="0 4 0 0">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 图标和标题 -->
                    <StackPanel Orientation="Horizontal"
                                Grid.Row="0"
                                Margin="0 8 0 16">
                        <materialDesign:PackIcon Kind="Alert"
                                                 Width="24"
                                                 Height="24"
                                                 Margin="0 0 12 0"
                                                 Foreground="Orange" />
                        <!-- 警告图标保持橙色 -->

                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Foreground="#FFFFFFFF" />
                        <!-- 深色主题下使用白色文字 -->
                    </StackPanel>

                    <!-- 消息内容 -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding Message}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="32 0 16 24"
                               Foreground="#FFCCCCCC" />
                    <!-- 使用浅灰色文字保证可读性 -->

                    <!-- 操作按钮区域 -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0 16 0 0">
                        <!-- 可选按钮 -->
                        <Button Content="{Binding ExtraButtonText}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding ExtraCommand}"
                                Margin="8 0 0 0"
                                MinWidth="120"
                                Height="36"
                                Foreground="#FF5DADE2"
                                BorderBrush="#FF5DADE2"
                                Visibility="{Binding IsExtraButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <!-- "NO" 按钮 -->
                        <Button Content="{Binding NoButtonText}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding NoCommand}"
                                Margin="8 0 0 0"
                                MinWidth="120"
                                Height="36"
                                Foreground="#FFFFFFFF"
                                BorderBrush="#FFFFFFFF"
                                Visibility="{Binding IsNoButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <!-- "YES" 按钮 -->
                        <Button Content="{Binding YesButtonText}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding YesCommand}"
                                Margin="8 0 0 0"
                                MinWidth="120"
                                Height="36"
                                Background="{DynamicResource SecondaryHueMidBrush}"
                                Foreground="#FFFFFFFF"
                                Visibility="{Binding IsYesButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- 添加进度条 -->
        <!--<Grid Grid.Row="2">
            <materialDesign:Card UniformCornerRadius="4"
                                 Margin="0 4 0 0">
                <Grid Margin="16">
                    --><!-- 按钮下方添加进度条 --><!--
                    <StackPanel Grid.Row="3"
                                Orientation="Vertical"
                                HorizontalAlignment="Stretch">
                        <ProgressBar Height="4"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0 16 0 0"
                                     Foreground="#FF4285F4" />
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>-->

    </Grid>
</Window>
