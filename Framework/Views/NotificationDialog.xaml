<UserControl x:Class="Framework.Views.NotificationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Framework.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="200"
             d:DesignWidth="400"
             MinWidth="400">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                             PrimaryColor="DeepPurple"
                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource MaterialDesignPaper}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题（可选） -->
        <TextBlock Text="{Binding Title}"
                   FontSize="20"
                   Margin="10"
                   HorizontalAlignment="Center"
                   Foreground="{StaticResource MaterialDesignBody}" />

        <!-- 消息和图标 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Grid.Row="1">
            <materialDesign:PackIcon Kind="{Binding IconKind}"
                                     Foreground="{StaticResource MaterialDesign.Brush.Primary.Dark}"
                                     Width="40"
                                     Height="40"
                                     Margin="10 0"
                                     HorizontalContentAlignment="Center" />
            <TextBlock Text="{Binding Message}"
                       FontSize="18"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="300" />
        </StackPanel>

        <!-- 确认按钮 -->
        <Button Grid.Row="2"
                Content="OK"
                Margin="10"
                Width="120"
                Height="36"
                HorizontalAlignment="Center"
                Command="{Binding ConfirmCommand}"
                Style="{StaticResource MaterialDesignRaisedButton}" />
    </Grid>

</UserControl>
