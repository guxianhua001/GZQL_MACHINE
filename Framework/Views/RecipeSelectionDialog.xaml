<!-- Framework/Views/RecipeSelectionDialog.xaml -->
<UserControl x:Class="Framework.Views.RecipeSelectionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="400"
             Height="500">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            <materialDesign:BundledTheme BaseTheme="Light"
                                         PrimaryColor="DeepPurple"
                                         SecondaryColor="Lime" />
            <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
            <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="RecipeItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="materialDesign:RippleAssist.Feedback"
                    Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="Margin"
                    Value="8,4" />
            <Setter Property="Padding"
                    Value="16,8" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource PrimaryHueLightBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource PrimaryHueLightForegroundBrush}" />
                </Trigger>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource PrimaryHueMidBrush}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource PrimaryHueMidForegroundBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1"
            CornerRadius="4"
            Effect="{DynamicResource MaterialDesignShadowDepth2}">

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Title}"
                       Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                       Foreground="{DynamicResource PrimaryHueMidBrush}"
                       Margin="0,0,0,16" />

            <!-- 消息 -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Message}"
                       Style="{DynamicResource MaterialDesignBody1TextBlock}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8" />
                       <!--Visibility="{Binding Message, Converter={x:Static materialDesign:ConverterHelper.NullOrEmptyToVisibilityConverter}}" />-->

            <!-- 当前配方提示 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource PrimaryHueLightBrush}"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,8">
                    <!--Visibility="{Binding CurrentRecipe, Converter={x:Static materialDesign:ConverterHelper.NullOrEmptyToVisibilityConverter}}">-->
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline"
                                             Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="{Binding CurrentRecipe, StringFormat='当前配方: {0}'}"
                               Style="{DynamicResource MaterialDesignBody2TextBlock}"
                               Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" />
                </StackPanel>
            </Border>

            <!-- 配方列表 -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding Recipes}"
                     SelectedItem="{Binding SelectedRecipe}"
                     Style="{StaticResource MaterialDesignListBox}"
                     ItemContainerStyle="{StaticResource RecipeItemStyle}"
                     MaxHeight="200"
                     Margin="0,8,0,16">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Margin="4">
                            <materialDesign:PackIcon Kind="BookmarkOutline"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,12,0" />
                            <TextBlock Text="{Binding}"
                                       Style="{DynamicResource MaterialDesignSubtitle1TextBlock}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 按钮区域 -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">

                <Button Content="取消"
                        Command="{Binding CancelCommand}"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Margin="0,0,8,0" />

                <Button Content="选择"
                        Command="{Binding SelectCommand}"
                        CommandParameter="{Binding SelectedRecipe}"
                        Style="{DynamicResource MaterialDesignRaisedButton}"
                        Background="{DynamicResource PrimaryHueMidBrush}"
                        IsDefault="True" />
            </StackPanel>
        </Grid>
            
    </Border>
</UserControl>