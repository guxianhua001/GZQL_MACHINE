<!-- Framework/Views/RecipeManagerView.xaml -->
<UserControl x:Class="Framework.Views.RecipeManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <Style x:Key="RecipeCardStyle"
                   TargetType="materialDesign:Card">
                <Setter Property="Margin"
                        Value="8" />
                <Setter Property="Padding"
                        Value="16" />
            </Style>

            <Style x:Key="ActionButtonStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="Margin"
                        Value="4,2" />
                <Setter Property="Padding"
                        Value="8,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <materialDesign:Card Grid.Row="0"
                             Style="{StaticResource RecipeCardStyle}">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="BookMultiple"
                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                         Width="32"
                                         Height="32"
                                         Margin="0,0,12,0" />
                <TextBlock Text="配方管理系统"
                           Style="{DynamicResource MaterialDesignHeadline6TextBlock}"
                           VerticalAlignment="Center" />

                <Separator Style="{StaticResource MaterialDesignDarkSeparator}"
                           Margin="24,0" />

                <TextBlock Text="{Binding CurrentRecipeName, StringFormat='当前配方: {0}'}"
                           Style="{DynamicResource MaterialDesignSubtitle1TextBlock}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryHueMidBrush}" />

                <ProgressBar IsIndeterminate="True"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                             Width="100"
                             Margin="16,0,0,0"
                             Style="{StaticResource MaterialDesignLinearProgressBar}" />
            </StackPanel>
        </materialDesign:Card>

        <!-- 主要内容区域 -->
        <Grid Grid.Row="1"
              Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 配方列表 -->
            <materialDesign:Card Grid.Column="0"
                                 Style="{StaticResource RecipeCardStyle}">
                <StackPanel>
                    <TextBlock Text="配方列表"
                               Style="{DynamicResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,12" />

                    <!-- 操作按钮 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,12">
                        <!-- 刷新 -->
                        <Button Command="{Binding LoadRecipesCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTip="刷新配方列表">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh"
                                                         Width="16"
                                                         Height="16" />
                                <TextBlock Text="刷新"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- 新建 -->
                        <Button Command="{Binding CreateRecipeCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTip="创建新配方">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus"
                                                         Width="16"
                                                         Height="16" />
                                <TextBlock Text="新建"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- 编辑 -->
                        <Button Command="{Binding EditRecipeCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTip="编辑选中配方">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Pencil"
                                                         Width="16"
                                                         Height="16" />
                                <TextBlock Text="编辑"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- 删除 -->
                        <Button Command="{Binding DeleteRecipeCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                Foreground="{DynamicResource MaterialDesignValidationErrorBrush}"
                                ToolTip="删除选中配方">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Delete"
                                                         Width="16"
                                                         Height="16" />
                                <TextBlock Text="删除"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 配方列表 -->
                    <ListBox ItemsSource="{Binding Recipes}"
                             SelectedItem="{Binding SelectedRecipe}"
                             Style="{StaticResource MaterialDesignListBox}"
                             MaxHeight="400">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,4"
                                        Background="Transparent">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{DynamicResource MaterialDesignSubtitle2TextBlock}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Id}"
                                                   Style="{DynamicResource MaterialDesignBody2TextBlock}"
                                                   Foreground="{DynamicResource MaterialDesignBody}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal"
                                                    Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ModifiedTime, StringFormat='修改: {0:yyyy-MM-dd HH:mm}'}"
                                                       Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                                                       Foreground="{DynamicResource MaterialDesignSecondaryText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </materialDesign:Card>

            <!-- 参数管理区域 -->
            <materialDesign:Card Grid.Column="1"
                                 Margin="16,0,0,0"
                                 Style="{StaticResource RecipeCardStyle}">
                <StackPanel>
                    <TextBlock Text="参数管理"
                               Style="{DynamicResource MaterialDesignSubtitle1TextBlock}"
                               Margin="0,0,0,12" />

                    <!-- 参数操作按钮 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,16">
                        <!-- 加载参数 -->
                        <Button Command="{Binding LoadParametersCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTip="加载当前配方所有参数">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Download"
                                                         Width="16"
                                                         Height="16" />
                                <TextBlock Text="加载参数"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- 保存参数 -->
                        <Button Command="{Binding SaveParametersCommand}"
                                Style="{StaticResource ActionButtonStyle}"
                                ToolTip="保存所有参数到当前配方">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave"
                                                         Width="16"
                                                         Height="16" />
                                <TextBlock Text="保存参数"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- 切换到选中配方 -->
                        <Button Command="{Binding SwitchRecipeCommand}"
                                CommandParameter="{Binding SelectedRecipe.Name}"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="{DynamicResource PrimaryHueMidBrush}"
                                ToolTip="切换到选中的配方">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SwapHorizontal"
                                                         Width="16"
                                                         Height="16" />
                                <TextBlock Text="切换到选中配方"
                                           Margin="4,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 参数选项卡 -->
                    <TabControl SelectedIndex="{Binding SelectedTabIndex}">
                        <!-- 位置参数选项卡 -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MapMarker"
                                                             Width="16"
                                                             Height="16"
                                                             Margin="0,0,4,0" />
                                    <TextBlock Text="位置参数" />
                                </StackPanel>
                            </TabItem.Header>
                            <TabItem.Content>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="位置参数管理"
                                                   Style="{DynamicResource MaterialDesignSubtitle2TextBlock}"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="这里可以集成 PositionViewModel 的位置参数管理界面"
                                                   Style="{DynamicResource MaterialDesignBody1TextBlock}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem.Content>
                        </TabItem>

                        <!-- 工站参数选项卡 -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Factory"
                                                             Width="16"
                                                             Height="16"
                                                             Margin="0,0,4,0" />
                                    <TextBlock Text="工站参数" />
                                </StackPanel>
                            </TabItem.Header>
                            <TabItem.Content>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="工站参数管理"
                                                   Style="{DynamicResource MaterialDesignSubtitle2TextBlock}"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="管理各个工站的运行参数"
                                                   Style="{DynamicResource MaterialDesignBody1TextBlock}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem.Content>
                        </TabItem>

                        <!-- 扩展参数选项卡 -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Cog"
                                                             Width="16"
                                                             Height="16"
                                                             Margin="0,0,4,0" />
                                    <TextBlock Text="扩展参数" />
                                </StackPanel>
                            </TabItem.Header>
                            <TabItem.Content>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="扩展参数管理"
                                                   Style="{DynamicResource MaterialDesignSubtitle2TextBlock}"
                                                   Margin="0,0,0,8" />
                                        <TextBlock Text="管理配方扩展参数和自定义配置"
                                                   Style="{DynamicResource MaterialDesignBody1TextBlock}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem.Content>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </materialDesign:Card>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource MaterialDesignBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Margin="0,16,0,0"
                Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}"
                       Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                       VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>