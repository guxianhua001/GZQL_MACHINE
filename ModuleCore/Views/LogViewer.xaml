<UserControl x:Class="ModuleCore.Views.LogViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ModuleCore.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:ModuleCore.ViewModels"
             xmlns:nlog="clr-namespace:Modules.LogViewer.Views;assembly=LogViewer"
             d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             SizeChanged="OnSizeChanged">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 滚动条样式 -->
            <Style TargetType="ScrollViewer"
                   x:Key="LogScrollViewerStyle">
                <Setter Property="HorizontalScrollBarVisibility"
                        Value="Auto" />
                <Setter Property="VerticalScrollBarVisibility"
                        Value="Auto" />
                <Setter Property="Background"
                        Value="White" />
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 使用DockPanel作为根容器 -->
    <DockPanel LastChildFill="True"
               Background="White">
        <!-- 功能区（上方固定高度） -->
        <!--<GroupBox DockPanel.Dock="Top"
                  Header="Functions"
                  Margin="5"
                  Padding="5">

        </GroupBox>-->

        <!-- 日志显示区（充满剩余空间） -->
        <Border Background="White"
                Margin="0">
            <!--<nlog:NlogViewer x:Name="logCtrl"
                             TimeWidth="Auto"
                             LoggerNameWidth="0"
                             LevelWidth="Auto"
                             ExceptionWidth="Auto"
                             MessageWidth="0"
                             MessagePercentage="60"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>-->
            <nlog:LogViewer x:Name="logCtrl" />
        </Border>
    </DockPanel>
</UserControl>
