<UserControl x:Class="ModuleCore.Views.DeviceConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="400">

    <StackPanel Margin="16">
        <!-- 设备控制标题 -->
        <TextBlock Text="硬件设备控制"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   Margin="0,0,0,16" />

        <!-- 配置选项面板 -->
        <Border Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="4"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel>
                <!-- 安全门控制 -->
                <CheckBox Content="安全门联锁功能"
                          IsChecked="{Binding EnableSafetyGate}"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Margin="0,8"
                          ToolTip="启用设备安全门状态监测">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2"
                                        ScaleY="1.2" />
                    </CheckBox.LayoutTransform>
                </CheckBox>

                <!-- 蜂鸣器控制 -->
                <CheckBox Content="警报蜂鸣器"
                          IsChecked="{Binding EnableBuzzer}"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Margin="0,8"
                          ToolTip="启用设备报警提示音">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2"
                                        ScaleY="1.2" />
                    </CheckBox.LayoutTransform>
                </CheckBox>

                <!-- SN控制 -->
                <CheckBox Content="启用产品SN"
                          IsChecked="{Binding EnableSnCode}"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Margin="0,8"
                          ToolTip="启用产品SN">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2"
                                        ScaleY="1.2" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
                
                <!-- 拨针模组屏蔽设置 -->
                <materialDesign:Card Margin="0,8"
                                     Padding="0">
                    <Expander Header="拨针模组屏蔽配置"
                              IsExpanded="{Binding PinModuleExpanded, Mode=TwoWay}">
                        <StackPanel Margin="16,8"
                                    Orientation="Vertical">
                            <!-- 四列模组切换 -->
                            <CheckBox Content="启用模组 1"
                                      IsChecked="{Binding IsModule1Enabled}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,8"
                                      ToolTip="启用第1组拨针设备">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.1"
                                                    ScaleY="1.1" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <CheckBox Content="启用模组 2"
                                      IsChecked="{Binding IsModule2Enabled}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,8"
                                      ToolTip="启用第2组拨针设备">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.1"
                                                    ScaleY="1.1" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <CheckBox Content="启用模组 3"
                                      IsChecked="{Binding IsModule3Enabled}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,8"
                                      ToolTip="启用第3组拨针设备">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.1"
                                                    ScaleY="1.1" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <CheckBox Content="启用模组 4"
                                      IsChecked="{Binding IsModule4Enabled}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,8"
                                      ToolTip="启用第4组拨针设备">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.1"
                                                    ScaleY="1.1" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                            
                            <!-- 快速操作按钮 -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8">
                                <Button Content="全选"
                                        Command="{Binding CheckAllModulesCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Margin="4,0" />
                                <Button Content="清空"
                                        Command="{Binding UncheckAllModulesCommand}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Margin="4,0" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </materialDesign:Card>

                <!-- SEC/GEM通信选项 -->
                <CheckBox Content="启用SECS/GEM通信"
                          IsChecked="{Binding EnableSecsGem}"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Margin="0,8"
                          ToolTip="启用半导体设备通讯标准协议">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2"
                                        ScaleY="1.2" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
                <!-- SECS/GEM高级设置（可折叠） -->
                <materialDesign:Card Margin="0,8"
                                     Padding="0">
                    <Expander Header="SECS/GEM高级设置"
                              IsExpanded="{Binding SecsGemAdvancedExpanded, Mode=TwoWay}">
                        <StackPanel Margin="16,8">
                            <TextBox Text="{Binding SecsGemIP, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,8"
                                     materialDesign:HintAssist.Hint="IP地址 (默认127.0.0.1)" />
                            <TextBox Text="{Binding SecsGemPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,8"
                                     materialDesign:HintAssist.Hint="端口号 (默认5000)" />

                            <TextBox Text="{Binding SecsGemDeviceId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,8"
                                     materialDesign:HintAssist.Hint="设备ID" />
                        </StackPanel>
                    </Expander>
                </materialDesign:Card>

                <!-- 配置文件路径设置 -->
                <Border Background="{DynamicResource MaterialDesignPaper}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- 路径标题 -->
                        <TextBlock Text="数据文件存储位置"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,0,0,8" />
                        <!-- 路径输入框 -->
                        <TextBox Text="{Binding DataSavePath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 Margin="0,0,8,0"
                                 materialDesign:HintAssist.Hint="配置存储路径"
                                 VerticalAlignment="Center" />
                        <!-- 浏览按钮 -->
                        <Button Command="{Binding BrowsePathCommand}"
                                Content="浏览..."
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="16,4"
                                VerticalAlignment="Center"
                                ToolTip="选择配置文件保存目录" />
                    </Grid>
                </Border>

                <!-- 数据保留设置 -->
                <Border Background="{DynamicResource MaterialDesignPaper}"
                        CornerRadius="4"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="数据保留设置"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   Grid.Row="0"
                                   Grid.ColumnSpan="2"
                                   Margin="0,0,0,8" />

                        <!-- 自动清理开关 -->
                        <CheckBox Content="自动清理旧数据"
                                  IsChecked="{Binding AutoCleanOldData}"
                                  Style="{StaticResource MaterialDesignCheckBox}"
                                  Grid.Row="1"
                                  Grid.Column="0"
                                  Margin="0,8,16,0"
                                  VerticalAlignment="Center"
                                  ToolTip="当磁盘空间不足时自动删除旧数据"
                                  Grid.ColumnSpan="2" />

                        <!-- 保留天数设置 -->
                        <TextBlock Text="保留天数："
                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                   Grid.Row="2"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Margin="0,8" />

                        <TextBox Text="{Binding DataRetentionDays}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 VerticalAlignment="Center"
                                 Margin="0,8"
                                 Width="80"
                                 HorizontalAlignment="Left"
                                 materialDesign:HintAssist.Hint="天数 (0=永久)">
                            <TextBox.InputBindings>
                                <!-- 限制只能输入整数 -->
                                <KeyBinding Command="{x:Null}"
                                            Key="Space" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </Grid>
                </Border>

            </StackPanel>
        </Border>

        <!-- 操作按钮组 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <!-- 保存按钮 -->
            <Button Content="应用设置"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Width="120"
                    Margin="8,0"
                    materialDesign:ButtonAssist.CornerRadius="4">
                <Button.ToolTip>
                    <TextBlock Text="保存当前硬件配置参数 (Ctrl+S)"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                </Button.ToolTip>
            </Button>

            <!-- 重置按钮（可选） -->
            <Button Content="恢复默认"
                    Command="{Binding LoadDefaultCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="120"
                    Margin="8,0"
                    materialDesign:ButtonAssist.CornerRadius="4" />
        </StackPanel>
    </StackPanel>
</UserControl>
