<UserControl x:Class="ModuleCore.Views.DeviceConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="400">

    <StackPanel Margin="16">
        <!-- 设备控制标题 -->
        <TextBlock Text="{lang:Lang DeviceConfig_HardwareControl}"
                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                   Margin="0,0,0,16" />

        <!-- 配置选项面板 -->
        <Border Background="{DynamicResource MaterialDesignPaper}"
                CornerRadius="4"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel>
                <!-- 安全信号分组 -->
                <materialDesign:Card Margin="0,8"
                                     Padding="0">
                    <Expander Header="{lang:Lang DeviceConfig_SafetySignalGroup}"
                              IsExpanded="True">
                        <StackPanel Margin="16,8">
                            <!-- 安全门控制 -->
                            <CheckBox IsChecked="{Binding EnableSafetyGate}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,8"
                                      ToolTip="{lang:Lang DeviceConfig_SafetyGateToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Door"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{lang:Lang DeviceConfig_SafetyGateInterlock}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2"
                                                    ScaleY="1.2" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <!-- 光幕控制 -->
                            <CheckBox IsChecked="{Binding EnableGrating}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,8"
                                      ToolTip="{lang:Lang DeviceConfig_EnableGratingToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="EyeOutline"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{lang:Lang DeviceConfig_EnableGrating}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2"
                                                    ScaleY="1.2" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <!-- 蜂鸣器控制 -->
                            <CheckBox IsChecked="{Binding EnableBuzzer}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,8"
                                      ToolTip="{lang:Lang DeviceConfig_AlarmBuzzerToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="BellOutline"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{lang:Lang DeviceConfig_AlarmBuzzer}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2"
                                                    ScaleY="1.2" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <!-- 安全事件日志 -->
                            <CheckBox IsChecked="{Binding EnableSafetyEventLog}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,8"
                                      ToolTip="{lang:Lang DeviceConfig_EnableSafetyEventLogToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{lang:Lang DeviceConfig_EnableSafetyEventLog}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2"
                                                    ScaleY="1.2" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <!-- 重开需整机初始化（调试用） -->
                            <CheckBox IsChecked="{Binding RequireInitOnRestart}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,8"
                                      ToolTip="{lang:Lang DeviceConfig_RequireInitOnRestartToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Restart"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{lang:Lang DeviceConfig_RequireInitOnRestart}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2"
                                                    ScaleY="1.2" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </StackPanel>
                    </Expander>
                </materialDesign:Card>

                <!-- SEC/GEM通信选项 -->
                <CheckBox Content="{lang:Lang DeviceConfig_EnableSecsGem}"
                          IsChecked="{Binding EnableSecsGem}"
                          Style="{StaticResource MaterialDesignCheckBox}"
                          Margin="0,8"
                          ToolTip="{lang:Lang DeviceConfig_EnableSecsGemToolTip}">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.2"
                                        ScaleY="1.2" />
                    </CheckBox.LayoutTransform>
                </CheckBox>
                <!-- SECS/GEM高级设置（可折叠） -->
                <materialDesign:Card Margin="0,8"
                                     Padding="0">
                    <Expander Header="{lang:Lang DeviceConfig_SecsGemAdvancedSettings}"
                              IsExpanded="{Binding SecsGemAdvancedExpanded, Mode=TwoWay}">
                        <StackPanel Margin="16,8">
                            <TextBox Text="{Binding SecsGemIP, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,8"
                                     materialDesign:HintAssist.Hint="{lang:Lang DeviceConfig_SecsGemIPHint}" />
                            <TextBox Text="{Binding SecsGemPort, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,8"
                                     materialDesign:HintAssist.Hint="{lang:Lang DeviceConfig_SecsGemPortHint}" />

                            <TextBox Text="{Binding SecsGemDeviceId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,8"
                                     materialDesign:HintAssist.Hint="{lang:Lang DeviceConfig_DeviceID}" />
                        </StackPanel>
                    </Expander>
                </materialDesign:Card>

                <!-- 配置文件路径设置 -->
                <materialDesign:Card Margin="0,8"
                                     Padding="0">
                    <Expander Header="{lang:Lang DeviceConfig_DataFileLocation}"
                              IsExpanded="True">
                        <StackPanel Margin="16,8">
                            <!-- 路径输入框 + 浏览按钮 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding DataSavePath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Grid.Column="0"
                                         Margin="0,0,8,0"
                                         materialDesign:HintAssist.Hint="{lang:Lang DeviceConfig_ConfigStoragePath}"
                                         VerticalAlignment="Center" />
                                <Button Command="{Binding BrowsePathCommand}"
                                        Content="{lang:Lang DeviceConfig_Browse}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Grid.Column="1"
                                        Padding="16,4"
                                        VerticalAlignment="Center"
                                        ToolTip="{lang:Lang DeviceConfig_BrowseToolTip}" />
                            </Grid>

                            <!-- 数据保留设置分隔标题 -->
                            <TextBlock Text="{lang:Lang DeviceConfig_DataRetentionSettings}"
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                       Margin="0,16,0,8" />

                            <!-- 自动清理开关 -->
                            <CheckBox Content="{lang:Lang DeviceConfig_AutoCleanOldData}"
                                      IsChecked="{Binding AutoCleanOldData}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,8"
                                      VerticalAlignment="Center"
                                      ToolTip="{lang:Lang DeviceConfig_AutoCleanToolTip}" />

                            <!-- 保留天数设置 -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0">
                                <TextBlock Text="{lang:Lang DeviceConfig_RetentionDays}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Text="{Binding DataRetentionDays}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Width="80"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         materialDesign:HintAssist.Hint="{lang:Lang DeviceConfig_DaysHint}">
                                    <TextBox.InputBindings>
                                        <!-- 限制只能输入整数 -->
                                        <KeyBinding Command="{x:Null}"
                                                    Key="Space" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </materialDesign:Card>

                <!-- 配置文件保留策略（按数量清理） -->
                <materialDesign:Card Margin="0,8"
                                     Padding="0">
                    <Expander Header="{lang:Lang DeviceConfig_ConfigRetentionGroup}"
                              IsExpanded="False">
                        <StackPanel Margin="16,8">
                            <!-- 启用开关 -->
                            <CheckBox IsChecked="{Binding ConfigRetentionEnabled}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,8"
                                      ToolTip="{lang:Lang DeviceConfig_ConfigRetentionEnabledToolTip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileRefresh"
                                                             VerticalAlignment="Center"
                                                             Margin="0,0,8,0" />
                                    <TextBlock Text="{lang:Lang DeviceConfig_ConfigRetentionEnabled}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2"
                                                    ScaleY="1.2" />
                                </CheckBox.LayoutTransform>
                            </CheckBox>

                            <!-- 配置文件根目录 -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ConfigFileBasePath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Grid.Column="0"
                                         Margin="0,0,8,0"
                                         materialDesign:HintAssist.Hint="{lang:Lang DeviceConfig_ConfigFileBasePathHint}"
                                         ToolTip="{lang:Lang DeviceConfig_ConfigFileBasePathToolTip}"
                                         VerticalAlignment="Center" />
                                <Button Command="{Binding BrowseConfigBasePathCommand}"
                                        Content="{lang:Lang DeviceConfig_Browse}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Grid.Column="1"
                                        Padding="16,4"
                                        VerticalAlignment="Center"
                                        ToolTip="{lang:Lang DeviceConfig_BrowseToolTip}" />
                            </Grid>

                            <!-- 最大文件数量（统一应用于所有文件夹） -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0">
                                <TextBlock Text="{lang:Lang DeviceConfig_DefaultMaxFileCount}"
                                           Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Text="{Binding DefaultMaxFileCount, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Width="100"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"
                                         materialDesign:HintAssist.Hint="{lang:Lang DeviceConfig_MaxFileCountHint}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </materialDesign:Card>

            </StackPanel>
        </Border>

        <!-- 操作按钮组 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <!-- 保存按钮 -->
            <Button Content="{lang:Lang DeviceConfig_ApplySettings}"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Width="120"
                    Margin="8,0"
                    materialDesign:ButtonAssist.CornerRadius="4">
                <Button.ToolTip>
                    <TextBlock Text="{lang:Lang DeviceConfig_SaveHardwareConfigToolTip}"
                               Style="{StaticResource MaterialDesignCaptionTextBlock}" />
                </Button.ToolTip>
            </Button>

            <!-- 重置按钮（可选） -->
            <Button Content="{lang:Lang ResetParameters}"
                    Command="{Binding LoadDefaultCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="120"
                    Margin="8,0"
                    materialDesign:ButtonAssist.CornerRadius="4" />
        </StackPanel>
    </StackPanel>
</UserControl>
