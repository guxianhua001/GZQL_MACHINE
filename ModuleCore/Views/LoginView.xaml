<UserControl
    x:Class="ModuleCore.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ModuleCore.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:viewmodels="clr-namespace:ModuleCore.ViewModels"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
    Width="400"
    Height="240"
    d:Background="White"
    d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Deeppurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition Height="30" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{lang:Lang Authorized_Login}" />
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{lang:Lang User}" />
            <ComboBox
                Grid.Column="1"
                Width="200"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Cursor="IBeam"
                DisplayMemberPath="Name"
                FontSize="16"
                ItemsSource="{Binding Model.UserList}"
                SelectedValue="{Binding Model.Name}"
                SelectedValuePath="Name" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Text="{lang:Lang Password}" />
            <PasswordBox
                x:Name="passwordBox"
                Grid.Column="1"
                Width="200"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Cursor="IBeam"
                FontSize="22" />
        </Grid>
        <Grid Grid.Row="3">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock d:Text="{lang:Lang Invalid_Password}"
                    FontSize="16"
                    Foreground="Red"
                    Text="{Binding Msg}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Button
                Width="80"
                Height="28"
                HorizontalAlignment="Center"
                Background="#5cb85c"
                Command="{Binding LoginCommand}"
                CommandParameter="{Binding ElementName=passwordBox}"
                Content="{lang:Lang Login}"
                FontSize="12"
                Foreground="White" Cursor="Hand" />

            <Button
                Grid.Column="1"
                Width="80"
                Height="28"
                HorizontalAlignment="Center"
                Background="#b85c5c"
                Command="{Binding CloseDialogCommand}"
                CommandParameter="false"
                Content="{lang:Lang Exit}"
                FontSize="12"
                Foreground="White" Cursor="Hand" />
            <Button
                Grid.Column="2"
                Width="80"
                Height="28"
                HorizontalAlignment="Center"
                Background="#5c5cb8"
                Command="{Binding CloseDialogCommand}"
                CommandParameter="manage"
                Content="{lang:Lang Management}"
                Cursor="Hand"
                FontSize="12"
                Foreground="White" />
        </Grid>
    </Grid>
</UserControl>