<UserControl x:Class="ModuleCore.Views.UserManage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ModuleCore.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:viewmodels="clr-namespace:ModuleCore.ViewModels"
             Width="640"
             Height="720"
             d:Background="White"
             d:DataContext="{d:DesignInstance Type=viewmodels:UserManageViewModel}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 用户列表区域 -->
        <DataGrid Grid.Row="0"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  ItemsSource="{Binding Model.UserList}"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <!-- 用户列 -->
                <DataGridTextColumn Width="2*"
                                    MinWidth="150"
                                    Binding="{Binding Name}"
                                    Header="用户"
                                    IsReadOnly="True" />

                <!-- 权限列 -->
                <DataGridTextColumn Width="2*"
                                    MinWidth="150"
                                    Binding="{Binding Authority}"
                                    Header="权限"
                                    IsReadOnly="True" />

                <!-- 操作按钮列 -->
                <DataGridTemplateColumn Width="2*"
                                        MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <UniformGrid Columns="2">
                                <Button Command="{Binding Delete}"
                                        Content="删除"
                                        Margin="3"
                                        Padding="8,2" />
                                <Button Command="{Binding ChangePassword}"
                                        Content="改密"
                                        Margin="3"
                                        Padding="8,2" />
                            </UniformGrid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 添加用户表单区域 -->
        <Border Grid.Row="1"
                BorderBrush="#DDD"
                BorderThickness="0,1,0,0"
                Padding="0,15,0,0">
            <Grid Width="450">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 用户名和权限行 -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="用户："
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <TextBox x:Name="UserName"
                             Grid.Column="1"
                             MinWidth="100" />

                    <TextBlock Text="权限："
                               Grid.Column="2"
                               VerticalAlignment="Center"
                               Margin="10,0,5,0" />
                    <ComboBox Grid.Column="3"
                              MinWidth="100"
                              ItemsSource="{Binding Model.AuthorityList}"
                              SelectedValue="{Binding Model.AuthoritySelect}"
                              DisplayMemberPath="Key"
                              SelectedValuePath="Value" />
                </Grid>

                <!-- 密码输入行 -->
                <Grid Grid.Row="1"
                      Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="密码："
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <PasswordBox x:Name="passwordBoxFirst"
                                 Grid.Column="1"
                                 MinWidth="200"
                                 PasswordChanged="CheckPassword" />
                </Grid>

                <!-- 确认密码行 -->
                <Grid Grid.Row="2"
                      Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="确认："
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <PasswordBox x:Name="passwordBoxSecond"
                                 Grid.Column="1"
                                 MinWidth="200"
                                 PasswordChanged="CheckPassword" />
                </Grid>

                <!-- 错误消息 -->
                <TextBlock x:Name="textBlockMsg"
                           Grid.Row="3"
                           Foreground="Red"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <!-- 添加按钮 -->
                <Button Grid.Row="4"
                        Content="添加用户"
                        HorizontalAlignment="Center"
                        MinWidth="100"
                        Click="AddUser"
                        Margin="0,0,0,15" />

                <!-- 系统设置区域 -->
                <StackPanel Grid.Row="5">
                    <TextBlock Text="系统全局设置"
                               FontWeight="Bold"
                               Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="自动注销时间(分钟):"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding Model.AutoLogoutMinutes}"
                                 materialDesign:HintAssist.Hint="1-1440分钟"
                                 Margin="0,0,10,0" />

                        <Button Grid.Column="2"
                                Content="应用"
                                Command="{Binding UpdateConfigCommand}"
                                MinWidth="80" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

</UserControl>