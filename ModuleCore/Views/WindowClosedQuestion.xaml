<Window x:Class="ModuleCore.Views.WindowClosedQuestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Title="提示"
        Width="420"
        Height="200">
    <Window.Resources>
        <ResourceDictionary>
            <!-- 主题样式 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
            </ResourceDictionary.MergedDictionaries>
            
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid Background="{DynamicResource BorderBrush}"
              VerticalAlignment="Top">
            <TextBlock Text="提示"
                       FontSize="20"
                       Background="#FFCCCCCC"
                       Margin="5" />
        </Grid>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="QuestionMarkCircle"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                                     Width="42"
                                     Height="42"
                                     Margin="80,5,5,5" />
            <TextBlock Text="确认是否退出"
                       FontSize="24"
                       Margin="5,-50"
                       VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel 
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
            <Button Content="YES"
                Margin="5"
                Width="100"
                HorizontalAlignment="Left"
                Click="ButtonYes_Click" />
            <Button Content="NO"
                Margin="5"
                Width="100"
                HorizontalAlignment="Right"
                Click="ButtonNo_Click" />
        </StackPanel>
    </Grid>
</Window>