<Window x:Class="ModuleCore.Views.WindowClosedQuestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
        mc:Ignorable="d"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Title="{lang:Lang Dialog_ConfirmExit_Title}"
        Width="420"
        Height="200">

    <Window.Resources>
        <ResourceDictionary>
            <!-- 主题样式 -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="Deeppurple"
                                             SecondaryColor="Lime" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!-- 标题栏 -->
        <Grid Background="{DynamicResource BorderBrush}"
              VerticalAlignment="Top">
            <TextBlock Text="{lang:Lang Dialog_ConfirmExit_Title}"
                       FontSize="20"
                       Background="#FFCCCCCC"
                       Margin="5" />
        </Grid>

        <!-- 图标和消息 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="QuestionMarkCircle"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                                     Width="42"
                                     Height="42"
                                     Margin="80,5,5,5" />
            <TextBlock Text="{lang:Lang Dialog_ConfirmExit_Message}"
                       FontSize="24"
                       Margin="5,-50"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- 按钮区域 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom">
            <Button Content="{lang:Lang Dialog_ConfirmExit_Yes}"
                    Margin="5"
                    Width="100"
                    HorizontalAlignment="Left"
                    Click="ButtonYes_Click" />
            <Button Content="{lang:Lang Dialog_ConfirmExit_No}"
                    Margin="5"
                    Width="100"
                    HorizontalAlignment="Right"
                    Click="ButtonNo_Click" />
        </StackPanel>
    </Grid>
</Window>  