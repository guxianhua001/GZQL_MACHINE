<UserControl x:Class="ModuleCore.Views.StatusDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ModuleCore"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:system="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="480"
             d:DesignWidth="600">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Secondary/MaterialDesignColor.Lime.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <md:Card Padding="16"
                 Margin="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <!-- 左侧状态面板 -->
                <Grid Grid.Column="0"
                      VerticalAlignment="Center">
                    <!-- 改用Grid并垂直居中 -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Width="260">
                        <!-- 配方名称显示区域 -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,8">
                            <md:PackIcon Kind="BookOutline"
                                         Width="20"
                                         Height="20"
                                         Margin="0,0,6,0"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentRecipeName}"
                                       Style="{StaticResource MaterialDesignBody2TextBlock}"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       ToolTip="当前使用配方" />
                        </StackPanel>
                        <!-- 固定宽度保持比例 -->
                        <TextBlock Text="质量分析看板"
                                   Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                                   Margin="0,0,0,8"
                                   HorizontalAlignment="Center" />
                        <!-- 标题居中 -->

                        <!-- 良率环形图 -->
                        <lvc:PieChart Series="{Binding YieldPieSeries}"
                                      LegendLocation="Bottom"
                                      InnerRadius="70"
                                      Height="200"
                                      Width="200"
                                      HorizontalAlignment="Center">
                            <!-- 图表居中 -->
                            <lvc:PieChart.DataTooltip>
                                <lvc:DefaultTooltip SelectionMode="OnlySender" />
                            </lvc:PieChart.DataTooltip>
                        </lvc:PieChart>

                        <!-- 良率数字显示 -->
                        <TextBlock Text="{Binding EquipmentStatus.YieldRate, StringFormat='良率: {0:F1}%'}"
                                   HorizontalAlignment="Center"
                                   Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                                   FontSize="18"
                                   Margin="0,8" />
                        <!-- 添加上边距 -->

                        <!-- OK/NG计数 -->
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Margin="0,8,0,0">
                            <!-- 添加上边距 -->
                            <TextBlock Text="{Binding EquipmentStatus.OKCount, StringFormat=' OK: {0}'}"
                                       Foreground="Green"
                                       Margin="0,0,10,0" />
                            <TextBlock Text="{Binding EquipmentStatus.TotalNG, StringFormat=' NG: {0}'}"
                                       Foreground="Red" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <Button Command="{Binding ResetStatisticsCommand}"
                                    Content="清零数据"
                                    Margin="5,80,0,0"
                                    Padding="8,2"
                                    ToolTip="重置所有统计指标"
                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                <Button.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextBlock.Foreground"
                                                Value="Red" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <!-- 右侧数据面板 -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- 状态摘要 -->
                        <RowDefinition Height="Auto" />
                        <!-- NG分布饼图 -->
                        <RowDefinition Height="*" />
                        <!-- 数据表格 -->
                    </Grid.RowDefinitions>
                    <!-- 状态摘要 -->
                    <Border Background="{DynamicResource MaterialDesignPaper}"
                            CornerRadius="4"
                            Padding="8"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="实时状态摘要"
                                       Style="{StaticResource MaterialDesignSubtitle1TextBlock}" />
                            <TextBlock Text="{Binding EquipmentStatus.CurrentState}"
                                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                    <!-- NG分布饼图 -->
                    <lvc:PieChart Grid.Row="1"
                                  Series="{Binding NgPieSeries}"
                                  LegendLocation="Right"
                                  Margin="10"
                                  Height="100">
                        <lvc:PieChart.DataTooltip>
                            <lvc:DefaultTooltip SelectionMode="OnlySender" />
                        </lvc:PieChart.DataTooltip>
                    </lvc:PieChart>
                    <!-- 详细数据表格 -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding StatusItemsSnapshot}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              md:DataGridAssist.CellPadding="8 4"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalAlignment="Stretch">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="指标"
                                                Binding="{Binding Key}"
                                                Width="90" />
                            <DataGridTextColumn Header="数值"
                                                Binding="{Binding Value}"
                                                Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </md:Card>

    </Grid>
</UserControl>
