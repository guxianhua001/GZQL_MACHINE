<UserControl x:Class="ModuleCore.Views.AlarmReportingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ext="clr-namespace:ModuleCore.Extensions"
             prism:ViewModelLocator.AutoWireViewModel="True">

    <!-- 日期验证资源 -->
    <UserControl.Resources>
        <Style TargetType="DatePicker"
               BasedOn="{StaticResource MaterialDesignFloatingHintDatePicker}">
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <DockPanel LastChildFill="True">
                            <Border BorderBrush="Red"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <AdornedElementPlaceholder />
                            </Border>
                            <TextBlock Text="开始日期不能晚于结束日期"
                                       Foreground="Red"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <materialDesign:Card Padding="16"
                         Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 顶部标题行 -->
                <RowDefinition Height="Auto" />
                <!-- 过滤条件行 -->
                <RowDefinition Height="Auto" />
                <!-- 数据表格行 -->
                <RowDefinition Height="*" />
                <!-- 分页控制行 -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="报警记录管理"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                       VerticalAlignment="Top"
                       Grid.Row="0"
                       Margin="0,0,0,16" />

            <!-- 查询条件面板 -->
            <GroupBox Header="查询条件"
                      Grid.Row="1"
                      Margin="0,0,0,10"
                      Style="{StaticResource MaterialDesignGroupBox}">
                <StackPanel Orientation="Horizontal">
                    <!-- 日期范围过滤 -->
                    <Label Content="开始日期:"
                           VerticalAlignment="Center"
                           Margin="5,0" />
                    <DatePicker SelectedDate="{Binding StartDate}"
                                materialDesign:HintAssist.Hint="选择开始日期"
                                Margin="5,0"
                                Width="150" />

                    <Label Content="结束日期:"
                           VerticalAlignment="Center"
                           Margin="5,0"
                           Padding="10,0,0,0" />
                    <DatePicker SelectedDate="{Binding EndDate}"
                                materialDesign:HintAssist.Hint="选择结束日期"
                                Margin="5,0"
                                Width="150" />

                    <!-- 报警等级过滤 -->
                    <Label Content="报警等级:"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
                    <ComboBox ItemsSource="{Binding AlarmLevels}"
                              SelectedItem="{Binding SelectedLevel}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              Margin="5,0"
                              Width="120">
                    </ComboBox>

                    <!-- 查询按钮 -->
                    <Button Command="{Binding QueryCommand}"
                            Content="查询"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="20,0,10,0"
                            Width="100"
                            Height="36"
                            materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsLoading}"
                            materialDesign:ButtonProgressAssist.Value="-1" />
                </StackPanel>
            </GroupBox>

            <!-- DataGrid -->
            <DataGrid x:Name="AlarmsDataGrid"
                      ItemsSource="{Binding Alarms}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      ext:SelectExtension.SelectedItems="{Binding SelectedAlarms, Mode=TwoWay}"
                      Grid.Row="2"
                      materialDesign:DataGridAssist.CellPadding="8 4"
                      Style="{StaticResource MaterialDesignDataGrid}">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="序号"
                                        Binding="{Binding Index}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                    <DataGridTextColumn Header="报警时间"
                                        Binding="{Binding StartTime}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                    <DataGridTextColumn Header="站号"
                                        Binding="{Binding StationId}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Code}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                    <DataGridTextColumn Header="等级"
                                        Binding="{Binding AlarmLevel}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                    <DataGridTextColumn Header="类别"
                                        Binding="{Binding Category}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}" />
                    <DataGridTextColumn Header="报警内容"
                                        Binding="{Binding Description}"
                                        ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"
                                        Width="*" />
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow"
                           BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="Background"
                                Value="{DynamicResource MaterialDesignBackground}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsActive}"
                                         Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource MaterialDesignValidationErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- 底部操作区域 -->
            <Grid Grid.Row="3"
                  Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <!-- 左侧操作按钮 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- 分页居中 -->
                    <ColumnDefinition Width="*" />
                    <!-- 右侧清除按钮 -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 批量操作按钮 -->
                <StackPanel Orientation="Horizontal"
                            Grid.Column="0">
                    <Button Command="{Binding ExportCsvCommand}"
                            ToolTip="导出为CSV文件"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Margin="0,0,5,0">
                        <materialDesign:PackIcon Kind="FileExport" />
                    </Button>

                    <Button Command="{Binding DeleteSelectedCommand}"
                            ToolTip="删除选中记录"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Margin="5,0,5,0"
                            materialDesign:ButtonProgressAssist.IsIndicatorVisible="{Binding IsDeleting}">
                        <materialDesign:PackIcon Kind="Delete" />
                    </Button>

                    <!--<Button Command="{Binding DeleteAllCommand}"
                            ToolTip="删除所有记录"
                            Margin="5,0,5,0"
                            Style="{StaticResource MaterialDesignIconButton}">
                        <materialDesign:PackIcon Kind="DeleteSweep" />
                    </Button>-->
                </StackPanel>

                <!-- 分页控件 (居中) -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Content="上一页"
                            IsEnabled="{Binding HasPreviousPage}"
                            Margin="5,0" />

                    <TextBlock Text="{Binding CurrentPage, StringFormat='第 {0} 页'}"
                               VerticalAlignment="Center"
                               Margin="5,0" />

                    <TextBlock Text="{Binding TotalCount, StringFormat='共 {0} 条记录'}"
                               VerticalAlignment="Center"
                               Margin="5,0" />
                    <!-- 正确的 ComboBox 实现 -->
                    <ComboBox ItemsSource="{Binding PageSizeOptions}"
                              SelectedValue="{Binding PageSize, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Width="120"
                              Margin="5,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Path=., StringFormat='每页 {0} 行'}"
                                           Padding="4 2" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Button Command="{Binding NextPageCommand}"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Content="下一页"
                            IsEnabled="{Binding HasNextPage}"
                            Margin="5,0" />
                </StackPanel>

                <!-- 删除全部按钮 (右对齐) -->
                <Button Command="{Binding DeleteAllCommand}"
                        Content="清空历史报警"
                        ToolTip="管理员可清空所有报警记录"
                        HorizontalAlignment="Right"
                        Grid.Column="2"
                        materialDesign:ButtonAssist.CornerRadius="8">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource MaterialDesignFlatButton}">
                            <Setter Property="IsEnabled"
                                    Value="{Binding CanClear}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanClear}"
                                             Value="False">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Grid>
    </materialDesign:Card>
</UserControl>
