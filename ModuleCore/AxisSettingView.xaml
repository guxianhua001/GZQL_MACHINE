<UserControl x:Class="ModuleCore.Views.AxisSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Height="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <!-- 视图状态切换器 -->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <Style TargetType="TextBox"
                           BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                        <Setter Property="Margin"
                                Value="0,0,0,12" />
                        <Setter Property="FontSize"
                                Value="14" />
                    </Style>
                    <Style TargetType="ComboBox"
                           BasedOn="{StaticResource MaterialDesignComboBox}">
                        <Setter Property="Margin"
                                Value="0,0,0,12" />
                        <Setter Property="FontSize"
                                Value="14" />
                    </Style>
                    <Style TargetType="CheckBox"
                           BasedOn="{StaticResource MaterialDesignCheckBox}">
                        <Setter Property="Margin"
                                Value="0,0,0,8" />
                    </Style>
                    <Style TargetType="Button"
                           BasedOn="{StaticResource MaterialDesignRaisedButton}">
                        <Setter Property="Margin"
                                Value="4" />
                        <Setter Property="Padding"
                                Value="8,4" />
                    </Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin"
                                Value="0,0,0,4" />
                        <Setter Property="FontSize"
                                Value="14" />
                        <Setter Property="VerticalAlignment"
                                Value="Center" />
                    </Style>
                    <DataTemplate x:Key="AxisListItemTemplate">
                        <StackPanel Orientation="Horizontal"
                                    Margin="8,4">
                            <materialDesign:PackIcon Kind="Axis"
                                                     Width="24"
                                                     Height="24"
                                                     Margin="0,0,8,0"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text=" ["
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ConfigId}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="]"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </DataTemplate>
                    <!-- 插补系列表项模板 -->
                    <DataTemplate x:Key="SystemListItemTemplate">
                        <StackPanel Orientation="Horizontal"
                                    Margin="8,4">
                            <materialDesign:PackIcon Kind="ShapePolygonPlus"
                                                     Width="24"
                                                     Height="24"
                                                     Margin="0,0,8,0"
                                                     Foreground="{DynamicResource PrimaryHueMidBrush}" />
                            <TextBlock Text="{Binding CoordId, StringFormat='插补系 {0}'}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text=" ("
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Axes.Count}"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="轴)"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </DataTemplate>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧轴列表 -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 插补系选择区域 -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Background="{DynamicResource PrimaryHueLightBrush}"
                                Height="40">
                        <TextBlock Text="管理单元"
                                   FontSize="16"
                                   Margin="12,0"
                                   Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                   VerticalAlignment="Center" />
                        <materialDesign:PackIcon Kind="ShapePolygonPlus"
                                                 Foreground="{DynamicResource PrimaryHueDarkBrush}"
                                                 VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 管理单元选择选项卡 -->
                    <TabControl Grid.Row="1"
                                SelectedIndex="{Binding ViewModeIndex}"
                                BorderThickness="0"
                                Background="{DynamicResource MaterialDesignCardBackground}">
                        <TabItem Header="单轴"
                                 Width="125" />
                        <TabItem Header="插补系"
                                 Width="125" />
                    </TabControl>

                    <!-- 单轴列表 -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Axes}"
                             SelectedItem="{Binding SelectedAxis}"
                             ItemTemplate="{StaticResource AxisListItemTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             materialDesign:ListBoxItemAssist.ShowSelection="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsSingleAxisMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Padding"
                                        Value="0" />
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 插补系列表 -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding InterpolationSystems}"
                             SelectedItem="{Binding SelectedSystem}"
                             ItemTemplate="{StaticResource SystemListItemTemplate}"
                             Background="Transparent"
                             BorderThickness="0"
                             materialDesign:ListBoxItemAssist.ShowSelection="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="{Binding IsSystemMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"
                                   BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="Padding"
                                        Value="0" />
                                <Setter Property="Background"
                                        Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧参数设置区域 -->
            <Grid Grid.Column="1">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="260" />
                    </Grid.RowDefinitions>

                    <!-- 单轴头部信息 -->
                    <Grid Visibility="{Binding IsSingleAxisMode, Converter={StaticResource BoolToVisibilityConverter}}"
                          Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedAxis.Name, StringFormat='当前轴: {0}'}"
                                       FontSize="22"
                                       FontWeight="Medium" />
                            <TextBlock Text="{Binding SelectedAxis.Description}"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Content="从卡读取"
                                    ToolTip="从运动控制卡读取参数"
                                    Command="{Binding UploadParamsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="2"
                                    Margin="5" />
                            <Button Content="设置到卡"
                                    ToolTip="设置参数到运动控制卡"
                                    Command="{Binding DownloadParamsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="2" />
                        </StackPanel>
                    </Grid>

                    <!-- 插补系头部信息 -->
                    <Grid Grid.Row="0"
                          Visibility="{Binding IsSystemMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSystem.CoordId, StringFormat='插补系 {0}'}"
                                       FontSize="22"
                                       FontWeight="Medium" />
                            <TextBlock Text="{Binding SelectedSystem.AxesInfo}"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,10,0">
                            <Button Content="保存配置"
                                    ToolTip="保存插补系配置"
                                    Command="{Binding SaveSystemParamsCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    materialDesign:ButtonAssist.CornerRadius="2" />
                        </StackPanel>
                    </Grid>

                    <!-- 表单区域 -->
                    <Grid Grid.Row="1"
                          Margin="0,10,0,0">
                        <Grid>
                            <!-- 单轴参数表单 -->
                            <Grid Visibility="{Binding IsSingleAxisMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <!-- 添加行定义 -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 脉冲当量 -->
                                <GroupBox Header="脉冲当量设置"
                                          Grid.Row="0"
                                          Grid.Column="0"
                                          Margin="0,0,8,16">
                                    <StackPanel>
                                        <TextBox materialDesign:HintAssist.Hint="脉冲当量 (pulse/unit)"
                                                 Text="{Binding CurrentAxisParams.PulsePerUnit}" />
                                        <TextBlock Text="设置命令: dmc_set_equiv(卡号, 轴号, 脉冲当量)"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   Margin="0,0,0,16" />
                                    </StackPanel>
                                </GroupBox>

                                <!-- 急停设置 -->
                                <GroupBox Header="急停设置"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          Margin="8,0,0,16">
                                    <StackPanel>
                                        <CheckBox Content="启用急停"
                                                  IsChecked="{Binding CurrentAxisParams.EmergencyStop.Enabled}" />
                                        <ComboBox materialDesign:HintAssist.Hint="有效电平"
                                                  ItemsSource="{Binding LogicLevels}"
                                                  SelectedItem="{Binding CurrentAxisParams.EmergencyStop.LogicLevel}"
                                                  IsEnabled="{Binding CurrentAxisParams.EmergencyStop.Enabled}">
                                            <!-- 自定义下拉项样式 -->
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem">
                                                    <Setter Property="HorizontalContentAlignment"
                                                            Value="Stretch" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ComboBoxItem">
                                                                <Grid Background="Transparent">
                                                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                                                      Margin="8,4" />
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                        </ComboBox>

                                        <ComboBox materialDesign:HintAssist.Hint="急停IO映射"
                                                  ItemsSource="{Binding MappedIOs}"
                                                  SelectedItem="{Binding CurrentAxisParams.EmergencyStop.MappedIO}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                <Run Text="{Binding PortName}" />
                                                <Run Text="(MapIoIndex: " />
                                                <Run Text="{Binding MapIoIndex}" />
                                                <Run Text=")" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Text="设置命令: dmc_set_emg_mode() &amp; dmc_set_axis_io_map()"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </GroupBox>

                                <!-- 回零设置 -->
                                <GroupBox Header="回零设置"
                                          Grid.Row="1"
                                          Grid.Column="0"
                                          Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBox materialDesign:HintAssist.Hint="低速 (unit/s)"
                                                 Text="{Binding CurrentAxisParams.Homing.LowSpeed}" />
                                        <TextBox materialDesign:HintAssist.Hint="高速 (unit/s)"
                                                 Text="{Binding CurrentAxisParams.Homing.HighSpeed}" />
                                        <TextBox materialDesign:HintAssist.Hint="加速时间 (s)"
                                                 Text="{Binding CurrentAxisParams.Homing.AccelerationTime}" />
                                        <TextBox materialDesign:HintAssist.Hint="减速时间 (s)"
                                                 Text="{Binding CurrentAxisParams.Homing.DecelerationTime}" />
                                        <TextBlock Text="回零模式"
                                                   Style="{StaticResource MaterialDesignBody2TextBlock}"
                                                   Margin="0,0,0,4"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                        <ComboBox materialDesign:HintAssist.Hint="回零模式"
                                                  ItemsSource="{Binding HomingModes}"
                                                  SelectedItem="{Binding CurrentAxisParams.Homing.Mode}" />

                                        <TextBox materialDesign:HintAssist.Hint="回零偏移位置"
                                                 Text="{Binding CurrentAxisParams.Homing.Offset}" />

                                        <TextBlock Text="设置命令: nmc_set_home_profile()"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </GroupBox>

                                <!-- 运动参数 -->
                                <GroupBox Header="运动参数"
                                          Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBox materialDesign:HintAssist.Hint="起始速度 (unit/s)"
                                                 Text="{Binding CurrentAxisParams.Motion.StartSpeed}" />
                                        <TextBox materialDesign:HintAssist.Hint="最大速度 (unit/s)"
                                                 Text="{Binding CurrentAxisParams.Motion.MaxSpeed}" />
                                        <TextBox materialDesign:HintAssist.Hint="加速时间 (s)"
                                                 Text="{Binding CurrentAxisParams.Motion.AccelerationTime}" />
                                        <TextBox materialDesign:HintAssist.Hint="减速时间 (s)"
                                                 Text="{Binding CurrentAxisParams.Motion.DecelerationTime}" />
                                        <TextBox materialDesign:HintAssist.Hint="停止速度 (unit/s)"
                                                 Text="{Binding CurrentAxisParams.Motion.StopSpeed}" />

                                        <TextBox materialDesign:HintAssist.Hint="S段时间 (0-0.5s)"
                                                 Text="{Binding CurrentAxisParams.Motion.SProfileTime}" />

                                        <TextBox materialDesign:HintAssist.Hint="减速停止时间 (s)"
                                                 Text="{Binding CurrentAxisParams.Motion.DecStopTime}" />

                                        <TextBlock Text="设置命令: dmc_set_profile_unit(), dmc_set_s_profile(), dmc_set_dec_stop_time(), dmc_set_soft_limit()"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}" />
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                            <!-- 插补系参数表单 -->
                            <Grid Visibility="{Binding IsSystemMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="550" />
                                </Grid.ColumnDefinitions>

                                <!-- 基本设置 -->
                                <GroupBox Header="基本设置"
                                          Grid.Column="0"
                                          Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <!--<ComboBox materialDesign:HintAssist.Hint="控制卡"
                                                  ItemsSource="{Binding Cards}"
                                                  SelectedValue="{Binding SelectedSystem.ActCardId}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CardId, StringFormat='卡 {0}'}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>-->

                                        <GroupBox Header="包含的轴"
                                                  Margin="0,10,0,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <ListBox Grid.Row="0"
                                                         ItemsSource="{Binding SelectedAxesInSystem}"
                                                         MinHeight="160"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem"
                                                               BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                                            <Setter Property="Padding"
                                                                    Value="0" />
                                                            <Setter Property="Background"
                                                                    Value="Transparent" />
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal"
                                                                        Margin="4">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontWeight="Bold"
                                                                           VerticalAlignment="Center"
                                                                           MinWidth="120" />
                                                                <TextBlock Text="["
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding SetCardId, StringFormat='卡{0}'}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="4,0,0,0" />
                                                                <TextBlock Text="-"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding SetAxisId, StringFormat='轴{0}'}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="]"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </Grid>
                                        </GroupBox>
                                    </Grid>
                                </GroupBox>
                                <!-- 运动参数 -->
                                <GroupBox Header="运动参数"
                                          Grid.Column="1"
                                          Margin="8,0,0,16">
                                    <StackPanel>
                                        <TextBox materialDesign:HintAssist.Hint="起始速度 (unit/s)"
                                                 Text="{Binding SelectedSystem.Params.StartVelocity}" />
                                        <TextBox materialDesign:HintAssist.Hint="插补速度 (unit/s)"
                                                 Text="{Binding SelectedSystem.Params.InterpolationVelocity}" />
                                        <TextBox materialDesign:HintAssist.Hint="终止速度 (unit/s)"
                                                 Text="{Binding SelectedSystem.Params.EndVelocity}" />
                                        <TextBox materialDesign:HintAssist.Hint="加速时间 (s)"
                                                 Text="{Binding SelectedSystem.Params.AccelerationTime}" />
                                        <TextBox materialDesign:HintAssist.Hint="减速时间 (s)"
                                                 Text="{Binding SelectedSystem.Params.DecelerationTime}" />
                                        <TextBox materialDesign:HintAssist.Hint="S段时间 (s)"
                                                 Text="{Binding SelectedSystem.Params.SProfileTime}" />
                                        <TextBox materialDesign:HintAssist.Hint="减速停止时间 (s)"
                                                 Text="{Binding SelectedSystem.Params.DecelerationStopTime}" />

                                        <TextBlock Text="设置命令: dmc_set_interpolation_params()"
                                                   Style="{StaticResource MaterialDesignCaptionTextBlock}"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                </GroupBox>
                            </Grid>
                        </Grid>
                    </Grid>
                    <!-- 指令按钮 -->
                    <Border Grid.Row="2"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            Padding="0,10,0,5"
                            Margin="0,-220,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧按钮 -->
                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left">
                                <!-- 导出配置按钮 - 显示于单轴模式 -->
                                <Button Command="{Binding ExportCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        ToolTip="导出配置为JSON文件"
                                        Visibility="{Binding IsSingleAxisMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Export"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="导出配置"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- 导入配置按钮 - 显示于单轴模式 -->
                                <Button Command="{Binding ImportCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        ToolTip="从JSON文件导入配置"
                                        Margin="10,0,0,0"
                                        Visibility="{Binding IsSingleAxisMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Import"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="导入配置"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- 添加插补系按钮 - 显示于插补系模式 -->
                                <!--<Button Command="{Binding AddSystemCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        ToolTip="添加新插补系"
                                        Margin="10,0,0,0"
                                        Visibility="{Binding IsSystemMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlaylistPlus"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="添加插补系"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding DeleteSystemCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#FFE53935"
                                        Foreground="White"
                                        ToolTip="删除当前插补系"
                                        Margin="10,0,10,0"
                                        Visibility="{Binding IsSystemMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Delete"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="删除插补系"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>-->
                                <Button Command="{Binding ManageSystemAxesCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Foreground="White"
                                        ToolTip="管理轴"
                                        Margin="10,0,10,0"
                                        Visibility="{Binding IsSystemMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AxisArrowInfo"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="管理轴"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <!--<Button Grid.Row="1"
                                        Content="管理轴"
                                        Command="{Binding ManageSystemAxesCommand}"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0" />-->
                            </StackPanel>

                            <!-- 右侧按钮 -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <!-- 设置全部按钮 - 显示于单轴模式 -->
                                <Button Command="{Binding DownloadAllParametersCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#FF1E88E5"
                                        Foreground="White"
                                        Margin="10,0,10,0"
                                        Visibility="{Binding IsSingleAxisMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button.ToolTip>
                                        <TextBlock Text="将所有轴的参数设置到对应的控制卡" />
                                    </Button.ToolTip>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlaylistPlay"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="设置全部轴"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 加载参数按钮 - 显示于单轴模式 -->
                                <Button Command="{Binding LoadParamsCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                                        Foreground="White"
                                        ToolTip="从配置文件加载"
                                        Margin="10,0,10,0"
                                        Visibility="{Binding IsSingleAxisMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpen"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="加载参数"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- 保存参数按钮 - 显示于单轴模式 -->
                                <Button Command="{Binding SaveParamsCommand}"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="{DynamicResource MaterialDesign.Brush.Primary.Dark}"
                                        Foreground="White"
                                        ToolTip="保存到配置文件"
                                        Visibility="{Binding IsSingleAxisMode, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ContentSave"
                                                                 VerticalAlignment="Center" />
                                        <TextBlock Text="保存参数"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0,0,0" />
                                    </StackPanel>
                                </Button>

                                <!-- 轴归零命令按钮 -->
                                <!--
