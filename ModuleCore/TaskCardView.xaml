<UserControl x:Class="ModuleCore.Views.TaskCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Framework.Converters;assembly=Framework"
             mc:Ignorable="d"
             d:DesignHeight="150"
             d:DesignWidth="300">
    <UserControl.Resources>
        <converters:BrushToMaterialCardBackgroundConverter x:Key="BrushToMaterialCardBackgroundConverter" />
    </UserControl.Resources>
    
    <materialDesign:Card UniformCornerRadius="3"
                         Margin="5"
                         Padding="10"
                         Background="{Binding StatusColor, Converter={StaticResource BrushToMaterialCardBackgroundConverter}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 任务头 -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal">
                <TextBlock Text="{Binding Name}"
                           FontWeight="Bold"
                           FontSize="16" />
                <TextBlock Text=" | "
                           Margin="5,0" />
                <TextBlock Text="{Binding TaskId}"
                           FontSize="14"
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
            </StackPanel>

            <!-- 步骤指示器 -->
            <ProgressBar Grid.Row="1"
                         Value="{Binding Step}"
                         Maximum="100"
                         Minimum="0"
                         Margin="0,10,0,5"
                         Height="8"
                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                         Background="{DynamicResource MaterialDesignSelection}" />

            <!-- 步骤信息 -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        Margin="0,5,0,0">
                <TextBlock Text="当前步: "
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="{Binding Step}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryHueDarkBrush}" />
                <TextBlock Text=" / "
                           Margin="5,0" />
                <TextBlock Text="上一步: "
                           Foreground="{DynamicResource MaterialDesignBodyLight}" />
                <TextBlock Text="{Binding LastStep}"
                           Foreground="{DynamicResource SecondaryAccentBrush}" />
            </StackPanel>

            <!-- 状态消息 -->
            <TextBlock Grid.Row="3"
                       Text="{Binding StatusMessage}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MaterialDesignBodyLight}" />
        </Grid>
    </materialDesign:Card>
</UserControl>
