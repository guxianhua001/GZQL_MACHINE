<UserControl x:Class="Recipe.Views.GlobalVariablesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="{lang:Lang GlobalVariablesView_Title}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,4" />

        <!-- 配方池信息 -->
        <TextBlock Grid.Row="1"
                   Text="{Binding CurrentPoolName, StringFormat={}{0}}"
                   FontSize="12"
                   FontStyle="Italic"
                   Margin="0,0,0,12" />

        <!-- 变量操作工具栏 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,8">
            <Button Content="{lang:Lang Add}"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="90"
                    Margin="0,0,8,0" />
            <Button Content="{lang:Lang Delete}"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="90"
                    Margin="0,0,8,0" />
            <Button Command="{Binding MoveUpCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="90"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowUp"
                                             Width="20"
                                             Height="20"
                                             Margin="-10,0,4,0" />
                    <TextBlock Text="{lang:Lang PositionEditor_Up}" />
                </StackPanel>
            </Button>
            <Button Command="{Binding MoveDownCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="90"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowDown"
                                             Width="20"
                                             Height="20"
                                             Margin="-10,0,4,0" />
                    <TextBlock Text="{lang:Lang PositionEditor_Down}" />
                </StackPanel>
            </Button>
            <!--<Button Content="Save"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Width="90"
                    Margin="0,0,8,0" />-->
        </StackPanel>

        <!-- 分组管理工具栏：分组过滤下拉 + 添加/删除/重命名分组 -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    Margin="0,0,0,8"
                    VerticalAlignment="Center">
            <TextBlock Text="{lang:Lang GlobalVariablesView_Group}"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="0,0,8,0" />
            <!-- 分组过滤下拉框：第一项 null=全部，空字符串=默认分组，其他=自定义分组 -->
            <ComboBox ItemsSource="{Binding GroupFilterOptions}"
                      SelectedItem="{Binding SelectedGroupFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Width="180"
                      Margin="0,0,8,0"
                      materialDesign:HintAssist.Hint="{lang:Lang GlobalVariablesView_GroupFilterHint}">
                <!-- 使用 ItemContainerStyle + DataTrigger 直接覆盖 Content，避免 ItemTemplate 重影 -->
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Style.Triggers>
                            <!-- AllGroupsKey (零宽空格 ZWSP) 显示"全部" -->
                            <DataTrigger Binding="{Binding}" Value="&#x200B;">
                                <Setter Property="Content" Value="{lang:Lang GlobalVariablesView_AllGroups}" />
                            </DataTrigger>
                            <!-- 空字符串显示"默认分组" -->
                            <DataTrigger Binding="{Binding}" Value="">
                                <Setter Property="Content" Value="{lang:Lang GlobalVariablesView_DefaultGroup}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>
            <Button Content="{lang:Lang GlobalVariablesView_AddGroup}"
                    Command="{Binding AddGroupCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="135"
                    Margin="0,0,8,0" />
            <Button Content="{lang:Lang GlobalVariablesView_RenameGroup}"
                    Command="{Binding RenameGroupCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="135"
                    Margin="0,0,8,0" />
            <Button Content="{lang:Lang GlobalVariablesView_DeleteGroup}"
                    Command="{Binding DeleteGroupCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Width="135"
                    Margin="0,0,8,0" />
        </StackPanel>

        <!-- DataGrid 表格：绑定过滤后的视图 VariablesView -->
        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding VariablesView}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  SelectedItem="{Binding SelectedVariable}"
                  materialDesign:DataGridAssist.CellPadding="4"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{lang:Lang Index}"
                                    Binding="{Binding Index}"
                                    IsReadOnly="True"
                                    Width="50" />
                <DataGridTemplateColumn Header="{lang:Lang GlobalVariablesView_Group}"
                                        Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!-- 显示分组名：空字符串显示"默认分组" -->
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Group}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Group}" Value="{x:Null}">
                                                <Setter Property="Text" Value="{lang:Lang GlobalVariablesView_DefaultGroup}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Group}" Value="">
                                                <Setter Property="Text" Value="{lang:Lang GlobalVariablesView_DefaultGroup}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <!-- 编辑分组：下拉选择已有分组 -->
                            <ComboBox ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding Group, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="False" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="{lang:Lang Type}"
                                        Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Type}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.TypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding Type, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="False" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{lang:Lang Name}"
                                    Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="280" />
                <DataGridTextColumn Header="{lang:Lang Value}"
                                    Binding="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="200" />
                <DataGridTextColumn Header="{lang:Lang Comment}"
                                    Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 提示信息 -->
        <TextBlock Grid.Row="5"
                   Text="{lang:Lang GlobalVariablesView_Tip}"
                   FontStyle="Italic"
                   FontSize="12"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center" />
    </Grid>
</UserControl>
