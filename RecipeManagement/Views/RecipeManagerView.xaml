<UserControl x:Class="Recipe.Views.RecipeManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Recipe.Converters"
             xmlns:moduleViews="clr-namespace:Recipe.Views"
             xmlns:viewModels="clr-namespace:Recipe.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Height="auto">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 转换器 -->
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:NodeTypeToVisibilityConverter x:Key="NodeTypeToVisibilityConverter" />
            <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter" />

            <!-- 分隔线样式保留 -->
            <Style x:Key="VSeparator"
                   TargetType="Rectangle">
                <Setter Property="Width"
                        Value="1" />
                <Setter Property="Height"
                        Value="18" />
                <Setter Property="Fill"
                        Value="{DynamicResource MaterialDesignDivider}" />
                <Setter Property="Margin"
                        Value="6,0" />
                <Setter Property="VerticalAlignment"
                        Value="Center" />
            </Style>

            <!-- 树节点容器样式 - Gmail风格右侧圆角 + 触摸手势反馈 -->
            <Style x:Key="TreeNodeBorder"
                   TargetType="Border">
                <Setter Property="Background"
                        Value="Transparent" />
                <Setter Property="CornerRadius"
                        Value="0,12,12,0" />
                <Setter Property="Padding"
                        Value="10,6" />
                <Setter Property="Margin"
                        Value="0,1" />
                <Setter Property="Cursor"
                        Value="Hand" />
                <Setter Property="RenderTransformOrigin"
                        Value="0.5,0.5" />
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- 悬停反馈 -->
                    <Trigger Property="IsMouseOver"
                             Value="True">
                        <Setter Property="Background"
                                Value="#E8F0FE" />
                    </Trigger>
                    <!-- 选中状态 -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                       Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background"
                                Value="#D2E3FC" />
                    </MultiDataTrigger>
                    <!-- 触摸/按下反馈 - 缩放动画 -->
                    <EventTrigger RoutedEvent="UIElement.PreviewStylusDown">
                        <BeginStoryboard Name="PressFeedback">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="0.97" Duration="0:0:0.08" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="0.97" Duration="0:0:0.08" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#C5D8FC" Duration="0:0:0.08" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="UIElement.PreviewStylusUp">
                        <RemoveStoryboard BeginStoryboardName="PressFeedback" />
                        <BeginStoryboard Name="ReleaseFeedback">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <!-- 鼠标按下也触发相同反馈 -->
                    <EventTrigger RoutedEvent="UIElement.PreviewMouseDown">
                        <BeginStoryboard Name="MousePressFeedback">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="0.97" Duration="0:0:0.08" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="0.97" Duration="0:0:0.08" />
                                <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#C5D8FC" Duration="0:0:0.08" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="UIElement.PreviewMouseUp">
                        <RemoveStoryboard BeginStoryboardName="MousePressFeedback" />
                        <BeginStoryboard Name="MouseReleaseFeedback">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部导航 -->
        <materialDesign:ColorZone Grid.Row="0"
                                  Mode="PrimaryMid"
                                  Padding="16,10"
                                  CornerRadius="8"
                                  Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="BookMultipleOutline"
                                             Width="28"
                                             Height="28"
                                             Margin="0,0,10,0"
                                             VerticalAlignment="Center" />
                    <TextBlock Text="{lang:Lang RecipeManagementSystem}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                 Width="60"
                                 Height="4"
                                 Margin="0,0,16,0"
                                 Style="{StaticResource MaterialDesignLinearProgressBar}"
                                 VerticalAlignment="Center" />

                    <Border Background="#30FFFFFF"
                            CornerRadius="4"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CubeOutline"
                                                     Width="14"
                                                     Height="14"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,4,0" />
                            <TextBlock Text="{Binding CurrentPoolName}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <materialDesign:PackIcon Kind="ChevronRight"
                                             Style="{x:Null}"
                                             Width="16"
                                             Height="16"
                                             VerticalAlignment="Center"
                                             Margin="6,0"
                                             Opacity="0.7" />

                    <Border Background="#20FFFFFF"
                            CornerRadius="4"
                            Padding="8,4"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileDocumentOutline"
                                                     Width="14"
                                                     Height="14"
                                                     VerticalAlignment="Center"
                                                     Margin="0,0,4,0" />
                            <TextBlock Text="{Binding CurrentRecipeName}"
                                       FontSize="13"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1"
              Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"
                                  MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*"
                                  MinWidth="500" />
            </Grid.ColumnDefinitions>

            <!-- ==================== 左侧树形导航 ==================== -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,0,1,0"
                    Padding="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="{lang:Lang RecipeLibrary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <!-- 配方池操作工具栏（全主题样式） -->
                    <WrapPanel Grid.Row="1"
                               Margin="0,0,0,8">
                        <Button Command="{Binding CreatePoolCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30"
                                Padding="10,0"
                                Margin="2,0"
                                FontSize="12"
                                Foreground="Green"
                                ToolTip="{lang:Lang CreateRecipePool}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabasePlusOutline"
                                                         Width="14"
                                                         Height="14"
                                                         Margin="0,0,3,0"
                                                         Foreground="Green" />
                                <TextBlock Text="{lang:Lang CreateNew}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding EditPoolCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30"
                                Padding="10,0"
                                Margin="2,0"
                                FontSize="12"
                                Foreground="Blue"
                                ToolTip="{lang:Lang EditRecipePool}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PencilOutline"
                                                         Width="14"
                                                         Height="14"
                                                         Margin="0,0,3,0"
                                                         Foreground="Blue" />
                                <TextBlock Text="{lang:Lang Edit}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeletePoolCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30"
                                Padding="10,0"
                                Margin="2,0"
                                FontSize="12"
                                Foreground="#D32F2F"
                                ToolTip="{lang:Lang DeleteRecipePool}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DeleteOutline"
                                                         Width="14"
                                                         Height="14"
                                                         Margin="0,0,3,0"
                                                         Foreground="#D32F2F" />
                                <TextBlock Text="{lang:Lang Delete}" />
                            </StackPanel>
                        </Button>
                        <Rectangle Style="{StaticResource VSeparator}" />
                        <Button Command="{Binding LoadPoolsCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30"
                                Padding="10,0"
                                Margin="2,0"
                                FontSize="12"
                                Foreground="Orange"
                                ToolTip="{lang:Lang RefreshRecipePool}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh"
                                                         Width="14"
                                                         Height="14"
                                                         Margin="0,0,3,0"
                                                         Foreground="Orange" />
                                <TextBlock Text="{lang:Lang Refresh}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- 树形视图 - 支持触摸手势选择 -->
                    <TreeView Grid.Row="2"
                              ItemsSource="{Binding TreeNodes}"
                              BorderThickness="0"
                              Background="Transparent"
                              Padding="0"
                              x:Name="RecipeTree"
                              Stylus.IsPressAndHoldEnabled="True">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectedItemChanged">
                                <i:InvokeCommandAction Command="{Binding SelectNodeCommand}"
                                                       CommandParameter="{Binding SelectedItem, ElementName=RecipeTree}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>

                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem"
                                   BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                <Setter Property="IsExpanded"
                                        Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected"
                                        Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Margin"
                                        Value="-5,0,0,0" />
                                <Setter Property="materialDesign:TreeViewAssist.ShowSelection"
                                        Value="False" />
                                <!-- 触摸优化：增大触控区域 -->
                                <Setter Property="Padding"
                                        Value="4,8" />
                                <Setter Property="MinHeight"
                                        Value="36" />
                                <Setter Property="Cursor"
                                        Value="Hand" />
                                <EventSetter Event="StylusDown"
                                             Handler="TreeViewItem_StylusDown" />
                                <EventSetter Event="PreviewStylusMove"
                                             Handler="TreeViewItem_PreviewStylusMove" />
                                <EventSetter Event="StylusUp"
                                             Handler="TreeViewItem_StylusUp" />
                            </Style>
                        </TreeView.ItemContainerStyle>

                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type viewModels:TreeNode}"
                                                      ItemsSource="{Binding Children}">
                                <Border Style="{StaticResource TreeNodeBorder}">
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,4" />
                                                <TextBlock Text="{Binding ModifiedTime, StringFormat=\{0:yyyy-MM-dd HH:mm\}}"
                                                           FontSize="11"
                                                           Foreground="White" />
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <DockPanel LastChildFill="True">
                                        <!-- 三点按钮（主题样式） -->
                                        <Button DockPanel.Dock="Right"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Height="30"
                                                Padding="4,0"
                                                Margin="2,0"
                                                Visibility="{Binding Type, Converter={StaticResource NodeTypeToVisibilityConverter}, ConverterParameter='Pool'}"
                                                ToolTip="{lang:Lang RecipeOperation}"
                                                Command="{Binding DataContext.ToggleMenuCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="DotsHorizontal"
                                                                     Width="16"
                                                                     Height="16" />
                                        </Button>

                                        <!-- 当前状态标签 -->
                                        <Border DockPanel.Dock="Right"
                                                Background="#E3F2FD"
                                                CornerRadius="8"
                                                Padding="6,2"
                                                Margin="4,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{lang:Lang CurrentLabel}"
                                                       FontSize="10"
                                                       Foreground="#1565C0"
                                                       FontWeight="Medium" />
                                        </Border>

                                        <!-- 子项数量标签 - 配方池显示配方数量 -->
                                        <Border DockPanel.Dock="Right"
                                                CornerRadius="8"
                                                Padding="6,2"
                                                Margin="4,0"
                                                VerticalAlignment="Center"
                                                Background="#E8F0FE"
                                                Visibility="{Binding Type, Converter={StaticResource NodeTypeToVisibilityConverter}, ConverterParameter='Pool'}">
                                            <TextBlock Text="{Binding Children.Count}"
                                                       FontSize="10"
                                                       Foreground="#1A73E8"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center" />
                                        </Border>

                                        <!-- 图标 - 根据节点类型着色 -->
                                        <materialDesign:PackIcon DockPanel.Dock="Left"
                                                                 Kind="{Binding Icon}"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Margin="0,0,8,0"
                                                                 VerticalAlignment="Center">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Foreground"
                                                            Value="#5F6368" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}"
                                                                     Value="Pool">
                                                            <Setter Property="Foreground"
                                                                    Value="#1A73E8" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}"
                                                                     Value="Recipe">
                                                            <Setter Property="Foreground"
                                                                    Value="#3C8039" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>

                                        <!-- 名称 -->
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="Medium"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <Rectangle Grid.Column="1"
                       Width="1"
                       Fill="{DynamicResource MaterialDesignDivider}" />

            <!-- ========== 右侧参数管理 ========== -->
            <Grid Grid.Column="2"
                  Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{lang:Lang ParamDetailManagement}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Command="{Binding SwitchToCurrentPoolCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30"
                                Padding="10,0"
                                Margin="2,0"
                                FontSize="12"
                                Foreground="{DynamicResource PrimaryHueMidBrush}"
                                FontWeight="SemiBold"
                                ToolTip="{lang:Lang SwitchToSelectedPool}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SwapHorizontal"
                                                         Width="14"
                                                         Height="14"
                                                         Margin="0,0,3,0" />
                                <TextBlock Text="{lang:Lang SwitchToThisPool}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveRecipePoolCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Height="30"
                                Padding="10,0"
                                Margin="2,0"
                                FontSize="12"
                                ToolTip="{lang:Lang SavePoolConfig}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="DatabaseSettingsOutline"
                                                         Width="14"
                                                         Height="14"
                                                         Margin="0,0,3,0" />
                                <TextBlock Text="{lang:Lang SavePool}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TabControl Grid.Row="1"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            Style="{StaticResource MaterialDesignTabControl}"
                            materialDesign:ColorZoneAssist.Mode="Standard">
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal"
                                        Margin="4,0">
                                <materialDesign:PackIcon Kind="MapMarkerPath"
                                                         Width="16"
                                                         Height="16"
                                                         Margin="0,0,5,0" />
                                <TextBlock Text="{lang:Lang PositionParams}" />
                            </StackPanel>
                        </TabItem.Header>
                        <moduleViews:MultiStationPositionEditorView Margin="4" />
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal"
                                        Margin="4,0">
                                <materialDesign:PackIcon Kind="CogOutline"
                                                         Width="16"
                                                         Height="16"
                                                         Margin="0,0,5,0" />
                                <TextBlock Text="{lang:Lang StationParams}" />
                            </StackPanel>
                        </TabItem.Header>
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0"
                                    Command="{Binding RefreshStationParametersCommand}"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Right"
                                    Padding="8,4"
                                    Margin="0,0,0,6"
                                    ToolTip="{lang:Lang ReloadStationParams}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Refresh"
                                                             Width="14"
                                                             Height="14"
                                                             Margin="0,0,4,0" />
                                    <TextBlock Text="{lang:Lang RefreshParams}"
                                               FontSize="12" />
                                </StackPanel>
                            </Button>
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          materialDesign:ScrollViewerAssist.IsAutoHideEnabled="True">
                                <ItemsControl ItemsSource="{Binding StationParameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding StationIdentifier}"
                                                      Margin="0,3"
                                                      IsExpanded="True"
                                                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="12">
                                                <Expander.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0"
                                                                        Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <materialDesign:PackIcon Kind="Factory"
                                                                                         Width="16"
                                                                                         Height="16"
                                                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                                         Margin="0,0,8,0"
                                                                                         VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding}"
                                                                           FontWeight="Medium"
                                                                           FontSize="13"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Expander}}"
                                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                                    Width="28"
                                                                    Height="28"
                                                                    Padding="0"
                                                                    ToolTip="{lang:Lang OpenStationParamEditor}"
                                                                    Visibility="{Binding EditCommand, Converter={StaticResource BoolToVis}}">
                                                                <materialDesign:PackIcon Kind="PencilOutline"
                                                                                         Width="16"
                                                                                         Height="16" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </Expander.HeaderTemplate>
                                                <DataGrid ItemsSource="{Binding Properties}"
                                                          AutoGenerateColumns="False"
                                                          HeadersVisibility="Column"
                                                          IsReadOnly="True"
                                                          GridLinesVisibility="Horizontal"
                                                          Background="Transparent"
                                                          RowBackground="Transparent"
                                                          AlternatingRowBackground="{DynamicResource MaterialDesignPaper}"
                                                          materialDesign:DataGridAssist.CellPadding="8,4"
                                                          materialDesign:DataGridAssist.ColumnHeaderPadding="8,6"
                                                          MaxHeight="280">
                                                    <DataGrid.Columns>
                                                        <!-- 第一列：显示 DisplayName -->
                                                        <DataGridTextColumn Header="{lang:Lang ParamName}"
                                                                                            Binding="{Binding DisplayName}"
                                                                                            Width="Auto"
                                                                                            ElementStyle="{StaticResource MaterialDesignBody2TextBlock}" />
                                                        <!-- 第二列：参数值 -->
                                                        <DataGridTextColumn Header="{lang:Lang ParamValue}"
                                                                                            Binding="{Binding Value}"
                                                                                            Width="*"
                                                                                            ElementStyle="{StaticResource MaterialDesignBody2TextBlock}" />
                                                        <!-- 第三列：类型 -->
                                                        <DataGridTextColumn Header="{lang:Lang Type}"
                                                                                            Binding="{Binding TypeName}"
                                                                                            Width="80"
                                                                                            ElementStyle="{StaticResource MaterialDesignCaptionTextBlock}" />
                                                        <!-- 第四列：描述 -->
                                                        <DataGridTextColumn Header="{lang:Lang Desc}"
                                                                                            Binding="{Binding Description}"
                                                                                            Width="2*"
                                                                                            ElementStyle="{StaticResource MaterialDesignCaptionTextBlock}" />
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal"
                                        Margin="4,0">
                                <materialDesign:PackIcon Kind="Variable"
                                                         Width="16"
                                                         Height="16"
                                                         Margin="0,0,5,0" />
                                <TextBlock Text="{lang:Lang GlobalVar}" />
                            </StackPanel>
                        </TabItem.Header>
                        <moduleViews:GlobalVariablesView Margin="4" />
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2"
                Background="{DynamicResource MaterialDesignToolBarBackground}"
                BorderBrush="{DynamicResource MaterialDesignDivider}"
                BorderThickness="0,1,0,0"
                Padding="12,5"
                CornerRadius="0,0,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="0,0,12,0">
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill"
                                        Value="#4CAF50" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}"
                                                 Value="True">
                                        <Setter Property="Fill"
                                                Value="#FF9800" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding IsLoading, Converter={StaticResource BoolToVis}, FallbackValue=Ready}"
                               FontSize="11"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMessage}"
                           Style="{DynamicResource MaterialDesignCaptionTextBlock}"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- 三点菜单弹出框（全局） -->
        <Popup IsOpen="{Binding IsMenuOpen}"
               Placement="MousePoint"
               StaysOpen="False"
               Closed="Popup_Closed">
            <Border DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    BorderThickness="0"
                    CornerRadius="4"
                    Padding="0">
                <StackPanel MinWidth="150">
                    <MenuItem Header="{lang:Lang CreateRecipe}"
                              Command="{Binding CreateRecipeCommand}"
                              Icon="{materialDesign:PackIcon Kind=FilePlusOutline}" />
                    <MenuItem Header="{lang:Lang EditRecipe}"
                              Command="{Binding EditRecipeCommand}"
                              Icon="{materialDesign:PackIcon Kind=PencilOutline}" />
                    <MenuItem Header="{lang:Lang DeleteRecipe}"
                              Command="{Binding DeleteRecipeCommand}"
                              Icon="{materialDesign:PackIcon Kind=DeleteOutline}" />
                    <MenuItem Header="{lang:Lang SwitchRecipe}"
                              Command="{Binding SwitchRecipeCommand}"
                              Icon="{materialDesign:PackIcon Kind=CubeOutline}" />
                    <MenuItem Header="{lang:Lang RefreshRecipe}"
                              Command="{Binding RefreshRecipeCommand}"
                              CommandParameter="{Binding SelectedNode}"
                              Icon="{materialDesign:PackIcon Kind=Refresh}" />
                    <MenuItem Header="{lang:Lang SaveRecipe}"
                              Command="{Binding SaveRecipeCommand}"
                              CommandParameter="{Binding SelectedNode}"
                              Icon="{materialDesign:PackIcon Kind=ContentSaveOutline}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>