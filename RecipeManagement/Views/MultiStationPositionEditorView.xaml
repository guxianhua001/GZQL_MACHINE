<UserControl x:Class="Recipe.Views.MultiStationPositionEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Recipe.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="550"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 标题行 -->
            <RowDefinition Height="Auto" />
            <!-- 工站选择栏 -->
            <RowDefinition Height="Auto" />
            <!-- 操作工具栏 -->
            <RowDefinition Height="*" />
            <!-- 表格 -->
            <RowDefinition Height="Auto" />
            <!-- 底部按钮 -->
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0"
                   Text="{lang:Lang PositionEditor_Title}"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10" />

        <!-- 工站选择栏 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <TextBlock Text="{lang:Lang PositionEditor_SelectStation}"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Margin="5,0,0,0" />
            <ComboBox ItemsSource="{Binding Stations}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedStation}"
                      Width="150"
                      Margin="5" />
            <Button Content="{lang:Lang PositionEditor_AddPosition}"
                    Command="{Binding AddPositionCommand}"
                    Margin="5,0,0,0" />
            <Button Content="{lang:Lang PositionEditor_DeletePosition}"
                    Command="{Binding DeletePositionCommand}"
                    Margin="5,0" />
        </StackPanel>

        <!-- 操作工具栏 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <TextBlock Text="{lang:Lang PositionEditor_Speed}"
                       VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding SpeedOptions}"
                      SelectedItem="{Binding SelectedSpeed}"
                      Width="70"
                      Margin="5,0,10,0" />
            <TextBlock Text="{lang:Lang Unit_mm_s}"
                       VerticalAlignment="Center"
                       Margin="5,0,10,0" />
            <Button Content="{lang:Lang AssemblyStep_Button_Teach}"
                    Command="{Binding TeachCommand}"
                    Margin="5,0" />
            <Button Content="{lang:Lang PositionEditor_Undo}"
                    Command="{Binding UndoCommand}"
                    Margin="5,0" />
            <Button Content="{lang:Lang PositionEditor_Goto}"
                    Command="{Binding ReplayCommand}"
                    Margin="5,0" />
            <Button Content="{lang:Lang Stop}"
                    Command="{Binding StopCommand}"
                    Width="80"
                    Margin="5,0" />
        </StackPanel>

        <!-- 位置表格（使用自动生成列） -->
        <DataGrid x:Name="PositionsDataGrid"
                  Grid.Row="3"
                  ItemsSource="{Binding PositionsTable.DefaultView}"
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CanUserSortColumns="False"
                  SelectedItem="{Binding SelectedRow}"
                  SelectionMode="Single"
                  CurrentCellChanged="PositionsDataGrid_CurrentCellChanged"
                  AutoGeneratingColumn="DataGrid_AutoGeneratingColumn" />

        <!-- 底部按钮 -->
        <Grid Grid.Row="4"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：向上/向下按钮组 -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Margin="8,0,0,0">
                <Button Command="{Binding MoveUpCommand}"
                        Width="100"
                        Margin="5,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowUp"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,5,0" />
                        <TextBlock Text="{lang:Lang PositionEditor_Up}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding MoveDownCommand}"
                        Width="100"
                        Margin="5,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowDown"
                                                 Width="20"
                                                 Height="20"
                                                 Margin="0,0,5,0" />
                        <TextBlock Text="{lang:Lang PositionEditor_Down}" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 右侧：保存/关闭按钮 -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal">
                <Button Content="{lang:Lang Save_Parameters}"
                        Command="{Binding SaveCommand}"
                        Width="100"
                        Margin="5" />
                <Button Content="{lang:Lang Close}"
                        Command="{Binding CloseCommand}"
                        Width="100"
                        Margin="5" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>