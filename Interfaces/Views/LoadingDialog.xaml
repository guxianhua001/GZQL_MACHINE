<Window x:Class="Interfaces.Views.LoadingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Interfaces.Views"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:con="clr-namespace:Interfaces.Converters"
        mc:Ignorable="d"
        Title="正在处理"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        Height="200"
        Width="400">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 添加BooleanToVisibilityConverter -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- 修正后的圆形进度条样式 -->
            <Style x:Key="MaterialDesignCircularProgressBar"
                   TargetType="ProgressBar">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Viewbox Width="60"
                                     Height="60">

                                <!-- 使用转换器控制可见性 -->
                                <materialDesign:PackIcon Kind="Loading"
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                         Width="60"
                                                         Height="60"
                                                         Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsIndeterminate, Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <materialDesign:PackIcon.RenderTransform>
                                        <RotateTransform CenterX="30"
                                                         CenterY="30"
                                                         Angle="0" />
                                    </materialDesign:PackIcon.RenderTransform>
                                    <materialDesign:PackIcon.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(RotateTransform.Angle)"
                                                                     From="0"
                                                                     To="360"
                                                                     Duration="0:0:1"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </materialDesign:PackIcon.Triggers>
                                </materialDesign:PackIcon>
                            </Viewbox>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>


    <!-- 半透明遮罩背景 -->
    <Grid>
        <Border CornerRadius="10"
                Background="#E0FFFFFF"
                BorderBrush="#A0A0A0"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <!-- 标题区域 -->
                <TextBlock x:Name="TitleText"
                           Text="正在处理"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Grid.Row="0" />

                <!-- 主要内容区域 -->
                <StackPanel Grid.Row="1"
                            Margin="20,10">
                    <!-- 加载动画 -->
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 Value="0"
                                 IsIndeterminate="True"
                                 HorizontalAlignment="Center"
                                 Height="60"
                                 Width="60" />

                    <!-- 状态消息 -->
                    <TextBlock x:Name="StatusText"
                               Text="正在处理，请稍候..."
                               Margin="0,15"
                               TextAlignment="Center"
                               FontSize="14" />

                    <!-- 进度条 -->
                    <ProgressBar x:Name="ProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="10"
                                 Margin="0,5,0,0" />

                    <!-- 进度文本 -->
                    <TextBlock x:Name="ProgressText"
                               Text=""
                               TextAlignment="Center"
                               FontSize="12"
                               Foreground="Gray"
                               Margin="0,5,0,0" />
                </StackPanel>

                <!-- 按钮区域 -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,5">
                    <!-- 取消按钮 -->
                    <Button x:Name="CancelButton"
                            Content="取消"
                            Padding="15,3"
                            Height="25"
                            Margin="0,-25"
                            Visibility="Visible"
                            Click="CancelButton_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
