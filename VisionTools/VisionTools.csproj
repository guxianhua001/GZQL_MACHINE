<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <AssemblyName>VisionTools</AssemblyName>
    <RootNamespace>VisionTools</RootNamespace>
    <OutputType>Library</OutputType>
    <Nullable>disable</Nullable>
    <!--
      视觉工具类库（纯托管，无HALCON依赖）：
      承载与图像处理相关、可在主进程（.NET 9）内直接复用的工具逻辑。
      当前仅含 TiffFloatReader（无压缩浮点TIFF托管解码器），用于安全读取
      仪器导出的ZMAP高度图（避免HALCON原生TIFF解码器对个别文件访问冲突）。
      HALCON相关的显示/采样由主程序 HalconWrapper / Module 在进程内完成，
      不再需要独立进程与命令分发（已移除 VisionTools.Host / ToolRunner）。
    -->
  </PropertyGroup>
</Project>
