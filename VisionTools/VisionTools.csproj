<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-windows7.0</TargetFramework>
    <AssemblyName>VisionTools</AssemblyName>
    <RootNamespace>VisionTools</RootNamespace>
    <OutputType>Library</OutputType>
    <Nullable>disable</Nullable>
    <!-- 视觉算法类库：承载可复用的 HALCON 读图和后续视觉工具能力，不包含 WPF/Prism/UI。 -->
    <HalconDllPath>..\MainApp\bin\Debug\net9.0-windows7.0\halcondotnet.dll</HalconDllPath>
    <DefineConstants Condition="Exists('$(HalconDllPath)')">$(DefineConstants);HAS_HALCON</DefineConstants>
  </PropertyGroup>

  <!-- HALCON SDK 缺失时生成空程序集，主程序会使用既有的无 HALCON 降级实现。 -->
  <ItemGroup Condition="!Exists('$(HalconDllPath)')">
    <Compile Remove="Tools\GrabImage\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="halcondotnet" Condition="Exists('$(HalconDllPath)')">
      <HintPath>$(HalconDllPath)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
