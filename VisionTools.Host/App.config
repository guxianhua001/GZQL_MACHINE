<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <!--
      允许托管代码捕获AccessViolationException等"损坏状态异常"：
      HALCON原生解码器读取异常TIFF时可能触发访问冲突，开启后
      ZMapReadTool能捕获该异常并转入托管兜底解码/输出可读错误信息，
      而不是让整个工具进程直接崩溃。
    -->
    <legacyCorruptedStateExceptionsPolicy enabled="true" />
  </runtime>
</configuration>
