<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>VisionTools.Host</AssemblyName>
    <RootNamespace>VisionTools.Host</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--
      视觉工具瘦启动壳（.NET Framework 4.7.2 / x64）：
      仅包含Main入口，所有工具逻辑在VisionTools类库中。
      主控程序（.NET 9）通过命令行启动本进程调用视觉工具，
      输出目录直接指向主程序部署目录下的VisionTools子目录。
      调试：设置环境变量 VISIONTOOLS_DEBUG=1 后由主程序触发调用，
      会弹出调试器选择框，选择当前VS实例即可命中断点；
      也可将本项目设为启动项目并在调试参数中填入命令行直接调试。
    -->
    <OutputPath>..\MainApp\bin\$(Configuration)\net9.0-windows7.0\VisionTools\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VisionTools\VisionTools.csproj" />
  </ItemGroup>
</Project>
