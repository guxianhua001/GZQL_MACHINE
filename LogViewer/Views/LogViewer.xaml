<UserControl x:Class="LogViewer.Views.LogViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:LogViewer.Converters"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ModuleCore;component/Themes/DialogTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:NewLineToLineBreakConverter x:Key="NewLineToLineBreakConverter" />
            <local:LevelToHoverBackgroundConverter x:Key="LevelToHoverBackgroundConverter" />

            <FontFamily x:Key="LogFontFamily">Consolas, Courier New, Microsoft YaHei UI, monospace</FontFamily>
            <sys:Double x:Key="LogFontSize">12</sys:Double>
            <sys:Double x:Key="LogRowMinHeight">22</sys:Double>
            <Thickness x:Key="LogCellPadding">4,2</Thickness>

        <Style x:Key="ToolbarButtonStyle"
               TargetType="Button">
            <Setter Property="Margin"
                    Value="2" />
            <Setter Property="Padding"
                    Value="5,2" />
            <Setter Property="MinWidth"
                    Value="60" />
        </Style>

        <!-- 行样式：日志级别背景色 + 最新日志橘黄色高亮（IsLatest放最后，优先级最高） -->
        <Style x:Key="LogRowStyle"
               TargetType="{x:Type DataGridRow}">
            <Setter Property="MinHeight"
                    Value="{StaticResource LogRowMinHeight}" />
            <Setter Property="FontFamily"
                    Value="{StaticResource LogFontFamily}" />
            <Setter Property="FontSize"
                    Value="{StaticResource LogFontSize}" />
            <!-- 动态前景色：跟随主题变化 -->
            <Setter Property="Foreground"
                    Value="{DynamicResource LogForeground}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}"
                             Value="INFO">
                    <Setter Property="Background"
                            Value="{DynamicResource LogInfoBackground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}"
                             Value="WARN">
                    <Setter Property="Background"
                            Value="{DynamicResource LogWarnBackground}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}"
                             Value="ERROR">
                    <Setter Property="Background"
                            Value="{DynamicResource LogErrorBackground}" />
                </DataTrigger>

                <Trigger Property="IsMouseOver"
                         Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource LevelToHoverBackgroundConverter}">
                                <Binding Path="Level" />
                                <Binding RelativeSource="{RelativeSource Self}"
                                         Path="IsSelected" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource LogSelectedBackground}" />
                </Trigger>

                <!-- 最新日志行：橘黄色高亮（放最后，优先级最高，覆盖级别颜色） -->
                <DataTrigger Binding="{Binding IsLatest}"
                             Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource LatestLogBackground}" />
                    <Setter Property="FontWeight"
                            Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogCellStyle"
               TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding"
                    Value="{StaticResource LogCellPadding}" />
            <Setter Property="FontFamily"
                    Value="{StaticResource LogFontFamily}" />
            <Setter Property="FontSize"
                    Value="{StaticResource LogFontSize}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <!-- 动态前景色，与 LogRowStyle 保持一致 -->
            <Setter Property="Foreground"
                    Value="{DynamicResource LogForeground}" />
            <Style.Triggers>
                <Trigger Property="IsSelected"
                         Value="True">
                    <Setter Property="Foreground"
                            Value="{DynamicResource LogForeground}" />
                    <Setter Property="Background"
                            Value="Transparent" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogColumnHeaderStyle"
               TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="FontWeight"
                    Value="Bold" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="Padding"
                    Value="{StaticResource LogCellPadding}" />
            <Setter Property="Height"
                    Value="{StaticResource LogRowMinHeight}" />
        </Style>

        <Style x:Key="FilterPanelStyle"
               TargetType="StackPanel">
            <Setter Property="Margin"
                    Value="5" />
            <Setter Property="Orientation"
                    Value="Horizontal" />
            <Setter Property="HorizontalAlignment"
                    Value="Right" />
        </Style>

        <!-- 卡片式悬浮提示样式 -->
        <Style x:Key="LogToolTipStyle"
               TargetType="ToolTip">
            <Setter Property="MaxWidth"
                    Value="500" />
            <Setter Property="Background"
                    Value="{DynamicResource LogToolTipBackground}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource DialogBorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Padding"
                    Value="8,6" />
            <Setter Property="FontFamily"
                    Value="{StaticResource LogFontFamily}" />
            <Setter Property="FontSize"
                    Value="{StaticResource LogFontSize}" />
        </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0"
                 Margin="2"
                 Background="{DynamicResource LogToolBarBackground}">
            <Button Content="{lang:Lang LogViewer_Clear}"
                    Click="ClearButton_Click"
                    ToolTip="{lang:Lang LogViewer_ClearTip}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Separator />
            <Button Content="{lang:Lang LogViewer_ScrollToFirst}"
                    Click="ScrollToFirstButton_Click"
                    ToolTip="{lang:Lang LogViewer_ScrollToFirstTip}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Button Content="{lang:Lang LogViewer_ScrollToLast}"
                    Click="ScrollToLastButton_Click"
                    ToolTip="{lang:Lang LogViewer_ScrollToLastTip}"
                    Style="{StaticResource ToolbarButtonStyle}" />
            <Separator />
            <CheckBox x:Name="AutoScrollCheckBox"
                      Content="{lang:Lang LogViewer_AutoScroll}"
                      ToolTip="{lang:Lang LogViewer_AutoScrollTip}"
                      Margin="5,0,0,0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding AutoScrollToLast, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </ToolBar>

        <StackPanel Grid.Row="0"
                    Style="{StaticResource FilterPanelStyle}">
            <TextBlock Text="{lang:Lang LogViewer_FilterByLevel}"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0" />
            <ComboBox x:Name="LevelFilterComboBox"
                      Width="100"
                      SelectionChanged="LevelFilterComboBox_SelectionChanged"
                      ToolTip="{lang:Lang LogViewer_FilterByLevelTip}">
                <ComboBoxItem Tag=""
                              Content="{lang:Lang LogViewer_LevelAll}"
                              IsSelected="True" />
                <ComboBoxItem Tag="INFO"
                              Content="{lang:Lang LogViewer_LEVEL_INFO}" />
                <ComboBoxItem Tag="WARN"
                              Content="{lang:Lang LogViewer_LEVEL_WARN}" />
                <ComboBoxItem Tag="ERROR"
                              Content="{lang:Lang LogViewer_LEVEL_ERROR}" />
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="LogDataGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Background="{DynamicResource DialogCardBrush}"
                  Foreground="{DynamicResource LogForeground}"
                  RowStyle="{StaticResource LogRowStyle}"
                  CellStyle="{StaticResource LogCellStyle}"
                  ColumnHeaderStyle="{StaticResource LogColumnHeaderStyle}"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  CanUserResizeRows="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{lang:Lang LogViewer_HeaderTime}"
                                    Binding="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.ffff'}"
                                    Width="170" />
                <DataGridTextColumn Header="{lang:Lang LogViewer_HeaderLevel}"
                                    Binding="{Binding Level}"
                                    Width="60" />
                <DataGridTemplateColumn Header="{lang:Lang LogViewer_HeaderMessage}"
                                        Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Message}"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource LogForeground}"
                                       Padding="{StaticResource LogCellPadding}"
                                       FontFamily="{StaticResource LogFontFamily}"
                                       FontSize="{StaticResource LogFontSize}"
                                       VerticalAlignment="Center">
                                <TextBlock.ToolTip>
                                    <ToolTip Style="{StaticResource LogToolTipStyle}"
                                             ToolTipService.ShowDuration="30000">
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{DynamicResource LogForeground}"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="480"
                                                   FontFamily="{StaticResource LogFontFamily}"
                                                   FontSize="{StaticResource LogFontSize}" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
