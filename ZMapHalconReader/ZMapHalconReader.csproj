<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ZMapHalconReader</AssemblyName>
    <RootNamespace>ZMapHalconReader</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!--
      HALCON 21.11仅提供dotnet20/dotnet35接口程序集。将读图放到.NET Framework
      4.7.2独立进程中，既与参考Plugin.GrabImage运行环境一致，也可隔离原生解码崩溃，
      避免System.ExecutionEngineException直接终止主控.NET 9进程。
    -->
    <OutputPath>..\MainApp\bin\$(Configuration)\net9.0-windows7.0\ZMapHalconReader\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="halcondotnet">
      <HintPath>$(HALCONROOT)\bin\dotnet35\halcondotnet.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
