<Window x:Class="MotionControl.Dialogs.ParameterProgressDialog"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
       xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
       Title="{lang:Lang AxisSetting_SetAllAxes}"
       Width="450" Height="200"
       ResizeMode="NoResize"
       WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="{lang:Lang AxisSetting_Preparing}" 
                   TextWrapping="Wrap" Margin="0,0,0,10" FontSize="14"/>
        <ProgressBar x:Name="ProgressBar" Height="20" Minimum="0" Maximum="1" Value="0"/>
        <TextBlock x:Name="ProgressText" Text="0%" HorizontalAlignment="Right" 
                   Margin="0,5,0,0" FontSize="12"/>
    </StackPanel>
</Window>