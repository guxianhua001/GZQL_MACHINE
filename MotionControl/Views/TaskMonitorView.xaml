<UserControl x:Class="MotionControl.Views.TaskMonitorView"
	             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	             xmlns:prism="http://prismlibrary.com/"
	             xmlns:models="clr-namespace:MotionControl.Models"
                 xmlns:conv="clr-namespace:MotionControl.Converters"
                 xmlns:common="clr-namespace:MotionControl.Common"
                 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                 xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
	             prism:ViewModelLocator.AutoWireViewModel="True"
	             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanConverter x:Key="InverseBoolToVis" />

        <!-- 状态指示灯样式：与 StationStateView 状态面板保持一致，紧凑模式缩小为 10x10 -->
        <Style x:Key="StatusLight" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#9E9E9E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Running">
                    <Setter Property="Fill" Value="#4CAF50"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Paused">
                    <Setter Property="Fill" Value="#FF9800"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Error">
                    <Setter Property="Fill" Value="#F44336"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="ErrorBlinkStoryboard">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0.15" Duration="0:0:0.5"
                                                 AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="ErrorBlinkStoryboard"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Homing">
                    <Setter Property="Fill" Value="#2196F3"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Idle">
                    <Setter Property="Fill" Value="#9E9E9E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Stopped">
                    <Setter Property="Fill" Value="#9E9E9E"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 步骤行样式：当前步骤高亮、重试预警 -->
        <Style x:Key="StepItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <!-- 当前执行步骤高亮 -->
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <!-- 重试时背景变为淡橙色预警 -->
                <DataTrigger Binding="{Binding RetryCount}" Value="1">
                    <Setter Property="Background" Value="#FFF3E0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RetryCount}" Value="2">
                    <Setter Property="Background" Value="#FFE0B2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 展开/收起切换按钮样式：使用 PackIcon 替代 emoji，根据 IsChecked 切换图标与文本 -->
        <Style x:Key="ExpandToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- 收起状态：显示向下箭头 + 展开文本 -->
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Content">
                        <Setter.Value>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronDown" Width="14" Height="14" VerticalAlignment="Center" Foreground="#757575"/>
                                <TextBlock Text="{lang:Lang TaskMonitor_Expand}" FontSize="10" Foreground="#757575" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <!-- 展开状态：显示向上箭头 + 收起文本 -->
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Content">
                        <Setter.Value>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ChevronUp" Width="14" Height="14" VerticalAlignment="Center" Foreground="#757575"/>
                                <TextBlock Text="{lang:Lang TaskMonitor_Collapse}" FontSize="10" Foreground="#757575" VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- 顶部布局密度切换工具栏 -->
        <Border DockPanel.Dock="Top" Background="#FAFAFA" Padding="6,4" Margin="2,2,2,4"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{lang:Lang TaskMonitor_Layout}" FontSize="10" Foreground="#757575"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <!-- 2列布局按钮 -->
                <Button Command="{Binding SetCardWidthCommand}" CommandParameter="170"
                        ToolTip="{lang:Lang TaskMonitor_Layout}" Margin="0,0,2,0" Padding="6,3" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#F0F0F0" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ViewGridOutline" Width="14" Height="14" VerticalAlignment="Center" Foreground="#616161"/>
                                        <TextBlock Text="2" FontSize="10" Foreground="#616161" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <!-- 当前选中：CardWidth=170 时高亮 -->
                                <DataTrigger Binding="{Binding CardWidth}" Value="170">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ViewGridOutline" Width="14" Height="14" VerticalAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="2" FontSize="10" Foreground="White" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#1976D2" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 3列布局按钮 -->
                <Button Command="{Binding SetCardWidthCommand}" CommandParameter="115"
                        ToolTip="{lang:Lang TaskMonitor_Layout}" Margin="0,0,2,0" Padding="6,3" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#F0F0F0" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ViewGrid" Width="14" Height="14" VerticalAlignment="Center" Foreground="#616161"/>
                                        <TextBlock Text="3" FontSize="10" Foreground="#616161" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CardWidth}" Value="115">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ViewGrid" Width="14" Height="14" VerticalAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="3" FontSize="10" Foreground="White" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#1976D2" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 4列布局按钮 -->
                <Button Command="{Binding SetCardWidthCommand}" CommandParameter="85"
                        ToolTip="{lang:Lang TaskMonitor_Layout}" Padding="6,3" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#F0F0F0" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Apps" Width="14" Height="14" VerticalAlignment="Center" Foreground="#616161"/>
                                        <TextBlock Text="4" FontSize="10" Foreground="#616161" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CardWidth}" Value="85">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Apps" Width="14" Height="14" VerticalAlignment="Center" Foreground="White"/>
                                                <TextBlock Text="4" FontSize="10" Foreground="White" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#1976D2" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 竖向单列布局按钮 -->
                <Button Command="{Binding SetCardWidthCommand}" CommandParameter="360"
                        ToolTip="{lang:Lang TaskMonitor_Layout}" Margin="2,0,0,0" Padding="6,3" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Background="#F0F0F0" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#E0E0E0"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ViewList" Width="14" Height="14" VerticalAlignment="Center" Foreground="#616161"/>
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CardWidth}" Value="360">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="ViewList" Width="14" Height="14" VerticalAlignment="Center" Foreground="White"/>
                                            </StackPanel>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#1976D2" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <!-- 外层 ScrollViewer：工站数量超出可视区域时垂直滚动 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Tasks}" Margin="2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- WrapPanel 自动换行，ItemWidth 绑定 CardWidth 控制布局密度（2/3/4列） -->
                    <WrapPanel Orientation="Horizontal" ItemWidth="{Binding CardWidth}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type models:TaskDisplayModel}">
                    <!-- 紧凑卡片：移除 DropShadowEffect，改用细边框降低渲染开销 -->
                    <Border Margin="3" Background="White" CornerRadius="6"
                            BorderBrush="#E0E0E0" BorderThickness="1" Padding="8">
                        <StackPanel>
                            <!-- 顶部：状态灯 + 工站名 + 当前步骤耗时 -->
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Ellipse Style="{StaticResource StatusLight}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding TaskName}" FontSize="12" FontWeight="Bold" Foreground="#333"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Right" Text="{Binding CurrentStepElapsed}"
                                           FontSize="11" Foreground="#E65100" FontFamily="Consolas" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- 当前步骤名称（显式属性绑定，替代脆弱的集合当前项绑定） -->
                            <TextBlock Text="{Binding CurrentStepName}" FontSize="11" Foreground="#1976D2"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4" FontWeight="Medium"/>

                            <!-- 初始化进度条：仅在 IsInitializing=True 时显示 -->
                            <Border Margin="0,0,0,4" Background="#E3F2FD" CornerRadius="3" Padding="6,4"
                                    Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,3">
                                        <TextBlock Text="{Binding InitMessage}" FontSize="10" Foreground="#1976D2"
                                                   FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="#1976D2" FontFamily="Consolas">
                                            <Run Text="{Binding InitProgress, StringFormat={}{0:F0}%}"/>
                                        </TextBlock>
                                    </Grid>
                                    <ProgressBar Value="{Binding InitProgress}" Maximum="100" Minimum="0" Height="4"
                                                 Foreground="#1976D2" Background="#BBDEFB" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <!-- 展开/收起切换按钮（手风琴式） -->
                            <ToggleButton IsChecked="{Binding IsExpanded}" Style="{StaticResource ExpandToggleButtonStyle}"/>

                            <!-- 步骤历史列表：仅展开时渲染，收起时 Visibility=Collapsed 零开销 -->
                            <ListBox ItemsSource="{Binding StepHistory}"
                                     ItemContainerStyle="{StaticResource StepItemStyle}"
                                     BorderThickness="0" Background="Transparent"
                                     MaxHeight="160" Margin="0,2,0,0"
                                     ScrollViewer.CanContentScroll="False"
                                     x:Name="StepList"
                                     common:ListBoxAutoScroll.IsEnabled="True"
                                     Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:StepRecord}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- 状态图标：使用 PackIcon 替代 emoji -->
                                            <materialDesign:PackIcon Kind="Check" Width="12" Height="12" VerticalAlignment="Center"
                                                                      Foreground="#4CAF50"
                                                                      Visibility="{Binding IsCurrent, Converter={StaticResource InverseBoolToVis}}"/>
                                            <materialDesign:PackIcon Kind="Play" Width="12" Height="12" VerticalAlignment="Center"
                                                                      Foreground="#1976D2"
                                                                      Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}"/>
                                            <!-- 步骤名 -->
                                            <TextBlock Grid.Column="1" Text="{Binding StepName}" FontSize="11" Foreground="#333"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <!-- 重试标记 -->
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="9" Foreground="#FF9800"
                                                       Margin="3,0,0,0" FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RetryCount}" Value="1">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <!-- 耗时 -->
                                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="10" Foreground="#9E9E9E"
                                                       HorizontalAlignment="Right" FontFamily="Consolas" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
    </DockPanel>
</UserControl>
