<UserControl x:Class="MotionControl.Views.SafetyZoneConfigView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             xmlns:converters="clr-namespace:MotionControl.Converters"
             xmlns:vm="clr-namespace:MotionControl.ViewModels"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1050"
             Background="{DynamicResource MaterialDesignPaper}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <!-- 安全区域可视化转换器 -->
            <converters:PositionToCanvasConverter x:Key="PositionToCanvasConverter" />
            <converters:DangerZoneRectConverter x:Key="DangerZoneRectConverter" />
            <converters:HeightFillWidthConverter x:Key="HeightFillWidthConverter" />
            <converters:SafeLineMarginConverter x:Key="SafeLineMarginConverter" />

            <Style x:Key="GroupBoxBlueHeader" TargetType="GroupBox">
                <Setter Property="Foreground" Value="#1565C0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,8,8"/>
            </Style>
            <Style x:Key="GroupBoxTealHeader" TargetType="GroupBox">
                <Setter Property="Foreground" Value="#00838F"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>

            <Style x:Key="ParamLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#FF607D8B"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SectionHeaderText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#1565C0"/>
                <Setter Property="Margin" Value="0,8,0,4"/>
            </Style>

            <!-- 高度轴（Z）编辑行模板：轴名(下拉)+安全高度+方向反转+启用+删除 -->
            <DataTemplate x:Key="HeightAxisRowTemplate" DataType="{x:Type vm:HeightAxisRowViewModel}">
                <Border Background="#F5F7FA" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Margin="0,0,4,0"
                                  ItemsSource="{Binding DataContext.AvailableAxisNames, ElementName=Root}"
                                  Text="{Binding AxisName, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" FontSize="11"
                                  VerticalAlignment="Center"/>

                        <!-- MinWidth 保证 DecimalUpDown 的 +/- 按钮完整可见，不被列宽裁切 -->
                        <materialDesign:DecimalUpDown Grid.Column="1" Value="{Binding SafeHeight}"
                                                      ValueStep="1" Minimum="-500" Maximum="500"
                                                      FontSize="11" Margin="0,0,6,0"
                                                      MinWidth="120" HorizontalAlignment="Stretch"/>

                        <CheckBox Grid.Column="2"
                                  Content="{lang:Lang SafetyZone_ZAxisInverted}"
                                  IsChecked="{Binding InvertedDirection}"
                                  ToolTip="{lang:Lang SafetyZone_ZAxisInvertedTip}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"
                                  FontSize="11"/>

                        <CheckBox Grid.Column="3"
                                  Content="{lang:Lang SafetyZone_EnabledHeader}"
                                  IsChecked="{Binding Enabled}"
                                  ToolTip="{lang:Lang SafetyZone_AxisEnabledTooltip}"
                                  VerticalAlignment="Center" Margin="0,0,4,0"
                                  FontSize="11"/>

                        <Button Grid.Column="4" Width="28" Height="28" Padding="0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="{lang:Lang SafetyZone_RemoveAxisTooltip}"
                                Command="{Binding DataContext.RemoveHeightAxisCommand, ElementName=Root}"
                                CommandParameter="{Binding}">
                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Foreground="#E53935"/>
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 平面锁定轴编辑行模板：轴名(下拉)+危险区下限+危险区上限+删除 -->
            <DataTemplate x:Key="PlaneAxisRowTemplate" DataType="{x:Type vm:PlaneAxisRowViewModel}">
                <Border Background="#F5F7FA" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" Margin="0,0,4,0"
                                  ItemsSource="{Binding DataContext.AvailableAxisNames, ElementName=Root}"
                                  Text="{Binding AxisName, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" FontSize="11"
                                  VerticalAlignment="Center"/>

                        <!-- MinWidth 保证 DecimalUpDown 的 +/- 按钮完整可见 -->
                        <materialDesign:DecimalUpDown Grid.Column="1" Value="{Binding DangerMin}"
                                                      ValueStep="1" Minimum="-1000" Maximum="1000"
                                                      FontSize="11" Margin="0,0,6,0"
                                                      MinWidth="120" HorizontalAlignment="Stretch"/>

                        <materialDesign:DecimalUpDown Grid.Column="2" Value="{Binding DangerMax}"
                                                      ValueStep="1" Minimum="-1000" Maximum="1000"
                                                      FontSize="11" Margin="0,0,6,0"
                                                      MinWidth="120" HorizontalAlignment="Stretch"/>

                        <Button Grid.Column="3" Width="28" Height="28" Padding="0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="{lang:Lang SafetyZone_RemoveAxisTooltip}"
                                Command="{Binding DataContext.RemovePlaneAxisCommand, ElementName=Root}"
                                CommandParameter="{Binding}">
                            <materialDesign:PackIcon Kind="Delete" Width="14" Height="14" Foreground="#E53935"/>
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- 高度轴实时状态条模板：轴名 + 进度条 + 数值 + 安全/危险文字 -->
            <DataTemplate x:Key="HeightAxisStatusTemplate" DataType="{x:Type vm:HeightAxisRowViewModel}">
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding AxisName}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#7E57C2" VerticalAlignment="Center" MinWidth="36"/>

                    <Border Grid.Column="1" Height="20" CornerRadius="4"
                            Background="#E8EAF6" Margin="8,0"
                            BorderBrush="#B39DDB" BorderThickness="1">
                        <Grid>
                            <Border HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Width>
                                    <MultiBinding Converter="{StaticResource HeightFillWidthConverter}">
                                        <Binding Path="CurrentPosition"/>
                                        <Binding Path="SafeHeight"/>
                                        <Binding ElementName="HeightBar" Path="ActualWidth"/>
                                    </MultiBinding>
                                </Border.Width>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#42A5F5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBelowSafe}" Value="True">
                                                <Setter Property="Background" Value="#EF5350"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Border HorizontalAlignment="Left" Width="2" Height="20"
                                    Background="#FF9800" Opacity="0.8">
                                <Border.Margin>
                                    <MultiBinding Converter="{StaticResource SafeLineMarginConverter}">
                                        <Binding Path="SafeHeight"/>
                                        <Binding ElementName="HeightBar" Path="ActualWidth"/>
                                    </MultiBinding>
                                </Border.Margin>
                            </Border>

                            <!-- 负高度或低高度时填充宽度为 0，白字会与浅色背景重叠；固定使用深色确保全行程可读 -->
                            <TextBlock Text="{Binding CurrentPosition, StringFormat=F1}" FontSize="11"
                                       Foreground="#263238" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <Border x:Name="HeightBar" Grid.Column="1" Height="20" Visibility="Collapsed"/>

                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{lang:Lang SafetyZone_Safe}"/>
                                <Setter Property="Foreground" Value="#43A047"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBelowSafe}" Value="True">
                                        <Setter Property="Text" Value="{lang:Lang SafetyZone_Danger}"/>
                                        <Setter Property="Foreground" Value="#E53935"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <materialDesign:Card UniformCornerRadius="8" Margin="8" MinWidth="700">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ========== 顶部标题栏 ========== -->
                <Border Grid.Row="0" Background="{DynamicResource PrimaryHueLightBrush}" Padding="12,8"
                        BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Shield" Width="24" Height="24"
                                                 Foreground="{DynamicResource PrimaryBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{lang:Lang SafetyZone_Title}" FontSize="18" FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryHueDarkBrush}" VerticalAlignment="Center"/>

                        <!-- 启用状态指示灯 -->
                        <Border Width="10" Height="10" CornerRadius="5" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#BDBDBD"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                            <Setter Property="Background" Value="#43A047"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ========== 主内容区：左列参数 + 右列可视化 ========== -->
                <Grid Grid.Row="1" Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="420"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== 左列：参数设置（动态轴列表） ===== -->
                    <GroupBox Grid.Column="0" Style="{StaticResource GroupBoxBlueHeader}">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang SafetyZone_Parameters}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
                        <StackPanel>

                            <!-- 启用安全互锁复选框 -->
                            <CheckBox Content="{lang:Lang SafetyZone_EnableInterlock}"
                                      IsChecked="{Binding Enabled}"
                                      Style="{StaticResource MaterialDesignCheckBox}"
                                      Margin="0,0,0,8"/>

                            <!-- 高度轴（Z）动态列表 -->
                            <TextBlock Text="{lang:Lang SafetyZone_HeightAxesSection}" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock Text="{lang:Lang SafetyZone_HeightAxesTip}" Style="{StaticResource ParamLabel}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding HeightAxisRows}"
                                          ItemTemplate="{StaticResource HeightAxisRowTemplate}"/>
                            <Button Command="{Binding AddHeightAxisCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang SafetyZone_AddHeightAxis}" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- 平面锁定轴动态列表 -->
                            <TextBlock Text="{lang:Lang SafetyZone_PlaneAxesSection}" Style="{StaticResource SectionHeaderText}"/>
                            <TextBlock Text="{lang:Lang SafetyZone_PlaneAxesTip}" Style="{StaticResource ParamLabel}"
                                       TextWrapping="Wrap" Margin="0,0,0,6"/>
                            <ItemsControl ItemsSource="{Binding PlaneAxisRows}"
                                          ItemTemplate="{StaticResource PlaneAxisRowTemplate}"/>
                            <Button Command="{Binding AddPlaneAxisCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang SafetyZone_AddPlaneAxis}" FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <!-- 保存按钮 -->
                            <Button Command="{Binding SaveCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#43A047" Foreground="White"
                                    materialDesign:ButtonAssist.CornerRadius="4"
                                    HorizontalAlignment="Stretch" Padding="0,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{lang:Lang SafetyZone_Save}" FontSize="13" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </ScrollViewer>
                    </GroupBox>

                    <!-- ===== 右列：区域可视化 ===== -->
                    <GroupBox Grid.Column="1" Style="{StaticResource GroupBoxTealHeader}" Margin="8,0,0,0">
                        <GroupBox.Header>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Target" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang SafetyZone_Visualization}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>

                            <!-- 前两个平面轴的 X-Y 区域画布：行程范围 + 危险区红色矩形 + 当前位置圆点 -->
                            <Border Background="#FAFAFA" CornerRadius="4" Padding="8"
                                    BorderBrush="#E0E0E0" BorderThickness="1" HorizontalAlignment="Left">
                                <Canvas Width="400" Height="300" ClipToBounds="True"
                                        x:Name="SafetyCanvas">

                                    <!-- 行程范围背景（浅灰） -->
                                    <Rectangle Fill="#F5F5F5" Stroke="#BDBDBD" StrokeThickness="1"
                                               Canvas.Left="0" Canvas.Top="0"
                                               Width="400" Height="300"/>

                                    <!-- 危险区红色矩形（第一/第二平面轴） -->
                                    <Rectangle Fill="#FFCDD2" Stroke="#E53935" StrokeThickness="1.5" Opacity="0.6">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Left">
                                                <Binding Path="PlaneAxis0.DangerMin"/>
                                                <Binding Path="PlaneAxis0.DangerMax"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Top">
                                                <Binding Path="PlaneAxis1.DangerMin"/>
                                                <Binding Path="PlaneAxis1.DangerMax"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                        <Rectangle.Width>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Width">
                                                <Binding Path="PlaneAxis0.DangerMin"/>
                                                <Binding Path="PlaneAxis0.DangerMax"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Rectangle.Width>
                                        <Rectangle.Height>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Height">
                                                <Binding Path="PlaneAxis1.DangerMin"/>
                                                <Binding Path="PlaneAxis1.DangerMax"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Rectangle.Height>
                                    </Rectangle>

                                    <!-- 危险区标签 -->
                                    <TextBlock Text="DANGER" FontSize="9" Foreground="#E53935" Opacity="0.6"
                                               FontWeight="Bold" HorizontalAlignment="Center">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Left">
                                                <Binding Path="PlaneAxis0.DangerMin"/>
                                                <Binding Path="PlaneAxis0.DangerMax"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource DangerZoneRectConverter}" ConverterParameter="Top">
                                                <Binding Path="PlaneAxis1.DangerMin"/>
                                                <Binding Path="PlaneAxis1.DangerMax"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                    </TextBlock>

                                    <!-- 坐标轴刻度标签 -->
                                    <TextBlock FontSize="9" Foreground="#9E9E9E" Text="{Binding XRangeMin, StringFormat=F0}">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>278</Canvas.Top>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="#9E9E9E" Text="{Binding XRangeMax, StringFormat=F0}">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>278</Canvas.Top>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="#9E9E9E" Text="{Binding YRangeMin, StringFormat=F0}">
                                        <Canvas.Left>2</Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="#9E9E9E" Text="{Binding YRangeMax, StringFormat=F0}">
                                        <Canvas.Left>2</Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                    </TextBlock>

                                    <!-- 当前位置标记圆点 -->
                                    <Ellipse Width="14" Height="14" StrokeThickness="2"
                                             Stroke="#E65100">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="PlaneAxis0.CurrentPosition"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}">
                                                <Binding Path="PlaneAxis1.CurrentPosition"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FF9800"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PlaneAxis0.IsInDanger}" Value="True">
                                                        <Setter Property="Fill" Value="#E53935"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding PlaneAxis1.IsInDanger}" Value="True">
                                                        <Setter Property="Fill" Value="#E53935"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- 当前位置坐标文本 -->
                                        <TextBlock FontSize="9" FontFamily="Consolas" Foreground="#FF9800">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}" ConverterParameter="LabelX">
                                                <Binding Path="PlaneAxis0.CurrentPosition"/>
                                                <Binding Path="XRangeMin"/>
                                                <Binding Path="XRangeMax"/>
                                                <Binding Path="CanvasWidth"/>
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Canvas.Top>
                                            <MultiBinding Converter="{StaticResource PositionToCanvasConverter}" ConverterParameter="LabelY">
                                                <Binding Path="PlaneAxis1.CurrentPosition"/>
                                                <Binding Path="YRangeMin"/>
                                                <Binding Path="YRangeMax"/>
                                                <Binding Path="CanvasHeight"/>
                                            </MultiBinding>
                                        </Canvas.Top>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="({0:F1},{1:F1})">
                                                <Binding Path="PlaneAxis0.CurrentPosition"/>
                                                <Binding Path="PlaneAxis1.CurrentPosition"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                </Canvas>
                            </Border>

                            <!-- 高度轴实时状态列表（动态数量） -->
                            <ItemsControl ItemsSource="{Binding HeightAxisRows}"
                                          ItemTemplate="{StaticResource HeightAxisStatusTemplate}"
                                          Margin="0,8,0,0"/>

                            <!-- 平面轴状态行（动态数量） -->
                            <ItemsControl ItemsSource="{Binding PlaneAxisRows}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PlaneAxisRowViewModel}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                            <materialDesign:PackIcon Kind="AxisArrow" Width="14" Height="14"
                                                                     Foreground="#43A047" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding AxisName}" FontSize="11" Foreground="#757575" VerticalAlignment="Center"/>
                                            <TextBlock Text=": " FontSize="11" Foreground="#757575" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CurrentPosition, StringFormat=F1}" FontSize="11" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Foreground="#43A047">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#424242"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInDanger}" Value="True">
                                                                <Setter Property="Foreground" Value="#E53935"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 画布行程范围设置 -->
                            <Separator Margin="0,12,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <materialDesign:PackIcon Kind="AspectRatio" Width="16" Height="16"
                                                         Foreground="#00838F" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{lang:Lang SafetyZone_CanvasRange}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="#00838F" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{lang:Lang SafetyZone_XRangeMin}" Style="{StaticResource ParamLabel}" Margin="0,0,4,0"/>
                                <materialDesign:DecimalUpDown Grid.Row="0" Grid.Column="1" Value="{Binding XRangeMin}"
                                                              ValueStep="1" Minimum="-5000" Maximum="5000"
                                                              MinWidth="120" Margin="0,0,4,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{lang:Lang SafetyZone_XRangeMax}" Style="{StaticResource ParamLabel}" Margin="4,0,4,0"/>
                                <materialDesign:DecimalUpDown Grid.Row="0" Grid.Column="3" Value="{Binding XRangeMax}"
                                                              ValueStep="1" Minimum="-5000" Maximum="5000"
                                                              MinWidth="120" Margin="0,0,0,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{lang:Lang SafetyZone_YRangeMin}" Style="{StaticResource ParamLabel}" Margin="0,0,4,0"/>
                                <materialDesign:DecimalUpDown Grid.Row="1" Grid.Column="1" Value="{Binding YRangeMin}"
                                                              ValueStep="1" Minimum="-5000" Maximum="5000"
                                                              MinWidth="120" Margin="0,0,4,4"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{lang:Lang SafetyZone_YRangeMax}" Style="{StaticResource ParamLabel}" Margin="4,0,4,0"/>
                                <materialDesign:DecimalUpDown Grid.Row="1" Grid.Column="3" Value="{Binding YRangeMax}"
                                                              ValueStep="1" Minimum="-5000" Maximum="5000"
                                                              MinWidth="120" Margin="0,0,0,4"/>
                            </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </Grid>

                <!-- ========== 底部告警栏 ========== -->
                <Border Grid.Row="2" Visibility="{Binding IsAlarmVisible}"
                        Background="#FFEBEE" CornerRadius="0,0,8,8"
                        BorderBrush="#EF9A9A" BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <materialDesign:PackIcon Grid.Column="0" Kind="Warning" Width="20" Height="20"
                                                 Foreground="#C62828" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <TextBlock Grid.Column="1" Text="{Binding AlarmMessage}" FontSize="12"
                                   Foreground="#C62828" FontWeight="Medium" VerticalAlignment="Center"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>

                        <Button Grid.Column="2" Command="{Binding DismissAlarmCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                BorderBrush="#EF9A9A" Foreground="#C62828"
                                materialDesign:ButtonAssist.CornerRadius="4"
                                Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{lang:Lang SafetyZone_DismissAlarm}" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </materialDesign:Card>
    </ScrollViewer>
</UserControl>
