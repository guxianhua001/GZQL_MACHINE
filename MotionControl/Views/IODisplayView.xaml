<UserControl x:Class="MotionControl.Views.IODisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:MotionControl.Converters"
             xmlns:models="clr-namespace:MotionControl.Models"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="1000"
             MinWidth="1000" MinHeight="500"
             Loaded="OnLoaded" Unloaded="OnUnloaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 转换器实例 -->
            <converters:BoolToLedColorConverter x:Key="BoolToLedColorConverter" />
            <converters:BoolToButtonColorConverter x:Key="BoolToButtonColorConverter" />
            <converters:BoolToTextConverter x:Key="BoolToTextConverter" />
            <converters:BoolToToggleTextConverter x:Key="BoolToToggleTextConverter" />
            <converters:BrushToColorConverter x:Key="BrushToColorConverter" />

            <!-- GroupBox 工业深色样式 -->
            <Style x:Key="IndustrialGroupBox" TargetType="GroupBox">
                <Setter Property="Background" Value="#2D2D30" />
                <Setter Property="BorderBrush" Value="#3E3E42" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <DockPanel LastChildFill="True">
                                    <ContentPresenter ContentSource="Header"
                                                      DockPanel.Dock="Top"
                                                      Margin="10,4,10,0" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                                </DockPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ListBox Item 容器样式 -->
            <Style x:Key="IndustrialListBoxItem" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#CCCCCC" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3A3A3C" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#45454A" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- DI DataTemplate -->
            <DataTemplate DataType="{x:Type models:DiChannelItem}">
                <Grid Margin="4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>

                    <!-- LED 指示灯（三色灯/蜂鸣器通道显示对应颜色） -->
                    <Ellipse Grid.Column="0" Width="16" Height="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{Binding StatusColor}" />

                    <!-- Logical ID（等宽字体，青色高亮）-->
                    <TextBlock Grid.Column="1" Text="{Binding LogicalId}"
                               Foreground="#4EC9B0" FontFamily="Consolas"
                               FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <!-- Port Number -->
                    <TextBlock Grid.Column="2" Text="{Binding Port}"
                               Foreground="#CCCCCC" FontFamily="Consolas"
                               FontSize="12"
                               VerticalAlignment="Center" />

                    <!-- Name（白色加粗） -->
                    <TextBlock Grid.Column="3" Text="{Binding Name}"
                               Foreground="#FFFFFF" FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center" />

                    <!-- Status Text -->
                    <TextBlock Grid.Column="4" Text="{Binding IsActive, Converter={StaticResource BoolToTextConverter}}"
                               Foreground="{Binding StatusColor}" FontSize="11"
                               VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <!-- DO DataTemplate -->
            <DataTemplate DataType="{x:Type models:DoChannelItem}">
                <Grid Margin="4,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>

                    <!-- LED 指示灯 -->
                    <Ellipse Grid.Column="0" Width="16" Height="16"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Fill="{Binding StatusColor}" />

                    <!-- Logical ID（等宽字体，青色高亮） -->
                    <TextBlock Grid.Column="1" Text="{Binding LogicalId}"
                               Foreground="#4EC9B0" FontFamily="Consolas"
                               FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" />

                    <!-- Port Number -->
                    <TextBlock Grid.Column="2" Text="{Binding Port}"
                               Foreground="#CCCCCC" FontFamily="Consolas"
                               FontSize="12"
                               VerticalAlignment="Center" />

                    <!-- Name（白色加粗） -->
                    <TextBlock Grid.Column="3" Text="{Binding Name}"
                               Foreground="#FFFFFF" FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center" />

                    <!-- Toggle Button（切换 DO 状态） -->
                    <Button Grid.Column="4"
                            Command="{Binding DataContext.ToggleDoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{Binding IsActive, Converter={StaticResource BoolToToggleTextConverter}}"
                            Padding="8,2" FontSize="11"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            BorderThickness="1">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding IsActive, Converter={StaticResource BoolToButtonColorConverter}}" />
                        </Button.Background>
                        <Button.Foreground>
                            <SolidColorBrush Color="White" />
                        </Button.Foreground>
                    </Button>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 主背景：工业深色 -->
    <Grid Background="#1E1E1E" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 报警指示灯行（与状态面板StationStateView同步闪烁） -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="8,4"
                Margin="0,0,0,8" BorderBrush="#3E3E42" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Ellipse Width="14" Height="14" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#3E3E42"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AlarmLightOn}" Value="True">
                                    <Setter Property="Fill" Value="#F44336"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{DynamicResource IOView_AlarmStatus}" Foreground="#AAAAAA"
                           FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- IO通道区域 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：DI 数字输入区 ==================== -->
        <GroupBox Grid.Column="0"
                  Style="{StaticResource IndustrialGroupBox}">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowDownBold"
                                             Foreground="#0078D4"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="{lang:Lang IOView_DiTitle}"
                               Foreground="#0078D4"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </GroupBox.Header>

            <ListBox ItemsSource="{Binding DIList}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     ScrollViewer.CanContentScroll="True"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource IndustrialListBoxItem}" />
        </GroupBox>

        <!-- 中间分隔条 -->
        <GridSplitter Grid.Column="1"
                      Width="2"
                      Background="#3E3E42"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch" />

        <!-- ==================== 右侧：DO 数字输出区 ==================== -->
        <GroupBox Grid.Column="2"
                  Style="{StaticResource IndustrialGroupBox}">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowUpBold"
                                             Foreground="#FFB900"
                                             Width="20" Height="20"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                    <TextBlock Text="{lang:Lang IOView_DoTitle}"
                               Foreground="#FFB900"
                               FontSize="14" FontWeight="Bold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </GroupBox.Header>

            <ListBox ItemsSource="{Binding DOList}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     ScrollViewer.CanContentScroll="True"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource IndustrialListBoxItem}" />
        </GroupBox>
    </Grid>
</Grid>
</UserControl>
