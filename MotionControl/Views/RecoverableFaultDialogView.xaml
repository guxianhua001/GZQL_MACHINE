<UserControl x:Class="MotionControl.Views.RecoverableFaultDialogView"
	             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	             xmlns:prism="http://prismlibrary.com/"
	             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	             xmlns:lang="clr-namespace:Core.Markup;assembly=Core"
	             prism:ViewModelLocator.AutoWireViewModel="True"
	             Width="480">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <materialDesign:PackIcon Kind="AlertCircleOutline"
	                                     Foreground="#FF9800" Width="28" Height="28" Margin="0,0,10,0"/>
            <TextBlock Text="{lang:Lang FaultDialog_Title}" FontSize="22" FontWeight="Bold" Foreground="Gray" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
            <TextBlock Text="{lang:Lang FaultDialog_TaskPrefix}" Foreground="Gray" FontSize="14"/>
            <TextBlock Text="{Binding TaskName}" Foreground="Gray" FontSize="14"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="{lang:Lang FaultDialog_StepPrefix}" Foreground="Gray" FontSize="14"/>
            <TextBlock Text="{Binding StepName}" Foreground="Gray" FontSize="14"/>
        </StackPanel>
        <Border Background="#FFF3E0" CornerRadius="4" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{lang:Lang FaultDialog_CauseLabel}" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,5"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#333" TextWrapping="Wrap" FontSize="14"/>
                <TextBlock Text="{lang:Lang FaultDialog_SuggestionLabel}" FontWeight="Bold" Foreground="#E65100" Margin="0,10,0,5"/>
                <TextBlock Text="{Binding SuggestedAction}" Foreground="#333" TextWrapping="Wrap" FontSize="14"/>
            </StackPanel>
        </Border>
        <!-- 自动运行模式：暂停/恢复/停止Task 三个按钮 -->
        <UniformGrid Columns="3" Margin="0,0,0,5"
                     Visibility="{Binding IsAutoOperation, Converter={StaticResource BoolToVis}}">
            <Button Content="{lang:Lang FaultDialog_Resume}"
	                Command="{Binding ResumeCommand}"
	                Background="#4CAF50" Foreground="White"
	                Style="{DynamicResource MaterialDesignRaisedButton}"
	                Height="40" FontSize="14" Margin="0,0,5,0"/>
            <Button Content="{lang:Lang FaultDialog_Pause}"
	                Command="{Binding PauseCommand}"
	                Background="#FF9800" Foreground="White"
	                Style="{DynamicResource MaterialDesignRaisedButton}"
	                Height="40" FontSize="14" Margin="5,0,5,0"/>
            <Button Content="{lang:Lang FaultDialog_StopTask}"
	                Command="{Binding StopCommand}"
	                Background="#F44336" Foreground="White"
	                Style="{DynamicResource MaterialDesignRaisedButton}"
	                Height="40" FontSize="14" Margin="5,0,0,0"/>
        </UniformGrid>
        <!-- 手动操作模式：只显示"确定"按钮，关闭弹窗不做状态切换 -->
        <Button Content="{lang:Lang FaultDialog_Confirm}"
                Command="{Binding ConfirmCommand}"
                Background="#2196F3" Foreground="White"
                Style="{DynamicResource MaterialDesignRaisedButton}"
                Height="40" FontSize="14" HorizontalAlignment="Center" Width="200"
                Visibility="{Binding IsManualOperation, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</UserControl>
